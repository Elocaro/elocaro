# Copy to deploy/.env and adjust. Do NOT commit this file.

# Public domain (the DNS A/AAAA record must point to the server) and contact for Let's Encrypt
MIETHAHN_DOMAIN=miethahn.example.de
ACME_EMAIL=admin@example.de

# Database password (long and random, e.g. `openssl rand -base64 32`)
POSTGRES_PASSWORD=bitte-aendern

# Mail delivery (SMTP of the mail provider)
MAIL_SENDER=verwaltung@example.de
MAIL_SENDER_NAME=Hausverwaltung Musterstraße
MAIL_REPLY_TO=
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USER=verwaltung@example.de
SMTP_PASSWORD=bitte-aendern

# Backup with restic (see docs/betrieb.md). The password encrypts the repository: WITHOUT THE PASSWORD THERE IS NO RESTORE.
# Keep it safe, e.g. in a password manager (generate with: openssl rand -base64 32).
RESTIC_PASSWORD=bitte-aendern
# Target: local (/repo = BACKUP_LOCAL_PATH, for trying out only, lives on the same server!),
# better external, e.g. s3:https://s3.example.com/bucket/miethahn or sftp:backup@nas.example.de:/miethahn
RESTIC_REPOSITORY=/repo
# BACKUP_LOCAL_PATH=./backup-repo
# BACKUP_SSH_PATH=./backup-ssh
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BACKUP_TIME=02:30
# Retention: daily, weekly and monthly snapshots
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12

# Optional: specific image (default: latest from GHCR)
# MIETHAHN_IMAGE=ghcr.io/ther00st3r/miethahn:0.1.0
# MIETHAHN_BACKUP_IMAGE=ghcr.io/ther00st3r/miethahn-backup:0.1.0
