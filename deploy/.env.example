# Kopieren nach deploy/.env und anpassen. Diese Datei NICHT einchecken.

# Öffentliche Domain (DNS-A/AAAA-Eintrag muss auf den Server zeigen) und Kontakt für Let's Encrypt
MIETHAHN_DOMAIN=miethahn.example.de
ACME_EMAIL=admin@example.de

# Datenbankpasswort (lang und zufällig, z. B. `openssl rand -base64 32`)
POSTGRES_PASSWORT=bitte-aendern

# Mailversand (SMTP des Mailanbieters)
MAIL_ABSENDER=verwaltung@example.de
MAIL_ABSENDER_NAME=Hausverwaltung Musterstraße
MAIL_ANTWORT_AN=
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_SICHERHEIT=StartTls
SMTP_BENUTZER=verwaltung@example.de
SMTP_PASSWORT=bitte-aendern

# Optional: bestimmtes Image (Standard: neuestes aus GHCR)
# MIETHAHN_IMAGE=ghcr.io/ther00st3r/miethahn:v0.1.0
