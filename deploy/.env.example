# Copy to deploy/.env and adjust. Do NOT commit this file.

# Public domain (the DNS A/AAAA record must point to the server) and contact for Let's Encrypt
ELOCARO_DOMAIN=elocaro.example.de
ACME_EMAIL=admin@example.de

# Database password (long and random, e.g. `openssl rand -base64 32`)
POSTGRES_PASSWORD=bitte-aendern

# Mail delivery (SMTP of the mail provider)
MAIL_SENDER=verwaltung@example.de
MAIL_SENDER_NAME=Hausverwaltung Musterstraße
MAIL_REPLY_TO=
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USER=verwaltung@example.de
SMTP_PASSWORD=bitte-aendern

# Receipt extraction (optional). None = off (default, no document leaves the server).
# Claude: documents are sent to the Anthropic API (third party!), requires explicit consent and a key.
# Ollama: local vision model (images only), documents stay in your network.
RECEIPT_AI_PROVIDER=None
# RECEIPT_AI_ACCEPT_EXTERNAL=false
# ANTHROPIC_API_KEY=
# RECEIPT_AI_CLAUDE_MODEL=claude-sonnet-5-5
# OLLAMA_URL=http://host.docker.internal:11434/
# OLLAMA_MODEL=qwen2.5vl:7b

# FinTS direct retrieval of bank transactions (optional, see docs/banking-fints.md).
# Product registration number of Elocaro is built in. Only set it for a fork with its own registration.
# FINTS_PRODUCT_ID=
# Version sent with it (at most 5 characters), default 1.0
# FINTS_PRODUCT_VERSION=1.0

# Backup with restic (see docs/betrieb.md). The password encrypts the repository: WITHOUT THE PASSWORD THERE IS NO RESTORE.
# Keep it safe, e.g. in a password manager (generate with: openssl rand -base64 32).
RESTIC_PASSWORD=bitte-aendern
# Target: local (/repo = BACKUP_LOCAL_PATH, for trying out only, lives on the same server!),
# better external, e.g. s3:https://s3.example.com/bucket/elocaro, sftp:backup@nas.example.de:/elocaro
# or azure:elocaro-backup:/ (Azure Blob container)
RESTIC_REPOSITORY=/repo
# BACKUP_LOCAL_PATH=./backup-repo
# BACKUP_SSH_PATH=./backup-ssh
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Azure Blob: storage account name and either the account key or a SAS token
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_ACCOUNT_SAS=
BACKUP_TIME=02:30
# Retention: daily, weekly and monthly snapshots
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12

# Memory limits of the containers (a runaway upload or PDF must not take down the whole server)
# APP_MEM_LIMIT=1536m
# GOTENBERG_MEM_LIMIT=1g

# Optional: specific image (default: latest from GHCR)
# ELOCARO_IMAGE=ghcr.io/elocaro/elocaro:0.1.0
# ELOCARO_BACKUP_IMAGE=ghcr.io/elocaro/elocaro-backup:0.1.0
# Build on the server instead of pulling (docker compose build): local image names and the version shown on /ueber
# ELOCARO_IMAGE=elocaro:0.1.0
# ELOCARO_BACKUP_IMAGE=elocaro-backup:0.1.0
# ELOCARO_VERSION=0.1.0

# Only for a public demo instance on its own server (docs/betrieb.md → "Demo-Instanz")
# DEMO_EMAIL=demo@elocaro.de
# DEMO_PASSWORD=
