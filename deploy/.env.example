# Kopieren nach deploy/.env und anpassen. Diese Datei NICHT einchecken.

# Öffentliche Domain (DNS-A/AAAA-Eintrag muss auf den Server zeigen) und Kontakt für Let's Encrypt
MIETHAHN_DOMAIN=miethahn.example.de
ACME_EMAIL=admin@example.de

# Datenbankpasswort (lang und zufällig, z. B. `openssl rand -base64 32`)
POSTGRES_PASSWORT=bitte-aendern

# Mailversand (SMTP des Mailanbieters)
MAIL_ABSENDER=verwaltung@example.de
MAIL_ABSENDER_NAME=Hausverwaltung Musterstraße
MAIL_ANTWORT_AN=
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_SICHERHEIT=StartTls
SMTP_BENUTZER=verwaltung@example.de
SMTP_PASSWORT=bitte-aendern

# Backup mit restic (siehe docs/betrieb.md). Das Passwort verschlüsselt das Repository: OHNE PASSWORT KEIN RESTORE.
# Sicher aufbewahren, z. B. im Passwortmanager (Erzeugen: openssl rand -base64 32).
RESTIC_PASSWORT=bitte-aendern
# Ziel: lokal (/repo = BACKUP_LOKAL_PFAD, nur zum Ausprobieren, liegt auf demselben Server!),
# besser extern, z. B. s3:https://s3.example.com/bucket/miethahn oder sftp:backup@nas.example.de:/miethahn
RESTIC_REPOSITORY=/repo
# BACKUP_LOKAL_PFAD=./backup-repo
# BACKUP_SSH_PFAD=./backup-ssh
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BACKUP_ZEIT=02:30
# Aufbewahrung: tägliche, wöchentliche und monatliche Stände
# BACKUP_BEHALTEN_TAGE=7
# BACKUP_BEHALTEN_WOCHEN=4
# BACKUP_BEHALTEN_MONATE=12

# Optional: bestimmtes Image (Standard: neuestes aus GHCR)
# MIETHAHN_IMAGE=ghcr.io/ther00st3r/miethahn:0.1.0
# MIETHAHN_BACKUP_IMAGE=ghcr.io/ther00st3r/miethahn-backup:0.1.0
