	email {$ACME_EMAIL}
}

{$ELOCARO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Uploads up to 30 MB (receipts, photos); the app additionally enforces its own limit.
	request_body {
		max_size 30MB
	}

	reverse_proxy app:8080 {
		health_uri /health/live
		health_interval 30s
	}
}
