@if (Errors is { Count: > 0 })
{
    <div class="message message-error" role="alert">
        @if (Errors.Count == 1)
        {
            @Errors[0]
        }
        else
        {
            <ul>
                @foreach (var f in Errors)
                {
                    <li>@f</li>
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<string>? Errors { get; set; }
}
