@* Shows a message from the parameter, from the status cookie of the previous page, or for a known key in the query (?meldung=gespeichert) after navigation from an interactive page. *@
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@if (!string.IsNullOrEmpty(DisplayText))
{
    <Notice Level="@(IsError ? NoticeLevel.Error : NoticeLevel.Success)">@DisplayText</Notice>
}

@code {
    private string? cookieMessage;

    [Parameter]
    public string? Message { get; set; }

    /// <summary>Show as an error (red, role=alert).</summary>
    [Parameter]
    public bool IsError { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? DisplayText => Message ?? cookieMessage;

    /// <summary>Texts for <c>?meldung=key</c>. Only fixed keys, so the URL cannot carry free text onto the page.</summary>
    public static IReadOnlyDictionary<string, string> Keys { get; } = new Dictionary<string, string>
    {
        ["gespeichert"] = "Die Angaben wurden gespeichert.",
        ["angelegt"] = "Der Eintrag wurde angelegt.",
        ["geloescht"] = "Der Eintrag wurde gelöscht.",
        ["objekt-angelegt"] = "Das Objekt wurde angelegt. Jetzt Flächen und Einheiten erfassen.",
    };

    protected override void OnInitialized()
    {
        if (HttpContext is not null)
        {
            cookieMessage = Redirector.ReadMessage(HttpContext);
        }

        if (cookieMessage is null
            && QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query).TryGetValue("meldung", out var key)
            && Keys.TryGetValue(key.ToString(), out var text))
        {
            cookieMessage = text;
        }
    }
}
