@* Heading with page title and optional actions (buttons/links on the right, or below on smartphones). *@
@inject NavigationManager Navigation
<PageTitle>@Title – MietHahn</PageTitle>
<div class="page-header">
    <div class="page-header-title">
        @if (Back is not null)
        {
            <a class="back" href="@Back"><Icon Path="@AppIcons.Back" /><span class="back-text">@(BackText ?? "Zurück")</span></a>
        }
        <h1>@Title</h1>
        @if (Subtitle is not null)
        {
            <p class="small">@Subtitle</p>
        }
    </div>
    @if (Actions is not null || info is not null)
    {
        <div class="page-header-actions">
            @if (info is not null)
            {
                <InfoDialog Info="info" PageId="pageId" />
            }
            @Actions
        </div>
    }
</div>

@code {
    private PageInfo? info;
    private string? pageId;

    protected override void OnParametersSet()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        info = ShowInfo ? PageInfoCatalog.For(path) : null;
        pageId = path.Split('/').FirstOrDefault(part => Guid.TryParse(part, out _));
    }

    /// <summary>false: no info button even if the page has an entry.</summary>
    [Parameter]
    public bool ShowInfo { get; set; } = true;

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string? Back { get; set; }

    [Parameter]
    public string? BackText { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
