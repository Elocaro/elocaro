@* Zeigt eine Meldung aus dem Parameter oder aus dem Status-Cookie der vorherigen Seite. *@
@if (!string.IsNullOrEmpty(AnzeigeText))
{
    <p class="meldung @(IstFehler ? "meldung-fehler" : "meldung-ok")" role="@(IstFehler ? "alert" : "status")">@AnzeigeText</p>
}

@code {
    private string? cookieMeldung;

    [Parameter]
    public string? Meldung { get; set; }

    /// <summary>Als Fehler darstellen (rot, role=alert).</summary>
    [Parameter]
    public bool IstFehler { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? AnzeigeText => Meldung ?? cookieMeldung;

    protected override void OnInitialized()
    {
        if (HttpContext is not null)
        {
            cookieMeldung = Weiterleitung.MeldungLesen(HttpContext);
        }
    }
}
