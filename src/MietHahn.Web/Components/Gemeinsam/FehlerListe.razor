@if (Fehler is { Count: > 0 })
{
    <div class="meldung meldung-fehler" role="alert">
        @if (Fehler.Count == 1)
        {
            @Fehler[0]
        }
        else
        {
            <ul>
                @foreach (var f in Fehler)
                {
                    <li>@f</li>
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<string>? Fehler { get; set; }
}
