@* Riskante Aktion mit Rückfrage ohne JavaScript: erst aufklappen, dann bestätigen. *@
<details class="gefahrenaktion">
    <summary class="knopf knopf-gefahr">@Text</summary>
    <div class="gefahrenaktion-inhalt" role="alertdialog" aria-label="@Text">
        <p>@Rueckfrage</p>
        <form method="post" @formname="@FormName" @onsubmit="Bestaetigt">
            <AntiforgeryToken />
            @ChildContent
            <button type="submit" class="knopf knopf-gefahr">@BestaetigenText</button>
        </form>
    </div>
</details>

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    [Parameter, EditorRequired]
    public string Rueckfrage { get; set; } = "";

    [Parameter]
    public string BestaetigenText { get; set; } = "Ja, ausführen";

    [Parameter, EditorRequired]
    public string FormName { get; set; } = "";

    [Parameter, EditorRequired]
    public EventCallback Bestaetigt { get; set; }

    /// <summary>Zusätzliche (versteckte) Felder des Formulars.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
