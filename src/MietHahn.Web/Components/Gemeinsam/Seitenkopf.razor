@* Überschrift mit Seitentitel und optionalen Aktionen (Knöpfe/Links rechts bzw. darunter auf dem Smartphone). *@
<PageTitle>@Titel – MietHahn</PageTitle>
<div class="seitenkopf">
    <div>
        @if (Zurueck is not null)
        {
            <a class="zurueck" href="@Zurueck">← @(ZurueckText ?? "Zurück")</a>
        }
        <h1>@Titel</h1>
        @if (Untertitel is not null)
        {
            <p class="klein">@Untertitel</p>
        }
    </div>
    @if (Aktionen is not null)
    {
        <div class="seitenkopf-aktionen">@Aktionen</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Titel { get; set; } = "";

    [Parameter]
    public string? Untertitel { get; set; }

    [Parameter]
    public string? Zurueck { get; set; }

    [Parameter]
    public string? ZurueckText { get; set; }

    [Parameter]
    public RenderFragment? Aktionen { get; set; }
}
