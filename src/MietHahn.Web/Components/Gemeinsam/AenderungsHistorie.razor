@using MietHahn.Application.Audit
@inject IAenderungsHistorie Historie

@* Zeigt die Änderungshistorie eines Datensatzes aus dem Audit-Log (zusammengeklappt). *@
<details class="historie">
    <summary>Änderungshistorie (@(eintraege?.Count ?? 0))</summary>
    @if (eintraege is { Count: 0 })
    {
        <p>Keine Einträge.</p>
    }
    else if (eintraege is not null)
    {
        <ol class="historie-liste">
            @foreach (var eintrag in eintraege)
            {
                <li>
                    <div class="historie-kopf">
                        <time>@Format.Zeitpunkt(eintrag.Zeitpunkt)</time>
                        <span class="historie-aktion">@AktionText(eintrag.Aktion)</span>
                        <span class="historie-benutzer">@eintrag.Benutzer</span>
                        @if (eintrag.Zweck is not null)
                        {
                            <span class="historie-zweck">(@eintrag.Zweck)</span>
                        }
                    </div>
                    @if (eintrag.Aenderungen.Count > 0)
                    {
                        <table class="tabelle historie-felder">
                            <thead><tr><th>Feld</th><th>Vorher</th><th>Nachher</th></tr></thead>
                            <tbody>
                                @foreach (var feld in eintrag.Aenderungen)
                                {
                                    <tr><td>@feld.Feld</td><td>@(feld.Alt ?? "–")</td><td>@(feld.Neu ?? "–")</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                </li>
            }
        </ol>
    }
</details>

@code {
    private IReadOnlyList<AuditEintragAnsicht>? eintraege;

    /// <summary>Klassenname der Entität (z. B. <c>nameof(Mietvertrag)</c>).</summary>
    [Parameter, EditorRequired]
    public string EntitaetTyp { get; set; } = "";

    [Parameter, EditorRequired]
    public Guid EntitaetId { get; set; }

    protected override async Task OnParametersSetAsync() => eintraege = await Historie.LadenAsync(EntitaetTyp, EntitaetId);

    private static string AktionText(AuditAktion aktion) => aktion switch
    {
        AuditAktion.Angelegt => "angelegt",
        AuditAktion.Geaendert => "geändert",
        AuditAktion.Geloescht => "gelöscht",
        AuditAktion.Gelesen => "eingesehen",
        _ => aktion.ToString(),
    };
}
