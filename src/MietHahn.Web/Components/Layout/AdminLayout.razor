@inherits LayoutComponentBase
@using MietHahn.Application.Admin
@inject NavigationManager Navigation
@inject IModuleState Modules

<SkipLink />
<div class="app app-admin">
    <header class="top-bar">
        <BrandMark Href="/verwaltung" />
        <QuickSearch @rendermode="InteractiveServer" />
        <UserMenu />
    </header>
    <nav class="sidebar" aria-label="Hauptnavigation">
        <AdminNavigation />
    </nav>
    <div class="@("workspace" + (HasTabs ? " has-tabs" : ""))">
        <ContextTabs />
        <main id="content" class="content">
            @Body
        </main>
    </div>
    <BottomBar />
</div>

@code {
    // With a tab bar the "back to the list" link of a page is redundant on wide screens (the tab leads there).
    private bool HasTabs => AdminNavModel.TabsFor(new Uri(Navigation.Uri).AbsolutePath, Modules) is not null;
}
