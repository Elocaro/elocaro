@using MietHahn.Application.Accounts
@using MietHahn.Application.Admin
@inject NavigationManager Navigation
@inject IModuleState Modules

@* Main navigation of the administration (sidebar and menu sheet on smartphones); entries only appear with the matching permission. *@
<ul class="navigation">
    @foreach (var group in AdminNavModel.VisibleAreas(Modules).GroupBy(a => a.Group))
    {
        var policies = group.Select(a => a.Policy).Distinct().ToList();
        var items = group.ToList();
        @if (group.Key is not null)
        {
            @if (policies.Count == 1)
            {
                <AuthorizeView Policy="@policies[0]"><li class="navigation-group">@group.Key</li></AuthorizeView>
            }
            else
            {
                <li class="navigation-divider" role="separator"></li>
            }
        }
        @foreach (var area in items)
        {
            <AuthorizeView Policy="@area.Policy">
                <li><a href="@area.Href" class="@(IsActive(area) ? "active" : null)" aria-current="@(IsActive(area) ? "page" : null)"><Icon Path="@area.Icon" /><span>@area.Label</span></a></li>
            </AuthorizeView>
        }
    }
</ul>

@code {
    private string Path => new Uri(Navigation.Uri).AbsolutePath;

    private bool IsActive(NavArea area) => AdminNavModel.AreaOf(Path)?.Label == area.Label;
}
