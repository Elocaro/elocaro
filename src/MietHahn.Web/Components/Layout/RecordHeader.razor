@using MietHahn.Application.Admin
@using MietHahn.Application.Portfolio
@using MietHahn.Web.Display

@* The property the tabs below belong to: name, address and key facts stay the same on every tab. The page keeps its own h1. *@
@if (Property is not null)
{
    <section class="record-header" aria-label="Objekt">
        <p class="record-title">@Property.Name</p>
        <p class="record-subtitle">@Property.Address</p>
        <dl class="record-facts">
            <div><dt>Einheiten</dt><dd>@Property.UnitCount</dd></div>
            @if (Property.YearBuilt is { } year)
            {
                <div><dt>Baujahr</dt><dd>@year.ToString(System.Globalization.CultureInfo.InvariantCulture)</dd></div>
            }
            @if (Labels.Heating(Property.HeatingType, Property.EnergySource) is { } heating && heating != "–")
            {
                <div><dt>Heizung</dt><dd>@heating</dd></div>
            }
        </dl>
    </section>
}

@code {
    [Parameter]
    public PropertySummary? Property { get; set; }
}
