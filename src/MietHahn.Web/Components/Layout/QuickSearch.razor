@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MietHahn.Application.Accounts
@using MietHahn.Application.Leases
@using MietHahn.Application.People
@using MietHahn.Application.Properties
@using MietHahn.Application.Admin
@inject IModuleState Modules
@inject IAuthorizationService Authorization
@inject AuthenticationStateProvider AuthenticationState
@inject IServiceScopeFactory Scopes
@inject ILogger<QuickSearch> Logger
@inject NavigationManager Navigation

@* Quick search (Ctrl+K): jumps to pages, properties, people and leases. Interactive island in the static layout. *@
<button type="button" class="@("quick-search-trigger" + (Compact ? " compact" : ""))" @onclick="OpenAsync" aria-keyshortcuts="Control+K">
    <Icon Path="@AppIcons.Search" />
    <span>Suchen …</span>
    <kbd>Strg K</kbd>
</button>

@if (open)
{
    <div class="quick-search" role="dialog" aria-modal="true" aria-label="Schnellsuche" @onkeydown="OnKeyDown">
        <div class="quick-search-backdrop" @onclick="Close"></div>
        <div class="quick-search-panel">
            <input @ref="input" type="search" class="quick-search-input" placeholder="Objekt, Person, Vertrag oder Seite suchen" aria-label="Suchbegriff"
                   autocomplete="off" @oninput="OnInputAsync" />
            @if (failed)
            {
                <p class="small quick-search-empty" role="status">Die Suche ist gerade nicht erreichbar. Bitte erneut versuchen.</p>
            }
            else if (results.Count == 0)
            {
                <p class="small quick-search-empty" role="status">@(query.Length < 2 ? "Mindestens zwei Zeichen eingeben." : searching ? "Suche läuft …" : "Keine Treffer.")</p>
            }
            else
            {
                <ul class="quick-search-results" role="listbox">
                    @for (var i = 0; i < results.Count; i++)
                    {
                        var result = results[i];
                        <li role="option" aria-selected="@(i == selected)">
                            <a href="@result.Href" class="@(i == selected ? "selected" : null)" @onclick="Close">
                                <Icon Path="@result.Icon" />
                                <span class="quick-search-label">@result.Label</span>
                                <span class="small">@result.Hint</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    private sealed record Hit(string Label, string Hint, string Href, string Icon);

    private bool open;
    private string query = "";
    private int selected;
    private List<Hit> results = [];
    private List<(Hit Hit, string? Policy)> pages = [];
    private ElementReference input;
    private bool focus;
    private CancellationTokenSource? cancellation;
    private bool canMasterData;
    private bool searching;
    private bool failed;

    [Parameter]
    public bool Compact { get; set; }

    private async Task OpenAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        canMasterData = (await Authorization.AuthorizeAsync(user, Policies.MasterData)).Succeeded;
        pages = [];
        foreach (var area in AdminNavModel.VisibleAreas(Modules))
        {
            if (area.Policy is null || (await Authorization.AuthorizeAsync(user, area.Policy)).Succeeded)
            {
                pages.Add((new Hit(area.Label, "Bereich", area.Href, area.Icon), area.Policy));
                foreach (var tab in AdminNavModel.Visible(area.Tabs, Modules).SelectMany(t => t.IsGroup ? t.Children! : [t]).Where(t => t.Href != area.Href))
                {
                    pages.Add((new Hit(tab.Label, area.Label, tab.Href, area.Icon), area.Policy));
                }
            }
        }

        query = "";
        results = [];
        failed = false;
        searching = false;
        selected = 0;
        open = true;
        focus = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focus)
        {
            focus = false;
            await input.FocusAsync();
        }
    }

    private void Close() => open = false;

    private async Task OnInputAsync(ChangeEventArgs args)
    {
        query = (args.Value as string ?? "").Trim();
        cancellation?.Cancel();
        cancellation = new CancellationTokenSource();
        var token = cancellation.Token;
        try
        {
            await Task.Delay(200, token);
            searching = true;
            await SearchAsync(token);
        }
        catch (OperationCanceledException)
        {
            // a newer keystroke replaced this search
        }
        catch (Exception ex)
        {
            // A failing search must never take the whole circuit (and with it the open dialog) down.
            Logger.LogWarning(ex, "Die Schnellsuche ist fehlgeschlagen.");
            results = [];
            failed = true;
            searching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SearchAsync(CancellationToken token)
    {
        var found = new List<Hit>();
        if (query.Length >= 2)
        {
            if (canMasterData)
            {
                // Own scope and DbContext: the page and the second search island use the circuit's context at the same time.
                await using var scope = Scopes.CreateAsyncScope();
                var properties = scope.ServiceProvider.GetRequiredService<IPropertyService>();
                var people = scope.ServiceProvider.GetRequiredService<IPersonService>();
                var leases = scope.ServiceProvider.GetRequiredService<ILeaseService>();

                found.AddRange((await properties.ListAsync(null, token))
                    .Where(p => Matches(p.Name, query) || Matches(p.Address, query))
                    .Take(5).Select(p => new Hit(p.Name, p.Address ?? "", $"/verwaltung/objekte/{p.Id}", AppIcons.Property)));
                found.AddRange((await people.SearchAsync(new PersonQuery(query, PersonFilter.All), token))
                    .Take(5).Select(p => new Hit(p.DisplayName, p.Email ?? p.City ?? "Person", $"/verwaltung/personen/{p.Id}", AppIcons.People)));
                found.AddRange((await leases.ListAsync(false, token))
                    .Where(l => Matches(l.Tenant, query) || Matches(l.RentalUnit, query) || Matches(l.Property, query))
                    .Take(5).Select(l => new Hit($"{l.RentalUnit}, {l.Property}", l.Tenant ?? "", $"/verwaltung/vertraege/{l.Id}", AppIcons.Lease)));
            }

            found.AddRange(pages.Where(p => Matches(p.Hit.Hint + " " + p.Hit.Label, query)).Select(p => p.Hit).Take(5));
        }

        token.ThrowIfCancellationRequested();
        results = found;
        failed = false;
        searching = false;
        selected = 0;
        await InvokeAsync(StateHasChanged);
    }

    private static bool Matches(string? text, string term) => text?.Contains(term, StringComparison.CurrentCultureIgnoreCase) ?? false;

    private void OnKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Escape":
                Close();
                break;
            case "ArrowDown" when results.Count > 0:
                selected = (selected + 1) % results.Count;
                break;
            case "ArrowUp" when results.Count > 0:
                selected = (selected - 1 + results.Count) % results.Count;
                break;
            case "Enter" when results.Count > 0:
                Navigation.NavigateTo(results[selected].Href);
                Close();
                break;
        }
    }
}
