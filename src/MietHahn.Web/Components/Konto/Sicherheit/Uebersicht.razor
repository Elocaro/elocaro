@page "/konto/sicherheit"
@inject UserManager<Benutzer> BenutzerManager

<PageTitle>Konto &amp; Sicherheit – MietHahn</PageTitle>

<h1>Konto &amp; Sicherheit</h1>

<StatusMeldung />

@if (benutzer is not null)
{
    <dl class="angaben">
        <dt>Name</dt><dd>@benutzer.Anzeigename</dd>
        <dt>E-Mail</dt><dd>@benutzer.Email</dd>
        <dt>Rolle</dt><dd>@string.Join(", ", rollen.Select(Rollen.Anzeigename))</dd>
        <dt>Zwei-Faktor-Anmeldung</dt><dd>@(benutzer.TwoFactorEnabled ? "aktiv" : "nicht eingerichtet")</dd>
    </dl>

    <ul class="konto-aktionen">
        @if (hatPasswort)
        {
            <li><a href="/konto/sicherheit/zwei-faktor">@(benutzer.TwoFactorEnabled ? "Zwei-Faktor-Anmeldung anzeigen" : "Zwei-Faktor-Anmeldung einrichten")</a></li>
            @if (benutzer.TwoFactorEnabled)
            {
                <li><a href="/konto/sicherheit/wiederherstellungscodes">Neue Wiederherstellungscodes erzeugen</a></li>
            }
            <li><a href="/konto/sicherheit/passwort">Passwort ändern</a></li>
        }
        else
        {
            <li>Sie melden sich per Anmeldelink an; ein Passwort ist nicht erforderlich.</li>
        }
    </ul>
}

<form method="post" action="/konto/abmelden">
    <AntiforgeryToken />
    <button type="submit" class="knopf">Abmelden</button>
</form>

@code {
    private Benutzer? benutzer;
    private IList<string> rollen = [];
    private bool hatPasswort;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        benutzer = await BenutzerManager.GetUserAsync(HttpContext.User);
        if (benutzer is not null)
        {
            rollen = await BenutzerManager.GetRolesAsync(benutzer);
            hatPasswort = await BenutzerManager.HasPasswordAsync(benutzer);
        }
    }
}
