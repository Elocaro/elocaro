@page "/konto/sicherheit/wiederherstellungscodes"
@inject UserManager<Benutzer> BenutzerManager

<PageTitle>Wiederherstellungscodes – MietHahn</PageTitle>

<h1>Wiederherstellungscodes</h1>

@if (codes is not null)
{
    <Wiederherstellungscodes Codes="codes" />
}
else if (aktiv)
{
    <p>Neue Codes ersetzen alle bisherigen Wiederherstellungscodes.</p>
    <form method="post" @formname="codes-erzeugen" @onsubmit="ErzeugenAsync">
        <AntiforgeryToken />
        <button type="submit" class="knopf knopf-primaer">Neue Codes erzeugen</button>
    </form>
}
else
{
    <p>Richten Sie zuerst die <a href="/konto/sicherheit/zwei-faktor">Zwei-Faktor-Anmeldung</a> ein.</p>
}

<div class="konto-links"><a href="/konto/sicherheit">Zurück</a></div>

@code {
    private bool aktiv;
    private IReadOnlyList<string>? codes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync() =>
        aktiv = (await BenutzerManager.GetUserAsync(HttpContext.User))?.TwoFactorEnabled == true;

    private async Task ErzeugenAsync()
    {
        var benutzer = await BenutzerManager.GetUserAsync(HttpContext.User);
        if (benutzer?.TwoFactorEnabled == true)
        {
            codes = [.. await BenutzerManager.GenerateNewTwoFactorRecoveryCodesAsync(benutzer, 10) ?? []];
        }
    }
}
