@* Zeigt Wiederherstellungscodes einmalig an. *@
<div class="wiederherstellungscodes">
    <p><strong>Bewahren Sie diese Wiederherstellungscodes sicher auf</strong> (z. B. ausgedruckt oder im Passwortmanager). Jeder Code ermöglicht einmal die Anmeldung ohne Authenticator-App. Sie werden nur jetzt angezeigt.</p>
    <ul class="codes">
        @foreach (var eintrag in Codes)
        {
            <li><code>@eintrag</code></li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Codes { get; set; } = [];
}
