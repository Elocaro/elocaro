@page "/konto/sicherheit/zwei-faktor"
@using QRCoder
@inject UserManager<Benutzer> BenutzerManager
@inject SignInManager<Benutzer> Anmeldung

<PageTitle>Zwei-Faktor-Anmeldung – MietHahn</PageTitle>

<h1>Zwei-Faktor-Anmeldung</h1>

@if (codes is not null)
{
    <p class="meldung meldung-ok" role="status">Die Zwei-Faktor-Anmeldung ist jetzt aktiv.</p>
    <Wiederherstellungscodes Codes="codes" />
    <div class="konto-links"><a href="/">Weiter zu MietHahn</a></div>
}
else if (benutzer?.TwoFactorEnabled == true)
{
    <p>Die Zwei-Faktor-Anmeldung ist aktiv. Bei der Anmeldung fragen wir nach dem Code aus Ihrer Authenticator-App.</p>
    <div class="konto-links">
        <a href="/konto/sicherheit/wiederherstellungscodes">Neue Wiederherstellungscodes erzeugen</a>
        <a href="/konto/sicherheit">Zurück</a>
    </div>
}
else if (benutzer is not null)
{
    @if (pflicht)
    {
        <p class="meldung meldung-hinweis" role="status">Für Ihre Rolle ist die Zwei-Faktor-Anmeldung vorgeschrieben. Bitte richten Sie sie jetzt ein.</p>
    }

    <ol class="schritte">
        <li>Installieren Sie eine Authenticator-App (z. B. Aegis, 2FAS, Google oder Microsoft Authenticator).</li>
        <li>
            Scannen Sie den QR-Code oder geben Sie den Schlüssel manuell ein:
            <div class="qr-code">@((MarkupString)qrSvg)</div>
            <p><code class="schluessel">@SchluesselFormatiert</code></p>
        </li>
        <li>Geben Sie den 6-stelligen Code aus der App ein.</li>
    </ol>

    <StatusMeldung Meldung="@fehler" IstFehler="true" />

    <EditForm Model="Eingabe" FormName="zwei-faktor-einrichten" OnValidSubmit="AktivierenAsync">
        <DataAnnotationsValidator />
        <div class="feld">
            <label for="code">Code aus der App</label>
            <InputText id="code" @bind-Value="Eingabe!.Code" autocomplete="one-time-code" inputmode="numeric" />
            <ValidationMessage For="() => Eingabe!.Code" />
        </div>
        <button type="submit" class="knopf knopf-primaer">Aktivieren</button>
    </EditForm>
}

@code {
    private Benutzer? benutzer;
    private string schluessel = "";
    private string qrSvg = "";
    private bool pflicht;
    private string? fehler;
    private IReadOnlyList<string>? codes;

    [SupplyParameterFromForm(FormName = "zwei-faktor-einrichten")]
    private CodeEingabe? Eingabe { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string SchluesselFormatiert => string.Join(' ', schluessel.Chunk(4).Select(c => new string(c))).ToLowerInvariant();

    protected override async Task OnInitializedAsync()
    {
        Eingabe ??= new();
        benutzer = await BenutzerManager.GetUserAsync(HttpContext.User);
        if (benutzer is null || benutzer.TwoFactorEnabled)
        {
            return;
        }

        pflicht = (await BenutzerManager.GetRolesAsync(benutzer)).Any(Rollen.MitZweiFaktorPflicht.Contains);
        var key = await BenutzerManager.GetAuthenticatorKeyAsync(benutzer);
        if (string.IsNullOrEmpty(key))
        {
            await BenutzerManager.ResetAuthenticatorKeyAsync(benutzer);
            key = await BenutzerManager.GetAuthenticatorKeyAsync(benutzer);
        }

        schluessel = key!;
        var uri = $"otpauth://totp/{Uri.EscapeDataString("MietHahn:" + benutzer.Email)}?secret={schluessel}&issuer=MietHahn&digits=6";
        using var generator = new QRCodeGenerator();
        using var daten = generator.CreateQrCode(uri, QRCodeGenerator.ECCLevel.Q);
        qrSvg = new SvgQRCode(daten).GetGraphic(4);
    }

    private async Task AktivierenAsync()
    {
        var code = Eingabe!.Code.Replace(" ", "", StringComparison.Ordinal).Replace("-", "", StringComparison.Ordinal);
        if (!await BenutzerManager.VerifyTwoFactorTokenAsync(benutzer!, BenutzerManager.Options.Tokens.AuthenticatorTokenProvider, code))
        {
            fehler = "Der Code ist ungültig. Bitte prüfen Sie die Uhrzeit Ihres Geräts und versuchen Sie es erneut.";
            return;
        }

        await BenutzerManager.SetTwoFactorEnabledAsync(benutzer!, true);
        codes = [.. await BenutzerManager.GenerateNewTwoFactorRecoveryCodesAsync(benutzer!, 10) ?? []];
        await Anmeldung.RefreshSignInAsync(benutzer!); // Claim „2FA aktiv“ aktualisieren
    }

    private sealed class CodeEingabe
    {
        [Required(ErrorMessage = "Bitte den Code eingeben.")]
        [StringLength(7, MinimumLength = 6, ErrorMessage = "Der Code hat 6 Ziffern.")]
        public string Code { get; set; } = "";
    }
}
