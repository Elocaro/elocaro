@page "/konto/anmelden/wiederherstellungscode"
@inject SignInManager<Benutzer> Anmeldung
@inject Weiterleitung Weiterleitung

<PageTitle>Wiederherstellungscode – MietHahn</PageTitle>

<h1>Wiederherstellungscode</h1>
<p>Geben Sie einen Ihrer Wiederherstellungscodes ein. Jeder Code funktioniert nur einmal.</p>

<StatusMeldung Meldung="@fehler" IstFehler="true" />

<EditForm Model="Eingabe" FormName="wiederherstellung" OnValidSubmit="PruefenAsync">
    <DataAnnotationsValidator />
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    <div class="feld">
        <label for="code">Wiederherstellungscode</label>
        <InputText id="code" @bind-Value="Eingabe!.Code" autocomplete="off" />
        <ValidationMessage For="() => Eingabe!.Code" />
    </div>
    <button type="submit" class="knopf knopf-primaer">Anmelden</button>
</EditForm>

@code {
    private string? fehler;

    [SupplyParameterFromForm(FormName = "wiederherstellung")]
    private CodeEingabe? Eingabe { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Eingabe ??= new();
        if (await Anmeldung.GetTwoFactorAuthenticationUserAsync() is null)
        {
            Weiterleitung.Zu("/konto/anmelden");
        }
    }

    private async Task PruefenAsync()
    {
        var ergebnis = await Anmeldung.TwoFactorRecoveryCodeSignInAsync(Eingabe!.Code.Replace(" ", "", StringComparison.Ordinal));
        if (ergebnis.Succeeded)
        {
            Weiterleitung.Zu(ReturnUrl);
        }
        else if (ergebnis.IsLockedOut)
        {
            Weiterleitung.Zu("/konto/gesperrt");
        }
        else
        {
            fehler = "Der Wiederherstellungscode ist ungültig.";
        }
    }

    private sealed class CodeEingabe
    {
        [Required(ErrorMessage = "Bitte einen Code eingeben.")]
        public string Code { get; set; } = "";
    }
}
