@page "/konto/link"
@inject IKontoverwaltung Konten

<PageTitle>Anmeldelink anfordern – MietHahn</PageTitle>

<h1>Anmelden per E-Mail</h1>

@if (gesendet)
{
    <p class="meldung meldung-ok" role="status">
        Falls ein passendes Konto existiert, haben wir Ihnen einen Anmeldelink geschickt. Er ist 15 Minuten gültig.
    </p>
}
else
{
    <p>Sie erhalten einen Link, mit dem Sie sich ohne Passwort anmelden können (für Mieter, Handwerker und Hausmeister).</p>
    <EditForm Model="Eingabe" FormName="anmeldelink" OnValidSubmit="AnfordernAsync">
        <DataAnnotationsValidator />
        <div class="feld">
            <label for="email">E-Mail-Adresse</label>
            <InputText id="email" type="email" @bind-Value="Eingabe!.Email" autocomplete="email" />
            <ValidationMessage For="() => Eingabe!.Email" />
        </div>
        <button type="submit" class="knopf knopf-primaer">Link senden</button>
    </EditForm>
}

<div class="konto-links"><a href="/konto/anmelden">Mit Passwort anmelden</a></div>

@code {
    private bool gesendet;

    [SupplyParameterFromForm(FormName = "anmeldelink")]
    private EmailEingabe? Eingabe { get; set; }

    protected override void OnInitialized() => Eingabe ??= new();

    private async Task AnfordernAsync()
    {
        await Konten.AnmeldelinkAnfordernAsync(Eingabe!.Email.Trim());
        gesendet = true; // gleiche Antwort für bekannte und unbekannte Adressen
    }

    private sealed class EmailEingabe
    {
        [Required(ErrorMessage = "Bitte die E-Mail-Adresse angeben.")]
        [EmailAddress(ErrorMessage = "Bitte eine gültige E-Mail-Adresse angeben.")]
        public string Email { get; set; } = "";
    }
}
