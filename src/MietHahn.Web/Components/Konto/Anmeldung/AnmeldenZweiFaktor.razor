@page "/konto/anmelden/zwei-faktor"
@inject SignInManager<Benutzer> Anmeldung
@inject Weiterleitung Weiterleitung

<PageTitle>Zwei-Faktor-Anmeldung – MietHahn</PageTitle>

<h1>Bestätigungscode</h1>
<p>Bitte geben Sie den 6-stelligen Code aus Ihrer Authenticator-App ein.</p>

<StatusMeldung Meldung="@fehler" IstFehler="true" />

<EditForm Model="Eingabe" FormName="zwei-faktor" OnValidSubmit="PruefenAsync">
    <DataAnnotationsValidator />
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    <input type="hidden" name="AngemeldetBleiben" value="@AngemeldetBleiben" />
    <div class="feld">
        <label for="code">Code</label>
        <InputText id="code" @bind-Value="Eingabe!.Code" autocomplete="one-time-code" inputmode="numeric" />
        <ValidationMessage For="() => Eingabe!.Code" />
    </div>
    <div class="feld feld-checkbox">
        <InputCheckbox id="geraet" @bind-Value="Eingabe!.GeraetMerken" />
        <label for="geraet">Dieses Gerät 30 Tage lang merken</label>
    </div>
    <button type="submit" class="knopf knopf-primaer">Anmelden</button>
</EditForm>

<div class="konto-links">
    <a href="/konto/anmelden/wiederherstellungscode?ReturnUrl=@Uri.EscapeDataString(ReturnUrl ?? "")">Kein Zugriff auf die App? Mit Wiederherstellungscode anmelden</a>
</div>

@code {
    private string? fehler;

    [SupplyParameterFromForm(FormName = "zwei-faktor")]
    private ZweiFaktorEingabe? Eingabe { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool AngemeldetBleiben { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Eingabe ??= new();
        if (await Anmeldung.GetTwoFactorAuthenticationUserAsync() is null)
        {
            Weiterleitung.Zu("/konto/anmelden");
        }
    }

    private async Task PruefenAsync()
    {
        var code = Eingabe!.Code.Replace(" ", "", StringComparison.Ordinal).Replace("-", "", StringComparison.Ordinal);
        var ergebnis = await Anmeldung.TwoFactorAuthenticatorSignInAsync(code, AngemeldetBleiben, Eingabe.GeraetMerken);

        if (ergebnis.Succeeded)
        {
            Weiterleitung.Zu(ReturnUrl);
        }
        else if (ergebnis.IsLockedOut)
        {
            Weiterleitung.Zu("/konto/gesperrt");
        }
        else
        {
            fehler = "Der Code ist ungültig.";
        }
    }

    private sealed class ZweiFaktorEingabe
    {
        [Required(ErrorMessage = "Bitte den Code eingeben.")]
        [StringLength(7, MinimumLength = 6, ErrorMessage = "Der Code hat 6 Ziffern.")]
        public string Code { get; set; } = "";

        public bool GeraetMerken { get; set; }
    }
}
