@page "/konto/einladung"
@inject UserManager<Benutzer> BenutzerManager
@inject SignInManager<Benutzer> Anmeldung
@inject Weiterleitung Weiterleitung

<PageTitle>Einladung annehmen – MietHahn</PageTitle>

<h1>Willkommen bei MietHahn</h1>

@if (ungueltig)
{
    <p class="meldung meldung-fehler" role="alert">Diese Einladung ist ungültig oder abgelaufen. Bitte wenden Sie sich an den Vermieter.</p>
}
else
{
    <p>Bitte legen Sie Ihr Passwort fest.</p>
    <FehlerListe Fehler="fehler" />
    <EditForm Model="Eingabe" FormName="einladung" OnValidSubmit="AnnehmenAsync">
        <DataAnnotationsValidator />
        <input type="hidden" name="Benutzer" value="@BenutzerId" />
        <input type="hidden" name="Code" value="@Code" />
        <PasswortFelder Eingabe="Eingabe!" />
        <button type="submit" class="knopf knopf-primaer">Passwort festlegen</button>
    </EditForm>
}

@code {
    private bool ungueltig;
    private IReadOnlyList<string>? fehler;

    [SupplyParameterFromForm(FormName = "einladung")]
    private NeuesPasswortEingabe? Eingabe { get; set; }

    [SupplyParameterFromQuery(Name = "benutzer")]
    private string? BenutzerId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Eingabe ??= new();
        ungueltig = await GueltigerBenutzerAsync() is null;
    }

    private async Task<Benutzer?> GueltigerBenutzerAsync()
    {
        var benutzer = BenutzerId is null ? null : await BenutzerManager.FindByIdAsync(BenutzerId);
        if (benutzer is null || string.IsNullOrEmpty(Code) || await BenutzerManager.HasPasswordAsync(benutzer))
        {
            return null;
        }

        return await BenutzerManager.VerifyUserTokenAsync(benutzer, TokenAnbieter.Einladung, TokenAnbieter.Einladung, Code)
            ? benutzer
            : null;
    }

    private async Task AnnehmenAsync()
    {
        var benutzer = await GueltigerBenutzerAsync();
        if (benutzer is null)
        {
            ungueltig = true;
            return;
        }

        var ergebnis = await BenutzerManager.AddPasswordAsync(benutzer, Eingabe!.Passwort);
        if (!ergebnis.Succeeded)
        {
            fehler = [.. ergebnis.Errors.Select(e => e.Description)];
            return;
        }

        benutzer.EmailConfirmed = true;
        await BenutzerManager.UpdateAsync(benutzer);
        await Anmeldung.SignInAsync(benutzer, isPersistent: false);

        var rollen = await BenutzerManager.GetRolesAsync(benutzer);
        Weiterleitung.Zu(rollen.Any(Rollen.MitZweiFaktorPflicht.Contains) ? KontoErweiterungen.ZweiFaktorEinrichtenPfad : "/");
    }
}
