@page "/konto/link/{Token}"
@inject IKontoverwaltung Konten
@inject UserManager<Benutzer> BenutzerManager
@inject SignInManager<Benutzer> Anmeldung
@inject Weiterleitung Weiterleitung

<PageTitle>Anmelden – MietHahn</PageTitle>

<h1>Anmelden</h1>

@if (ungueltig)
{
    <p class="meldung meldung-fehler" role="alert">Dieser Link ist ungültig, abgelaufen oder wurde bereits verwendet.</p>
    <div class="konto-links"><a href="/konto/link">Neuen Anmeldelink anfordern</a></div>
}
else
{
    @* Erst der Klick löst den Link ein: E-Mail-Scanner, die Links vorab öffnen, verbrauchen ihn so nicht. *@
    <p>Klicken Sie auf „Anmelden“, um sich bei MietHahn anzumelden.</p>
    <form method="post" @formname="link-einloesen" @onsubmit="EinloesenAsync">
        <AntiforgeryToken />
        <button type="submit" class="knopf knopf-primaer">Anmelden</button>
    </form>
}

@code {
    private bool ungueltig;

    [Parameter]
    public string Token { get; set; } = "";

    private async Task EinloesenAsync()
    {
        var id = await Konten.AnmeldelinkEinloesenAsync(Token);
        var benutzer = id is null ? null : await BenutzerManager.FindByIdAsync(id.Value.ToString());
        if (benutzer is null)
        {
            ungueltig = true;
            return;
        }

        await Anmeldung.SignInAsync(benutzer, isPersistent: true);
        Weiterleitung.Zu("/");
    }
}
