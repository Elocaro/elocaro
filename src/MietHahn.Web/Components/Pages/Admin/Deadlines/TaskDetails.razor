@page "/verwaltung/fristen/wartung/{TaskId:guid}"
@rendermode InteractiveServer
@using MudBlazor
@using MietHahn.Application.Documents
@inject IDeadlines Admin
@inject IPropertyService Properties
@inject IDocumentLibrary Library
@inject Notifier Notify
@inject Confirmations Confirm
@inject NavigationManager Navigation
@inject TimeProvider Clock

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (detail is null)
{
    <PageHeader Title="Wartung nicht gefunden" Back="/verwaltung/fristen/wartung" BackText="Alle Wartungen" />
}
else
{
    <PageHeader Title="@detail.Task.Title" Subtitle="@Summary()" Back="/verwaltung/fristen/wartung" BackText="Alle Wartungen" />

    <ErrorList Errors="errors" />

    @if (detail.Task.Active)
    {
        <section>
            <h2>Als erledigt eintragen</h2>
            <p class="small">@(detail.Task.IntervalMonths == 0 ? "Die einmalige Wartung ist danach abgeschlossen." : "Die nächste Fälligkeit rückt um den Abstand weiter.")</p>
            <EditForm Model="completion" OnValidSubmit="CompleteAsync" novalidate>
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <AppDateField @bind-Value="completion.DoneOn" Label="Erledigt am" Required="true" />
                    <OptionSelect @bind-Value="completion.DocumentId" Label="Nachweis (Dokument)" Options="documents" />
                </div>
                <p class="small">Den Nachweis (Rechnung, Protokoll) vorher unter <a href="/verwaltung/dokumente/neu">Dokumente</a> ablegen.</p>
                <AppTextField @bind-Value="completion.Note" Label="Notiz" Lines="2" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Erledigt</MudButton>
            </EditForm>
        </section>
    }

    <section>
        <h2>Verlauf</h2>
        @if (detail.Completions.Count == 0)
        {
            <EmptyState Text="Noch nicht erledigt." />
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Erledigt am</th><th>Nachweis</th><th>Notiz</th></tr></thead>
                    <tbody>
                        @foreach (var row in detail.Completions)
                        {
                            <tr>
                                <td>@Format.Date(row.DoneOn)</td>
                                <td>@if (row.DocumentId is { } id) { <a href="/verwaltung/dokumente/@id">@row.DocumentTitle</a> } else { <span>–</span> }</td>
                                <td>@row.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section>
        <h2>Angaben</h2>
        <EditForm Model="Data" OnValidSubmit="UpdateAsync" novalidate>
            <DataAnnotationsValidator />
            <TaskEditor Data="Data!" Properties="properties" ShowActive="true" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="DeleteAsync">Löschen</MudButton>
        </EditForm>
    </section>
}
</InteractiveShell>

@code {
    private TaskDetail? detail;
    private IReadOnlyList<PropertyOverview> properties = [];
    private IReadOnlyList<(Guid Id, string Name)> documents = [];
    private IReadOnlyList<string>? errors;
    private CompletionInput completion = new();
    private bool loaded;

    [Parameter]
    public Guid TaskId { get; set; }

    private TaskInput? Data { get; set; }

    protected override async Task OnInitializedAsync()
    {
        properties = await Properties.ListAsync();
        await LoadAsync();
        Data = detail?.Input;
        completion.DoneOn = GermanTime.Today(Clock.GetUtcNow());
        if (detail is not null)
        {
            var rows = await Library.SearchAsync(new DocumentQuery(PropertyId: detail.Task.PropertyId));
            documents = rows.OrderBy(d => d.Title).Select(d => (d.Id, d.Title)).ToList();
        }

        loaded = true;
    }

    private async Task LoadAsync() => detail = await Admin.TaskAsync(TaskId);

    private string Summary() => detail!.Task.Active
        ? $"Nächste Fälligkeit {Format.Date(detail.Task.DueOn)} · {Labels.Interval(detail.Task.IntervalMonths)} · {detail.Task.PropertyName ?? "alle Objekte"}"
        : $"Abgeschlossen · {detail.Task.PropertyName ?? "alle Objekte"}";

    private async Task CompleteAsync()
    {
        if (await ExecuteAsync(Admin.CompleteTaskAsync(TaskId, completion), "Die Wartung wurde als erledigt eingetragen."))
        {
            completion = new() { DoneOn = GermanTime.Today(Clock.GetUtcNow()) };
            Data = detail?.Input;
        }
    }

    private async Task UpdateAsync()
    {
        if (await ExecuteAsync(Admin.UpdateTaskAsync(TaskId, Data!), "Die Wartung wurde gespeichert."))
        {
            Data = detail?.Input;
        }
    }

    private async Task DeleteAsync()
    {
        if (await Confirm.AskAsync("Wartung löschen", $"Soll die Wartung „{detail!.Task.Title}“ samt Verlauf gelöscht werden?", "Ja, löschen"))
        {
            var result = await Admin.DeleteTaskAsync(TaskId);
            if (result.Succeeded)
            {
                Navigation.NavigateTo("/verwaltung/fristen/wartung");
            }
            else
            {
                errors = result.Errors;
            }
        }
    }

    private async Task<bool> ExecuteAsync(Task<Result> action, string message)
    {
        var result = await action;
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success(message);
        }

        await LoadAsync();
        return result.Succeeded;
    }
}
