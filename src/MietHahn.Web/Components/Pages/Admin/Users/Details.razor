@page "/verwaltung/benutzer/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor
@using Microsoft.AspNetCore.Identity
@using MietHahn.Infrastructure.Identity
@using MietHahn.Application.Properties
@inject IUserManagementService Admin
@inject IPropertyService Properties
@inject IPropertyAssignments Assignments
@inject UserManager<ApplicationUser> UserManager
@inject Notifier Notify
@inject Confirmations Confirm

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (user is null)
{
    <PageHeader Title="Konto nicht gefunden" Back="/verwaltung/benutzer" BackText="Alle Benutzer" />
}
else
{
<PageHeader Title="@user.DisplayName" Subtitle="@Roles.DisplayName(user.Role)" Back="/verwaltung/benutzer" BackText="Alle Benutzer" />

<ErrorList Errors="errors" />

<dl class="details">
    <dt>E-Mail</dt><dd>@user.Email</dd>
    <dt>Rolle</dt><dd>@Roles.DisplayName(user.Role)</dd>
    <dt>Status</dt><dd>@(user.Locked ? "gesperrt" : user.InvitationAccepted ? "aktiv" : "eingeladen")</dd>
    <dt>Anmeldung</dt><dd>@(user.HasPassword ? "Passwort" : "Anmeldelink")@(user.TwoFactorEnabled ? " + Zwei-Faktor" : "")</dd>
    <dt>Angelegt</dt><dd>@Format.Timestamp(user.CreatedAt)</dd>
    <dt>Letzte Anmeldung</dt><dd>@Format.Timestamp(user.LastSignInAt)</dd>
</dl>

<section>
    <h2>Rolle</h2>
    <div class="form-row">
        <AppSelect T="string" Value="role" ValueChanged="@(r => role = r!)" Label="Rolle" Items="Roles.All" Text="@(r => Roles.DisplayName(r!))" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangeRoleAsync">Rolle ändern</MudButton>
    </div>
</section>

@if (user.Role == Roles.Manager)
{
    <section>
        <h2>Rechte</h2>
        @foreach (var permission in Permissions.All)
        {
            <AppCheckBox Value="permissionSelection.Contains(permission)" ValueChanged="@(on => Toggle(permissionSelection, permission, on))" Label="@Permissions.DisplayName(permission)" />
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SetPermissionsAsync">Rechte speichern</MudButton>
    </section>
}

@if (user.Role == Roles.Caretaker)
{
    <section>
        <h2>Betreute Objekte</h2>
        @if (allProperties.Count == 0)
        {
            <p class="small">Es gibt noch keine Objekte.</p>
        }
        else
        {
            @foreach (var property in allProperties)
            {
                <AppCheckBox Value="propertySelection.Contains(property.Id)" ValueChanged="@(on => Toggle(propertySelection, property.Id, on))" Label="@($"{property.Name} ({property.Address})")" />
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SetPropertiesAsync">Objekte speichern</MudButton>
            <p class="small">Hausmeister sehen nur diese Objekte (ohne Mieterdaten).</p>
        }
    </section>
}

@if (!isOwnAccount)
{
    <section>
        <h2>Zugang</h2>
        @if (user.Locked)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ToggleLockAsync">Konto entsperren</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ToggleLockAsync">Konto sperren</MudButton>
        }
    </section>
}

<ChangeHistory EntityType="ApplicationUser" EntityId="Id" />
}
</InteractiveShell>

@code {
    private UserOverview? user;
    private bool isOwnAccount;
    private bool loaded;
    private IReadOnlyList<string>? errors;
    private string role = Roles.Tenant;
    private readonly HashSet<AccessRight> permissionSelection = [];
    private readonly HashSet<Guid> propertySelection = [];
    private IReadOnlyList<PropertyOverview> allProperties = [];

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> Authentication { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await Authentication).User;
        isOwnAccount = UserManager.GetUserId(principal) == Id.ToString();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        user = await Admin.GetAsync(Id);
        if (user is not null)
        {
            role = user.Role;
            permissionSelection.Clear();
            permissionSelection.UnionWith(user.Permissions);
            if (user.Role == Roles.Caretaker)
            {
                allProperties = await Properties.ListAsync();
                propertySelection.Clear();
                propertySelection.UnionWith(await Assignments.PropertiesOfAsync(Id));
            }
        }

        loaded = true;
    }

    private static void Toggle<T>(HashSet<T> selection, T item, bool on)
    {
        if (on)
        {
            selection.Add(item);
        }
        else
        {
            selection.Remove(item);
        }
    }

    private async Task ChangeRoleAsync() => await ExecuteAsync(Admin.ChangeRoleAsync(Id, role), "Die Rolle wurde geändert.");

    private async Task SetPermissionsAsync() => await ExecuteAsync(Admin.SetPermissionsAsync(Id, permissionSelection.ToList()), "Die Rechte wurden gespeichert.");

    private async Task SetPropertiesAsync()
    {
        var result = await Assignments.SetAsync(Id, propertySelection.ToList());
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success("Die betreuten Objekte wurden gespeichert.");
        }
    }

    private async Task ToggleLockAsync()
    {
        if (!user!.Locked
            && !await Confirm.AskAsync("Konto sperren", "Das Konto wird sofort abgemeldet und kann sich nicht mehr anmelden. Fortfahren?", "Ja, Konto sperren"))
        {
            return;
        }

        await ExecuteAsync(user.Locked ? Admin.UnlockAsync(Id) : Admin.LockAsync(Id), user.Locked ? "Das Konto wurde entsperrt." : "Das Konto wurde gesperrt.");
    }

    private async Task ExecuteAsync(Task<AccountResult> action, string success)
    {
        var result = await action;
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success(success);
        }

        await LoadAsync();
    }
}
