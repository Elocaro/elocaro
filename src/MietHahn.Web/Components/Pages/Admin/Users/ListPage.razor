@page "/verwaltung/benutzer"
@rendermode InteractiveServer
@using MudBlazor
@using System.ComponentModel.DataAnnotations
@inject IUserManagementService Admin
@inject IAccountService Accounts
@inject Notifier Notify

<InteractiveShell>
    <PageHeader Title="Benutzer" Subtitle="Wer Zugang zu MietHahn hat – Verwaltung, Hausmeister, Handwerker und Mieter." />

    <ErrorList Errors="errors" />

    <section>
        <h2>Person einladen</h2>
        <EditForm Model="invitation" OnValidSubmit="InviteAsync" novalidate class="form-grid">
            <DataAnnotationsValidator />
            <AppTextField @bind-Value="invitation.DisplayName" Label="Name" Required="true" />
            <AppTextField @bind-Value="invitation.Email" Label="E-Mail-Adresse" Type="email" Required="true" />
            <AppSelect @bind-Value="invitation.Role" Label="Rolle" Items="Roles.All" Text="@(r => Roles.DisplayName(r!))" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Einladung senden</MudButton>
        </EditForm>
    </section>

    <section>
        <h2>Konten</h2>
        <MudTable T="UserOverview" Items="users" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" RowsPerPage="25">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="UserOverview" SortBy="@(u => u.DisplayName)" InitialDirection="SortDirection.Ascending">Name</MudTableSortLabel></MudTh>
                <MudTh>E-Mail</MudTh>
                <MudTh>Rolle</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Letzte Anmeldung</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name"><a href="/verwaltung/benutzer/@context.Id">@context.DisplayName</a></MudTd>
                <MudTd DataLabel="E-Mail">@context.Email</MudTd>
                <MudTd DataLabel="Rolle">@Roles.DisplayName(context.Role)</MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Locked)
                    {
                        <StatusChip Level="StatusLevel.Error">gesperrt</StatusChip>
                    }
                    else if (!context.InvitationAccepted)
                    {
                        <StatusChip Level="StatusLevel.Warning">eingeladen</StatusChip>
                    }
                    else
                    {
                        <StatusChip Level="StatusLevel.Success">aktiv</StatusChip>
                    }
                    @if (context.TwoFactorEnabled)
                    {
                        <StatusChip title="Zwei-Faktor-Anmeldung aktiv">2FA</StatusChip>
                    }
                </MudTd>
                <MudTd DataLabel="Letzte Anmeldung">@Format.Timestamp(context.LastSignInAt)</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" RowsPerPageString="Zeilen pro Seite" InfoFormat="{first_item}–{last_item} von {all_items}" AllItemsText="Alle" />
            </PagerContent>
        </MudTable>
    </section>
</InteractiveShell>

@code {
    private IReadOnlyList<UserOverview> users = [];
    private IReadOnlyList<string>? errors;
    private InvitationInput invitation = new();

    protected override async Task OnInitializedAsync() => users = await Admin.ListAsync();

    private async Task InviteAsync()
    {
        var result = await Accounts.InviteAsync(invitation.Email.Trim(), invitation.DisplayName.Trim(), invitation.Role);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success($"Die Einladung an {invitation.Email} wurde verschickt.");
            invitation = new();
            users = await Admin.ListAsync();
        }
    }

    private sealed class InvitationInput
    {
        [Required(ErrorMessage = "Bitte einen Namen angeben.")]
        [StringLength(200)]
        public string DisplayName { get; set; } = "";

        [Required(ErrorMessage = "Bitte eine E-Mail-Adresse angeben.")]
        [EmailAddress(ErrorMessage = "Bitte eine gültige E-Mail-Adresse angeben.")]
        public string Email { get; set; } = "";

        [Required]
        public string Role { get; set; } = Roles.Tenant;
    }
}
