<div class="form-grid">
    <FormField Id="loan-property" Label="Objekt" For="() => Data.PropertyId" Required="true">
        <InputSelect id="loan-property" @bind-Value="Data.PropertyId">
            <option value="">– wählen –</option>
            @foreach (var property in Properties)
            {
                <option value="@property.Id">@property.Name</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="loan-bank" Label="Bank" For="() => Data.Bank" Required="true">
        <InputText id="loan-bank" @bind-Value="Data.Bank" />
    </FormField>
    <FormField Id="loan-number" Label="Darlehensnummer" For="() => Data.LoanNumber">
        <InputText id="loan-number" @bind-Value="Data.LoanNumber" />
    </FormField>
    <FormField Id="loan-principal" Label="Darlehensbetrag" For="() => Data.Principal" Required="true">
        <InputAmount id="loan-principal" @bind-Value="Data.Principal" />
    </FormField>
    <FormField Id="loan-disbursement" Label="Auszahlung" For="() => Data.DisbursementDate" Required="true" Hint="Ab hier laufen Zinsen">
        <InputDate id="loan-disbursement" @bind-Value="Data.DisbursementDate" />
    </FormField>
    <FormField Id="loan-first-payment" Label="Erste Rate fällig" For="() => Data.FirstPaymentDate" Required="true">
        <InputDate id="loan-first-payment" @bind-Value="Data.FirstPaymentDate" />
    </FormField>
    <FormField Id="loan-interest" Label="Sollzins (% p. a.)" For="() => Data.InterestRatePercent" Required="true">
        <InputArea id="loan-interest" @bind-Value="Data.InterestRatePercent" />
    </FormField>
    <FormField Id="loan-instalment" Label="Rate (Zins + Tilgung)" For="() => Data.Instalment" Hint="Alternativ die Anfangstilgung angeben">
        <InputAmount id="loan-instalment" @bind-Value="Data.Instalment" />
    </FormField>
    <FormField Id="loan-repayment" Label="Anfangstilgung (% p. a.)" For="() => Data.InitialRepaymentPercent">
        <InputArea id="loan-repayment" @bind-Value="Data.InitialRepaymentPercent" />
    </FormField>
    <FormField Id="loan-period" Label="Ratenfolge" For="() => Data.MonthsPerPeriod">
        <InputSelect id="loan-period" @bind-Value="Data.MonthsPerPeriod">
            <option value="1">monatlich</option>
            <option value="3">vierteljährlich</option>
        </InputSelect>
    </FormField>
    <FormField Id="loan-fixed-until" Label="Zinsbindung bis" For="() => Data.FixedUntil">
        <InputDate id="loan-fixed-until" @bind-Value="Data.FixedUntil" />
    </FormField>
    <FormField Id="loan-share" Label="Anteil Vermietung (%)" For="() => Data.SharePercent" Hint="Nur dieser Anteil der Zinsen ist Werbungskosten">
        <InputArea id="loan-share" @bind-Value="Data.SharePercent" />
    </FormField>
</div>
<FormField Id="loan-notes" Label="Notiz" For="() => Data.Notes">
    <InputTextArea id="loan-notes" @bind-Value="Data.Notes" rows="2" />
</FormField>

@code {
    [Parameter, EditorRequired]
    public LoanInput Data { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<PropertyOverview> Properties { get; set; } = [];
}
