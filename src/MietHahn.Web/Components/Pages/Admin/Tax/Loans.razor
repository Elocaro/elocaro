@page "/verwaltung/finanzen/darlehen"
@rendermode InteractiveServer
@using MudBlazor
@inject ILoanService Admin
@inject IPropertyService Properties
@inject NavigationManager Navigation

<InteractiveShell>
    <PageHeader Title="Darlehen" Subtitle="Finanzierung der Objekte: Tilgungsplan, Zinsen als Werbungskosten." />

    <ErrorList Errors="errors" />

    @if (loans is { Count: 0 })
    {
        <EmptyState Text="Noch keine Darlehen erfasst." />
    }
    else if (loans is not null)
    {
        <MudTable T="LoanListItem" Items="loans" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true">
            <HeaderContent>
                <MudTh>Bank</MudTh><MudTh>Objekt</MudTh><MudTh Style="text-align:right">Betrag</MudTh><MudTh Style="text-align:right">Sollzins</MudTh><MudTh>Zinsbindung bis</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Bank"><a href="/verwaltung/finanzen/darlehen/@context.Id">@context.Bank</a><span class="small">&#32;@context.LoanNumber</span></MudTd>
                <MudTd DataLabel="Objekt">@context.PropertyName</MudTd>
                <MudTd DataLabel="Betrag" Style="text-align:right">@Format.Money(context.Principal)</MudTd>
                <MudTd DataLabel="Sollzins" Style="text-align:right">@Format.Number(context.InterestRatePercent) %</MudTd>
                <MudTd DataLabel="Zinsbindung bis">@(context.FixedUntil is { } until ? Format.Date(until) : "–")</MudTd>
            </RowTemplate>
        </MudTable>
    }

    <section>
        <h2>Darlehen anlegen</h2>
        <EditForm Model="data" OnValidSubmit="CreateAsync" novalidate>
            <DataAnnotationsValidator />
            <LoanEditor Data="data" Properties="properties" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Anlegen</MudButton>
        </EditForm>
    </section>
</InteractiveShell>

@code {
    private IReadOnlyList<LoanListItem>? loans;
    private IReadOnlyList<PropertyOverview> properties = [];
    private IReadOnlyList<string>? errors;
    private readonly LoanInput data = new();

    protected override async Task OnInitializedAsync()
    {
        loans = await Admin.ListAsync();
        properties = await Properties.ListAsync();
    }

    private async Task CreateAsync()
    {
        var result = await Admin.CreateAsync(data);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"/verwaltung/finanzen/darlehen/{result.Id}?meldung=angelegt");
        }
        else
        {
            errors = result.Errors;
        }
    }
}
