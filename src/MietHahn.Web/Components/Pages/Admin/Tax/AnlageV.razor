@page "/verwaltung/objekte/{PropertyId:guid}/anlage-v"
@inject IAnlageVService Admin
@inject Redirector Redirector
@inject TimeProvider Clock

@if (report is null)
{
    <PageHeader Title="Objekt nicht gefunden" Back="/verwaltung/objekte" BackText="Alle Objekte" />
    return;
}

<PageHeader Title="@($"Anlage V {report.Year}")" Subtitle="@report.PropertyName" Back="@($"/verwaltung/objekte/{PropertyId}")" BackText="@report.PropertyName" />

<StatusMessage />

<FilterBar SubmitText="Anzeigen" AllowReset="false">
    <ChildContent>
    <div class="field">
        <label for="year">Steuerjahr</label>
        <input id="year" type="number" name="jahr" value="@Year" min="2000" max="2100" />
    </div>
    <div class="field field-checkbox">
        <input id="forecast" type="checkbox" name="prognose" value="true" checked="@Forecast" />
        <label for="forecast">Totalüberschussprognose positiv</label>
    </div>
    </ChildContent>
    <Actions>
        <a class="button button-outlined" href="/verwaltung/objekte/@PropertyId/anlage-v.csv?jahr=@Year&prognose=@Forecast.ToString().ToLowerInvariant()">CSV exportieren</a>
        <a class="button button-outlined" href="/verwaltung/objekte/@PropertyId/anlage-v.pdf?jahr=@Year&prognose=@Forecast.ToString().ToLowerInvariant()">PDF</a>
        <a class="button button-outlined" href="/verwaltung/finanzen/anlage-v-zeilen?jahr=@Year">Zeilennummern pflegen</a>
    </Actions>
</FilterBar>

@if (report.Warnings.Count > 0)
{
    <Notice Level="NoticeLevel.Warning">
        <strong>Bitte prüfen:</strong>
        <ul>
            @foreach (var warning in report.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </Notice>
}

<p class="small">
    Es zählen Zahlungen und Zahlungsabflüsse im Jahr (Zuflussprinzip, § 11 EStG). Regelmäßig wiederkehrende Zahlungen, die innerhalb von zehn Tagen um den Jahreswechsel
    fällig sind und gezahlt werden, gehören zum Jahr der Fälligkeit. Die Zeilennummern sind je Steuerjahr pflegbar und vor dem Eintragen am amtlichen Vordruck zu prüfen.
</p>

<section>
    <h2>Einnahmen</h2>
    <AnlageVTable Lines="report.Result.Income" Total="report.Result.IncomeTotal" TotalText="Summe der Einnahmen" PropertyId="PropertyId" />
</section>

<section>
    <h2>Werbungskosten</h2>
    <AnlageVTable Lines="report.Result.Expenses" Total="report.Result.ExpenseTotal" TotalText="Summe der Werbungskosten" PropertyId="PropertyId" />
</section>

<dl class="summary">
    @if (report.Result.Reduction != 0)
    {
        <dt>Kürzung der Werbungskosten (verbilligte Vermietung, @Format.Number(report.RentPercent ?? 0) % der ortsüblichen Miete)</dt><dd>@Format.Money(-report.Result.Reduction)</dd>
        <dt>Abziehbare Werbungskosten</dt><dd>@Format.Money(report.Result.DeductibleExpenses)</dd>
    }
    <dt>Überschuss</dt><dd>@Format.Money(report.Result.Surplus)</dd>
</dl>

<section>
    <h2>Verbilligte Vermietung</h2>
    <p class="small">
        Liegt die Miete (Kaltmiete und Umlagen) unter 66 % der ortsüblichen Miete, sind die Werbungskosten nur anteilig abziehbar (§ 21 Abs. 2 EStG).
        Trage dafür die ortsübliche Jahresmiete einschließlich Umlagen für den vermieteten Zeitraum ein, zum Beispiel aus dem Mietspiegel.
        @if (report.RentPercent is { } percent)
        {
            <text>Aktuell: @Format.Number(percent) % der ortsüblichen Miete.</text>
        }
    </p>
    <form method="post" @formname="local-rent" @onsubmit="SaveLocalRentAsync">
        <AntiforgeryToken />
        <input type="hidden" name="SaveYear" value="@Year" />
        <label for="local-rent">Ortsübliche Jahresmiete (€)</label>
        <input id="local-rent" type="text" inputmode="decimal" name="LocalRentText" value="@(report.LocalRent is { } rent ? rent.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("de-DE")) : "")" />
        <button type="submit" class="button">Speichern</button>
    </form>
</section>

@code {
    private AnlageVReport? report;

    [Parameter]
    public Guid PropertyId { get; set; }

    [SupplyParameterFromQuery(Name = "jahr")]
    private int? YearQuery { get; set; }

    [SupplyParameterFromQuery(Name = "prognose")]
    private bool? ForecastQuery { get; set; }

    [SupplyParameterFromForm(Name = "SaveYear")]
    private int? SaveYear { get; set; }

    [SupplyParameterFromForm(Name = "LocalRentText")]
    private string? LocalRentText { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private bool Forecast => ForecastQuery ?? false;

    private int Year => SaveYear ?? YearQuery ?? MietHahn.Domain.Common.GermanTime.Today(Clock.GetUtcNow()).Year - 1;

    protected override async Task OnInitializedAsync() => report = await Admin.GetAsync(PropertyId, Year, Forecast);

    private async Task SaveLocalRentAsync()
    {
        decimal? rent = null;
        if (!string.IsNullOrWhiteSpace(LocalRentText))
        {
            if (!decimal.TryParse(LocalRentText, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.GetCultureInfo("de-DE"), out var parsed))
            {
                report = await Admin.GetAsync(PropertyId, Year, Forecast);
                return;
            }

            rent = parsed;
        }

        var result = await Admin.SaveLocalRentAsync(PropertyId, Year, rent);
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage($"/verwaltung/objekte/{PropertyId}/anlage-v?jahr={Year}", "Die ortsübliche Miete wurde gespeichert.", HttpContext);
        }
    }
}
