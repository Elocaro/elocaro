@page "/verwaltung/nachrichten/neu"
@rendermode InteractiveServer
@using MudBlazor
@using MietHahn.Application.Leases
@using MietHahn.Application.Files
@using MietHahn.Application.Notices
@using MietHahn.Web.Components.Controls
@inject IMessages Messages
@inject ILeaseService Leases
@inject IFileStore Files
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<InteractiveShell>
    <PageHeader Title="Nachricht schreiben" Back="/verwaltung/nachrichten" BackText="Alle Nachrichten" />
    <ErrorList Errors="errors" />

    @if (leases is not null)
    {
        <EditForm Model="input" OnValidSubmit="SubmitAsync" novalidate>
            <DataAnnotationsValidator />
            <div class="form-grid">
                <AppSelect T="Guid?" @bind-Value="input.LeaseId" Label="Mietverhältnis" Required="true" Items="leases.Select(l => (Guid?)l.Id).ToList()" Text="@(id => leases.FirstOrDefault(l => l.Id == id) is { } l ? $"{l.Tenant} · {l.RentalUnit}" : "")" />
                <AppTextField @bind-Value="input.Subject" Label="Betreff" Required="true" />
                <AppTextField @bind-Value="input.Text" Label="Nachricht" Required="true" Lines="6" />
            </div>
            <div class="form-row">
                <AppFileUpload Text="Anhang hinzufügen" Multiple="true" OnSelectedMany="files => selected = files" />
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy">Senden</MudButton>
        </EditForm>
    }
</InteractiveShell>

@code {
    private readonly NewThread input = new();
    private IReadOnlyList<LeaseOverview>? leases;
    private IReadOnlyList<FileSelection> selected = [];
    private IReadOnlyList<string>? errors;
    private bool busy;

    [SupplyParameterFromQuery(Name = "vertrag")]
    private Guid? LeaseId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        leases = await Leases.ListAsync();
        input.LeaseId = LeaseId;
    }

    private async Task SubmitAsync()
    {
        busy = true;
        try
        {
            var ids = new List<Guid>();
            foreach (var file in selected)
            {
                await using var content = file.Open();
                ids.Add((await Files.SaveAsync(content, file.Name)).Id);
            }

            var result = await Messages.StartAsync((await Authentication.GetAuthenticationStateAsync()).User, input, ids);
            if (result.Succeeded)
            {
                Navigation.NavigateTo($"/verwaltung/nachrichten/{result.Id}");
                return;
            }

            errors = result.Errors;
        }
        catch (FileRejectedException ex)
        {
            errors = [ex.Message];
        }
        finally
        {
            busy = false;
        }
    }
}
