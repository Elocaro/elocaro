@page "/verwaltung/vertraege/{Id:guid}/konto"
@using MietHahn.Domain.Leases
@inject ITenantAccounts Accounts
@inject Redirector Redirector

@if (account is null)
{
    <PageHeader Title="Vertrag nicht gefunden" Back="/verwaltung/finanzen/offene-posten" BackText="Offene Posten" />
    return;
}

<PageHeader Title="@($"Mieterkonto {account.Tenant}")" Subtitle="@account.RentalUnit" Back="@($"/verwaltung/vertraege/{Id}")" BackText="Zum Vertrag" />

<StatusMessage />
<ErrorList Errors="errors" />

@if (account.AccountingStart is null)
{
    <p class="meldung meldung-hinweis" role="status">Noch kein Buchhaltungsbeginn festgelegt, daher entstehen keine Monatsmieten. <a href="/verwaltung/finanzen/einstellungen">Jetzt festlegen</a></p>
}

<dl class="angaben">
    <dt>Saldo</dt>
    <dd><strong>@Format.Money(Math.Abs(account.Balance))</strong> @(account.Balance > 0 ? "Rückstand" : account.Balance < 0 ? "Guthaben des Mieters" : "ausgeglichen")</dd>
    <dt>Davon fällig</dt><dd>@Format.Money(account.Due)</dd>
    <dt>Verrechnung</dt><dd>@Labels.From(account.Allocation)</dd>
</dl>

<form method="post" @formname="aktualisieren" @onsubmit="RefreshAsync">
    <AntiforgeryToken />
    <button type="submit" class="knopf">Monatsmieten jetzt aktualisieren</button>
    <span class="feld-hinweis">Passiert sonst jede Nacht automatisch, z. B. nach einer Mieterhöhung.</span>
</form>

<section>
    <h2>Buchungen</h2>
    @if (account.Entries.Count == 0)
    {
        <p class="klein">Noch keine Buchungen.</p>
    }
    else
    {
        <form method="post" @formname="loeschen" @onsubmit="DeleteAsync">
            <AntiforgeryToken />
            <div class="tabellen-rahmen">
                <table class="tabelle">
                    <thead>
                        <tr><th>Datum</th><th>Buchung</th><th class="zahl">Soll</th><th class="zahl">Haben</th><th class="zahl">Saldo</th><th>Offen</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in account.Entries.Reverse())
                        {
                            <tr>
                                <td>@Format.Date(b.Date)</td>
                                <td>@b.Text</td>
                                <td class="zahl">@(b.Debit == 0 ? "" : Format.Money(b.Debit))</td>
                                <td class="zahl">@(b.Credit == 0 ? "" : Format.Money(b.Credit))</td>
                                <td class="zahl">@Format.Money(b.Balance)</td>
                                <td>
                                    @if (b.Open is 0m)
                                    {
                                        <span class="status status-ok">bezahlt</span>
                                    }
                                    else if (b.Open is { } open && open == b.Debit)
                                    {
                                        <span class="status status-wartend">offen</span>
                                    }
                                    else if (b.Open is { } part)
                                    {
                                        <span class="status status-wartend">@Format.Money(part) offen</span>
                                    }
                                </td>
                                <td>
                                    @if (!b.Automatic && b.Origin is null or PaymentOrigin.Manual)
                                    {
                                        <button type="submit" class="knopf knopf-gefahr" name="Delete" value="@($"{b.EntryType}:{b.Id}")" aria-label="@($"{b.Text} löschen")">Löschen</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    }
</section>

<section>
    <h2>Zahlung erfassen</h2>
    <EditForm Model="Payment" FormName="zahlung" OnValidSubmit="PaymentAsync">
        <DataAnnotationsValidator />
        <div class="formular-raster">
            <FormField Id="zahlung-datum" Label="Datum" For="() => Payment!.Date" Required="true">
                <InputDate id="zahlung-datum" @bind-Value="Payment!.Date" />
            </FormField>
            <FormField Id="zahlung-betrag" Label="Betrag" For="() => Payment!.Amount" Required="true">
                <InputAmount id="zahlung-betrag" @bind-Value="Payment!.Amount" />
            </FormField>
            <FormField Id="zahlung-zweck" Label="Verwendungszweck" For="() => Payment!.Purpose">
                <InputText id="zahlung-zweck" @bind-Value="Payment!.Purpose" />
            </FormField>
            <FormField Id="zahlung-bestimmung" Label="Zahlt auf (optional)" For="() => Payment!.ChargeId" Hint="Nur wenn der Mieter das bestimmt hat (z. B. „Kaution“).">
                <InputSelect id="zahlung-bestimmung" @bind-Value="Payment!.ChargeId">
                    <option value="">– automatisch verrechnen –</option>
                    @foreach (var b in account.Entries.Where(b => b.Open > 0))
                    {
                        <option value="@b.Id">@b.Text (@Format.Money(b.Open))</option>
                    }
                </InputSelect>
            </FormField>
        </div>
        <div class="feld feld-checkbox">
            <InputCheckbox id="zahlung-auszahlung" @bind-Value="Payment!.Payout" />
            <label for="zahlung-auszahlung">Auszahlung an den Mieter (z. B. Guthaben überwiesen)</label>
        </div>
        <button type="submit" class="knopf knopf-primaer">Zahlung buchen</button>
    </EditForm>
</section>

<section>
    <h2>Sonstige Forderung oder Gutschrift</h2>
    <EditForm Model="Charge" FormName="sollstellung" OnValidSubmit="ChargeAsync">
        <DataAnnotationsValidator />
        <div class="formular-raster">
            <FormField Id="soll-art" Label="Art" For="() => Charge!.Kind">
                <InputSelect id="soll-art" @bind-Value="Charge!.Kind">
                    @foreach (var value in Enum.GetValues<ChargeType>().Where(a => a != ChargeType.Rent))
                    {
                        <option value="@value">@Labels.From(value)</option>
                    }
                </InputSelect>
            </FormField>
            <FormField Id="soll-faellig" Label="Fällig am" For="() => Charge!.Due" Required="true">
                <InputDate id="soll-faellig" @bind-Value="Charge!.Due" />
            </FormField>
            <FormField Id="soll-betrag" Label="Betrag" For="() => Charge!.Amount" Required="true" Hint="Immer positiv, eine Erstattung wird als Guthaben gebucht.">
                <InputAmount id="soll-betrag" @bind-Value="Charge!.Amount" />
            </FormField>
            <FormField Id="soll-text" Label="Bezeichnung" For="() => Charge!.Name" Hint="z. B. „Nachzahlung Betriebskosten 2025“">
                <InputText id="soll-text" @bind-Value="Charge!.Name" />
            </FormField>
        </div>
        <button type="submit" class="knopf">Buchen</button>
    </EditForm>
</section>

<section>
    <h2>Mieten je Jahr</h2>
    @if (account.AnnualValues.Count == 0)
    {
        <p class="klein">Noch keine Monatsmieten.</p>
    }
    else
    {
        <p class="klein">Soll nach Leistungsmonat, davon bezahlt (für die Nebenkostenabrechnung) und im Kalenderjahr zugeflossen (Zahlungsdatum, § 11 EStG).</p>
        <div class="tabellen-rahmen">
            <table class="tabelle">
                <thead><tr><th>Jahr</th><th>Bestandteil</th><th class="zahl">Soll</th><th class="zahl">davon bezahlt</th><th class="zahl">Zufluss im Jahr</th></tr></thead>
                <tbody>
                    @foreach (var w in account.AnnualValues)
                    {
                        <tr>
                            <td>@w.Year</td>
                            <td>@Labels.From(w.Component)</td>
                            <td class="zahl">@Format.Money(w.Debit)</td>
                            <td class="zahl">@Format.Money(w.Settled)</td>
                            <td class="zahl">@Format.Money(w.Inflow)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private TenantAccount? account;
    private IReadOnlyList<string>? errors;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "zahlung")]
    private PaymentInput? Payment { get; set; }

    [SupplyParameterFromForm(FormName = "sollstellung")]
    private ChargeInput? Charge { get; set; }

    [SupplyParameterFromForm(FormName = "loeschen")]
    private string? Delete { get; set; }

    private string Target => $"/verwaltung/vertraege/{Id}/konto";

    protected override async Task OnInitializedAsync()
    {
        Payment ??= new();
        Charge ??= new();
        account = await Accounts.GetAsync(Id);
    }

    private async Task RefreshAsync()
    {
        var count = await Accounts.GenerateChargesAsync(Id);
        Redirector.RedirectWithMessage(Target, count == 0 ? "Die Monatsmieten sind aktuell." : $"{count} Sollstellungen angelegt oder angeglichen.", HttpContext);
    }

    private Task PaymentAsync() => ExecuteAsync(Accounts.RecordPaymentAsync(Id, Payment!), "Die Zahlung wurde gebucht.");

    private Task ChargeAsync() => ExecuteAsync(Accounts.CreateChargeAsync(Id, Charge!), "Die Buchung wurde angelegt.");

    private Task DeleteAsync()
    {
        var parts = (Delete ?? "").Split(':');
        if (parts.Length != 2 || !Guid.TryParse(parts[1], out var id) || !Enum.TryParse<EntryType>(parts[0], out var kind))
        {
            errors = ["Unbekannte Buchung."];
            return Task.CompletedTask;
        }

        return ExecuteAsync(kind == EntryType.Payment ? Accounts.DeletePaymentAsync(id) : Accounts.DeleteChargeAsync(id), "Die Buchung wurde gelöscht.");
    }

    private async Task ExecuteAsync(Task<Result> command, string success)
    {
        var result = await command;
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage(Target, success, HttpContext);
        }
        else
        {
            errors = result.Errors;
        }
    }
}
