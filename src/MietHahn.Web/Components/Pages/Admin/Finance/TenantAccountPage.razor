@page "/verwaltung/vertraege/{Id:guid}/konto"
@rendermode InteractiveServer
@using MudBlazor
@using MietHahn.Domain.Leases
@inject ITenantAccounts Accounts
@inject IDunning Dunning
@inject Notifier Notify
@inject Confirmations Confirm

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (account is null)
{
    <PageHeader Title="Vertrag nicht gefunden" Back="/verwaltung/finanzen/offene-posten" BackText="Offene Posten" />
}
else
{

<PageHeader Title="@($"Mieterkonto {account.Tenant}")" Subtitle="@account.RentalUnit" Back="@($"/verwaltung/vertraege/{Id}")" BackText="Zum Vertrag" />

<ErrorList Errors="errors" />

@if (account.AccountingStart is null)
{
    <Notice Level="NoticeLevel.Info">Noch kein Buchhaltungsbeginn festgelegt, daher entstehen keine Monatsmieten. <a href="/verwaltung/finanzen/einstellungen">Jetzt festlegen</a></Notice>
}

<dl class="details">
    <dt>Saldo</dt>
    <dd><strong>@Format.Money(Math.Abs(account.Balance))</strong> @(account.Balance > 0 ? "Rückstand" : account.Balance < 0 ? "Guthaben des Mieters" : "ausgeglichen")</dd>
    <dt>Davon fällig</dt><dd>@Format.Money(account.Due)</dd>
    <dt>Verrechnung</dt><dd>@Labels.From(account.Allocation)</dd>
</dl>

<div class="form-row">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshAsync">Monatsmieten jetzt aktualisieren</MudButton>
    <span class="field-hint">Passiert sonst jede Nacht automatisch, z. B. nach einer Mieterhöhung.</span>
</div>

<section>
    <h2>Buchungen</h2>
    @if (account.Entries.Count == 0)
    {
        <EmptyState Compact="true" Text="Noch keine Buchungen." />
    }
    else
    {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr><th>Datum</th><th>Buchung</th><th class="number">Soll</th><th class="number">Haben</th><th class="number">Saldo</th><th>Offen</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in account.Entries.Reverse())
                        {
                            <tr>
                                <td>@Format.Date(b.Date)</td>
                                <td>@b.Text</td>
                                <td class="number">@(b.Debit == 0 ? "" : Format.Money(b.Debit))</td>
                                <td class="number">@(b.Credit == 0 ? "" : Format.Money(b.Credit))</td>
                                <td class="number">@Format.Money(b.Balance)</td>
                                <td>
                                    @if (b.Open is 0m)
                                    {
                                        <StatusChip Level="StatusLevel.Success">bezahlt</StatusChip>
                                    }
                                    else if (b.Open is { } open && open == b.Debit)
                                    {
                                        <StatusChip Level="StatusLevel.Warning">offen</StatusChip>
                                    }
                                    else if (b.Open is { } part)
                                    {
                                        <StatusChip Level="StatusLevel.Warning">@Format.Money(part) offen</StatusChip>
                                    }
                                </td>
                                <td>
                                    @if (!b.Automatic && b.Origin is null or PaymentOrigin.Manual)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteAsync(b)" aria-label="@($"{b.Text} löschen")">Löschen</MudButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
    }
</section>

<section>
    <h2>Zahlung erfassen</h2>
    <EditForm Model="payment" OnValidSubmit="PaymentAsync" novalidate>
        <DataAnnotationsValidator />
        <div class="form-grid">
            <AppDateField @bind-Value="payment.Date" Label="Datum" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="payment.Amount" Label="Betrag" Suffix="€" Required="true" />
            <AppTextField @bind-Value="payment.Purpose" Label="Verwendungszweck" />
            <AppSelect T="Guid?" @bind-Value="payment.ChargeId" Label="Zahlt auf (optional)" Hint="Nur wenn der Mieter das bestimmt hat (z. B. „Kaution“)." Items="openChargeIds" Text="ChargeText" EmptyText="– automatisch verrechnen –" />
        </div>
        <AppCheckBox @bind-Value="payment.Payout" Label="Auszahlung an den Mieter (z. B. Guthaben überwiesen)" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Zahlung buchen</MudButton>
    </EditForm>
</section>

<section>
    <h2>Sonstige Forderung oder Gutschrift</h2>
    <EditForm Model="charge" OnValidSubmit="ChargeAsync" novalidate>
        <DataAnnotationsValidator />
        <div class="form-grid">
            <AppSelect @bind-Value="charge.Kind" Label="Art" Items="Enum.GetValues<ChargeType>().Where(a => a != ChargeType.Rent).ToList()" Text="@(v => Labels.From(v))" />
            <AppDateField @bind-Value="charge.Due" Label="Fällig am" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="charge.Amount" Label="Betrag" Suffix="€" Required="true" Hint="Immer positiv, eine Erstattung wird als Guthaben gebucht." />
            <AppTextField @bind-Value="charge.Name" Label="Bezeichnung" Hint="z. B. „Nachzahlung Betriebskosten 2025“" />
        </div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Buchen</MudButton>
    </EditForm>
</section>

<section id="mahnwesen" aria-labelledby="dunning-heading">
    <h2 id="dunning-heading">Mahnwesen</h2>
    @if (dunning is not null)
    {
        @if (dunning.TerminationHint is { } hint)
        {
            <Notice Level="NoticeLevel.Info">
                <strong>Hinweis Kündigungsrelevanz:</strong> Mietrückstand @Format.Money(hint.OpenRent) bei einer Monatsmiete von @Format.Money(hint.MonthlyRent)
                (§ 543 Abs. 2 Nr. 3 BGB). Nur ein Hinweis, keine Automatik; bitte rechtlich prüfen lassen.
            </Notice>
        }

        @if (dunning.Proposal is { } proposal)
        {
            <Notice Level="NoticeLevel.Info">
                Mahnvorschlag: <strong>@Labels.From(proposal.Level)</strong> über @Format.Money(proposal.Principal).
                <a href="/verwaltung/finanzen/mahnungen/@proposal.Id">Prüfen und freigeben</a>
            </Notice>
        }

        @if (dunning.Issued.Count > 0)
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Datum</th><th>Stufe</th><th class="number">Gesamt</th><th>Zahlbar bis</th><th>Versand</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in dunning.Issued)
                        {
                            <tr>
                                <td>@Format.Date(m.Date)</td>
                                <td>@Labels.From(m.Level)</td>
                                <td class="number">@Format.Money(m.Principal + m.Fee + m.Interest)</td>
                                <td>@Format.Date(m.Deadline)</td>
                                <td>@(m.SentByMail ? "E-Mail" : "Post (PDF)")</td>
                                <td><a href="/verwaltung/finanzen/mahnungen/@m.Id">Ansehen</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (dunning.Proposal is null)
        {
            <p class="small">Bisher wurde nicht gemahnt.</p>
        }

        <h3>Mahnsperre</h3>
        @if (dunning.Holds.Count > 0)
        {
            <ul>
                @foreach (var h in dunning.Holds)
                {
                    <li>
                        @h.Reason (@(h.Until is { } until ? "bis " + Format.Date(until) : "bis auf Weiteres"))
                        <MudButton Variant="Variant.Outlined" OnClick="() => EndHoldAsync(h)">Aufheben</MudButton>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="small">Keine aktive Mahnsperre. Mit einer Sperre (z. B. Ratenvereinbarung) gibt es keine Mahnvorschläge für dieses Mietverhältnis.</p>
        }

        <EditForm Model="hold" OnValidSubmit="HoldAsync" novalidate>
            <DataAnnotationsValidator />
            <div class="form-grid">
                <AppTextField @bind-Value="hold.Reason" Label="Grund" Required="true" />
                <AppDateField @bind-Value="hold.Until" Label="Bis (optional)" Hint="Leer = bis zur Aufhebung." />
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Mahnsperre setzen</MudButton>
        </EditForm>
    }
</section>

<section>
    <h2>Mieten je Jahr</h2>
    @if (account.AnnualValues.Count == 0)
    {
        <EmptyState Compact="true" Text="Noch keine Monatsmieten." />
    }
    else
    {
        <p class="small">Soll nach Leistungsmonat, davon bezahlt (für die Nebenkostenabrechnung) und im Kalenderjahr zugeflossen (Zahlungsdatum, § 11 EStG).</p>
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Jahr</th><th>Bestandteil</th><th class="number">Soll</th><th class="number">davon bezahlt</th><th class="number">Zufluss im Jahr</th></tr></thead>
                <tbody>
                    @foreach (var w in account.AnnualValues)
                    {
                        <tr>
                            <td>@w.Year</td>
                            <td>@Labels.From(w.Component)</td>
                            <td class="number">@Format.Money(w.Debit)</td>
                            <td class="number">@Format.Money(w.Settled)</td>
                            <td class="number">@Format.Money(w.Inflow)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
}
</InteractiveShell>

@code {
    private TenantAccount? account;
    private LeaseDunning? dunning;
    private IReadOnlyList<string>? errors;
    private PaymentInput payment = new();
    private ChargeInput charge = new();
    private DunningHoldInput hold = new();
    private IReadOnlyList<Guid?> openChargeIds = [];
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        account = await Accounts.GetAsync(Id);
        if (account is not null)
        {
            dunning = await Dunning.ForLeaseAsync(Id);
            openChargeIds = account.Entries.Where(b => b.Open > 0).Select(b => (Guid?)b.Id).ToList();
        }

        loaded = true;
    }

    private string ChargeText(Guid? id) => account?.Entries.FirstOrDefault(b => b.Id == id) is { } b ? $"{b.Text} ({Format.Money(b.Open)})" : "";

    private async Task RefreshAsync()
    {
        var count = await Accounts.GenerateChargesAsync(Id);
        Notify.Success(count == 0 ? "Die Monatsmieten sind aktuell." : $"{count} Sollstellungen angelegt oder angeglichen.");
        await LoadAsync();
    }

    private Task PaymentAsync() => ExecuteAsync(Accounts.RecordPaymentAsync(Id, payment), "Die Zahlung wurde gebucht.", () => payment = new());

    private Task ChargeAsync() => ExecuteAsync(Accounts.CreateChargeAsync(Id, charge), "Die Buchung wurde angelegt.", () => charge = new());

    private Task HoldAsync() => ExecuteAsync(Dunning.AddHoldAsync(Id, hold), "Die Mahnsperre wurde gesetzt.", () => hold = new());

    private async Task EndHoldAsync(DunningHoldRow row)
    {
        if (await Confirm.AskAsync("Mahnsperre aufheben", "Soll die Mahnsperre aufgehoben werden?", "Ja, aufheben"))
        {
            await ExecuteAsync(Dunning.EndHoldAsync(row.Id), "Die Mahnsperre wurde aufgehoben.");
        }
    }

    private async Task DeleteAsync(AccountEntry entry)
    {
        if (!await Confirm.AskAsync("Buchung löschen", $"Soll die Buchung „{entry.Text}“ gelöscht werden?", "Ja, löschen"))
        {
            return;
        }

        await ExecuteAsync(entry.EntryType == EntryType.Payment ? Accounts.DeletePaymentAsync(entry.Id) : Accounts.DeleteChargeAsync(entry.Id), "Die Buchung wurde gelöscht.");
    }

    private async Task ExecuteAsync(Task<Result> command, string success, Action? reset = null)
    {
        var result = await command;
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            reset?.Invoke();
            Notify.Success(success);
            await LoadAsync();
        }
    }
}
