@page "/verwaltung/vertraege/{Id:guid}/konto"
@using MietHahn.Domain.Leases
@inject ITenantAccounts Accounts
@inject IDunning Dunning
@inject Redirector Redirector

@if (account is null)
{
    <PageHeader Title="Vertrag nicht gefunden" Back="/verwaltung/finanzen/offene-posten" BackText="Offene Posten" />
    return;
}

<PageHeader Title="@($"Mieterkonto {account.Tenant}")" Subtitle="@account.RentalUnit" Back="@($"/verwaltung/vertraege/{Id}")" BackText="Zum Vertrag" />

<StatusMessage />
<ErrorList Errors="errors" />

@if (account.AccountingStart is null)
{
    <Notice Level="NoticeLevel.Info">Noch kein Buchhaltungsbeginn festgelegt, daher entstehen keine Monatsmieten. <a href="/verwaltung/finanzen/einstellungen">Jetzt festlegen</a></Notice>
}

<dl class="details">
    <dt>Saldo</dt>
    <dd><strong>@Format.Money(Math.Abs(account.Balance))</strong> @(account.Balance > 0 ? "Rückstand" : account.Balance < 0 ? "Guthaben des Mieters" : "ausgeglichen")</dd>
    <dt>Davon fällig</dt><dd>@Format.Money(account.Due)</dd>
    <dt>Verrechnung</dt><dd>@Labels.From(account.Allocation)</dd>
</dl>

<form method="post" @formname="refresh" @onsubmit="RefreshAsync">
    <AntiforgeryToken />
    <button type="submit" class="button">Monatsmieten jetzt aktualisieren</button>
    <span class="field-hint">Passiert sonst jede Nacht automatisch, z. B. nach einer Mieterhöhung.</span>
</form>

<section>
    <h2>Buchungen</h2>
    @if (account.Entries.Count == 0)
    {
        <p class="small">Noch keine Buchungen.</p>
    }
    else
    {
        <form method="post" @formname="delete" @onsubmit="DeleteAsync">
            <AntiforgeryToken />
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr><th>Datum</th><th>Buchung</th><th class="number">Soll</th><th class="number">Haben</th><th class="number">Saldo</th><th>Offen</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in account.Entries.Reverse())
                        {
                            <tr>
                                <td>@Format.Date(b.Date)</td>
                                <td>@b.Text</td>
                                <td class="number">@(b.Debit == 0 ? "" : Format.Money(b.Debit))</td>
                                <td class="number">@(b.Credit == 0 ? "" : Format.Money(b.Credit))</td>
                                <td class="number">@Format.Money(b.Balance)</td>
                                <td>
                                    @if (b.Open is 0m)
                                    {
                                        <span class="status status-ok">bezahlt</span>
                                    }
                                    else if (b.Open is { } open && open == b.Debit)
                                    {
                                        <span class="status status-pending">offen</span>
                                    }
                                    else if (b.Open is { } part)
                                    {
                                        <span class="status status-pending">@Format.Money(part) offen</span>
                                    }
                                </td>
                                <td>
                                    @if (!b.Automatic && b.Origin is null or PaymentOrigin.Manual)
                                    {
                                        <button type="submit" class="button button-danger" name="Delete" value="@($"{b.EntryType}:{b.Id}")" aria-label="@($"{b.Text} löschen")">Löschen</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    }
</section>

<section>
    <h2>Zahlung erfassen</h2>
    <EditForm Model="Payment" FormName="payment" OnValidSubmit="PaymentAsync">
        <DataAnnotationsValidator />
        <div class="form-grid">
            <FormField Id="payment-date" Label="Datum" For="() => Payment!.Date" Required="true">
                <InputDate id="payment-date" @bind-Value="Payment!.Date" />
            </FormField>
            <FormField Id="payment-amount" Label="Betrag" For="() => Payment!.Amount" Required="true">
                <InputAmount id="payment-amount" @bind-Value="Payment!.Amount" />
            </FormField>
            <FormField Id="payment-purpose" Label="Verwendungszweck" For="() => Payment!.Purpose">
                <InputText id="payment-purpose" @bind-Value="Payment!.Purpose" />
            </FormField>
            <FormField Id="payment-allocation" Label="Zahlt auf (optional)" For="() => Payment!.ChargeId" Hint="Nur wenn der Mieter das bestimmt hat (z. B. „Kaution“).">
                <InputSelect id="payment-allocation" @bind-Value="Payment!.ChargeId">
                    <option value="">– automatisch verrechnen –</option>
                    @foreach (var b in account.Entries.Where(b => b.Open > 0))
                    {
                        <option value="@b.Id">@b.Text (@Format.Money(b.Open))</option>
                    }
                </InputSelect>
            </FormField>
        </div>
        <div class="field field-checkbox">
            <InputCheckbox id="payment-payout" @bind-Value="Payment!.Payout" />
            <label for="payment-payout">Auszahlung an den Mieter (z. B. Guthaben überwiesen)</label>
        </div>
        <button type="submit" class="button button-primary">Zahlung buchen</button>
    </EditForm>
</section>

<section>
    <h2>Sonstige Forderung oder Gutschrift</h2>
    <EditForm Model="Charge" FormName="charge" OnValidSubmit="ChargeAsync">
        <DataAnnotationsValidator />
        <div class="form-grid">
            <FormField Id="charge-kind" Label="Art" For="() => Charge!.Kind">
                <InputSelect id="charge-kind" @bind-Value="Charge!.Kind">
                    @foreach (var value in Enum.GetValues<ChargeType>().Where(a => a != ChargeType.Rent))
                    {
                        <option value="@value">@Labels.From(value)</option>
                    }
                </InputSelect>
            </FormField>
            <FormField Id="charge-due" Label="Fällig am" For="() => Charge!.Due" Required="true">
                <InputDate id="charge-due" @bind-Value="Charge!.Due" />
            </FormField>
            <FormField Id="charge-amount" Label="Betrag" For="() => Charge!.Amount" Required="true" Hint="Immer positiv, eine Erstattung wird als Guthaben gebucht.">
                <InputAmount id="charge-amount" @bind-Value="Charge!.Amount" />
            </FormField>
            <FormField Id="charge-text" Label="Bezeichnung" For="() => Charge!.Name" Hint="z. B. „Nachzahlung Betriebskosten 2025“">
                <InputText id="charge-text" @bind-Value="Charge!.Name" />
            </FormField>
        </div>
        <button type="submit" class="button">Buchen</button>
    </EditForm>
</section>

<section id="mahnwesen" aria-labelledby="dunning-heading">
    <h2 id="dunning-heading">Mahnwesen</h2>
    @if (dunning is not null)
    {
        @if (dunning.TerminationHint is { } hint)
        {
            <Notice Level="NoticeLevel.Info">
                <strong>Hinweis Kündigungsrelevanz:</strong> Mietrückstand @Format.Money(hint.OpenRent) bei einer Monatsmiete von @Format.Money(hint.MonthlyRent)
                (§ 543 Abs. 2 Nr. 3 BGB). Nur ein Hinweis, keine Automatik; bitte rechtlich prüfen lassen.
            </Notice>
        }

        @if (dunning.Proposal is { } proposal)
        {
            <Notice Level="NoticeLevel.Info">
                Mahnvorschlag: <strong>@Labels.From(proposal.Level)</strong> über @Format.Money(proposal.Principal).
                <a href="/verwaltung/finanzen/mahnungen/@proposal.Id">Prüfen und freigeben</a>
            </Notice>
        }

        @if (dunning.Issued.Count > 0)
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Datum</th><th>Stufe</th><th class="number">Gesamt</th><th>Zahlbar bis</th><th>Versand</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in dunning.Issued)
                        {
                            <tr>
                                <td>@Format.Date(m.Date)</td>
                                <td>@Labels.From(m.Level)</td>
                                <td class="number">@Format.Money(m.Principal + m.Fee + m.Interest)</td>
                                <td>@Format.Date(m.Deadline)</td>
                                <td>@(m.SentByMail ? "E-Mail" : "Post (PDF)")</td>
                                <td><a href="/verwaltung/finanzen/mahnungen/@m.Id">Ansehen</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (dunning.Proposal is null)
        {
            <p class="small">Bisher wurde nicht gemahnt.</p>
        }

        <h3>Mahnsperre</h3>
        @if (dunning.Holds.Count > 0)
        {
            <form method="post" @formname="end-hold" @onsubmit="EndHoldAsync">
                <AntiforgeryToken />
                <ul>
                    @foreach (var h in dunning.Holds)
                    {
                        <li>
                            @h.Reason (@(h.Until is { } until ? "bis " + Format.Date(until) : "bis auf Weiteres"))
                            <button type="submit" class="button" name="EndHold" value="@h.Id">Aufheben</button>
                        </li>
                    }
                </ul>
            </form>
        }
        else
        {
            <p class="small">Keine aktive Mahnsperre. Mit einer Sperre (z. B. Ratenvereinbarung) gibt es keine Mahnvorschläge für dieses Mietverhältnis.</p>
        }

        <EditForm Model="Hold" FormName="hold" OnValidSubmit="HoldAsync">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <FormField Id="hold-reason" Label="Grund" For="() => Hold!.Reason" Required="true">
                    <InputText id="hold-reason" @bind-Value="Hold!.Reason" />
                </FormField>
                <FormField Id="hold-until" Label="Bis (optional)" For="() => Hold!.Until" Hint="Leer = bis zur Aufhebung.">
                    <InputDate id="hold-until" @bind-Value="Hold!.Until" />
                </FormField>
            </div>
            <button type="submit" class="button">Mahnsperre setzen</button>
        </EditForm>
    }
</section>

<section>
    <h2>Mieten je Jahr</h2>
    @if (account.AnnualValues.Count == 0)
    {
        <p class="small">Noch keine Monatsmieten.</p>
    }
    else
    {
        <p class="small">Soll nach Leistungsmonat, davon bezahlt (für die Nebenkostenabrechnung) und im Kalenderjahr zugeflossen (Zahlungsdatum, § 11 EStG).</p>
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Jahr</th><th>Bestandteil</th><th class="number">Soll</th><th class="number">davon bezahlt</th><th class="number">Zufluss im Jahr</th></tr></thead>
                <tbody>
                    @foreach (var w in account.AnnualValues)
                    {
                        <tr>
                            <td>@w.Year</td>
                            <td>@Labels.From(w.Component)</td>
                            <td class="number">@Format.Money(w.Debit)</td>
                            <td class="number">@Format.Money(w.Settled)</td>
                            <td class="number">@Format.Money(w.Inflow)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private TenantAccount? account;
    private IReadOnlyList<string>? errors;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "payment")]
    private PaymentInput? Payment { get; set; }

    [SupplyParameterFromForm(FormName = "charge")]
    private ChargeInput? Charge { get; set; }

    [SupplyParameterFromForm(FormName = "delete")]
    private string? Delete { get; set; }

    [SupplyParameterFromForm(FormName = "hold")]
    private DunningHoldInput? Hold { get; set; }

    [SupplyParameterFromForm(FormName = "end-hold")]
    private Guid? EndHold { get; set; }

    private LeaseDunning? dunning;

    private string Target => $"/verwaltung/vertraege/{Id}/konto";

    protected override async Task OnInitializedAsync()
    {
        Payment ??= new();
        Charge ??= new();
        Hold ??= new();
        account = await Accounts.GetAsync(Id);
        if (account is not null)
        {
            dunning = await Dunning.ForLeaseAsync(Id);
        }
    }

    private Task HoldAsync() => ExecuteAsync(Dunning.AddHoldAsync(Id, Hold!), "Die Mahnsperre wurde gesetzt.");

    private Task EndHoldAsync() =>
        EndHold is { } holdId ? ExecuteAsync(Dunning.EndHoldAsync(holdId), "Die Mahnsperre wurde aufgehoben.") : Task.CompletedTask;

    private async Task RefreshAsync()
    {
        var count = await Accounts.GenerateChargesAsync(Id);
        Redirector.RedirectWithMessage(Target, count == 0 ? "Die Monatsmieten sind aktuell." : $"{count} Sollstellungen angelegt oder angeglichen.", HttpContext);
    }

    private Task PaymentAsync() => ExecuteAsync(Accounts.RecordPaymentAsync(Id, Payment!), "Die Zahlung wurde gebucht.");

    private Task ChargeAsync() => ExecuteAsync(Accounts.CreateChargeAsync(Id, Charge!), "Die Buchung wurde angelegt.");

    private Task DeleteAsync()
    {
        var parts = (Delete ?? "").Split(':');
        if (parts.Length != 2 || !Guid.TryParse(parts[1], out var id) || !Enum.TryParse<EntryType>(parts[0], out var kind))
        {
            errors = ["Unbekannte Buchung."];
            return Task.CompletedTask;
        }

        return ExecuteAsync(kind == EntryType.Payment ? Accounts.DeletePaymentAsync(id) : Accounts.DeleteChargeAsync(id), "Die Buchung wurde gelöscht.");
    }

    private async Task ExecuteAsync(Task<Result> command, string success)
    {
        var result = await command;
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage(Target, success, HttpContext);
        }
        else
        {
            errors = result.Errors;
        }
    }
}
