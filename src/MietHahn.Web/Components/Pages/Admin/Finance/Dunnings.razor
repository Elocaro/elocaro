@page "/verwaltung/finanzen/mahnungen"
@inject IDunning Dunning
@inject Redirector Redirector

<PageHeader Title="Mahnwesen" Subtitle="Rückstände werden erkannt und Mahnungen vorgeschlagen. Versendet wird erst nach Ihrer Freigabe.">
    <Actions>
        <a class="button" href="/verwaltung/finanzen/offene-posten">Offene Posten</a>
        <a class="button" href="/verwaltung/finanzen/einstellungen#mahnwesen">Einstellungen</a>
    </Actions>
</PageHeader>

<StatusMessage />
<ErrorList Errors="errors" />

<Notice Level="NoticeLevel.Info">
    Die mitgelieferte Mahnvorlage ist eine <strong>Basisvorlage</strong> und keine Rechtsberatung. Bitte lassen Sie Text, Fristen,
    Gebühren und Verzugszinsen vor dem produktiven Einsatz rechtlich prüfen.
</Notice>

@if (overview is not null)
{
    @if (overview.TerminationHints.Count > 0)
    {
        <section aria-labelledby="hints-heading">
            <h2 id="hints-heading">Hinweis Kündigungsrelevanz</h2>
            @foreach (var hint in overview.TerminationHints)
            {
                <Notice Level="NoticeLevel.Info">
                    <a href="/verwaltung/vertraege/@hint.LeaseId/konto">@hint.Tenant</a> <span class="small">(@hint.RentalUnit)</span>:
                    Mietrückstand @Format.Money(hint.OpenRent) bei einer Monatsmiete von @Format.Money(hint.MonthlyRent).
                    @if (hint.Relevance.TwoConsecutiveTerms)
                    {
                        <span>Für zwei aufeinanderfolgende Termine ist mehr als eine Monatsmiete offen.</span>
                    }
                    @if (hint.Relevance.TwoMonthlyRents)
                    {
                        <span>Der Rückstand erreicht zwei Monatsmieten.</span>
                    }
                    Das kann eine fristlose Kündigung nach § 543 Abs. 2 Nr. 3 BGB ermöglichen. Dies ist nur ein Hinweis, MietHahn kündigt nie automatisch; bitte rechtlich prüfen lassen.
                </Notice>
            }
        </section>
    }

    <section aria-labelledby="proposals-heading">
        <h2 id="proposals-heading">Mahnvorschläge</h2>
        @if (overview.Proposals.Count == 0)
        {
            <EmptyState Text="Keine Mahnvorschläge. Es gibt keine Rückstände, die gemahnt werden müssten." />
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr><th>Mietverhältnis</th><th>Stufe</th><th class="number">Rückstand</th><th>Ältester Posten</th><th class="number">Gebühr</th><th class="number">Zinsen</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in overview.Proposals)
                        {
                            <tr>
                                <td><a href="/verwaltung/vertraege/@m.LeaseId/konto">@m.Tenant</a><span class="small"> @m.RentalUnit</span></td>
                                <td>
                                    @Labels.From(m.Level)
                                    @if (m.TerminationRelevant)
                                    {
                                        <StatusChip Level="StatusLevel.Error">Kündigungsrelevanz</StatusChip>
                                    }
                                </td>
                                <td class="number">@Format.Money(m.Principal)</td>
                                <td>@Format.Date(m.OldestDue)</td>
                                <td class="number">@(m.Fee > 0 ? Format.Money(m.Fee) : "–")</td>
                                <td class="number">@(m.Interest > 0 ? Format.Money(m.Interest) : "–")</td>
                                <td><a class="button button-primary" href="/verwaltung/finanzen/mahnungen/@m.Id" aria-label="@($"{Labels.From(m.Level)} für {m.Tenant} prüfen und freigeben")">Prüfen und freigeben</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section aria-labelledby="issued-heading">
        <h2 id="issued-heading">Freigegebene Mahnungen</h2>
        @if (overview.Issued.Count == 0)
        {
            <EmptyState Compact="true" Text="Noch keine Mahnung freigegeben." />
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr><th>Datum</th><th>Mietverhältnis</th><th>Stufe</th><th class="number">Gesamt</th><th>Zahlbar bis</th><th>Versand</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in overview.Issued)
                        {
                            <tr>
                                <td>@Format.Date(m.Date)</td>
                                <td><a href="/verwaltung/vertraege/@m.LeaseId/konto">@m.Tenant</a><span class="small"> @m.RentalUnit</span></td>
                                <td>@Labels.From(m.Level)</td>
                                <td class="number">@Format.Money(m.Principal + m.Fee + m.Interest)</td>
                                <td>@Format.Date(m.Deadline)</td>
                                <td>@(m.SentByMail ? "E-Mail" : "Post (PDF)")</td>
                                <td>
                                    <a href="/verwaltung/finanzen/mahnungen/@m.Id">Ansehen</a>
                                    @if (m.FileId is { } file)
                                    {
                                        <span> · </span><a href="/dateien/@file?download=true">PDF</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section aria-labelledby="holds-heading">
        <h2 id="holds-heading">Mahnsperren</h2>
        <p class="small">Solange eine Mahnsperre besteht (z. B. bei einer Ratenvereinbarung), gibt es für das Mietverhältnis keine Vorschläge. Angelegt wird sie im Mieterkonto.</p>
        @if (overview.Holds.Count == 0)
        {
            <p class="small">Keine aktive Mahnsperre.</p>
        }
        else
        {
            <form method="post" @formname="holds" @onsubmit="EndHoldAsync">
                <AntiforgeryToken />
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Mietverhältnis</th><th>Grund</th><th>Bis</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var h in overview.Holds)
                            {
                                <tr>
                                    <td><a href="/verwaltung/vertraege/@h.LeaseId/konto">@h.Tenant</a><span class="small"> @h.RentalUnit</span></td>
                                    <td>@h.Reason</td>
                                    <td>@(h.Until is { } until ? Format.Date(until) : "bis auf Weiteres")</td>
                                    <td><button type="submit" class="button" name="EndHold" value="@h.Id" aria-label="@($"Mahnsperre für {h.Tenant} aufheben")">Aufheben</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        }
    </section>
}

@code {
    private DunningOverview? overview;
    private IReadOnlyList<string>? errors;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "holds")]
    private Guid? EndHold { get; set; }

    protected override async Task OnInitializedAsync() => overview = await Dunning.OverviewAsync();

    private async Task EndHoldAsync()
    {
        if (EndHold is not { } id)
        {
            errors = ["Unbekannte Mahnsperre."];
            return;
        }

        var result = await Dunning.EndHoldAsync(id);
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage("/verwaltung/finanzen/mahnungen", "Die Mahnsperre wurde aufgehoben.", HttpContext);
        }
        else
        {
            errors = result.Errors;
        }
    }
}
