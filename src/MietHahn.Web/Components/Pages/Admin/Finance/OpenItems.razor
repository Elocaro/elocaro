@page "/verwaltung/finanzen/offene-posten"
@inject ITenantAccounts Accounts

<PageHeader Title="Offene Posten" Subtitle="Fällige, nicht vollständig bezahlte Forderungen aller Mietverhältnisse.">
    <Actions>
        <a class="knopf" href="/verwaltung/finanzen/offene-posten.csv">CSV exportieren</a>
    </Actions>
</PageHeader>

@if (items is { Count: 0 })
{
    <EmptyState Text="Keine offenen Posten. Alles bezahlt." />
}
else if (items is not null)
{
    <p><strong>Summe offen: @Format.Money(items.Sum(p => p.Open))</strong></p>
    <div class="tabellen-rahmen">
        <table class="tabelle">
            <thead>
                <tr><th>Mietverhältnis</th><th>Forderung</th><th>Fällig</th><th class="zahl">Betrag</th><th class="zahl">Offen</th></tr>
            </thead>
            <tbody>
                @foreach (var p in items)
                {
                    <tr>
                        <td><a href="/verwaltung/vertraege/@p.LeaseId/konto">@p.Tenant</a><span class="klein"> @p.RentalUnit</span></td>
                        <td>@p.Text</td>
                        <td>@Format.Date(p.Due) <span class="klein">(@p.DaysOverdue Tage)</span></td>
                        <td class="zahl">@Format.Money(p.Amount)</td>
                        <td class="zahl">@Format.Money(p.Open)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<OpenItem>? items;

    protected override async Task OnInitializedAsync() => items = await Accounts.OpenItemsAsync();
}
