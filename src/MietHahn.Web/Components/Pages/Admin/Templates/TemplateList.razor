@page "/verwaltung/einstellungen/vorlagen"
@rendermode InteractiveServer
@using MudBlazor
@inject IDocumentTemplates Library
@inject Notifier Notify

<InteractiveShell>
    <PageHeader Title="Vorlagen" Subtitle="Texte für Schreiben an Mieter. Platzhalter wie {{ tenant_name }} werden beim Erzeugen ersetzt.">
        <Actions>
            <MudButton Variant="Variant.Outlined" OnClick="InstallDefaultsAsync">Standardvorlagen anlegen</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/verwaltung/einstellungen/vorlagen/neu">Vorlage anlegen</MudButton>
        </Actions>
    </PageHeader>

    <ErrorList Errors="errors" />

    @if (rows is { Count: 0 })
    {
        <EmptyState Text="Noch keine Vorlagen." />
    }
    else if (rows is not null)
    {
        <MudTable T="TemplateRow" Items="rows" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" RowsPerPage="25">
            <HeaderContent>
                <MudTh>Name</MudTh><MudTh>Art</MudTh><MudTh>Fassung</MudTh><MudTh>Geändert</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name"><a href="/verwaltung/einstellungen/vorlagen/@context.Id">@context.Name</a>@if (context.Description is not null) {<span class="small">&#32;@context.Description</span>}</MudTd>
                <MudTd DataLabel="Art">@Labels.From(context.Kind)</MudTd>
                <MudTd DataLabel="Fassung">@context.Revision</MudTd>
                <MudTd DataLabel="Geändert">@(context.ChangedAt is { } at ? Format.Timestamp(at) : "–")</MudTd>
            </RowTemplate>
        </MudTable>
    }

    <section>
        <h2>Vorlage importieren</h2>
        <p class="small">Eine zuvor exportierte Vorlagendatei (.json). Gibt es den Namen schon, bekommt die neue Vorlage den Zusatz „(Import)“.</p>
        <AppFileUpload Text="Datei auswählen" Accept=".json" OnSelected="ImportAsync" />
    </section>
</InteractiveShell>

@code {
    private IReadOnlyList<TemplateRow>? rows;
    private IReadOnlyList<string>? errors;

    protected override async Task OnInitializedAsync() => rows = await Library.ListAsync();

    private async Task InstallDefaultsAsync()
    {
        var installed = await Library.InstallDefaultsAsync();
        rows = await Library.ListAsync();
        Notify.Success(installed.Created == 0 ? "Alle Standardvorlagen sind schon vorhanden." : $"{installed.Created} Standardvorlagen wurden angelegt. Texte vor dem Einsatz prüfen.");
    }

    private async Task ImportAsync(FileSelection file)
    {
        using var buffer = new MemoryStream();
        await using (var content = file.Open())
        {
            await content.CopyToAsync(buffer);
        }

        var result = await Library.ImportAsync(buffer.ToArray());
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            rows = await Library.ListAsync();
            Notify.Success("Die Vorlage wurde importiert.");
        }
    }
}
