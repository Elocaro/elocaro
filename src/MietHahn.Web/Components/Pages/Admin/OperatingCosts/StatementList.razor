@page "/verwaltung/objekte/{PropertyId:guid}/abrechnungen"
@using MietHahn.Application.Statements
@inject IStatements Statements

<PageHeader Title="Freigegebene Abrechnungen" Back="@($"/verwaltung/objekte/{PropertyId}")" BackText="Zum Objekt">
    <Actions>
        <a class="button button-primary" href="/verwaltung/objekte/@PropertyId/abrechnung">Abrechnungs-Assistent</a>
    </Actions>
</PageHeader>

<StatusMessage />

@if (statements.Count == 0)
{
    <EmptyState Text="Es ist noch keine Abrechnung freigegeben. Der Abrechnungs-Assistent führt durch die Erstellung." />
    return;
}

<div class="table-wrapper">
    <table class="data-table" id="statements">
        <thead><tr><th>Zeitraum</th><th>Fassung</th><th>Freigegeben</th><th class="number">Gesamtkosten</th><th class="number">Vermieteranteil</th><th>Bemerkung</th></tr></thead>
        <tbody>
            @foreach (var statement in statements)
            {
                <tr>
                    <td><a href="/verwaltung/abrechnungen/@statement.Id">@Format.Period(statement.BillingPeriod)</a></td>
                    <td>@statement.Revision@(statement.Current ? "" : " (ersetzt)")</td>
                    <td>@statement.ReleasedAt.ToString("dd.MM.yyyy")</td>
                    <td class="number">@Format.Money(statement.TotalCosts)</td>
                    <td class="number">@Format.Money(statement.LandlordTotal)</td>
                    <td>@statement.Note</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private IReadOnlyList<StatementSummary> statements = [];

    [Parameter]
    public Guid PropertyId { get; set; }

    protected override async Task OnInitializedAsync() => statements = await Statements.ListAsync(PropertyId);
}
