@page "/verwaltung/objekte/{PropertyId:guid}/nebenkosten"
@rendermode InteractiveServer
@using MudBlazor
@inject IOperatingCosts OperatingCosts
@inject TimeProvider Clock

<InteractiveShell>
<PageHeader Title="Nebenkosten-Vorschau" Back="@($"/verwaltung/objekte/{PropertyId}")" BackText="Zum Objekt">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/verwaltung/objekte/{PropertyId}/abrechnung?jahr={year}")">Abrechnungs-Assistent</MudButton>
    </Actions>
</PageHeader>

<div class="form-row search-bar" role="search">
    <AppNumberField T="int" Value="year" ValueChanged="OnYearChanged" Label="Abrechnungsjahr" Min="2000" Max="2100" />
</div>

@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (errorText is not null)
{
    <Notice Level="NoticeLevel.Error">@errorText</Notice>
}
else if (preview is null)
{
    <EmptyState Text="Objekt nicht gefunden." />
}
else
{
var result = preview.Result;

<div id="preview-notice">
    <Notice Level="NoticeLevel.Info">Das ist eine <strong>Vorschau</strong>. Es wird nichts gespeichert oder versendet.</Notice>
    <details class="explain">
        <summary>Grundlage der Berechnung und Prüfhinweis</summary>
        <p>
            Grundlage sind die Belege mit Kostenpositionen des Jahres, die Umlageschlüssel des Objekts, die Mietverträge und die tatsächlich gezahlten Vorauszahlungen im Mieterkonto.
            Heiz- und Warmwasserkosten werden nach der HeizkostenV mit der CO₂-Kostenaufteilung (CO2KostAufG) berechnet und mit den Heizkostenvorauszahlungen
            verrechnet. Die dafür hinterlegten Tabellen (CO₂-Stufen, Gradtagszahlen) sind <strong>Stand/prüfen</strong>: Sie müssen vor dem Versand einer Abrechnung
            gegen die amtlichen Quellen geprüft werden.
        </p>
    </details>
</div>

@if (result.Problems.Count > 0 || preview.Hints.Count > 0)
{
    <section id="problems">
        <h2>Hinweise und fehlende Daten</h2>
        @if (result.HasErrors)
        {
            <Notice Level="NoticeLevel.Error">Es fehlen Angaben. Das Ergebnis ist <strong>nicht belastbar</strong>, bis sie ergänzt sind.</Notice>
        }
        <ul>
            @foreach (var problem in result.Problems.OrderByDescending(p => p.Severity))
            {
                <li class="@(problem.Severity == ProblemSeverity.Error ? "problem-error" : "problem-warning")">
                    <strong>@(problem.Severity == ProblemSeverity.Error ? "Fehlt:" : "Hinweis:")</strong> @problem.Text
                </li>
            }
            @foreach (var hint in preview.Hints)
            {
                <li><strong>Hinweis:</strong> @hint</li>
            }
        </ul>
    </section>
}

<section id="cost-types">
    <h2>Kosten @Format.Period(result.BillingPeriod)</h2>
    @if (result.CostTypes.Count == 0)
    {
        <EmptyState Text="Für diesen Zeitraum gibt es keine umlagefähigen Kostenpositionen. Belege mit Kostenart und Objekt erfassen." />
    }
    else
    {
        <CostSplitChart Types="result.CostTypes" Previous="previousTotals" />
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Kostenart</th><th>Schlüssel</th><th class="number">Kosten</th><th class="number">Mieter</th><th class="number">Vermieter</th></tr></thead>
                <tbody>
                    @foreach (var type in result.CostTypes)
                    {
                        <tr id="@($"type-{type.CostType}")">
                            <td>@type.Name</td>
                            <td>@type.Key</td>
                            <td class="number">@Format.Money(type.Total)</td>
                            <td class="number">@Format.Money(type.TenantTotal)</td>
                            <td class="number">@Format.Money(type.LandlordTotal)</td>
                        </tr>
                        @foreach (var item in type.Items)
                        {
                            <tr class="detail-row">
                                <td colspan="2" class="small">@item.Description (@Format.Period(item.Period))</td>
                                <td class="number small" colspan="3">@item.Calculation = @Format.Money(item.Prorated)</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr><th colspan="2">Summe</th><th class="number">@Format.Money(result.TotalCosts)</th><th class="number">@Format.Money(result.TenantTotal)</th><th class="number">@Format.Money(result.LandlordTotal)</th></tr>
                </tfoot>
            </table>
        </div>
    }
    @foreach (var excluded in result.NonAllocable)
    {
        <p class="small non-allocable">Nicht umlagefähig, nicht verteilt: @excluded.Description, @Format.Money(excluded.Prorated)</p>
    }
    @foreach (var group in result.UncalculatedGroups)
    {
        <p class="small" id="uncalculated">@group.Name: @Format.Money(group.Total) in @group.Items.Count Positionen. Wird mit der Heizkostenabrechnung berechnet, nicht hier.</p>
    }
</section>

@if (preview.MeterChecks is { Count: > 0 } checks)
{
    <section id="meter-checks">
        <h2>Zähler und Verbrauch</h2>
        @foreach (var check in checks)
        {
            <h3>@check.Contract</h3>
            @if (check.DifferencePercent is { } difference)
            {
                <p>
                    <StatusChip Level="@(check.Level switch { CheckLevel.Ok => StatusLevel.Success, CheckLevel.Warning => StatusLevel.Warning, _ => StatusLevel.Error })">@(check.Level switch { CheckLevel.Ok => "Passt", CheckLevel.Warning => "Auffällig", _ => "Prüfen" })</StatusChip>
                    Hauptzähler @check.Main?.ToString("N2") · Zähler der Einheiten zusammen @check.UnitsTotal?.ToString("N2") · Differenz @difference.ToString("0.#") %
                </p>
            }
            @if (check.Consumption.Count > 0)
            {
                var max = check.Consumption.Max(c => c.Quantity);
                <figure class="cost-chart" aria-label="@($"Verbrauch je Einheit: {check.Contract}")">
                    @foreach (var row in check.Consumption)
                    {
                        <div class="cost-chart-row">
                            <span class="cost-chart-label">@row.Unit</span>
                            <span class="cost-chart-track"><span class="cost-chart-bar tenant" style="width:@((row.Quantity / max * 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                            <span class="cost-chart-value">@row.Quantity.ToString("N2")</span>
                        </div>
                    }
                </figure>
            }
        }
    </section>
}

@foreach (var block in result.Sections)
{
    <section id="@($"section-{block.Id}")">
        <h2>@block.Title</h2>
        @if (block.Notice is not null)
        {
            <Notice Level="NoticeLevel.Info"><strong>Stand/prüfen:</strong> @block.Notice</Notice>
        }
        <ol>
            @foreach (var entry in block.Entries)
            {
                <li>@Entry(entry)</li>
            }
        </ol>
    </section>
}

@if (result.Landlord.Count > 0)
{
    <section id="landlord">
        <h2>Anteil des Vermieters</h2>
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Grund</th><th>Bezeichnung</th><th>Kostenart</th><th class="number">Betrag</th></tr></thead>
                <tbody>
                    @foreach (var position in result.Landlord.OrderBy(p => p.Reason).ThenBy(p => p.Label, StringComparer.CurrentCulture))
                    {
                        <tr>
                            <td>@Labels.From(position.Reason)</td>
                            <td>@position.Label</td>
                            <td>@TypeName(position.CostType)</td>
                            <td class="number">@Format.Money(position.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@foreach (var tenant in result.Tenants.OrderBy(t => t.Rental, StringComparer.CurrentCulture).ThenBy(t => t.Term.From))
{
    <section class="statement" id="@($"tenant-{tenant.LeaseId}")" aria-labelledby="@($"heading-{tenant.LeaseId}")">
        <h2 id="@($"heading-{tenant.LeaseId}")">@tenant.Label · @tenant.Rental</h2>
        <p class="small">Mietzeit im Abrechnungszeitraum: @Format.Period(tenant.Term.Intersect(result.BillingPeriod) ?? tenant.Term) (@tenant.Days Tage) · <a href="/verwaltung/vertraege/@tenant.LeaseId">Vertrag</a></p>
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Kostenart</th><th>Schlüssel</th><th class="number">Gesamtkosten</th><th>Ihr Anteil am Schlüssel</th><th class="number">Ihr Betrag</th></tr></thead>
                <tbody>
                    @foreach (var line in tenant.Lines.Where(l => l.Group == CostGroup.Operating))
                    {
                        <tr>
                            <td>@line.Name</td>
                            <td>@line.Key</td>
                            <td class="number">@Format.Money(line.CostTotal)</td>
                            <td class="small">@line.Basis</td>
                            <td class="number">@Format.Money(line.Share)@(line.NotAgreed != 0 ? " (nicht vereinbart)" : "")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th colspan="4">Summe Betriebskosten</th><th class="number">@Format.Money(tenant.Share)</th></tr>
                    @foreach (var group in tenant.Groups)
                    {
                        @if (group.Group == CostGroup.Operating)
                        {
                            <tr><th colspan="4">abzüglich gezahlter Vorauszahlungen (Soll @Format.Money(group.PrepaymentsDue))</th><th class="number">@Format.Money(group.PrepaymentsPaid)</th></tr>
                            <tr class="balance"><th colspan="4">@(group.Balance >= 0 ? "Nachzahlung" : "Guthaben")</th><th class="number">@Format.Money(Math.Abs(group.Balance))</th></tr>
                        }
                        else if (!group.Calculated)
                        {
                            <tr><td colspan="4" class="small">Heizkostenvorauszahlungen gezahlt (Verrechnung mit der Heizkostenabrechnung)</td><td class="number small">@Format.Money(group.PrepaymentsPaid)</td></tr>
                        }
                    }
                </tfoot>
            </table>
        </div>
        @if (tenant.Groups.FirstOrDefault(g => g.Group == CostGroup.Heating) is { Calculated: true } heating)
        {
            <h3>Heiz- und Warmwasserkosten</h3>
            <div class="table-wrapper">
                <table class="data-table" id="@($"heating-{tenant.LeaseId}")">
                    <thead><tr><th>Kostenart</th><th>Schlüssel</th><th class="number">Gesamtkosten</th><th>Ihr Anteil am Schlüssel</th><th class="number">Ihr Betrag</th></tr></thead>
                    <tbody>
                        @foreach (var line in tenant.Lines.Where(l => l.Group == CostGroup.Heating))
                        {
                            <tr class="@(line.CostType == HeatingCostCalculator.CarbonKey ? "carbon-row" : "")">
                                <td>@line.Name</td>
                                <td>@line.Key</td>
                                <td class="number">@Format.Money(line.CostTotal)</td>
                                <td class="small">@line.Basis</td>
                                <td class="number">@Format.Money(line.Share)@(line.NotAgreed != 0 ? " (nicht vereinbart)" : "")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><th colspan="4">Summe Heiz- und Warmwasserkosten (nach Abzug des CO₂-Vermieteranteils)</th><th class="number">@Format.Money(heating.Share)</th></tr>
                        <tr><th colspan="4">abzüglich gezahlter Heizkostenvorauszahlungen (Soll @Format.Money(heating.PrepaymentsDue))</th><th class="number">@Format.Money(heating.PrepaymentsPaid)</th></tr>
                        <tr class="balance"><th colspan="4">@(heating.Balance >= 0 ? "Nachzahlung Heizkosten" : "Guthaben Heizkosten")</th><th class="number">@Format.Money(Math.Abs(heating.Balance))</th></tr>
                    </tfoot>
                </table>
            </div>
        }
        @if (tenant.HouseholdLabor != 0 || tenant.TradesmanLabor != 0)
        {
            <p class="small">Arbeitskosten nach § 35a EStG: haushaltsnahe Dienstleistungen @Format.Money(tenant.HouseholdLabor), Handwerkerleistungen @Format.Money(tenant.TradesmanLabor).</p>
        }
        <details class="disclosure protocol">
            <summary>Rechenprotokoll</summary>
            @foreach (var line in tenant.Lines)
            {
                <h3>@line.Name</h3>
                <ol>
                    @foreach (var entry in line.Protocol)
                    {
                        <li>@Entry(entry)</li>
                    }
                </ol>
            }
            <h3>Zeitraum, Vorauszahlungen und Ergebnis</h3>
            <ol>
                @foreach (var entry in tenant.Protocol)
                {
                    <li>@Entry(entry)</li>
                }
            </ol>
        </details>
    </section>
}

@if (result.FlatRates.Count > 0)
{
    <section id="flat-rates">
        <h2>Pauschale: Ist-Kosten gegen Einnahmen (intern)</h2>
        <p class="small">Diese Verträge erhalten keine Abrechnung. Die Ist-Kosten ihres Anteils werden nur zur Kontrolle den Pauschalzahlungen gegenübergestellt.</p>
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Mieter</th><th>Mietobjekt</th><th class="number">Ist-Kosten</th><th class="number">Pauschale gezahlt</th><th class="number">Differenz</th></tr></thead>
                <tbody>
                    @foreach (var flat in result.FlatRates)
                    {
                        <tr>
                            <td>@flat.Label</td>
                            <td>@flat.Rental</td>
                            <td class="number">@Format.Money(flat.ActualCosts)</td>
                            <td class="number">@Format.Money(flat.Paid)</td>
                            <td class="number">@Format.Money(flat.Difference)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
}
</InteractiveShell>

@code {
    private OperatingCostPreview? preview;
    private IReadOnlyDictionary<string, decimal>? previousTotals;
    private string? errorText;
    private int year;
    private bool loaded;

    [Parameter]
    public Guid PropertyId { get; set; }

    [SupplyParameterFromQuery(Name = "jahr")]
    private int? Year { get; set; }

    // The query string only provides the start value (see ADR 0005).
    protected override async Task OnInitializedAsync()
    {
        year = Year ?? GermanTime.Today(Clock.GetUtcNow()).Year - 1;
        await LoadAsync();
        loaded = true;
    }

    private async Task OnYearChanged(int value)
    {
        year = value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorText = null;
        preview = null;
        if (year is < 2000 or > 2100)
        {
            errorText = "Bitte ein Abrechnungsjahr zwischen 2000 und 2100 angeben.";
            return;
        }

        preview = await OperatingCosts.PreviewAsync(PropertyId, year);
        var before = preview is null ? null : await OperatingCosts.PreviewAsync(PropertyId, year - 1);
        previousTotals = before is { Result.CostTypes.Count: > 0 } ? before.Result.CostTypes.ToDictionary(t => t.CostType, t => t.Total) : null;
    }

    private static string TypeName(string key) => Domain.Receipts.CostTypes.Find(key)?.Name ?? key;

    private static RenderFragment Entry(ProtocolEntry entry) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "protocol-entry");
        builder.OpenElement(2, "strong");
        builder.AddContent(3, entry.Title);
        builder.CloseElement();
        builder.OpenElement(4, "div");
        builder.AddAttribute(5, "class", "small");
        builder.AddContent(6, "Formel: " + entry.Formula);
        builder.CloseElement();
        builder.OpenElement(7, "div");
        builder.AddContent(8, "Werte: " + entry.Values);
        builder.CloseElement();
        if (entry.Result is { } value)
        {
            builder.OpenElement(9, "div");
            builder.AddContent(10, "Ergebnis: " + value.ToString("#,##0.####", System.Globalization.CultureInfo.GetCultureInfo("de-DE")) + (entry.Unit is null ? "" : " " + entry.Unit));
            builder.CloseElement();
        }

        if (entry.Note is not null)
        {
            builder.OpenElement(11, "div");
            builder.AddAttribute(12, "class", "small");
            builder.AddContent(13, entry.Note);
            builder.CloseElement();
        }

        builder.CloseElement();
    };
}
