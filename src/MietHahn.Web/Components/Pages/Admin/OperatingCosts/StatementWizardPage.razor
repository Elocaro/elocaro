@page "/verwaltung/objekte/{PropertyId:guid}/abrechnung"
@using MietHahn.Application.Statements
@using MietHahn.Domain.Statements
@rendermode InteractiveServer
@inject IStatements Statements
@inject NavigationManager Navigation
@inject TimeProvider Clock

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (wizard is null && errorText is null)
{
    <PageHeader Title="Objekt nicht gefunden" Back="/verwaltung/objekte" BackText="Alle Objekte" />
}
else
{
<PageHeader Title="Abrechnungs-Assistent" Back="@($"/verwaltung/objekte/{PropertyId}")" BackText="Zum Objekt" />

<ErrorList Errors="errors" />

@if (errorText is not null)
{
    <Notice Level="NoticeLevel.Error">@errorText</Notice>
}
else
{
var w = wizard!;
var result = w.Preview.Result;

@if (w.Deadline is { } deadline)
{
    <Notice Level="@(deadline.Level >= DeadlineLevel.Warning ? NoticeLevel.Error : NoticeLevel.Info)" id="deadline">
        @if (deadline.Level == DeadlineLevel.Expired)
        {
            <text><strong>Frist verstrichen:</strong> Die Abrechnung hätte spätestens am @Format.Date(deadline.Deadline) bei den Mietern sein müssen (§ 556 Abs. 3 BGB). Nachforderungen sind ausgeschlossen, Guthaben bleiben fällig.</text>
        }
        else
        {
            <text><strong>Frist:</strong> Die Abrechnung muss spätestens am @Format.Date(deadline.Deadline) bei den Mietern sein (§ 556 Abs. 3 BGB), noch @deadline.Days Tage.</text>
        }
    </Notice>
}

@if (w.Released is { } released)
{
    <Notice Level="NoticeLevel.Info" id="released-notice">
        Für diesen Zeitraum ist bereits eine Abrechnung freigegeben (Fassung @released.Revision vom @Format.Day(released.ReleasedAt)):
        <a href="/verwaltung/abrechnungen/@released.Id">ansehen</a>. Änderungen erzeugen eine neue Fassung.
    </Notice>
}

<Wizard Steps="StepsOf(w)" @bind-Current="StepIndex" FreeNavigation="true" Model="Release"
        FinishText="@(w.Released is null ? "Abrechnung freigeben" : "Neue Fassung freigeben")" OnFinish="ReleaseAsync" FinishDisabled="w.HasErrors"
        StepsLabel="Alle Schritte" ProgressLabel="Fortschritt der Abrechnung">
@switch (step)
{
    case WizardStep.PeriodAndProperty:
        <section id="step-1">
            <div class="form-row search-bar" role="search">
                <AppNumberField T="int" Value="year" ValueChanged="OnYearChanged" Label="Abrechnungsjahr" Min="2000" Max="2100" />
                <AppNumberField T="decimal" Value="threshold" ValueChanged="OnThresholdChanged" Label="Abweichung zum Vorjahr (± %)" Hint="Kostenarten, die stärker vom Vorjahr abweichen, werden zur Prüfung markiert." Min="1" Max="500" />
            </div>
            <dl class="summary">
                <dt>Objekt</dt><dd>@w.Preview.PropertyName</dd>
                <dt>Abrechnungszeitraum</dt><dd>@Format.Period(result.BillingPeriod)</dd>
                <dt>Frist für den Zugang (§ 556 Abs. 3 BGB)</dt><dd>@Format.Date(w.DeadlineDate)</dd>
                <dt>Mietverträge im Zeitraum</dt><dd>@result.Tenants.Count mit Abrechnung, @result.FlatRates.Count mit Pauschale</dd>
            </dl>
        </section>
        break;

    case WizardStep.Costs:
        <section id="step-2">
            @Findings(WizardStep.Costs)
            <div class="table-wrapper">
                <table class="data-table" id="cost-checklist">
                    <thead><tr><th>Kostenart</th><th class="number">Dieses Jahr</th><th class="number">Vorjahr</th><th class="number">Änderung</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var row in CostRows(w))
                        {
                            <tr class="@(row.Missing ? "problem-warning" : "")">
                                <td>@row.Name</td>
                                <td class="number">@Format.Money(row.Current)</td>
                                <td class="number">@(row.Previous is null ? "–" : Format.Money(row.Previous))</td>
                                <td class="number">@row.Change</td>
                                <td>@row.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="small"><a href="/verwaltung/belege?aufteilen=true">Belege ohne Kostenaufteilung</a> · <a href="/verwaltung/belege/neu">Beleg erfassen</a></p>
        </section>
        break;

    case WizardStep.Meters:
        <section id="step-3">
            @Findings(WizardStep.Meters)
            @if (!w.Findings.Any(f => f.Step == WizardStep.Meters))
            {
                <Notice Level="NoticeLevel.Info">Für alle Zähler liegen Anfangs- und Endstand vor.</Notice>
            }
            <p class="small"><a href="/verwaltung/objekte/@PropertyId/zaehler">Zähler und Ablesungen</a></p>
        </section>
        break;

    case WizardStep.Occupancy:
        <section id="step-4">
            @Findings(WizardStep.Occupancy)
            @if (!w.Findings.Any(f => f.Step == WizardStep.Occupancy))
            {
                <Notice Level="NoticeLevel.Info">Alle Mietobjekte sind im ganzen Zeitraum vermietet.</Notice>
            }
            <div class="table-wrapper">
                <table class="data-table" id="occupancy">
                    <thead><tr><th>Mieter</th><th>Mietobjekt</th><th>Mietzeit im Zeitraum</th><th class="number">Tage</th></tr></thead>
                    <tbody>
                        @foreach (var tenant in result.Tenants.OrderBy(t => t.Rental, StringComparer.CurrentCulture).ThenBy(t => t.Term.From))
                        {
                            <tr>
                                <td><a href="/verwaltung/vertraege/@tenant.LeaseId">@tenant.Label</a></td>
                                <td>@tenant.Rental</td>
                                <td>@Format.Period(tenant.Term.Intersect(result.BillingPeriod) ?? tenant.Term)</td>
                                <td class="number">@tenant.Days</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
        break;

    case WizardStep.Calculation:
        <section id="step-5">
            @Findings(WizardStep.Calculation)
            <div class="table-wrapper">
                <table class="data-table" id="totals">
                    <thead><tr><th>Mieter</th><th>Mietobjekt</th><th class="number">Anteil Betriebskosten</th><th class="number">Saldo</th></tr></thead>
                    <tbody>
                        @foreach (var tenant in result.Tenants.OrderBy(t => t.Rental, StringComparer.CurrentCulture).ThenBy(t => t.Term.From))
                        {
                            <tr>
                                <td>@tenant.Label</td>
                                <td>@tenant.Rental</td>
                                <td class="number">@Format.Money(tenant.Share)</td>
                                <td class="number">@Format.Money(Math.Abs(tenant.Balance)) @(tenant.Balance >= 0 ? "Nachzahlung" : "Guthaben")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><th colspan="2">Gesamtkosten @Format.Money(result.TotalCosts)</th><th class="number">Mieter @Format.Money(result.TenantTotal)</th><th class="number">Vermieter @Format.Money(result.LandlordTotal)</th></tr>
                    </tfoot>
                </table>
            </div>
            @if (result.FlatRates.Count > 0)
            {
                <h3>Ist-Kosten gegen Pauschale (intern)</h3>
                <p class="small">Grundlage für eine Erhöhung der Pauschale nach § 560 Abs. 1 BGB (Erklärung in Textform, wirksam zum Beginn des übernächsten Monats; Erhöhungen sind nur für die Zukunft möglich).</p>
                <div class="table-wrapper">
                    <table class="data-table" id="flat-rates">
                        <thead><tr><th>Mieter</th><th class="number">Ist-Kosten</th><th class="number">Pauschale gezahlt</th><th class="number">Differenz</th><th class="number">Vorschlag je Monat</th></tr></thead>
                        <tbody>
                            @foreach (var flat in result.FlatRates)
                            {
                                <tr>
                                    <td>@flat.Label (@flat.Rental)</td>
                                    <td class="number">@Format.Money(flat.ActualCosts)</td>
                                    <td class="number">@Format.Money(flat.Paid)</td>
                                    <td class="number">@Format.Money(flat.Difference)</td>
                                    <td class="number">@(flat.Difference > 0 ? Format.Money(Math.Ceiling(flat.Difference / MonthsOf(result.BillingPeriod) * 100m) / 100m) + " mehr" : "keine Erhöhung nötig")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <p class="small"><a href="/verwaltung/objekte/@PropertyId/nebenkosten?jahr=@year">Vollständige Vorschau mit Rechenprotokoll</a></p>
        </section>
        break;

    default:
        <section id="step-6">
            @if (w.HasErrors)
            {
                <Notice Level="NoticeLevel.Error">Die Abrechnung kann nicht freigegeben werden, solange Angaben fehlen:</Notice>
                <ul>
                    @foreach (var finding in w.Findings.Where(f => f.Severity == FindingSeverity.Error))
                    {
                        <li class="problem-error">@finding.Text</li>
                    }
                </ul>
            }
            else
            {
                @if (w.HasWarnings)
                {
                    <Notice Level="NoticeLevel.Info">Es gibt @w.Findings.Count(f => f.Severity == FindingSeverity.Warning) Hinweise. Prüfen Sie sie in den Schritten oben.</Notice>
                }
                <p>
                    Mit der Freigabe wird die Abrechnung @Format.Period(result.BillingPeriod) eingefroren (Gesamtkosten @Format.Money(result.TotalCosts), davon Mieter @Format.Money(result.TenantTotal)).
                    Sie lässt sich danach nicht mehr ändern; spätere Korrekturen erzeugen eine neue Fassung mit Differenz-Abrechnung.
                </p>
                @if (w.HasWarnings)
                {
                    <AppCheckBox @bind-Value="Release.Acknowledge" Label="Ich habe die Hinweise geprüft." />
                }
                <AppTextField @bind-Value="Release.Note" Label="@(w.Released is null ? "Bemerkung (optional)" : "Begründung der Korrektur")" Required="@(w.Released is not null)" />
            }
        </section>
        break;
}
</Wizard>
}
}
</InteractiveShell>

@code {
    private sealed record CostRow(string Name, decimal Current, decimal? Previous, string Change, string Status, bool Missing);

    private sealed class ReleaseInput
    {
        public bool Acknowledge { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(2000)]
        public string? Note { get; set; }
    }

    private StatementWizard? wizard;
    private IReadOnlyList<string>? errors;
    private string? errorText;
    private int year;
    private decimal threshold;
    private bool loaded;
    private WizardStep step;

    [Parameter]
    public Guid PropertyId { get; set; }

    [SupplyParameterFromQuery(Name = "jahr")]
    private int? Year { get; set; }

    [SupplyParameterFromQuery(Name = "schritt")]
    private int? StepNumber { get; set; }

    [SupplyParameterFromQuery(Name = "abweichung")]
    private decimal? Threshold { get; set; }

    private ReleaseInput Release { get; set; } = new();

    /// <summary>Index of the current step in the wizard frame (the domain steps are numbered from 1).</summary>
    private int StepIndex
    {
        get => (int)step - 1;
        set => step = (WizardStep)(value + 1);
    }

    // The query string only provides the start values (see ADR 0005).
    protected override async Task OnInitializedAsync()
    {
        year = Year ?? GermanTime.Today(Clock.GetUtcNow()).Year - 1;
        threshold = Threshold is > 0 and <= 500 ? Threshold.Value : PlausibilityChecker.DefaultThresholdPercent;
        step = StepNumber is >= 1 and <= 6 ? (WizardStep)StepNumber.Value : WizardStep.PeriodAndProperty;
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        errorText = null;
        if (year is < 2000 or > 2100)
        {
            errorText = "Bitte ein Abrechnungsjahr zwischen 2000 und 2100 angeben.";
            return;
        }

        wizard = await Statements.PrepareAsync(PropertyId, Period.CalendarYear(year), threshold is > 0 and <= 500 ? threshold : PlausibilityChecker.DefaultThresholdPercent);
    }

    /// <summary>The six steps; findings that need attention show as a badge in the step list.</summary>
    private static IReadOnlyList<WizardStepInfo> StepsOf(StatementWizard w)
    {
        WizardStepInfo Step(WizardStep target, string title, string? description = null)
        {
            var count = w.Findings.Count(f => f.Step == target && f.Severity != FindingSeverity.Info);
            return new(title, Description: description, Badge: count > 0 ? count.ToString(System.Globalization.CultureInfo.InvariantCulture) : null,
                BadgeLabel: count > 0 ? (count == 1 ? "1 Hinweis" : $"{count} Hinweise") : null);
        }

        var period = Format.Period(w.Preview.Result.BillingPeriod);
        return
        [
            Step(WizardStep.PeriodAndProperty, "Zeitraum und Objekt"),
            Step(WizardStep.Costs, "Checkliste Kosten", $"Erfasste Kostenarten {period} im Vergleich zum Vorjahr. Fehlende wiederkehrende Kostenarten sind markiert."),
            Step(WizardStep.Meters, "Zählerstände vollständig?"),
            Step(WizardStep.Occupancy, "Personen und Belegung prüfen"),
            Step(WizardStep.Calculation, "Berechnung und Vorschau"),
            Step(WizardStep.Release, "Freigabe"),
        ];
    }

    private async Task OnYearChanged(int value)
    {
        year = value;
        await LoadAsync();
    }

    private async Task OnThresholdChanged(decimal value)
    {
        threshold = value;
        await LoadAsync();
    }

    private static decimal MonthsOf(Period period) => Math.Max(1, (period.To!.Value.Year - period.From.Year) * 12 + period.To.Value.Month - period.From.Month + 1);

    private async Task ReleaseAsync()
    {
        var result = await Statements.ReleaseAsync(PropertyId, Period.CalendarYear(year), Release.Acknowledge, Release.Note);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"/verwaltung/abrechnungen/{result.Id}?meldung=freigegeben");
        }
        else
        {
            errors = result.Errors;
        }
    }

    private static IEnumerable<CostRow> CostRows(StatementWizard w)
    {
        var current = w.Preview.Result.CostTypes.ToDictionary(t => t.CostType);
        var previous = w.Previous?.CostTypes.ToDictionary(t => t.CostType) ?? [];
        foreach (var key in current.Keys.Union(previous.Keys).OrderBy(k => (current.GetValueOrDefault(k) ?? previous[k]).Name, StringComparer.CurrentCulture))
        {
            var now = current.GetValueOrDefault(key);
            var old = previous.GetValueOrDefault(key);
            var change = now is not null && old is { Total: > 0 } ? (now.Total - old.Total) / old.Total * 100m : (decimal?)null;
            var finding = w.Findings.Any(f => f.Step == WizardStep.Costs && f.CostType == key && f.Severity == FindingSeverity.Warning);
            yield return new CostRow(
                (now ?? old)!.Name,
                now?.Total ?? 0m,
                old?.Total,
                change is { } value ? $"{(value > 0 ? "+" : "")}{value:0.#} %" : "–",
                now is null || now.Total == 0 ? "fehlt" : old is null ? "neu" : finding ? "prüfen" : "ok",
                (now is null || now.Total == 0) && old is { Total: > 0 });
        }
    }

    private RenderFragment Findings(WizardStep target) => builder =>
    {
        var list = wizard!.For(target).ToList();
        if (list.Count == 0)
        {
            return;
        }

        builder.OpenElement(0, "ul");
        builder.AddAttribute(1, "class", "findings");
        foreach (var finding in list)
        {
            builder.OpenElement(2, "li");
            builder.AddAttribute(3, "class", finding.Severity switch { FindingSeverity.Error => "problem-error", FindingSeverity.Warning => "problem-warning", _ => "problem-info" });
            builder.OpenElement(4, "strong");
            builder.AddContent(5, finding.Severity switch { FindingSeverity.Error => "Fehlt: ", FindingSeverity.Warning => "Prüfen: ", _ => "Hinweis: " });
            builder.CloseElement();
            builder.AddContent(6, finding.Text);
            builder.CloseElement();
        }

        builder.CloseElement();
    };
}
