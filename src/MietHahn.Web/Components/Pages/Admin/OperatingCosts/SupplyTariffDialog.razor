@using MudBlazor
@inject ISupplyContracts Supply
@inject Notifier Notify

@* Dialog "new tariff" of a supply contract. *@
<EditForm Model="data" OnValidSubmit="SaveAsync" novalidate class="dialog-form">
    <DataAnnotationsValidator />
    <MudDialog>
        <DialogContent>
            <ErrorList Errors="errors" />
            <p class="small">Der bisherige Tarif endet am Vortag.</p>
            <div class="form-grid">
                <AppDateField @bind-Value="data.From" Label="Gilt ab" Required="true" />
                <AppNumberField T="decimal?" @bind-Value="data.UnitPrice" Label="@($"Preis ({Labels.From(PriceUnit)}, brutto)")" />
                <AppNumberField T="decimal?" @bind-Value="data.BaseFeePerMonth" Label="Grundpreis je Monat (brutto)" Suffix="€" />
                <AppTextField @bind-Value="data.Note" Label="Notiz" />
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Abbrechen</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Tarif speichern</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    private readonly SupplyTariffInput data = new();
    private IReadOnlyList<string>? errors;

    [Parameter, EditorRequired]
    public Guid ContractId { get; set; }

    [Parameter]
    public PriceUnit PriceUnit { get; set; }

    [Parameter]
    public DateOnly DefaultFrom { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    protected override void OnInitialized() => data.From = DefaultFrom;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        var result = await Supply.AddTariffAsync(ContractId, data);
        if (result.Succeeded)
        {
            Notify.Success("Der Tarif wurde gespeichert.");
            MudDialog.Close(DialogResult.Ok(result.Id));
        }
        else
        {
            errors = result.Errors;
        }
    }
}
