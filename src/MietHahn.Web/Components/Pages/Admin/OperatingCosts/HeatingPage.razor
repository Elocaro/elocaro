@page "/verwaltung/objekte/{PropertyId:guid}/heizung"
@using MietHahn.Application.Heating
@inject IHeatingSettings Settings
@inject Redirector Redirector

@if (view is null)
{
    <PageHeader Title="Objekt nicht gefunden" Back="/verwaltung/objekte" BackText="Alle Objekte" />
    return;
}

<PageHeader Title="Heizkosten (HeizkostenV)" Subtitle="@view.PropertyName" Back="@($"/verwaltung/objekte/{PropertyId}")" BackText="@view.PropertyName">
    <Actions>
        <a class="button" href="/verwaltung/objekte/@PropertyId/nebenkosten">Nebenkosten-Vorschau</a>
        <a class="button" href="/verwaltung/objekte/@PropertyId/zaehler">Zähler</a>
    </Actions>
</PageHeader>

<StatusMessage />
<ErrorList Errors="errors" />

@if (!view.Saved)
{
    <Notice Level="NoticeLevel.Info" id="defaults-notice">
        Es sind noch keine Einstellungen gespeichert. Die Vorschau rechnet mit den Standardwerten: 70 % nach Verbrauch, 30 % nach Fläche,
        Gas mit kWh laut Beleg, gemeinsame Anlage für Heizung und Warmwasser.
    </Notice>
}

<p class="small">
    Die Heizkosten werden nach der Heizkostenverordnung verteilt: 50 bis 70 % nach Verbrauch (Heizung: Wärmemengenzähler der Wohnungen in kWh,
    Warmwasser: Warmwasserzähler in m³), der Rest nach Fläche (Heizung: Heizfläche, Warmwasser: Wohnfläche). Eine Abrechnung ausschließlich nach Verbrauch
    ist nicht zulässig. Brennstoff, Betriebsstrom, Wartung, Abgasmessung, Reinigung und Zählermiete einer gemeinsamen Anlage buchen Sie unter der Kostenart
    „6. Verbundene Heizungs- und Warmwasseranlagen“ (Art der Position wählen); die Kostenarten 4 und 5 gelten nur für Heizung bzw. nur für Warmwasser.
</p>

<EditForm Model="Data" FormName="heating" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <section>
        <h2>Verteilung</h2>
        <div class="form-grid">
            <FormField Id="heating-percent" Label="Anteil nach Verbrauch (%)" For="() => Data!.ConsumptionPercent" Required="true" Hint="50 bis 70 %, Standard 70 %. Der Rest (Grundkosten) wird nach Fläche verteilt.">
                <InputNumber id="heating-percent" @bind-Value="Data!.ConsumptionPercent" step="0.01" min="50" max="70" />
            </FormField>
            <FormField Id="heating-fuel" Label="Energieträger" For="() => Data!.Fuel">
                <InputSelect id="heating-fuel" @bind-Value="Data!.Fuel">
                    @foreach (var value in Enum.GetValues<HeatingFuel>())
                    {
                        <option value="@value">@Labels.From(value)</option>
                    }
                </InputSelect>
            </FormField>
            <FormField Id="heating-kwh" Label="Energieinhalt je Einheit (kWh)" For="() => Data!.FuelKwhPerUnit" Hint="Nur nötig, wenn der Beleg die Menge nicht in kWh nennt (m³ Gas, l Öl: Standard Öl 10 kWh/l).">
                <InputNumber id="heating-kwh" @bind-Value="Data!.FuelKwhPerUnit" step="0.0001" />
            </FormField>
            <div class="field field-checkbox">
                <InputCheckbox id="heating-joint" @bind-Value="Data!.JointPlant" />
                <label for="heating-joint">Eine Anlage für Heizung und Warmwasser</label>
                <span class="field-hint">Dann werden die Kosten der Kostenarten 4 und 6 nach § 9 HeizkostenV in Heizung und Warmwasser aufgeteilt.</span>
            </div>
        </div>
    </section>

    <section>
        <h2>Aufteilung Heizung und Warmwasser (§ 9)</h2>
        <div class="form-grid">
            <FormField Id="heating-ww-meter" Label="Wärmezähler im Warmwasserkreis" For="() => Data!.HotWaterHeatMeterId" Hint="Ohne Zähler gilt die Formel Q = Faktor × V × (t − 10 °C) mit dem Warmwasserverbrauch V aller Wohnungen.">
                <InputSelect id="heating-ww-meter" @bind-Value="Data!.HotWaterHeatMeterId">
                    <option value="">– keiner (Formel) –</option>
                    @foreach (var meter in view.HeatMeters)
                    {
                        <option value="@meter.Id">@meter.Name</option>
                    }
                </InputSelect>
            </FormField>
            <FormField Id="heating-factor" Label="Formelfaktor (kWh je m³ und K)" For="() => Data!.HotWaterFormulaFactor" Hint="Standard 2,5 (Heizwert). Bei Abrechnung nach Brennwert den Faktor prüfen.">
                <InputNumber id="heating-factor" @bind-Value="Data!.HotWaterFormulaFactor" step="0.001" />
            </FormField>
            <FormField Id="heating-temperature" Label="Warmwassertemperatur (°C)" For="() => Data!.HotWaterTemperature" Hint="Standard 60 °C.">
                <InputNumber id="heating-temperature" @bind-Value="Data!.HotWaterTemperature" step="0.1" />
            </FormField>
        </div>
    </section>

    <section>
        <h2>Heizöl</h2>
        <p class="small">Bei Heizöl ergibt sich der Verbrauch aus Anfangsbestand + Lieferungen − Endbestand. Die Bestände sind Ablesungen eines Tankzählers (Typ Öl, Einheit Liter) zum Tag vor Beginn und zum Ende des Abrechnungszeitraums.</p>
        <div class="form-grid">
            <FormField Id="heating-tank" Label="Tankzähler" For="() => Data!.OilTankMeterId">
                <InputSelect id="heating-tank" @bind-Value="Data!.OilTankMeterId">
                    <option value="">–</option>
                    @foreach (var meter in view.OilMeters)
                    {
                        <option value="@meter.Id">@meter.Name</option>
                    }
                </InputSelect>
            </FormField>
            <FormField Id="heating-valuation" Label="Bewertung" For="() => Data!.OilValuation">
                <InputSelect id="heating-valuation" @bind-Value="Data!.OilValuation">
                    @foreach (var value in Enum.GetValues<OilValuation>())
                    {
                        <option value="@value">@Labels.From(value)</option>
                    }
                </InputSelect>
            </FormField>
            <FormField Id="heating-oil-price" Label="Preis des Anfangsbestands (€/l)" For="() => Data!.OilOpeningPricePerLiter" Hint="Jährlich anpassen; leer = Preis der ersten Lieferung.">
                <InputNumber id="heating-oil-price" @bind-Value="Data!.OilOpeningPricePerLiter" step="0.0001" />
            </FormField>
        </div>
    </section>

    <section id="carbon-settings">
        <h2>CO₂-Kostenaufteilung (CO2KostAufG)</h2>
        <Notice Level="NoticeLevel.Warning" id="legal-notice">
            <strong>Stand/prüfen:</strong> Die Stufentabelle (@view.CarbonTableVersion: @view.CarbonTableStatus) und die Gradtagszahlen
            (@view.DegreeDayTableVersion: @view.DegreeDayTableStatus) sind versionierte Daten, die vor dem Versand einer Abrechnung gegen die
            amtlichen Quellen geprüft werden müssen. MietHahn gibt keine Rechtssicherheit.
        </Notice>
        <div class="form-grid">
            <div class="field field-checkbox">
                <InputCheckbox id="heating-carbon" @bind-Value="Data!.ApplyCarbonCosts" />
                <label for="heating-carbon">CO₂-Kosten zwischen Vermieter und Mieter aufteilen</label>
                <span class="field-hint">Die CO₂-Menge (kg) steht auf dem Brennstoffbeleg, die CO₂-Kosten erfassen Sie als eigene Position der Art „CO₂-Kosten laut Lieferant“.</span>
            </div>
            <FormField Id="heating-special" Label="Sonderfall" For="() => Data!.CarbonSpecialCase" Hint="Wird nur als Warnung ausgewiesen, nicht gerechnet.">
                <InputSelect id="heating-special" @bind-Value="Data!.CarbonSpecialCase">
                    @foreach (var value in Enum.GetValues<CarbonSpecialCase>())
                    {
                        <option value="@value">@Labels.From(value)</option>
                    }
                </InputSelect>
            </FormField>
            <FormField Id="heating-carbon-note" Label="Notiz zum Sonderfall" For="() => Data!.CarbonNote">
                <InputText id="heating-carbon-note" @bind-Value="Data!.CarbonNote" />
            </FormField>
        </div>
    </section>

    <button type="submit" class="button button-primary">Einstellungen speichern</button>
</EditForm>

@code {
    private HeatingSettingsView? view;
    private IReadOnlyList<string>? errors;

    [Parameter]
    public Guid PropertyId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "heating")]
    private HeatingSettingsInput? Data { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var form = Data;
        Data ??= new();
        view = await Settings.GetAsync(PropertyId);
        if (form is null && view is not null)
        {
            Data = view.Input;
        }
    }

    private async Task SaveAsync()
    {
        var result = await Settings.SaveAsync(PropertyId, Data!);
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage($"/verwaltung/objekte/{PropertyId}/heizung", "Die Heizungseinstellungen wurden gespeichert.", HttpContext);
        }
        else
        {
            errors = result.Errors;
        }
    }
}
