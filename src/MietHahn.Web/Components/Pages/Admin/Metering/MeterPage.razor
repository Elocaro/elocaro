@page "/verwaltung/zaehler/{Id:guid}"
@inject IMeterService Admin
@inject IPropertyService Properties
@inject IFileStore Storage
@inject Redirector Redirector
@inject TimeProvider Clock

@if (meter is null)
{
    <PageHeader Title="Zähler nicht gefunden" Back="/verwaltung/objekte" BackText="Alle Objekte" />
    return;
}

<PageHeader Title="@meter.Meter.Name" Subtitle="@($"{Labels.From(meter.Meter.Type)} · Nr. {meter.Meter.Number} · {meter.Meter.Assignment}")"
            Back="@($"/verwaltung/objekte/{meter.PropertyId}/zaehler")" BackText="@($"Zähler {meter.PropertyName}")" />

<StatusMessage />
<ErrorList Errors="errors" />

<dl class="details">
    <dt>Eingebaut</dt><dd>@Format.Date(meter.Meter.InstalledOn)@(meter.Meter.RemovedOn is { } removal ? $", ausgebaut am {Format.Date(removal)}" : "")</dd>
    @if (meter.Meter.CalibrationDueDate is { } deadline)
    {
        <dt>Eichfrist</dt><dd>@Format.Date(deadline)</dd>
    }
    @if (meter.Meter.Location is not null)
    {
        <dt>Lage</dt><dd>@meter.Meter.Location</dd>
    }
    @if (meter.MeteringPoint.Count > 1)
    {
        <dt>Messstelle</dt>
        <dd>
            @foreach (var m in meter.MeteringPoint)
            {
                <a href="/verwaltung/zaehler/@m.Id">@m.Number</a>
                <span class="small">(@Format.Date(m.InstalledOn) – @(m.RemovedOn is null ? "heute" : Format.Date(m.RemovedOn)))</span>
                @if (m != meter.MeteringPoint[^1])
                {
                    <span> → </span>
                }
            }
        </dd>
    }
</dl>

@if (meter.Meter.RemovedOn is null)
{
    <section>
        <h2>Stand erfassen</h2>
        @if (warnings is { Count: > 0 })
        {
            <div class="message message-info" role="alert">
                <strong>Bitte prüfen:</strong>
                <ul>
                    @foreach (var w in warnings)
                    {
                        <li>@w</li>
                    }
                </ul>
            </div>
        }
        <EditForm Model="Entry" FormName="entry" OnValidSubmit="RecordReadingAsync" enctype="multipart/form-data">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <FormField Id="entry-date" Label="Datum" For="() => Entry!.Date" Required="true">
                    <InputDate id="entry-date" @bind-Value="Entry!.Date" />
                </FormField>
                <FormField Id="entry-value" Label="@($"Zählerstand ({Labels.From(meter.Meter.MeasurementUnit)})")" For="() => Entry!.Value" Required="true">
                    <InputArea id="entry-value" @bind-Value="Entry!.Value" step="0.001" />
                </FormField>
                <FormField Id="entry-kind" Label="Art" For="() => Entry!.Kind">
                    <InputSelect id="entry-kind" @bind-Value="Entry!.Kind">
                        <option value="@ReadingType.Reading">Ablesung</option>
                        <option value="@ReadingType.InterimReading">Zwischenablesung (z. B. Mieterwechsel)</option>
                        <option value="@ReadingType.Estimate">Schätzung</option>
                    </InputSelect>
                </FormField>
                <div class="field">
                    <label for="entry-photo">Foto</label>
                    <input type="file" id="entry-photo" name="Photo" accept="image/*" capture="environment" />
                </div>
                <FormField Id="entry-note" Label="Notiz" For="() => Entry!.Note">
                    <InputText id="entry-note" @bind-Value="Entry!.Note" />
                </FormField>
            </div>
            @if (warnings is { Count: > 0 })
            {
                <input type="hidden" name="Entry.Confirmed" value="true" />
                <input type="hidden" name="PhotoId" value="@PhotoId" />
                <button type="submit" class="button button-primary">Trotzdem speichern</button>
            }
            else
            {
                <button type="submit" class="button button-primary">Stand speichern</button>
            }
        </EditForm>
    </section>
}

<section>
    <h2>Verbrauch</h2>
    <div class="table-wrapper">
        <table class="data-table">
            <thead><tr><th>Jahr</th><th class="number">Verbrauch</th><th>Hinweis</th></tr></thead>
            <tbody>
                @foreach (var year in meter.AnnualConsumptions)
                {
                    <tr>
                        <td>@year.Year</td>
                        <td class="number">@Format.Quantity(year.Consumption.Quantity, Labels.From(meter.Meter.MeasurementUnit))</td>
                        <td class="small">@(year.Consumption.MissingReason ?? (year.Consumption.ContainsInterpolation ? "enthält interpolierte Stände" : ""))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (meter.SubMeters.Count > 0)
{
    <section>
        <h2>Unterzähler</h2>
        <ul>
            @foreach (var u in meter.SubMeters)
            {
                <li><a href="/verwaltung/zaehler/@u.Id">@u.Name</a> <span class="small">@u.Number · @u.Assignment</span></li>
            }
        </ul>
        @if (meter.Balance is { } balance)
        {
            <dl class="details">
                <dt>@balance.Year: Hauptzähler</dt><dd>@Format.Quantity(balance.MainMeter, Labels.From(meter.Meter.MeasurementUnit))</dd>
                <dt>Summe Unterzähler</dt><dd>@Format.Quantity(balance.SubMeterTotal, Labels.From(meter.Meter.MeasurementUnit))</dd>
                <dt>Differenz</dt><dd><strong>@Format.Quantity(balance.Difference, Labels.From(meter.Meter.MeasurementUnit))</strong> <span class="small">(Allgemeinverbrauch, Schwund, Messtoleranz)</span></dd>
            </dl>
            @foreach (var hint in balance.Hints)
            {
                <p class="small">@hint</p>
            }
        }
    </section>
}

<section>
    <h2>Stände</h2>
    <form method="post" @formname="entry-remove" @onsubmit="RemoveReadingAsync">
        <AntiforgeryToken />
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Datum</th><th class="number">Stand</th><th>Art</th><th>Erfasst von</th><th></th></tr></thead>
                <tbody>
                    @foreach (var entry in meter.Readings)
                    {
                        <tr>
                            <td>@Format.Date(entry.Date)</td>
                            <td class="number">@Format.Quantity(entry.Value)</td>
                            <td>
                                @Labels.From(entry.Kind)
                                @if (entry.PhotoFileId is { } photo)
                                {
                                    <a href="/dateien/@photo" target="_blank" rel="noopener">Foto</a>
                                }
                                @if (entry.Note is not null)
                                {
                                    <span class="small">@entry.Note</span>
                                }
                            </td>
                            <td class="small">@entry.ReadBy</td>
                            <td>
                                @if (entry.Kind is not (ReadingType.Installation or ReadingType.Removal))
                                {
                                    <button type="submit" name="RemoveReadingId" value="@entry.Id" class="button button-danger" aria-label="Stand vom @Format.Date(entry.Date) entfernen">Entfernen</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</section>

@if (meter.Meter.RemovedOn is null)
{
    <section>
        <details class="disclosure">
            <summary>Zähler tauschen</summary>
            <EditForm Model="Replacement" FormName="replacement" OnValidSubmit="ReplaceAsync" class="form-grid">
                <DataAnnotationsValidator />
                <FormField Id="replacement-date" Label="Tauschdatum" For="() => Replacement!.Date" Required="true">
                    <InputDate id="replacement-date" @bind-Value="Replacement!.Date" />
                </FormField>
                <FormField Id="replacement-final-reading" Label="Endstand alter Zähler" For="() => Replacement!.FinalReading" Required="true">
                    <InputArea id="replacement-final-reading" @bind-Value="Replacement!.FinalReading" step="0.001" />
                </FormField>
                <FormField Id="replacement-number" Label="Nummer neuer Zähler" For="() => Replacement!.NewNumber" Required="true">
                    <InputText id="replacement-number" @bind-Value="Replacement!.NewNumber" autocomplete="off" />
                </FormField>
                <FormField Id="replacement-opening" Label="Anfangsstand neuer Zähler" For="() => Replacement!.InitialReading" Required="true">
                    <InputArea id="replacement-opening" @bind-Value="Replacement!.InitialReading" step="0.001" />
                </FormField>
                <FormField Id="replacement-calibration-deadline" Label="Eichfrist neuer Zähler" For="() => Replacement!.CalibrationDueDate" Hint="Leer = gesetzliche Frist">
                    <InputDate id="replacement-calibration-deadline" @bind-Value="Replacement!.CalibrationDueDate" />
                </FormField>
                <div class="field field-action"><button type="submit" class="button">Tausch erfassen</button></div>
            </EditForm>
            <p class="small">Der Verbrauch wird über alten und neuen Zähler durchgängig berechnet.</p>
        </details>
    </section>

    <section>
        <details class="disclosure">
            <summary>Angaben ändern</summary>
            <EditForm Model="Data" FormName="data" OnValidSubmit="SaveDataAsync">
                <DataAnnotationsValidator />
                <MeterFields Data="Data!" Units="units" MainMeter="mainMeter" TypeLocked="true" />
                <button type="submit" class="button button-primary">Speichern</button>
            </EditForm>
        </details>
    </section>
}

<ChangeHistory EntityType="Zaehler" EntityId="Id" />

@code {
    private MeterDetails? meter;
    private IReadOnlyList<UnitRow> units = [];
    private IReadOnlyList<MeterRow> mainMeter = [];
    private IReadOnlyList<string>? errors;
    private IReadOnlyList<string>? warnings;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "entry")]
    private ReadingInput? Entry { get; set; }

    [SupplyParameterFromForm(FormName = "entry")]
    private IFormFile? Photo { get; set; }

    /// <summary>When confirming after warnings: do not upload the already saved photo again.</summary>
    [SupplyParameterFromForm(FormName = "entry")]
    private Guid? PhotoId { get; set; }

    [SupplyParameterFromForm(FormName = "entry-remove")]
    private Guid? RemoveReadingId { get; set; }

    [SupplyParameterFromForm(FormName = "replacement")]
    private ReplacementInput? Replacement { get; set; }

    [SupplyParameterFromForm(FormName = "data")]
    private MeterInput? Data { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var form = Data;
        Entry ??= new() { Date = MietHahn.Domain.Common.GermanTime.Today(Clock.GetUtcNow()) };
        Replacement ??= new();
        Data ??= new();
        meter = await Admin.GetAsync(Id);
        if (meter is not null)
        {
            Data = form ?? meter.Data;
            units = (await Properties.GetAsync(meter.PropertyId))?.Units ?? [];
            mainMeter = (await Admin.ListAsync(meter.PropertyId)).Where(z => z.Id != Id).ToList();
        }
    }

    private async Task RecordReadingAsync()
    {
        if (Photo is { Length: > 0 } && PhotoId is null)
        {
            try
            {
                await using var content = Photo.OpenReadStream();
                PhotoId = (await Storage.SaveAsync(content, Photo.FileName)).Id;
            }
            catch (FileRejectedException ex)
            {
                errors = [ex.Message];
                return;
            }
        }

        var result = await Admin.RecordReadingAsync(Id, Entry!, PhotoId);
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage($"/verwaltung/zaehler/{Id}", "Der Zählerstand wurde gespeichert.", HttpContext);
        }
        else if (result.NeedsConfirmation)
        {
            warnings = result.Warnings;
        }
        else
        {
            errors = result.Errors;
        }
    }

    private Task RemoveReadingAsync() =>
        RemoveReadingId is { } entry ? ExecuteAsync(Admin.RemoveReadingAsync(Id, entry), $"/verwaltung/zaehler/{Id}", "Der Stand wurde entfernt.") : Task.CompletedTask;

    private async Task ReplaceAsync()
    {
        var result = await Admin.ReplaceAsync(Id, Replacement!);
        await ExecuteAsync(Task.FromResult(result), $"/verwaltung/zaehler/{result.Id}", "Der Zähler wurde getauscht. Das ist der neue Zähler.");
    }

    private Task SaveDataAsync() => ExecuteAsync(Admin.UpdateAsync(Id, Data!), $"/verwaltung/zaehler/{Id}", "Die Angaben wurden gespeichert.");

    private async Task ExecuteAsync(Task<Result> command, string destination, string success)
    {
        var result = await command;
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage(destination, success, HttpContext);
        }
        else
        {
            errors = result.Errors;
            meter = await Admin.GetAsync(Id);
        }
    }
}
