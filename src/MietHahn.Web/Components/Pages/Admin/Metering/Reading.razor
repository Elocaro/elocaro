@page "/verwaltung/objekte/{PropertyId:guid}/ablesung"
@using System.Globalization
@inject IMeterService Admin
@inject IPropertyService Properties
@inject IFileStore Storage
@inject Redirector Redirector
@inject TimeProvider Clock

@if (property is null)
{
    <PageHeader Title="Objekt nicht gefunden" Back="/verwaltung/objekte" BackText="Alle Objekte" />
    return;
}

<PageHeader Title="Ablese-Runde" Subtitle="@($"{property.Data.Name} · {Format.Date(ReferenceDate)}{(TypeValue == ReadingType.InterimReading ? " · Zwischenablesung" : "")}")"
            Back="@($"/verwaltung/objekte/{PropertyId}/zaehler")" BackText="Alle Zähler" />

<StatusMessage />
<ErrorList Errors="errors" />

@if (round.Count == 0)
{
    <EmptyState Text="Keine aktiven Zähler für diese Runde." />
    return;
}

@if (Step >= round.Count)
{
    <p class="message message-ok" role="status">Runde abgeschlossen: @round.Count(z => z.LastReading?.Date == ReferenceDate) von @round.Count Zählern erfasst.</p>
    <ul class="todos">
        @foreach (var z in round)
        {
            <li class="todo @(z.LastReading?.Date == ReferenceDate ? "" : "todo-soon")">
                <a href="/verwaltung/zaehler/@z.Id">@z.Name</a> <span class="small">@z.Assignment · @z.Number</span>
                <p class="small">@(z.LastReading?.Date == ReferenceDate ? $"{Format.Quantity(z.LastReading.Value, Labels.From(z.MeasurementUnit))}" : "nicht erfasst")</p>
            </li>
        }
    </ul>
    <p><a class="button" href="@Link(0)">Runde erneut durchgehen</a></p>
    return;
}

@{
    var meter = round[Step];
    var recorded = meter.LastReading?.Date == ReferenceDate;
}

<p class="small" aria-live="polite">Zähler @(Step + 1) von @round.Count</p>
<progress class="progress" max="@round.Count" value="@Step">@(Step + 1) von @round.Count</progress>

<div class="reading-card">
    <h2>@meter.Name</h2>
    <p>@Labels.From(meter.Type) · <strong>Nr. @meter.Number</strong></p>
    <p class="small">@meter.Assignment@(meter.Location is null ? "" : " · " + meter.Location)</p>
    @if (meter.LastReading is { } lastReading)
    {
        <p class="small">Letzter Stand: @Format.Quantity(lastReading.Value, Labels.From(meter.MeasurementUnit)) am @Format.Date(lastReading.Date)</p>
    }
</div>

@if (recorded)
{
    <p class="message message-ok">Für diesen Tag bereits erfasst.</p>
    <a class="button button-primary" href="@Link(Step + 1)">Weiter</a>
    return;
}

@if (warnings is { Count: > 0 })
{
    <div class="message message-info" role="alert">
        <ul>
            @foreach (var w in warnings)
            {
                <li>@w</li>
            }
        </ul>
    </div>
}

<EditForm Model="Entry" FormName="reading" OnValidSubmit="SaveAsync" enctype="multipart/form-data">
    <DataAnnotationsValidator />
    <FormField Id="reading-value" Label="@($"Zählerstand ({Labels.From(meter.MeasurementUnit)})")" For="() => Entry!.Value" Required="true">
        <InputArea id="reading-value" class="input-large" @bind-Value="Entry!.Value" step="0.001" autofocus />
    </FormField>
    <div class="field">
        <label for="reading-photo">Foto vom Zähler</label>
        <input type="file" id="reading-photo" name="Photo" accept="image/*" capture="environment" />
    </div>
    <input type="hidden" name="Entry.Date" value="@ReferenceDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
    <input type="hidden" name="Entry.Kind" value="@TypeValue" />
    @if (warnings is { Count: > 0 })
    {
        <input type="hidden" name="Entry.Confirmed" value="true" />
        <input type="hidden" name="PhotoId" value="@PhotoId" />
    }
    <div class="form-row">
        <button type="submit" class="button button-primary">@(warnings is { Count: > 0 } ? "Trotzdem speichern & weiter" : "Speichern & weiter")</button>
        <a class="button" href="@Link(Step + 1)">Überspringen</a>
    </div>
</EditForm>

@code {
    private PropertyDetails? property;
    private IReadOnlyList<MeterRow> round = [];
    private IReadOnlyList<string>? errors;
    private IReadOnlyList<string>? warnings;

    [Parameter]
    public Guid PropertyId { get; set; }

    [SupplyParameterFromQuery(Name = "schritt")]
    private int Step { get; set; }

    [SupplyParameterFromQuery(Name = "einheit")]
    private Guid? Unit { get; set; }

    [SupplyParameterFromQuery(Name = "datum")]
    private DateOnly? Date { get; set; }

    [SupplyParameterFromQuery(Name = "art")]
    private string? Kind { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "reading")]
    private ReadingInput? Entry { get; set; }

    [SupplyParameterFromForm(FormName = "reading")]
    private IFormFile? Photo { get; set; }

    [SupplyParameterFromForm(FormName = "reading")]
    private Guid? PhotoId { get; set; }

    private DateOnly ReferenceDate => Date ?? MietHahn.Domain.Common.GermanTime.Today(Clock.GetUtcNow());

    private ReadingType TypeValue => Enum.TryParse<ReadingType>(Kind, out var kind) && kind is ReadingType.InterimReading or ReadingType.Estimate ? kind : ReadingType.Reading;

    protected override async Task OnInitializedAsync()
    {
        Entry ??= new();
        property = await Properties.GetAsync(PropertyId);
        if (property is not null)
        {
            round = await Admin.RoundAsync(PropertyId, Unit);
            Step = Math.Clamp(Step, 0, round.Count);
        }
    }

    private async Task SaveAsync()
    {
        if (Photo is { Length: > 0 } && PhotoId is null)
        {
            try
            {
                await using var content = Photo.OpenReadStream();
                PhotoId = (await Storage.SaveAsync(content, Photo.FileName)).Id;
            }
            catch (FileRejectedException ex)
            {
                errors = [ex.Message];
                return;
            }
        }

        var result = await Admin.RecordReadingAsync(round[Step].Id, Entry!, PhotoId);
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage(Link(Step + 1), $"{round[Step].Name}: gespeichert.", HttpContext);
        }
        else if (result.NeedsConfirmation)
        {
            warnings = result.Warnings;
        }
        else
        {
            errors = result.Errors;
        }
    }

    private string Link(int step)
    {
        var parts = new List<string> { $"schritt={step}" };
        if (Unit is { } unit)
        {
            parts.Add($"einheit={unit}");
        }

        if (Date is { } date)
        {
            parts.Add($"datum={date:yyyy-MM-dd}");
        }

        if (TypeValue != ReadingType.Reading)
        {
            parts.Add($"art={TypeValue}");
        }

        return $"/verwaltung/objekte/{PropertyId}/ablesung?{string.Join('&', parts)}";
    }
}
