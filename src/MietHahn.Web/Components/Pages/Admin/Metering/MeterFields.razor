@* Master data of a meter; sits inside an EditForm with Model = Data (field names Data.*). *@
<div class="form-grid">
    <FormField Id="meter-type" Label="Art" For="() => Data.Type" Hint="@(TypeLocked ? "Nicht änderbar; bei einem anderen Zähler einen neuen anlegen." : null)">
        @if (TypeLocked)
        {
            @* Locked fields would not be submitted: value as a hidden field, display read-only. *@
            <input type="hidden" name="Data.Type" value="@Data.Type" />
            <input id="meter-type" type="text" value="@Labels.From(Data.Type)" readonly />
        }
        else
        {
            <InputSelect id="meter-type" @bind-Value="Data.Type">
                @foreach (var value in Enum.GetValues<MeterType>())
                {
                    <option value="@value">@Labels.From(value)</option>
                }
            </InputSelect>
        }
    </FormField>
    <FormField Id="meter-designation" Label="Bezeichnung" For="() => Data.Name" Required="true" Hint="z. B. „Kaltwasser Bad“">
        <InputText id="meter-designation" @bind-Value="Data.Name" />
    </FormField>
    <FormField Id="meter-number" Label="Zählernummer" For="() => Data.Number" Required="true">
        <InputText id="meter-number" @bind-Value="Data.Number" autocomplete="off" />
    </FormField>
    <FormField Id="meter-assignment" Label="Zuordnung" For="() => Data.AssignmentId">
        <InputSelect id="meter-assignment" @bind-Value="Data.AssignmentId">
            <option value="">Haus (Haupt-/Allgemeinzähler)</option>
            @foreach (var unit in Units)
            {
                <option value="@unit.Id">@unit.Name</option>
                @foreach (var room in unit.RentalUnits.Where(m => m.IsRoom))
                {
                    <option value="@room.Id">@unit.Name, @room.Name</option>
                }
            }
        </InputSelect>
    </FormField>
    <FormField Id="meter-main" Label="Hauptzähler" For="() => Data.MainMeterId" Hint="Für die Differenz Haupt- zu Unterzählern">
        <InputSelect id="meter-main" @bind-Value="Data.MainMeterId">
            <option value="">– keiner –</option>
            @foreach (var z in MainMeter)
            {
                <option value="@z.Id">@z.Name (@z.Number)</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="meter-location" Label="Lage" For="() => Data.Location" Hint="z. B. „Keller, Raum 2“">
        <InputText id="meter-location" @bind-Value="Data.Location" />
    </FormField>
    <FormField Id="meter-calibration-deadline" Label="Eichfrist bis" For="() => Data.CalibrationDueDate" Hint="Leer = gesetzliche Frist ab Einbau">
        <InputDate id="meter-calibration-deadline" @bind-Value="Data.CalibrationDueDate" />
    </FormField>
    <FormField Id="meter-order" Label="Reihenfolge der Ablesung" For="() => Data.Order">
        <InputNumber id="meter-order" @bind-Value="Data.Order" min="0" max="999" />
    </FormField>
</div>

@code {
    [Parameter, EditorRequired]
    public MeterInput Data { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<UnitRow> Units { get; set; } = [];

    [Parameter]
    public IReadOnlyList<MeterRow> MainMeter { get; set; } = [];

    [Parameter]
    public bool TypeLocked { get; set; }
}
