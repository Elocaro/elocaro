@using MietHahn.Application.Properties
@* Fields of a bank account for interactive pages; sits inside an EditForm with Model = Data. *@
<div class="form-grid">
    <AppTextField @bind-Value="Data.Name" Label="Name" Required="true" Hint="z. B. „Mietkonto Lindenweg“" />
    <AppTextField @bind-Value="Data.Iban" Label="IBAN" Required="true" />
    <AppTextField @bind-Value="Data.Bic" Label="BIC" />
    <AppTextField @bind-Value="Data.Bank" Label="Bank" />
    <AppSelect @bind-Value="Data.Type" Label="Art" Items="Enum.GetValues<AccountType>()" Text="@(v => Labels.From(v))" />
</div>
<details class="field" open="@(Data.FinTsUrl is not null)">
    <summary>Direktabruf per FinTS (optional)</summary>
    <p class="small">Zugangsdaten der Bank für den Umsatzabruf. Die PIN wird nicht gespeichert, sondern bei jedem Abruf eingegeben. Die Benutzerkennung wird verschlüsselt abgelegt. Alle drei Felder ausfüllen oder alle leer lassen.</p>
    <div class="form-grid">
        <AppTextField @bind-Value="Data.FinTsUrl" Label="FinTS-URL" Hint="beginnt mit https://, steht in der Hilfe der Bank" />
        <AppTextField @bind-Value="Data.FinTsBankCode" Label="Bankleitzahl" Hint="8 Ziffern" />
        <AppTextField @bind-Value="Data.FinTsUserId" Label="Benutzerkennung" Hint="Login-Name bzw. VR-NetKey / Anmeldename im Onlinebanking" Autocomplete="off" />
    </div>
</details>
@if (Properties.Count > 0)
{
    <fieldset class="field">
        <legend>Objekte (leer = alle)</legend>
        @foreach (var property in Properties)
        {
            <AppCheckBox Value="Data.PropertyIds?.Contains(property.Id) == true" ValueChanged="@(on => Toggle(property.Id, on))" Label="@property.Name" />
        }
    </fieldset>
}

@code {
    [Parameter, EditorRequired]
    public BankAccountInput Data { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<PropertyOverview> Properties { get; set; } = [];

    private void Toggle(Guid id, bool on)
    {
        var ids = Data.PropertyIds?.ToList() ?? [];
        if (on && !ids.Contains(id))
        {
            ids.Add(id);
        }
        else if (!on)
        {
            ids.Remove(id);
        }

        Data.PropertyIds = ids;
    }
}
