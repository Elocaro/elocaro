@using MietHahn.Application.Properties
@* Input fields of a bank account; sits inside an EditForm with Model = Data. *@
<div class="form-grid">
    <FormField Id="account-name" Label="Name" For="() => Data.Name" Required="true" Hint="z. B. „Mietkonto Lindenweg“">
        <InputText id="account-name" @bind-Value="Data.Name" />
    </FormField>
    <FormField Id="account-iban" Label="IBAN" For="() => Data.Iban" Required="true">
        <InputText id="account-iban" @bind-Value="Data.Iban" autocomplete="off" />
    </FormField>
    <FormField Id="account-bic" Label="BIC" For="() => Data.Bic">
        <InputText id="account-bic" @bind-Value="Data.Bic" />
    </FormField>
    <FormField Id="account-bank" Label="Bank" For="() => Data.Bank">
        <InputText id="account-bank" @bind-Value="Data.Bank" />
    </FormField>
    <FormField Id="account-type" Label="Art" For="() => Data.Type">
        <InputSelect id="account-type" @bind-Value="Data.Type">
            @foreach (var value in Enum.GetValues<AccountType>())
            {
                <option value="@value">@Labels.From(value)</option>
            }
        </InputSelect>
    </FormField>
</div>
@if (Properties.Count > 0)
{
    <fieldset class="field">
        <legend>Objekte (leer = alle)</legend>
        @foreach (var property in Properties)
        {
            <div class="field field-checkbox">
                <input type="checkbox" id="account-property-@property.Id" name="Data.PropertyIds" value="@property.Id" checked="@(Data.PropertyIds?.Contains(property.Id) == true)" />
                <label for="account-property-@property.Id">@property.Name</label>
            </div>
        }
    </fieldset>
}

@code {
    [Parameter, EditorRequired]
    public BankAccountInput Data { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<PropertyOverview> Properties { get; set; } = [];
}
