@page "/verwaltung/bank/konten/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor
@using MietHahn.Application.Properties
@inject IBankService Bank
@inject IPropertyService PropertyService
@inject NavigationManager Navigation
@inject Notifier Notify
@inject IDialogService Dialogs

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (account is null)
{
    <PageHeader Title="Konto nicht gefunden" Back="/verwaltung/bank/konten" BackText="Alle Konten" />
}
else
{

<PageHeader Title="@account.Name" Subtitle="@account.Iban" Back="/verwaltung/bank/konten" BackText="Alle Konten">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="@($"/verwaltung/bank/umsaetze?konto={Id}")">Umsätze</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="EditAsync" StartIcon="@Icons.Material.Outlined.Edit">Bearbeiten</MudButton>
    </Actions>
</PageHeader>

<ErrorList Errors="errors" />

<MudTabs Elevation="0" Rounded="false" TabPanelsClass="mt-4" Class="detail-tabs" KeepPanelsAlive="true">
    <MudTabPanel Text="Import">
<section>
    <h2>Kontoauszug importieren</h2>
    <div class="form-grid">
        <div>
            <AppFileUpload Text="Datei auswählen *" Accept=".xml,.sta,.mt940,.940,.txt,.csv" OnSelected="OnFileSelected" />
            <p class="small">camt.053 (XML), MT940 oder CSV. Das Format wird erkannt; schon vorhandene Umsätze werden übersprungen.</p>
        </div>
        <AppSelect T="string" @bind-Value="profile" Label="CSV-Profil" Items="profileNames" EmptyText="automatisch erkennen" />
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UploadAsync">Vorschau anzeigen</MudButton>
</section>

<FinTsFetch BankAccountId="Id" Enabled="@(account.FinTsUrl is not null && account.FinTsBankCode is not null && account.FinTsUserId is not null)" />
    </MudTabPanel>
    <MudTabPanel Text="Importprotokoll">
<section>
    <h2>Importprotokoll</h2>
    @if (imports is { Count: 0 })
    {
        <EmptyState Compact="true" Text="Noch keine Importe." />
    }
    else if (imports is not null)
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Zeitpunkt</th><th>Datei</th><th>Zeitraum</th><th class="number">Umsätze</th><th class="number">neu</th><th class="number">Duplikate</th></tr></thead>
                <tbody>
                    @foreach (var import in imports)
                    {
                        <tr>
                            <td>@Format.Timestamp(import.Timestamp)<span class="small">&#32;@import.CreatedBy</span></td>
                            <td>
                                @if (import.Status == ImportStatus.Preview)
                                {
                                    <a href="/verwaltung/bank/importe/@import.Id">@import.FileName</a> <StatusChip Level="StatusLevel.Warning">Vorschau</StatusChip>
                                }
                                else
                                {
                                    @import.FileName
                                }
                                <span class="small">&#32;@Labels.From(import.Format)@(import.Profile is null ? "" : $" ({import.Profile})")</span>
                            </td>
                            <td>@(import.From is null ? "–" : $"{Format.Date(import.From)} – {Format.Date(import.To)}")</td>
                            <td class="number">@import.Read</td>
                            <td class="number">@import.Added</td>
                            <td class="number">@import.Duplicates</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

    </MudTabPanel>
</MudTabs>
}
</InteractiveShell>

@code {
    private BankAccountInput? account;
    private BankAccountInput data = new();
    private IReadOnlyList<ImportRow>? imports;
    private IReadOnlyList<string> profileNames = [];
    private IReadOnlyList<PropertyOverview> properties = [];
    private IReadOnlyList<string>? errors;
    private FileSelection? file;
    private string? profile;
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        account = await Bank.GetAccountAsync(Id);
        if (account is not null)
        {
            data = account;
            imports = await Bank.ImportsAsync(Id);
            profileNames = (await Bank.CsvProfilesAsync()).Select(p => p.Name).ToList();
            properties = await PropertyService.ListAsync(null);
        }

        loaded = true;
    }

    private void OnFileSelected(FileSelection selection) => file = selection;

    private async Task UploadAsync()
    {
        if (file is null || file.Length == 0)
        {
            errors = ["Bitte eine Datei auswählen."];
            return;
        }

        using var buffer = new MemoryStream();
        await using (var content = file.Open())
        {
            await content.CopyToAsync(buffer);
        }

        var result = await Bank.CreatePreviewAsync(Id, file.Name, buffer.ToArray(), string.IsNullOrEmpty(profile) ? null : profile);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"/verwaltung/bank/importe/{result.Id}");
        }
        else
        {
            errors = result.Errors;
        }
    }

    // "Bearbeiten" opens the data of the account in a dialog.
    private async Task EditAsync()
    {
        RenderFragment fields = @<AccountEditor Data="data" Properties="properties" />;
        if (await Dialogs.ShowFormAsync("Bankkonto bearbeiten", data, fields, () => Bank.UpdateAccountAsync(Id, data)))
        {
            Notify.Success("Die Angaben wurden gespeichert.");
        }

        account = await Bank.GetAccountAsync(Id); // after cancelling, too: drops the unsaved changes of the shared model
        data = account!;
    }
}
