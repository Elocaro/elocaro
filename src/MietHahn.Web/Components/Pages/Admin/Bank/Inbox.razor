@page "/verwaltung/bank/zuordnung"
@rendermode InteractiveServer
@using MudBlazor
@inject IPaymentAssignment Assignment
@inject IBankService Bank
@inject Notifier Notify

<InteractiveShell>
    <PageHeader Title="Umsätze zuordnen" Subtitle="Unzugeordnete Umsätze mit Vorschlag: bestätigen, ändern oder aufteilen, ignorieren." Back="/verwaltung/bank/umsaetze" BackText="Alle Umsätze">
        <Actions>
            <MudButton Variant="Variant.Outlined" Href="/verwaltung/bank/regeln">Regeln</MudButton>
        </Actions>
    </PageHeader>

    <ErrorList Errors="errors" />

    <div class="form-row search-bar" role="search">
        <AppSelect T="Guid?" Value="accountId" ValueChanged="OnAccountChanged" Label="Konto" Items="accountIds" Text="AccountText" EmptyText="Alle Konten" />
    </div>

    @if (rows is { Count: 0 })
    {
        <EmptyState Text="Alle Umsätze sind zugeordnet." />
    }
    else if (rows is not null)
    {
        <p class="small">@rows.Count offene Umsätze · @rows.Count(r => r.Suggestion is not null) mit Vorschlag</p>
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Buchung</th><th>Gegenseite und Verwendungszweck</th><th class="number">Betrag</th><th>Vorschlag</th><th>Aktion</th></tr></thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        var u = row.Transaction;
                        <tr>
                            <td>@Format.Date(u.BookingDate)</td>
                            <td>
                                @u.CounterpartyName<span class="small"> @u.CounterpartyIban</span>
                                <br /><span class="small">@u.Purpose</span>
                            </td>
                            <td class="number">@Format.Money(u.Amount)</td>
                            <td>
                                @if (row.Suggestion is { } s)
                                {
                                    <strong>@s.Target</strong>
                                    <StatusChip Level="@(s.Score >= 70 ? StatusLevel.Success : StatusLevel.Warning)">@s.Score % (@s.Confidence)</StatusChip>
                                    <br /><span class="small">@string.Join(" · ", s.Reasons)</span>
                                    @if (s.Parts.Count > 1)
                                    {
                                        <br /><span class="small">@s.Parts.Count Teilbeträge</span>
                                    }
                                    @if (row.Alternatives > 0)
                                    {
                                        <br /><span class="small">+ @row.Alternatives weitere Vorschläge</span>
                                    }
                                }
                                else
                                {
                                    <span class="small">kein Vorschlag</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    @if (row.Suggestion is not null)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => AcceptAsync(u)" aria-label="@($"Vorschlag für den Umsatz vom {Format.Date(u.BookingDate)} über {Format.Money(u.Amount)} bestätigen")">Bestätigen</MudButton>
                                    }
                                    <MudButton Variant="Variant.Outlined" Href="@($"/verwaltung/bank/umsaetze/{u.Id}/zuordnen")" aria-label="@($"Umsatz vom {Format.Date(u.BookingDate)} über {Format.Money(u.Amount)} ändern oder aufteilen")">Ändern / Aufteilen</MudButton>
                                    <MudButton Variant="Variant.Outlined" OnClick="() => IgnoreAsync(u)" aria-label="@($"Umsatz vom {Format.Date(u.BookingDate)} über {Format.Money(u.Amount)} ignorieren")">Ignorieren</MudButton>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <AppTextField @bind-Value="ignoreNote" Label="Notiz beim Ignorieren (optional)" Placeholder="z. B. privat, Umbuchung" />
    }
</InteractiveShell>

@code {
    private IReadOnlyList<BankAccountRow> accounts = [];
    private IReadOnlyList<Guid?> accountIds = [];
    private IReadOnlyList<InboxRow>? rows;
    private IReadOnlyList<string>? errors;
    private Guid? accountId;
    private string? ignoreNote;

    // The query string only provides the start value (see ADR 0005).
    [SupplyParameterFromQuery(Name = "konto")]
    private Guid? InitialAccount { get; set; }

    protected override async Task OnInitializedAsync()
    {
        accounts = await Bank.AccountsAsync();
        accountIds = accounts.Select(a => (Guid?)a.Id).ToList();
        accountId = InitialAccount;
        await LoadAsync();
    }

    private string AccountText(Guid? id) => accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "";

    private async Task OnAccountChanged(Guid? value)
    {
        accountId = value;
        await LoadAsync();
    }

    private async Task LoadAsync() => rows = await Assignment.InboxAsync(accountId);

    private async Task AcceptAsync(TransactionRow transaction) => await ChangeAsync(await Assignment.AcceptAsync(transaction.Id, 0), "Der Vorschlag wurde übernommen.");

    private async Task IgnoreAsync(TransactionRow transaction) => await ChangeAsync(await Bank.IgnoreAsync(transaction.Id, ignoreNote), "Der Umsatz wird ignoriert.");

    private async Task ChangeAsync(Result result, string success)
    {
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success(success);
            await LoadAsync();
        }
    }
}
