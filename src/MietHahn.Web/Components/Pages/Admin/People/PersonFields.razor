@* Input fields of a person; sits inside an EditForm with Model = Data. *@
<div class="form-grid">
    <FormField Id="salutation" Label="Anrede" For="() => Data.Salutation">
        <InputSelect id="salutation" @bind-Value="Data.Salutation">
            @foreach (var value in Enum.GetValues<Salutation>())
            {
                <option value="@value">@Labels.From(value)</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="title" Label="Titel" For="() => Data.Title">
        <InputText id="title" @bind-Value="Data.Title" autocomplete="honorific-prefix" />
    </FormField>
    <FormField Id="first-name" Label="Vorname" For="() => Data.FirstName">
        <InputText id="first-name" @bind-Value="Data.FirstName" autocomplete="off" />
    </FormField>
    <FormField Id="last-name" Label="Nachname bzw. Name" For="() => Data.LastName" Required="true">
        <InputText id="last-name" @bind-Value="Data.LastName" autocomplete="off" />
    </FormField>
    <FormField Id="company" Label="Firma" For="() => Data.Company">
        <InputText id="company" @bind-Value="Data.Company" autocomplete="off" />
    </FormField>
    <FormField Id="contact-type" Label="Kontaktart" For="() => Data.ContactType" Hint="Für Mieter und Bürgen „privat“ lassen.">
        <InputSelect id="contact-type" @bind-Value="Data.ContactType">
            @foreach (var value in Enum.GetValues<ContactType>())
            {
                <option value="@value">@Labels.From(value)</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="activity" Label="Gewerk / Sparte" For="() => Data.Occupation" Hint="z. B. „Sanitär“ oder „Wasser“">
        <InputText id="activity" @bind-Value="Data.Occupation" />
    </FormField>
    <FormField Id="email" Label="E-Mail" For="() => Data.Email">
        <InputText id="email" type="email" @bind-Value="Data.Email" autocomplete="off" />
    </FormField>
    <FormField Id="phone" Label="Telefon" For="() => Data.Phone">
        <InputText id="phone" type="tel" @bind-Value="Data.Phone" autocomplete="off" />
    </FormField>
    <FormField Id="mobile" Label="Mobil" For="() => Data.Mobile">
        <InputText id="mobile" type="tel" @bind-Value="Data.Mobile" autocomplete="off" />
    </FormField>
    <FormField Id="birth-date" Label="Geburtsdatum" For="() => Data.DateOfBirth" Hint="Nur wenn nötig (Datensparsamkeit).">
        <InputDate id="birth-date" @bind-Value="Data.DateOfBirth" />
    </FormField>
</div>
<FormField Id="notes" Label="Notizen" For="() => Data.Notes">
    <InputTextArea id="notes" @bind-Value="Data.Notes" rows="3" />
</FormField>

@code {
    [Parameter, EditorRequired]
    public PersonInput Data { get; set; } = default!;
}
