@page "/verwaltung/personen/{Id:guid}/bearbeiten"
@rendermode InteractiveServer
@using MudBlazor
@inject IPersonService Admin
@inject NavigationManager Navigation

<InteractiveShell>
    @if (loaded && person is null)
    {
        <PageHeader Title="Person nicht gefunden" Back="/verwaltung/personen" BackText="Alle Personen" />
    }
    else if (person is not null && data is not null)
    {
        <PageHeader Title="@($"{person.DisplayName} bearbeiten")" Back="@($"/verwaltung/personen/{Id}")" BackText="Zur Person" />

        <ErrorList Errors="errors" />

        <EditForm Model="data" OnValidSubmit="SaveAsync" novalidate>
            <DataAnnotationsValidator />
            <PersonEditor Data="data" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
        </EditForm>
    }
</InteractiveShell>

@code {
    private PersonDetails? person;
    private PersonInput? data;
    private IReadOnlyList<string>? errors;
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        person = await Admin.GetAsync(Id);
        data = person?.Data;
        loaded = true;
    }

    private async Task SaveAsync()
    {
        var result = await Admin.UpdateAsync(Id, data!);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"/verwaltung/personen/{Id}?meldung=gespeichert");
        }
        else
        {
            errors = result.Errors;
        }
    }
}
