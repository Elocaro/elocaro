@page "/verwaltung/personen/neu"
@rendermode InteractiveServer
@using MudBlazor
@inject IPersonService Admin
@inject NavigationManager Navigation
@inject TimeProvider Clock

<InteractiveShell>
    <PageHeader Title="Person anlegen" Subtitle="Mieter, Bürgen oder Kontakte wie Handwerker und Hausmeister. Pflicht ist nur der Name; Anschrift und Weiteres können später ergänzt werden." Back="/verwaltung/personen" BackText="Alle Personen" />

    <ErrorList Errors="errors" />

    <EditForm Model="data" OnValidSubmit="CreateAsync" novalidate>
        <DataAnnotationsValidator />
        <PersonEditor Data="data" Address="address" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Person anlegen</MudButton>
    </EditForm>
</InteractiveShell>

@code {
    private readonly PersonInput data = new();
    private readonly AddressInput address = new();
    private IReadOnlyList<string>? errors;

    private async Task CreateAsync()
    {
        var withAddress = !string.IsNullOrWhiteSpace(address.Street);
        if (withAddress && (string.IsNullOrWhiteSpace(address.PostalCode) || string.IsNullOrWhiteSpace(address.City)))
        {
            errors = ["Bitte zur Straße auch PLZ und Ort angeben."];
            return;
        }

        address.From ??= MietHahn.Domain.Common.GermanTime.Today(Clock.GetUtcNow());
        var result = await Admin.CreateAsync(data, withAddress ? address : null);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"/verwaltung/personen/{result.Id}?meldung=angelegt");
        }
        else
        {
            errors = result.Errors;
        }
    }
}
