@* Address as of a reference date; sits inside an EditForm with Model = Address. *@
<div class="form-grid">
    @if (WithReferenceDate)
    {
        <FormField Id="address-valid-from" Label="Gültig ab" For="() => Address.From" Required="true" Hint="Umzugsdatum">
            <InputDate id="address-valid-from" @bind-Value="Address.From" />
        </FormField>
    }
    <FormField Id="address-street" Label="Straße und Hausnummer" For="() => Address.Street" Required="@WithReferenceDate">
        <InputText id="address-street" @bind-Value="Address.Street" autocomplete="off" />
    </FormField>
    <FormField Id="address-postal-code" Label="PLZ" For="() => Address.PostalCode" Required="@WithReferenceDate">
        <InputText id="address-postal-code" @bind-Value="Address.PostalCode" inputmode="numeric" autocomplete="off" />
    </FormField>
    <FormField Id="address-city" Label="Ort" For="() => Address.City" Required="@WithReferenceDate">
        <InputText id="address-city" @bind-Value="Address.City" autocomplete="off" />
    </FormField>
    <FormField Id="address-supplement" Label="Zusatz" For="() => Address.AddressLine2" Hint="z. B. „c/o Müller“">
        <InputText id="address-supplement" @bind-Value="Address.AddressLine2" autocomplete="off" />
    </FormField>
    <FormField Id="address-country" Label="Land" For="() => Address.Country" Hint="Leer = Deutschland">
        <InputText id="address-country" @bind-Value="Address.Country" autocomplete="off" />
    </FormField>
</div>

@code {
    [Parameter, EditorRequired]
    public AddressInput Address { get; set; } = default!;

    [Parameter]
    public bool WithReferenceDate { get; set; } = true;
}
