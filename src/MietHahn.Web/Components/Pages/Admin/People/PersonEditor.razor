@using MudBlazor
@* Fields of a person (and optionally the address) for interactive pages and dialogs; sits inside an EditForm with Model = Data.
   Address = null: no address section (editing). The interactive counterpart of PersonFields/AddressFields. *@
<div class="form-grid">
    <MudSelect ShrinkLabel="true" T="Salutation" @bind-Value="Data.Salutation" For="() => Data.Salutation" Label="Anrede" Variant="Variant.Outlined">
        @foreach (var value in Enum.GetValues<Salutation>())
        {
            <MudSelectItem Value="value">@Labels.From(value)</MudSelectItem>
        }
    </MudSelect>
    <MudTextField ShrinkLabel="true" @bind-Value="Data.Title" For="() => Data.Title" Label="Titel" Variant="Variant.Outlined" autocomplete="honorific-prefix" />
    <MudTextField ShrinkLabel="true" @bind-Value="Data.FirstName" For="() => Data.FirstName" Label="Vorname" Variant="Variant.Outlined" autocomplete="off" />
    <MudTextField ShrinkLabel="true" @bind-Value="Data.LastName" For="() => Data.LastName" Label="Nachname bzw. Name" Required="true" Variant="Variant.Outlined" autocomplete="off" />
    <MudTextField ShrinkLabel="true" @bind-Value="Data.Company" For="() => Data.Company" Label="Firma" Variant="Variant.Outlined" autocomplete="off" />
    <MudSelect ShrinkLabel="true" T="ContactType" @bind-Value="Data.ContactType" For="() => Data.ContactType" Label="Kontaktart" HelperText="Für Mieter und Bürgen „privat“ lassen." Variant="Variant.Outlined">
        @foreach (var value in Enum.GetValues<ContactType>())
        {
            <MudSelectItem Value="value">@Labels.From(value)</MudSelectItem>
        }
    </MudSelect>
    <MudTextField ShrinkLabel="true" @bind-Value="Data.Occupation" For="() => Data.Occupation" Label="Gewerk / Sparte" HelperText="z. B. „Sanitär“ oder „Wasser“" Variant="Variant.Outlined" />
    <MudTextField ShrinkLabel="true" @bind-Value="Data.Email" For="() => Data.Email" Label="E-Mail" InputType="InputType.Email" Variant="Variant.Outlined" autocomplete="off" />
    <MudTextField ShrinkLabel="true" @bind-Value="Data.Phone" For="() => Data.Phone" Label="Telefon" InputType="InputType.Telephone" Variant="Variant.Outlined" autocomplete="off" />
    <MudTextField ShrinkLabel="true" @bind-Value="Data.Mobile" For="() => Data.Mobile" Label="Mobil" InputType="InputType.Telephone" Variant="Variant.Outlined" autocomplete="off" />
    <MudDatePicker ShrinkLabel="true" @bind-Date="BirthDate" Label="Geburtsdatum" HelperText="Nur wenn nötig (Datensparsamkeit)." Variant="Variant.Outlined" Editable="true" Clearable="true" Culture="@German" />
</div>
<MudTextField ShrinkLabel="true" @bind-Value="Data.Notes" For="() => Data.Notes" Label="Notizen" Lines="3" Variant="Variant.Outlined" />

@if (Address is not null)
{
    <h2>Anschrift</h2>
    <p class="small">Optional. Für Mieter die bisherige Anschrift (Voranschrift); beim Einzug wird sie fortgeschrieben.</p>
    <div class="form-grid">
        <MudTextField ShrinkLabel="true" @bind-Value="Address.Street" Label="Straße und Hausnummer" Variant="Variant.Outlined" autocomplete="off" />
        <MudTextField ShrinkLabel="true" @bind-Value="Address.PostalCode" Label="PLZ" InputMode="InputMode.numeric" Variant="Variant.Outlined" autocomplete="off" />
        <MudTextField ShrinkLabel="true" @bind-Value="Address.City" Label="Ort" Variant="Variant.Outlined" autocomplete="off" />
        <MudTextField ShrinkLabel="true" @bind-Value="Address.AddressLine2" Label="Zusatz" HelperText="z. B. „c/o Müller“" Variant="Variant.Outlined" autocomplete="off" />
        <MudTextField ShrinkLabel="true" @bind-Value="Address.Country" Label="Land" HelperText="Leer = Deutschland" Variant="Variant.Outlined" autocomplete="off" />
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo German = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    [Parameter, EditorRequired]
    public PersonInput Data { get; set; } = default!;

    [Parameter]
    public AddressInput? Address { get; set; }

    // The date picker works with DateTime; the input model with DateOnly.
    private DateTime? BirthDate
    {
        get => Data.DateOfBirth?.ToDateTime(TimeOnly.MinValue);
        set => Data.DateOfBirth = value is null ? null : DateOnly.FromDateTime(value.Value);
    }
}
