@page "/verwaltung/einstellungen/vermieter"
@rendermode InteractiveServer
@using MudBlazor
@using MietHahn.Application.Admin
@inject ILandlordProfileService Profile
@inject Notifier Notify

<InteractiveShell>
    <PageHeader Title="Vermieter" Subtitle="Absenderangaben für Briefkopf, Fußzeile und Zahlungshinweise in Dokumenten." />

    @if (newItem)
    {
        <Notice Level="NoticeLevel.Info">Noch kein Vermieterprofil hinterlegt – ohne diese Angaben können keine Dokumente erzeugt werden.</Notice>
    }

    @if (data is not null)
    {
        <EditForm Model="data" OnValidSubmit="SaveAsync" novalidate>
            <DataAnnotationsValidator />
            <div class="form-grid">
                <AppTextField @bind-Value="data.Name" Label="Name" Required="true" Autocomplete="name" />
                <AppTextField @bind-Value="data.AddressLine2" Label="Zusatz" Hint="z. B. „Hausverwaltung Hauptstraße 5“" />
                <AppTextField @bind-Value="data.Street" Label="Straße und Hausnummer" Required="true" Autocomplete="street-address" />
                <AppTextField @bind-Value="data.PostalCode" Label="PLZ" Required="true" Autocomplete="postal-code" />
                <AppTextField @bind-Value="data.City" Label="Ort" Required="true" Autocomplete="address-level2" />
                <AppTextField @bind-Value="data.Phone" Label="Telefon" Type="tel" Autocomplete="tel" />
                <AppTextField @bind-Value="data.Email" Label="E-Mail" Type="email" Autocomplete="email" />
            </div>

            <h2>Bankverbindung &amp; Steuer</h2>
            <div class="form-grid">
                <AppTextField @bind-Value="data.Iban" Label="IBAN" Hint="Erscheint in der Fußzeile und in Zahlungsaufforderungen." />
                <AppTextField @bind-Value="data.Bic" Label="BIC" />
                <AppTextField @bind-Value="data.Bank" Label="Bank" />
                <AppTextField @bind-Value="data.TaxNumber" Label="Steuernummer" />
            </div>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
        </EditForm>
    }
</InteractiveShell>

@code {
    private bool newItem;
    private LandlordProfileInput? data;

    protected override async Task OnInitializedAsync()
    {
        var loaded = await Profile.GetAsync();
        newItem = loaded is null;
        data = loaded ?? new();
    }

    private async Task SaveAsync()
    {
        await Profile.SaveAsync(data!);
        newItem = false;
        Notify.Success("Die Vermieterangaben wurden gespeichert.");
    }
}
