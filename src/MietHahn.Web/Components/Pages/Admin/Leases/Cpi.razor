@page "/verwaltung/vpi"
@rendermode InteractiveServer
@using MudBlazor
@inject ICpiService Admin
@inject Notifier Notify

<InteractiveShell>
    <PageHeader Title="Verbraucherpreisindex" Subtitle="Monatswerte für Indexmieten (Destatis, Basis 2020 = 100, Tabelle 61111-0002)." />

    <ErrorList Errors="errors" />

    <section>
        <h2>Wert erfassen</h2>
        <EditForm Model="input" OnValidSubmit="SaveAsync" novalidate class="form-row">
            <DataAnnotationsValidator />
            <AppMonthField @bind-Value="input.Month" Label="Monat" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="input.Value" Label="Indexwert" Required="true" Hint="z. B. 121,7" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
        </EditForm>
    </section>

    <section>
        <h2>Import</h2>
        <p class="small">
            In <a href="https://www-genesis.destatis.de/datenbank/online/table/61111-0002" rel="noopener" target="_blank">GENESIS-Online, Tabelle 61111-0002</a>
            die Monatswerte als CSV herunterladen und den Inhalt hier einfügen. Vorhandene Monate werden aktualisiert.
        </p>
        <EditForm Model="import" OnValidSubmit="ImportAsync" novalidate>
            <AppTextField @bind-Value="import.Csv" Label="CSV-Inhalt" Lines="6" Placeholder="2026;Januar;121,2" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Importieren</MudButton>
        </EditForm>
    </section>

    <section>
        <h2>Werte</h2>
        @if (values is { Count: 0 })
        {
            <EmptyState Text="Noch keine Indexwerte." />
        }
        else if (values is not null)
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Monat</th><th class="number">Wert</th><th>Quelle</th></tr></thead>
                    <tbody>
                        @foreach (var value in values)
                        {
                            <tr>
                                <td>@Format.Month(value.Month)</td>
                                <td class="number">@Format.Number(value.Value)</td>
                                <td>@value.Source</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</InteractiveShell>

@code {
    private IReadOnlyList<CpiView>? values;
    private IReadOnlyList<string>? errors;
    private CpiInput input = new();
    private ImportInput import = new();

    protected override async Task OnInitializedAsync() => values = await Admin.ListAsync();

    private async Task SaveAsync()
    {
        if (!DateOnly.TryParseExact(input.Month + "-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var month))
        {
            errors = ["Bitte einen Monat wählen."];
            return;
        }

        var result = await Admin.SetAsync(month, input.Value!.Value);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success("Der Indexwert wurde gespeichert.");
            input = new();
            values = await Admin.ListAsync();
        }
    }

    private async Task ImportAsync()
    {
        var result = await Admin.ImportAsync(import.Csv ?? "");
        var message = $"Import: {result.Added} neu, {result.Modified} geändert, {result.Unchanged} unverändert.";
        values = await Admin.ListAsync();
        if (result.Errors.Count > 0)
        {
            errors = [message, .. result.Errors];
            return;
        }

        errors = null;
        Notify.Success(message);
        import = new();
    }

    private sealed class CpiInput
    {
        [Required(ErrorMessage = "Bitte einen Monat wählen.")]
        public string? Month { get; set; }

        [Required(ErrorMessage = "Bitte den Indexwert angeben.")]
        [Range(typeof(decimal), "1", "1000", ErrorMessage = "Bitte einen Indexwert wie 121,7 angeben.", ParseLimitsInInvariantCulture = true)]
        public decimal? Value { get; set; }
    }

    private sealed class ImportInput
    {
        public string? Csv { get; set; }
    }
}
