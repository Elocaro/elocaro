@inherits InputBase<Guid?>

@* Selection of a person (name and city to tell apart people with the same name). *@
<select id="@Id" name="@NameAttributeValue" class="@CssClass" @onchange="e => CurrentValueAsString = e.Value?.ToString()">
    <option value="" selected="@(CurrentValue is null)">– keine –</option>
    @foreach (var person in People)
    {
        <option value="@person.Id" selected="@(CurrentValue == person.Id)">@person.DisplayName@(person.City is null ? "" : $" ({person.City})")</option>
    }
</select>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<PersonOption> People { get; set; } = [];

    protected override bool TryParseValueFromString(string? value, out Guid? result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        validationErrorMessage = null;
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            return true;
        }

        if (Guid.TryParse(value, out var id))
        {
            result = id;
            return true;
        }

        result = null;
        validationErrorMessage = "Bitte eine Person wählen.";
        return false;
    }
}
