@using MudBlazor
@using MietHahn.Application.Finance
@inject ILeaseService Leases
@inject ITenantAccounts Accounts
@inject Notifier Notify

@* Dialog "edit rent entry": corrects amount, name and period of an entry of the rent history. *@
<EditForm Model="data" OnValidSubmit="SaveAsync" novalidate class="dialog-form">
    <DataAnnotationsValidator />
    <MudDialog>
        <DialogContent>
            <ErrorList Errors="errors" />
            <p><strong>@Labels.From(Component.Kind)</strong></p>
            <div class="form-grid">
                <AppDateField @bind-Value="data.From" Label="Gültig ab" Required="true" />
                <AppDateField @bind-Value="data.To" Label="Gültig bis" Hint="Leer = unbefristet" />
                <AppNumberField T="decimal?" @bind-Value="data.Amount" Label="Betrag (€/Monat)" Suffix="€" Required="true" />
                @if (Component.Kind == RentComponentType.Miscellaneous)
                {
                    <AppTextField @bind-Value="data.Name" Label="Bezeichnung" />
                }
            </div>
            <p class="small">Korrigiert den Eintrag selbst, ohne einen neuen Stichtag anzulegen. Die Monatsmieten werden danach neu berechnet.</p>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Abbrechen</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    private ComponentCorrection data = new();
    private IReadOnlyList<string>? errors;

    [Parameter, EditorRequired]
    public Guid LeaseId { get; set; }

    [Parameter, EditorRequired]
    public ComponentVersion Component { get; set; } = default!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    protected override void OnInitialized() =>
        data = new ComponentCorrection { From = Component.Validity.From, To = Component.Validity.To, Amount = Component.Amount, Name = Component.Name };

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        var result = await Leases.CorrectComponentAsync(LeaseId, Component.Id, data);
        if (result.Succeeded)
        {
            await Accounts.GenerateChargesAsync(LeaseId);
            Notify.Success("Der Eintrag wurde gespeichert.");
            MudDialog.Close(DialogResult.Ok(Component.Id));
        }
        else
        {
            errors = result.Errors;
        }
    }
}
