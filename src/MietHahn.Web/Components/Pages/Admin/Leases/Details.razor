@page "/verwaltung/vertraege/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor
@inject ILeaseService Admin
@inject IPersonService People
@inject Notifier Notify
@inject Confirmations Confirm

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (lease is null)
{
    <PageHeader Title="Vertrag nicht gefunden" Back="/verwaltung/vertraege" BackText="Alle Verträge" />
}
else
{
<PageHeader Title="@($"Mietvertrag {lease.RentalUnit}")" Subtitle="@($"{lease.Property} · {TenantText}")" Back="/verwaltung/vertraege" BackText="Alle Verträge">
    <Actions>
        <AuthorizeView Policy="@Policies.Finance">
            <MudButton Variant="Variant.Outlined" Href="@($"/verwaltung/vertraege/{Id}/konto")">Mieterkonto</MudButton>
            <MudButton Variant="Variant.Outlined" Href="@($"/verwaltung/vertraege/{Id}/kostenarten")">Vereinbarte Kostenarten</MudButton>
        </AuthorizeView>
        <MudButton Variant="Variant.Outlined" Href="@($"/verwaltung/vertraege/{Id}/vertragsdokument")">Vertragsdokument</MudButton>
        @if (lease.Status != LeaseStatus.Ended)
        {
            <MudButton Variant="Variant.Outlined" Href="@($"/verwaltung/vertraege/{Id}/auszug")">Mieterwechsel</MudButton>
        }
    </Actions>
</PageHeader>

<ErrorList Errors="errors" />

<dl class="details">
    <dt>Status</dt><dd><StatusChip Level="Labels.Level(lease.Status)">@Labels.From(lease.Status)</StatusChip></dd>
    <dt>Laufzeit</dt>
    <dd>
        @Format.Date(lease.Term.From) – @(lease.Term.To is null ? "unbefristet" : Format.Date(lease.Term.To))
        @if (lease.FixedTermUntil is not null)
        {
            <span class="small">(Zeitmietvertrag bis @Format.Date(lease.FixedTermUntil))</span>
        }
    </dd>
    @if (lease.TerminationReceivedOn is { } incoming)
    {
        <dt>Kündigung</dt><dd>durch @Labels.From(lease.TerminatedBy!.Value), eingegangen am @Format.Date(incoming)</dd>
    }
    <dt>Mietobjekt</dt>
    <dd><a href="@(lease.RoomId is { } z ? $"/verwaltung/zimmer/{z}" : $"/verwaltung/einheiten/{lease.UnitId}")">@lease.RentalUnit</a>, <a href="/verwaltung/objekte/@lease.PropertyId">@lease.Property</a></dd>
    <dt>Nebenkosten</dt><dd>@Labels.From(lease.Data.BillingType)@(lease.Data.HeatingCostsConsumptionBased ? ", Heizkosten verbrauchsabhängig" : "")</dd>
    <dt>Fälligkeit</dt><dd>@(lease.Data.DueOnWorkingDay). Werktag, @Labels.From(lease.Data.PaymentMethod)@(lease.NextDueDate is { } f ? $" (nächste: {Format.Date(f)})" : "")</dd>
    @if (lease.Data.Deposit is not null)
    {
        <dt>Kaution</dt><dd>@Format.Money(lease.Data.Deposit) @lease.Data.DepositNote</dd>
    }
</dl>

<section>
    <h2>Miete <span class="small">am @Format.Date(lease.ReferenceDate)</span></h2>
    <div class="table-wrapper">
        <table class="data-table">
            <tbody>
                @foreach (var b in lease.CurrentComponents)
                {
                    <tr>
                        <td>@Labels.From(b.Kind)@(b.Name is null ? "" : $" ({b.Name})")</td>
                        <td class="small">@Format.Period(b.Validity)</td>
                        <td class="number">@Format.Money(b.Amount)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th colspan="2">Monatlich gesamt</th><th class="number">@Format.Money(lease.MonthlyRent)</th></tr>
            </tfoot>
        </table>
    </div>

    @if (lease.Status != LeaseStatus.Ended)
    {
        <details class="disclosure">
            <summary>Betrag ändern oder hinzufügen (ab Stichtag)</summary>
            <EditForm Model="component" OnValidSubmit="SetComponentAsync" novalidate class="form-grid">
                <DataAnnotationsValidator />
                <AppSelect @bind-Value="component.Kind" Label="Bestandteil" Items="Enum.GetValues<RentComponentType>()" Text="@(v => Labels.From(v))" />
                <AppDateField @bind-Value="component.From" Label="Gültig ab" Required="true" />
                <AppNumberField T="decimal?" @bind-Value="component.Amount" Label="Betrag (€/Monat)" Suffix="€" Required="true" />
                <AppTextField @bind-Value="component.Name" Label="Bezeichnung" Hint="Für „Sonstiges“" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Betrag speichern</MudButton>
            </EditForm>
            <p class="small">Der bisherige Betrag gilt bis zum Vortag weiter. Für Mieterhöhungen nach § 558 BGB folgt ein Assistent mit Schreiben.</p>
        </details>
        <details class="disclosure">
            <summary>Bestandteil beenden (z. B. Stellplatz gekündigt)</summary>
            <EditForm Model="end" OnValidSubmit="EndComponentAsync" novalidate class="form-grid">
                <DataAnnotationsValidator />
                <AppSelect @bind-Value="end.Kind" Label="Bestandteil" Items="lease.CurrentComponents.Select(b => b.Kind).Distinct().ToList()" Text="@(v => Labels.From(v))" />
                <AppDateField @bind-Value="end.LastDay" Label="Letzter Tag" Required="true" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">Beenden</MudButton>
            </EditForm>
        </details>
    }

    @if (lease.Components.Count > lease.CurrentComponents.Count)
    {
        <h3>Verlauf</h3>
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Bestandteil</th><th>Zeitraum</th><th class="number">Betrag</th></tr></thead>
                <tbody>
                    @foreach (var b in lease.Components)
                    {
                        <tr>
                            <td>@Labels.From(b.Kind)@(b.Name is null ? "" : $" ({b.Name})")</td>
                            <td>@Format.Period(b.Validity)</td>
                            <td class="number">@Format.Money(b.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<RentModelSection LeaseId="Id" Model="lease.RentModel" OnChanged="LoadAsync" />

<section>
    <h2>Vertragsparteien</h2>
    <ul class="todos">
        @foreach (var party in lease.Parties)
        {
            <li class="todo">
                <a href="/verwaltung/personen/@party.PersonId">@party.Name</a> <StatusChip>@Labels.From(party.Role)</StatusChip>
                <p class="small">@party.Email @party.Phone</p>
                @if (lease.Parties.Count(p => p.Role == PartyRole.Tenant) > 1 || party.Role == PartyRole.Guarantor)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemovePartyAsync(party)" aria-label="@($"{party.Name} entfernen")">Entfernen</MudButton>
                }
            </li>
        }
    </ul>
    <details class="disclosure">
        <summary>Mieter oder Bürgen hinzufügen</summary>
        <EditForm Model="newParty" OnValidSubmit="AddPartyAsync" novalidate class="form-grid">
            <DataAnnotationsValidator />
            <PersonSelect @bind-Value="newParty.PersonId" Label="Person" People="people" Required="true" />
            <AppSelect @bind-Value="newParty.Role" Label="Rolle" Items="Enum.GetValues<PartyRole>()" Text="@(v => Labels.From(v))" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Hinzufügen</MudButton>
        </EditForm>
    </details>
</section>

<section>
    <h2>Personen im Haushalt</h2>
    <p>
        @(lease.People.FirstOrDefault(p => p.Validity.Contains(lease.ReferenceDate))?.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "–")
        <span class="small">(Umlage nach Personen)</span>
    </p>
    @if (lease.Status != LeaseStatus.Ended)
    {
        <details class="disclosure">
            <summary>Personenanzahl ändern</summary>
            <EditForm Model="occupantCount" OnValidSubmit="SetOccupantCountAsync" novalidate class="form-row">
                <DataAnnotationsValidator />
                <AppDateField @bind-Value="occupantCount.From" Label="Ab" Required="true" />
                <AppNumberField T="int" @bind-Value="occupantCount.Count" Label="Anzahl" Min="1" Max="20" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
            </EditForm>
        </details>
    }
    @if (lease.People.Count > 1)
    {
        <ul class="small">
            @foreach (var entry in lease.People)
            {
                <li>@Format.Period(entry.Validity): @entry.Count</li>
            }
        </ul>
    }
</section>

<section>
    <h2>Kündigung</h2>
    @if (lease.TerminationReceivedOn is not null)
    {
        <p>Das Mietverhältnis endet am <strong>@Format.Date(lease.Term.To)</strong>.</p>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RevokeTerminationAsync">Kündigung aufheben (zurückgenommen)</MudButton>
    }
    else if (lease.Status != LeaseStatus.Ended)
    {
        <EditForm Model="termination" OnValidSubmit="TerminateAsync" novalidate class="form-grid">
            <DataAnnotationsValidator />
            <AppDateField @bind-Value="termination.ReceivedOn" Label="Eingegangen am" Required="true" />
            <AppSelect @bind-Value="termination.By" Label="Gekündigt durch" Items="Enum.GetValues<TerminatingParty>()" Text="@(v => Labels.From(v))" />
            <AppDateField @bind-Value="termination.EffectiveDate" Label="Zum" Hint="@($"Leer = gesetzliche Frist (Mieter {lease.Data.NoticePeriodMonths}, Vermieter derzeit {lease.LandlordNoticePeriodMonths} Monate).")" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Kündigung erfassen</MudButton>
        </EditForm>
        <p class="small">Frist nach § 573c BGB: Geht die Kündigung bis zum 3. Werktag eines Monats zu, zählt dieser Monat mit. Vermieter brauchen zudem einen Kündigungsgrund (§ 573 BGB).</p>
    }
</section>

<section>
    <h2>Angaben</h2>
    <EditForm Model="data" OnValidSubmit="SaveDataAsync" novalidate>
        <DataAnnotationsValidator />
        <div class="form-grid">
            <AppSelect @bind-Value="data.BillingType" Label="Nebenkosten" Items="Enum.GetValues<BillingType>()" Text="@(v => Labels.From(v))" />
            <AppNumberField T="int" @bind-Value="data.DueOnWorkingDay" Label="Fällig am … Werktag" Min="1" Max="10" />
            <AppSelect @bind-Value="data.PaymentMethod" Label="Zahlungsart" Items="Enum.GetValues<PaymentMethod>()" Text="@(v => Labels.From(v))" />
            <AppNumberField T="int" @bind-Value="data.NoticePeriodMonths" Label="Kündigungsfrist Mieter (Monate)" Min="1" Max="24" />
            <AppNumberField T="decimal?" @bind-Value="data.Deposit" Label="Kaution" Suffix="€" />
            <AppTextField @bind-Value="data.DepositNote" Label="Kaution – Notiz" />
        </div>
        <AppCheckBox @bind-Value="data.HeatingCostsConsumptionBased" Label="Heizkosten trotz Pauschale verbrauchsabhängig abrechnen" />
        <AppTextField @bind-Value="data.Notes" Label="Notizen" Lines="2" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Angaben speichern</MudButton>
    </EditForm>
</section>

<DocumentsSection LeaseId="Id" />

<ChangeHistory EntityType="@nameof(Lease)" EntityId="Id" />
}
</InteractiveShell>

@code {
    private LeaseDetails? lease;
    private IReadOnlyList<PersonOption> people = [];
    private IReadOnlyList<string>? errors;
    private bool loaded;

    private ComponentInput component = new();
    private EndModel end = new();
    private OccupantCountInput occupantCount = new();
    private PartyModel newParty = new();
    private TerminationInput termination = new();
    private LeaseInput data = new();

    [Parameter]
    public Guid Id { get; set; }

    private string TenantText => string.Join(", ", lease!.Parties.Where(p => p.Role == PartyRole.Tenant).Select(p => p.Name));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        lease = await Admin.GetAsync(Id);
        if (lease is not null)
        {
            data = lease.Data;
            people = await People.OptionsAsync();
            end = new EndModel { Kind = lease.CurrentComponents.Select(b => b.Kind).FirstOrDefault() };
        }

        loaded = true;
    }

    private Task SetComponentAsync() => ExecuteAsync(Admin.SetComponentAsync(Id, component), "Der Betrag wurde gespeichert.", () => component = new());

    private Task EndComponentAsync() => ExecuteAsync(Admin.EndComponentAsync(Id, end.Kind, end.LastDay!.Value), "Der Bestandteil wurde beendet.");

    private Task SetOccupantCountAsync() => ExecuteAsync(Admin.SetOccupantCountAsync(Id, occupantCount), "Die Personenanzahl wurde gespeichert.", () => occupantCount = new());

    private Task AddPartyAsync() => ExecuteAsync(Admin.AddPartyAsync(Id, newParty.PersonId!.Value, newParty.Role), "Die Person wurde hinzugefügt.", () => newParty = new());

    private async Task RemovePartyAsync(LeasePartyView party)
    {
        if (await Confirm.AskAsync("Person entfernen", $"Soll {party.Name} aus dem Vertrag entfernt werden?", "Ja, entfernen"))
        {
            await ExecuteAsync(Admin.RemovePartyAsync(Id, party.PersonId), "Die Person wurde entfernt.");
        }
    }

    private Task TerminateAsync() => ExecuteAsync(Admin.TerminateAsync(Id, termination), "Die Kündigung wurde erfasst.", () => termination = new());

    private Task RevokeTerminationAsync() => ExecuteAsync(Admin.RevokeTerminationAsync(Id), "Die Kündigung wurde aufgehoben.");

    private Task SaveDataAsync() => ExecuteAsync(Admin.UpdateAsync(Id, data), "Die Angaben wurden gespeichert.");

    private async Task ExecuteAsync(Task<Result> command, string success, Action? reset = null)
    {
        var result = await command;
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            reset?.Invoke();
            Notify.Success(success);
        }

        await LoadAsync();
    }

    private sealed class EndModel
    {
        public RentComponentType Kind { get; set; }

        [Required(ErrorMessage = "Bitte den letzten Tag angeben.")]
        public DateOnly? LastDay { get; set; }
    }

    private sealed class PartyModel
    {
        [Required(ErrorMessage = "Bitte eine Person wählen.")]
        public Guid? PersonId { get; set; }

        public PartyRole Role { get; set; }
    }
}
