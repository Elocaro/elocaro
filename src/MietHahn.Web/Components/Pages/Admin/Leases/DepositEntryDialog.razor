@using MudBlazor
@using MietHahn.Domain.Deposits
@inject IDeposits Deposits
@inject Notifier Notify

@* Dialog "edit deposit entry": corrects kind, date, amount and note of an entry. *@
<EditForm Model="data" OnValidSubmit="SaveAsync" novalidate class="dialog-form">
    <DataAnnotationsValidator />
    <MudDialog>
        <DialogContent>
            <ErrorList Errors="errors" />
            <div class="form-grid">
                <AppSelect @bind-Value="data.Kind" Label="Art" Items="Enum.GetValues<DepositEntryKind>()" Text="@(v => Labels.From(v))" />
                <AppDateField @bind-Value="data.Date" Label="Datum" Required="true" />
                <AppNumberField T="decimal?" @bind-Value="data.Amount" Label="Betrag" Suffix="€" Required="true" />
                <AppTextField @bind-Value="data.Note" Label="Hinweis" Hint="@(data.Kind == DepositEntryKind.Deduction ? "Wogegen wird verrechnet? (Pflicht)" : null)" />
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Abbrechen</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    private DepositEntryInput data = new();
    private IReadOnlyList<string>? errors;

    [Parameter, EditorRequired]
    public DepositRow Row { get; set; } = default!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    protected override void OnInitialized() => data = new DepositEntryInput { Kind = Row.Kind, Date = Row.Date, Amount = Row.Amount, Note = Row.Note };

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        var result = await Deposits.UpdateAsync(Row.Id, data);
        if (result.Succeeded)
        {
            Notify.Success("Die Buchung wurde gespeichert.");
            MudDialog.Close(DialogResult.Ok(Row.Id));
        }
        else
        {
            errors = result.Errors;
        }
    }
}
