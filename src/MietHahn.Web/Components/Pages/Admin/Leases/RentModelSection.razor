@* Rent model of a lease: standard (rent development), graduated or index-linked rent. The page processes the forms. *@
<section>
    <h2>Mietmodell: @Labels.From(Model.Model)</h2>

    @switch (Model.Model)
    {
        case RentModel.Standard:
            <dl class="details">
                <dt>Letzte Erhöhung</dt><dd>@(Model.LastIncrease is { } last ? Format.Date(last) : "seit Mietbeginn unverändert")</dd>
                @if (Model.BaseRentThreeYearsAgo is { } before && Model.BaseRent is { } now)
                {
                    <dt>Vor 3 Jahren</dt><dd>@Format.Money(before) (Steigerung @Format.Number(Math.Round((now / before - 1) * 100, 1)) %, Kappungsgrenze beachten)</dd>
                }
            </dl>
            <p class="small">Erhöhung auf die ortsübliche Vergleichsmiete (§ 558 BGB): frühestens 15 Monate nach Einzug bzw. letzter Erhöhung wirksam, höchstens 20 % (in angespannten Märkten 15 %) in 3 Jahren.</p>
            break;

        case RentModel.Graduated:
            @if (Model.RentSteps.Count == 0)
            {
                <p class="small">Noch keine Staffeln erfasst.</p>
            }
            else
            {
                <form method="post" @formname="graduated-remove" @onsubmit="OnRemoveStep">
                    <AntiforgeryToken />
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead><tr><th>Ab</th><th class="number">Kaltmiete</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var rentStep in Model.RentSteps)
                                {
                                    <tr>
                                        <td>@Format.Date(rentStep.From)</td>
                                        <td class="number">@Format.Money(rentStep.BaseRent)</td>
                                        <td>
                                            @if (rentStep.AppliedAt is not null)
                                            {
                                                <span class="status status-ok">übernommen</span>
                                            }
                                            else
                                            {
                                                <span class="status status-pending">geplant</span>
                                            }
                                        </td>
                                        <td>
                                            @if (rentStep.AppliedAt is null)
                                            {
                                                <button type="submit" name="RemoveStepId" value="@rentStep.Id" class="button button-danger" aria-label="Staffel @Format.Date(rentStep.From) entfernen">Entfernen</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </form>
            }
            <details class="disclosure" open="@(Model.RentSteps.Count == 0)">
                <summary>Staffel hinzufügen</summary>
                <EditForm Model="Graduated" FormName="graduated" OnValidSubmit="OnAddStep" class="form-row">
                    <DataAnnotationsValidator />
                    <FormField Id="graduated-valid-from" Label="Ab" For="() => Graduated.From" Required="true">
                        <InputDate id="graduated-valid-from" @bind-Value="Graduated.From" />
                    </FormField>
                    <FormField Id="graduated-rent" Label="Neue Kaltmiete (€)" For="() => Graduated.BaseRent" Required="true">
                        <InputAmount id="graduated-rent" @bind-Value="Graduated.BaseRent" />
                    </FormField>
                    <div class="field field-action"><button type="submit" class="button">Staffel speichern</button></div>
                </EditForm>
                <p class="small">§ 557a BGB: Die Miete muss jeweils mindestens ein Jahr unverändert bleiben. Am Stichtag übernimmt MietHahn die Staffel automatisch als Kaltmiete.</p>
            </details>
            break;

        case RentModel.Index:
            <dl class="details">
                <dt>Ausgangsindex</dt><dd>@Format.Number(Model.IndexBaseValue) (@Month(Model.IndexBaseMonth))</dd>
                <dt>Letzte Änderung</dt><dd>@(Model.LastIncrease is { } lastChange ? Format.Date(lastChange) : "seit Mietbeginn unverändert")</dd>
            </dl>
            @if (Model.Index is { } suggestion)
            {
                <div class="message @(suggestion.PossibleNow ? "message-info" : "")">
                    <p>VPI @Month(suggestion.CpiMonth): @Format.Number(suggestion.CpiValue) (@(suggestion.ChangePercent >= 0 ? "+" : "")@Format.Number(suggestion.ChangePercent) %) → neue Kaltmiete <strong>@Format.Money(suggestion.NewBaseRent)</strong> statt @Format.Money(Model.BaseRent).</p>
                    <p class="small">Frühestens wirksam ab @Format.Date(suggestion.EarliestEffective) (ein Jahr nach der letzten Änderung).</p>
                </div>
                <EditForm Model="Adjustment" FormName="index-adjustment" OnValidSubmit="OnAdjustIndex" class="form-row">
                    <DataAnnotationsValidator />
                    <FormField Id="declaration" Label="Erklärung geht zu am" For="() => Adjustment.DeclaredOn" Required="true" Hint="Die neue Miete gilt ab dem übernächsten Monat (§ 557b Abs. 3 BGB).">
                        <InputDate id="declaration" @bind-Value="Adjustment.DeclaredOn" />
                    </FormField>
                    <div class="field field-action"><button type="submit" class="button">Anpassung übernehmen</button></div>
                </EditForm>
            }
            else
            {
                <p class="small">Kein VPI-Wert neuer als der Ausgangsindex. <a href="/verwaltung/vpi">Verbraucherpreisindex pflegen</a></p>
            }
            break;
    }

    <details class="disclosure">
        <summary>Mietmodell ändern</summary>
        <EditForm Model="Input" FormName="rent-model" OnValidSubmit="OnSetModel" class="form-grid">
            <DataAnnotationsValidator />
            <FormField Id="model" Label="Mietmodell" For="() => Input.Model">
                <InputSelect id="model" @bind-Value="Input.Model">
                    @foreach (var value in Enum.GetValues<RentModel>())
                    {
                        <option value="@value">@Labels.From(value)</option>
                    }
                </InputSelect>
            </FormField>
            <FormField Id="index-month" Label="Indexmiete: Ausgangsmonat" For="() => Input.BaseMonth" Hint="Monat des Ausgangsindex, z. B. Mietbeginn">
                <InputText id="index-month" type="month" @bind-Value="Input.BaseMonth" />
            </FormField>
            <FormField Id="index-value" Label="Indexmiete: Ausgangswert" For="() => Input.BaseValue" Hint="VPI (2020 = 100), z. B. 117,4">
                <InputArea id="index-value" @bind-Value="Input.BaseValue" step="0.1" />
            </FormField>
            <div class="field field-action"><button type="submit" class="button">Mietmodell speichern</button></div>
        </EditForm>
    </details>
</section>

@code {
    [Parameter, EditorRequired]
    public RentModelView Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public RentModelForm Input { get; set; } = default!;

    [Parameter, EditorRequired]
    public RentStepInput Graduated { get; set; } = default!;

    [Parameter, EditorRequired]
    public IndexAdjustmentInput Adjustment { get; set; } = default!;

    [Parameter]
    public EventCallback OnSetModel { get; set; }

    [Parameter]
    public EventCallback OnAddStep { get; set; }

    [Parameter]
    public EventCallback OnRemoveStep { get; set; }

    [Parameter]
    public EventCallback OnAdjustIndex { get; set; }

    private static string Month(DateOnly? month) => month?.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("de-DE")) ?? "–";
}
