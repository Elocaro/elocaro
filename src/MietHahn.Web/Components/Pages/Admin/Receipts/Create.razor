@page "/verwaltung/belege/neu"
@using MietHahn.Application.Files
@inject IReceiptService Receipts
@inject IFileStore Storage
@inject Redirector Redirector

<PageHeader Title="Beleg erfassen" Back="/verwaltung/belege" BackText="Alle Belege" />

<ErrorList Errors="errors" />

@if (selection is not null)
{
    <EditForm Model="Data" FormName="receipt" OnValidSubmit="SaveAsync" enctype="multipart/form-data">
        <DataAnnotationsValidator />
        <div class="field">
            <label for="files">Rechnung (PDF oder Fotos)</label>
            <input type="file" id="files" name="Files" accept="application/pdf,image/*" multiple />
            <span class="field-hint">Mehrere Seiten auf einmal möglich; auf dem Handy öffnet sich die Kamera zur Auswahl.</span>
        </div>
        <ReceiptFields Data="Data!" Options="selection" />
        <h2>Kostenart</h2>
        <p class="small">Für eine Rechnung mit einer Kostenart. Aufteilen auf mehrere Kostenarten oder Objekte geht danach.</p>
        <CostItemFields Position="Position!" Options="selection" WithDetails="false" Required="false" />
        <button type="submit" class="button button-primary">Speichern</button>
    </EditForm>
}

@code {
    private ReceiptOptions? selection;
    private IReadOnlyList<string>? errors;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "receipt")]
    private ReceiptInput? Data { get; set; }

    [SupplyParameterFromForm(FormName = "receipt")]
    private CostItemInput? Position { get; set; }

    [SupplyParameterFromForm(FormName = "receipt")]
    private IFormFileCollection? Files { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Data ??= new();
        Position ??= new();
        selection = await Receipts.OptionsAsync();
    }

    private async Task SaveAsync()
    {
        try
        {
            var fileIds = new List<Guid>();
            foreach (var file in Files?.Where(d => d.Length > 0) ?? [])
            {
                await using var content = file.OpenReadStream();
                fileIds.Add((await Storage.SaveAsync(content, file.FileName)).Id);
            }

            var result = await Receipts.CreateAsync(Data!, fileIds, Position);
            if (result.Succeeded)
            {
                Redirector.RedirectWithMessage($"/verwaltung/belege/{result.Id}", "Der Beleg wurde gespeichert.", HttpContext);
            }
            else
            {
                errors = result.Errors;
            }
        }
        catch (FileRejectedException ex)
        {
            errors = [ex.Message];
        }
    }
}
