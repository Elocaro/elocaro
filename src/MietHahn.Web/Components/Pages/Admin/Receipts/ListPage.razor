@page "/verwaltung/belege"
@rendermode InteractiveServer
@using MudBlazor
@inject IReceiptService Receipts

<InteractiveShell>
    <PageHeader Title="Belege" Subtitle="Rechnungen und Kostenbelege, aufgeteilt nach Kostenart und Objekt.">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/verwaltung/belege/neu">Beleg erfassen</MudButton>
        </Actions>
    </PageHeader>

    <div class="form-row search-bar" role="search">
        <AppYearSelect T="int?" Value="year" ValueChanged="OnYearChanged" Label="Jahr" EmptyText="Alle Jahre" />
        @if (selection is not null)
        {
            <OptionSelect Value="propertyId" ValueChanged="OnPropertyChanged" Label="Objekt" Options="selection.Properties.Select(o => (o.Id, o.Name)).ToList()" />
        }
        <CostTypeSelect Value="@costType" ValueChanged="OnCostTypeChanged" Label="Kostenart" EmptyText="Alle" />
        <AppTextField Value="@search" Label="Suche" Type="search" Placeholder="Lieferant, Rechnungsnr." Immediate="true" DebounceMilliseconds="300" OnDebounced="OnSearchChanged" Clearable="true" />
        <AppCheckBox Value="unpaid" ValueChanged="OnUnpaidChanged" Label="ohne Zahlung" />
        <AppCheckBox Value="split" ValueChanged="OnSplitChanged" Label="nicht aufgeteilt" />
    </div>

    @if (receipts is { Count: 0 })
    {
        <EmptyState Text="Keine Belege in dieser Auswahl." />
    }
    else if (receipts is not null)
    {
        <p class="small">@receipts.Count Belege · Summe @Format.Money(receipts.Sum(b => b.Gross))</p>
        <MudTable T="ReceiptRow" Items="receipts" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" RowsPerPage="50">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="ReceiptRow" SortBy="@(b => b.InvoiceDate)" InitialDirection="SortDirection.Descending">Datum</MudTableSortLabel></MudTh>
                <MudTh>Lieferant</MudTh><MudTh>Kostenarten</MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel T="ReceiptRow" SortBy="@(b => b.Gross)">Betrag</MudTableSortLabel></MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Datum">@Format.Date(context.InvoiceDate)</MudTd>
                <MudTd DataLabel="Lieferant"><a href="/verwaltung/belege/@context.Id">@context.Supplier</a>@if (context.InvoiceNumber is not null) {<span class="small">&#32;@context.InvoiceNumber</span>}</MudTd>
                <MudTd DataLabel="Kostenarten">@string.Join(", ", context.CostTypes)<span class="small">&#32;@string.Join(", ", context.Properties)</span></MudTd>
                <MudTd DataLabel="Betrag" Style="text-align:right">@Format.Money(context.Gross)</MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Incomplete)
                    {
                        <StatusChip Level="StatusLevel.Warning">Betrag fehlt</StatusChip>
                    }
                    else if (context.Allocated != context.Gross)
                    {
                        <StatusChip Level="StatusLevel.Warning">@Format.Money(context.Gross - context.Allocated) nicht aufgeteilt</StatusChip>
                    }
                    @if (context.PaidOn is null)
                    {
                        <StatusChip Level="StatusLevel.Warning">unbezahlt</StatusChip>
                    }
                    @if (context.Files == 0)
                    {
                        <StatusChip>ohne Datei</StatusChip>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 50, 100, 250 }" RowsPerPageString="Zeilen pro Seite" InfoFormat="{first_item}–{last_item} von {all_items}" AllItemsText="Alle" />
            </PagerContent>
        </MudTable>
    }
</InteractiveShell>

@code {
    private IReadOnlyList<ReceiptRow>? receipts;
    private ReceiptOptions? selection;
    private int? year;
    private Guid? propertyId;
    private string? costType;
    private string? search;
    private bool unpaid;
    private bool split;

    // The query string only provides the start values (see ADR 0005).
    [SupplyParameterFromQuery(Name = "jahr")]
    private int? InitialYear { get; set; }

    [SupplyParameterFromQuery(Name = "objekt")]
    private Guid? InitialProperty { get; set; }

    [SupplyParameterFromQuery(Name = "kostenart")]
    private string? InitialCostType { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? InitialSearch { get; set; }

    [SupplyParameterFromQuery(Name = "ohneZahlung")]
    private bool InitialUnpaid { get; set; }

    [SupplyParameterFromQuery(Name = "aufteilen")]
    private bool InitialSplit { get; set; }

    protected override async Task OnInitializedAsync()
    {
        year = InitialYear;
        propertyId = InitialProperty;
        costType = string.IsNullOrEmpty(InitialCostType) ? null : InitialCostType;
        search = InitialSearch;
        unpaid = InitialUnpaid;
        split = InitialSplit;
        selection = await Receipts.OptionsAsync();
        await LoadAsync();
    }

    private async Task OnYearChanged(int? value)
    {
        year = value;
        await LoadAsync();
    }

    private async Task OnPropertyChanged(Guid? value)
    {
        propertyId = value;
        await LoadAsync();
    }

    private async Task OnCostTypeChanged(string? value)
    {
        costType = string.IsNullOrEmpty(value) ? null : value;
        await LoadAsync();
    }

    private async Task OnSearchChanged(string? text)
    {
        search = text;
        await LoadAsync();
    }

    private async Task OnUnpaidChanged(bool value)
    {
        unpaid = value;
        await LoadAsync();
    }

    private async Task OnSplitChanged(bool value)
    {
        split = value;
        await LoadAsync();
    }

    private async Task LoadAsync() => receipts = await Receipts.SearchAsync(new ReceiptQuery(year, propertyId, costType, unpaid, split, search));
}
