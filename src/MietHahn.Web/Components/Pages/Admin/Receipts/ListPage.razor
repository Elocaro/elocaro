@page "/verwaltung/belege"
@inject IReceiptService Receipts

<PageHeader Title="Belege" Subtitle="Rechnungen und Kostenbelege, aufgeteilt nach Kostenart und Objekt.">
    <Actions>
        <a class="button button-primary" href="/verwaltung/belege/neu">Beleg erfassen</a>
    </Actions>
</PageHeader>

<StatusMessage />

<FilterBar>
    <div class="field">
        <label for="year">Jahr</label>
        <input id="year" type="number" name="jahr" value="@Year" min="2000" max="2100" />
    </div>
    <div class="field">
        <label for="property">Objekt</label>
        <select id="property" name="objekt">
            <option value="">Alle</option>
            @foreach (var o in selection?.Properties ?? [])
            {
                <option value="@o.Id" selected="@(o.Id == PropertyId)">@o.Name</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="cost-type">Kostenart</label>
        <select id="cost-type" name="kostenart">
            <option value="">Alle</option>
            <CostTypeOptions Selected="@CostType" />
        </select>
    </div>
    <div class="field">
        <label for="search">Suche</label>
        <input id="search" type="search" name="q" value="@Q" placeholder="Lieferant, Rechnungsnr." />
    </div>
    <div class="field field-checkbox">
        <input id="without-payment" type="checkbox" name="ohneZahlung" value="true" checked="@Unpaid" />
        <label for="without-payment">ohne Zahlung</label>
    </div>
    <div class="field field-checkbox">
        <input id="split" type="checkbox" name="aufteilen" value="true" checked="@Split" />
        <label for="split">nicht aufgeteilt</label>
    </div>
</FilterBar>

@if (receipts is { Count: 0 })
{
    <EmptyState Text="Keine Belege in dieser Auswahl." />
}
else if (receipts is not null)
{
    <p class="small">@receipts.Count Belege · Summe @Format.Money(receipts.Sum(b => b.Gross))</p>
    <div class="table-wrapper">
        <table class="data-table">
            <thead><tr><th>Datum</th><th>Lieferant</th><th>Kostenarten</th><th class="number">Betrag</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var b in receipts)
                {
                    <tr>
                        <td>@Format.Date(b.InvoiceDate)</td>
                        <td><a href="/verwaltung/belege/@b.Id">@b.Supplier</a>@if (b.InvoiceNumber is not null) {<span class="small"> @b.InvoiceNumber</span>}</td>
                        <td>@string.Join(", ", b.CostTypes)<span class="small"> @string.Join(", ", b.Properties)</span></td>
                        <td class="number">@Format.Money(b.Gross)</td>
                        <td>
                            @if (b.Allocated != b.Gross)
                            {
                                <StatusChip Level="StatusLevel.Warning">@Format.Money(b.Gross - b.Allocated) nicht aufgeteilt</StatusChip>
                            }
                            @if (b.PaidOn is null)
                            {
                                <StatusChip Level="StatusLevel.Warning">unbezahlt</StatusChip>
                            }
                            @if (b.Files == 0)
                            {
                                <StatusChip>ohne Datei</StatusChip>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<ReceiptRow>? receipts;
    private ReceiptOptions? selection;

    [SupplyParameterFromQuery(Name = "jahr")]
    private int? Year { get; set; }

    [SupplyParameterFromQuery(Name = "objekt")]
    private Guid? PropertyId { get; set; }

    [SupplyParameterFromQuery(Name = "kostenart")]
    private string? CostType { get; set; }

    [SupplyParameterFromQuery]
    private string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "ohneZahlung")]
    private bool Unpaid { get; set; }

    [SupplyParameterFromQuery(Name = "aufteilen")]
    private bool Split { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        selection = await Receipts.OptionsAsync();
        receipts = await Receipts.SearchAsync(new ReceiptQuery(Year, PropertyId, string.IsNullOrEmpty(CostType) ? null : CostType, Unpaid, Split, Q));
    }
}
