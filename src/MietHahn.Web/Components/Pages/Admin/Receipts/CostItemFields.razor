@* Input fields of a cost item; field names "Position.…" (page property Position). *@
<div class="form-grid">
    <FormField Uncertain="Marked(nameof(ReceiptSuggestion.CostType))" Id="item-cost-type" Label="Kostenart" For="() => Position.CostType" Required="@Required">
        <InputSelect id="item-cost-type" @bind-Value="Position.CostType">
            <option value="">@(Required ? "– bitte wählen –" : "– später aufteilen –")</option>
            <CostTypeOptions />
        </InputSelect>
    </FormField>
    <FormField Id="item-property" Label="Objekt" For="() => Position.PropertyId" Required="@Required">
        <InputSelect id="item-property" @bind-Value="Position.PropertyId">
            <option value="">–</option>
            @foreach (var o in Options.Properties)
            {
                <option value="@o.Id">@o.Name</option>
            }
        </InputSelect>
    </FormField>
    @if (WithDetails)
    {
        <FormField Id="item-amount" Label="Betrag" For="() => Position.Amount" Hint="Leer = noch nicht aufgeteilter Rest">
            <InputAmount id="item-amount" @bind-Value="Position.Amount" />
        </FormField>
        <FormField Id="item-unit" Label="Nur Einheit" For="() => Position.UnitId" Hint="Bei Kosten einer einzelnen Einheit">
            <InputSelect id="item-unit" @bind-Value="Position.UnitId">
                <option value="">– ganzes Objekt –</option>
                @foreach (var e in Options.Units)
                {
                    <option value="@e.Id">@e.Name</option>
                }
            </InputSelect>
        </FormField>
        <FormField Id="item-from" Label="Abrechnungszeitraum von" For="() => Position.From" Hint="Leer = Leistungszeitraum bzw. Kalenderjahr">
            <InputDate id="item-from" @bind-Value="Position.From" />
        </FormField>
        <FormField Id="item-until" Label="bis" For="() => Position.To">
            <InputDate id="item-until" @bind-Value="Position.To" />
        </FormField>
        <FormField Uncertain="Marked(nameof(ReceiptSuggestion.Section35a))" Id="item-35a" Label="§ 35a EStG" For="() => Position.Section35a">
            <InputSelect id="item-35a" @bind-Value="Position.Section35a">
                @foreach (var value in Enum.GetValues<Section35a>())
                {
                    <option value="@value">@Labels.From(value)</option>
                }
            </InputSelect>
        </FormField>
        <FormField Uncertain="Marked(nameof(ReceiptSuggestion.LaborCosts))" Id="item-labor" Label="davon Arbeitskosten" For="() => Position.LaborCosts" Hint="Lohn-, Maschinen- und Fahrtkosten inkl. USt">
            <InputAmount id="item-labor" @bind-Value="Position.LaborCosts" />
        </FormField>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public CostItemInput Position { get; set; } = default!;

    [Parameter, EditorRequired]
    public ReceiptOptions Options { get; set; } = default!;

    [Parameter]
    public bool WithDetails { get; set; } = true;

    [Parameter]
    public bool Required { get; set; } = true;

    [Parameter]
    public IReadOnlySet<string>? Uncertain { get; set; }

    private bool Marked(string field) => Uncertain?.Contains(field) == true;
}
