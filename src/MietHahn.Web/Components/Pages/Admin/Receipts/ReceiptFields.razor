@* Input fields of a receipt; sits inside an EditForm with Model = Data. *@
<div class="form-grid">
    <FormField Id="receipt-supplier" Label="Lieferant (Kontakt)" For="() => Data.SupplierId" Hint="Kontakte unter Personen anlegen; sonst unten den Namen eintragen.">
        <InputSelect id="receipt-supplier" @bind-Value="Data.SupplierId">
            <option value="">–</option>
            @foreach (var l in Options.Suppliers)
            {
                <option value="@l.Id">@l.Name</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="receipt-supplier-name" Label="oder Name" For="() => Data.SupplierName">
        <InputText id="receipt-supplier-name" @bind-Value="Data.SupplierName" />
    </FormField>
    <FormField Id="receipt-number" Label="Rechnungsnummer" For="() => Data.InvoiceNumber">
        <InputText id="receipt-number" @bind-Value="Data.InvoiceNumber" />
    </FormField>
    <FormField Id="receipt-date" Label="Rechnungsdatum" For="() => Data.InvoiceDate" Required="true">
        <InputDate id="receipt-date" @bind-Value="Data.InvoiceDate" />
    </FormField>
    <FormField Id="receipt-from" Label="Leistung von" For="() => Data.ServiceFrom">
        <InputDate id="receipt-from" @bind-Value="Data.ServiceFrom" />
    </FormField>
    <FormField Id="receipt-until" Label="Leistung bis" For="() => Data.ServiceTo">
        <InputDate id="receipt-until" @bind-Value="Data.ServiceTo" />
    </FormField>
    <FormField Id="receipt-gross" Label="Brutto" For="() => Data.Gross" Required="true" Hint="Gutschriften negativ">
        <InputAmount id="receipt-gross" @bind-Value="Data.Gross" />
    </FormField>
    <FormField Id="receipt-net" Label="Netto" For="() => Data.Net">
        <InputAmount id="receipt-net" @bind-Value="Data.Net" />
    </FormField>
    <FormField Id="receipt-vat" Label="Umsatzsteuer" For="() => Data.Vat">
        <InputAmount id="receipt-vat" @bind-Value="Data.Vat" />
    </FormField>
    <FormField Id="receipt-due" Label="Fällig am" For="() => Data.DueOn">
        <InputDate id="receipt-due" @bind-Value="Data.DueOn" />
    </FormField>
    <FormField Id="receipt-paid" Label="Bezahlt am" For="() => Data.PaidOn" Hint="Bei Bankumsätzen später über die Zuordnung.">
        <InputDate id="receipt-paid" @bind-Value="Data.PaidOn" />
    </FormField>
</div>
<details class="field">
    <summary>Brennstoff (Menge, CO₂)</summary>
    <div class="form-grid">
        <FormField Id="receipt-quantity" Label="Menge" For="() => Data.FuelQuantity">
            <InputNumber id="receipt-quantity" @bind-Value="Data.FuelQuantity" step="0.001" />
        </FormField>
        <FormField Id="receipt-unit" Label="Einheit" For="() => Data.FuelUnit" Hint="l, kWh, kg, m³">
            <InputText id="receipt-unit" @bind-Value="Data.FuelUnit" />
        </FormField>
        <FormField Id="receipt-co2" Label="CO₂ (kg)" For="() => Data.Co2Kg" Hint="Pflichtangabe des Lieferanten (CO2KostAufG)">
            <InputNumber id="receipt-co2" @bind-Value="Data.Co2Kg" step="0.001" />
        </FormField>
    </div>
</details>
<FormField Id="receipt-note" Label="Notiz" For="() => Data.Note">
    <InputTextArea id="receipt-note" @bind-Value="Data.Note" rows="2" />
</FormField>

@code {
    [Parameter, EditorRequired]
    public ReceiptInput Data { get; set; } = default!;

    [Parameter, EditorRequired]
    public ReceiptOptions Options { get; set; } = default!;
}
