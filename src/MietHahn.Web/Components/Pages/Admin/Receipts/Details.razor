@page "/verwaltung/belege/{Id:guid}"
@using MietHahn.Application.Files
@inject IReceiptService Receipts
@inject IFileStore Storage
@inject Redirector Redirector

@if (receipt is null)
{
    <PageHeader Title="Beleg nicht gefunden" Back="/verwaltung/belege" BackText="Alle Belege" />
    return;
}

<PageHeader Title="@($"{receipt.Supplier} {Format.Money(receipt.Data.Gross)}")" Subtitle="@($"Rechnung {receipt.Data.InvoiceNumber} vom {Format.Date(receipt.Data.InvoiceDate)}")" Back="/verwaltung/belege" BackText="Alle Belege" />

<StatusMessage />
<ErrorList Errors="errors" />

<section>
    <h2>Kostenaufteilung</h2>
    @if (receipt.Open != 0)
    {
        <p class="message message-info" role="status">Noch @Format.Money(receipt.Open) nicht aufgeteilt (aufgeteilt @Format.Money(receipt.Allocated) von @Format.Money(receipt.Data.Gross)).</p>
    }
    @if (receipt.Items.Count > 0)
    {
        <form method="post" @formname="items" @onsubmit="RemoveCostItemAsync">
            <AntiforgeryToken />
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Kostenart</th><th>Objekt</th><th>Zeitraum</th><th class="number">Betrag</th><th>§ 35a</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in receipt.Items)
                        {
                            <tr>
                                <td>@p.CostTypeText @if (!p.Allocable) {<span class="status">nicht umlagefähig</span>}</td>
                                <td>@p.Property@(p.Unit is null ? "" : $", {p.Unit}")</td>
                                <td>@Format.Period(p.BillingPeriod)</td>
                                <td class="number">@Format.Money(p.Amount)</td>
                                <td>@(p.Section35a == Section35a.None ? "–" : $"{Labels.From(p.Section35a)}: {Format.Money(p.LaborCosts)}")</td>
                                <td><button type="submit" class="button button-danger" name="PositionId" value="@p.Id" aria-label="Position @p.CostTypeText entfernen">Entfernen</button></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th colspan="3">Summe</th><th class="number">@Format.Money(receipt.Allocated)</th><th colspan="2"></th></tr></tfoot>
                </table>
            </div>
        </form>
    }
    @* During static rendering an intermediate state may be rendered before the option lists are loaded. *@
    @if (receipt.Open != 0 && selection is not null)
    {
        <h3>Position hinzufügen</h3>
        <EditForm Model="Position" FormName="item" OnValidSubmit="AddItemAsync">
            <DataAnnotationsValidator />
            <CostItemFields Position="Position!" Options="selection" />
            <button type="submit" class="button">Position hinzufügen</button>
        </EditForm>
    }
</section>

<section>
    <h2>Dateien</h2>
    @if (receipt.Files.Count == 0)
    {
        <p class="small">Noch keine Datei.</p>
    }
    else
    {
        <form method="post" @formname="files" @onsubmit="RemoveFileAsync">
            <AntiforgeryToken />
            <ul>
                @foreach (var d in receipt.Files)
                {
                    <li>
                        Seite @d.Page: <a href="/dateien/@d.FileId" target="_blank" rel="noopener">@d.Name</a>
                        (<a href="/dateien/@d.FileId?download=true">herunterladen</a>)
                        <button type="submit" class="button button-danger" name="FileId" value="@d.FileId" aria-label="Seite @d.Page entfernen">Entfernen</button>
                    </li>
                }
            </ul>
        </form>
        var first = receipt.Files[0];
        @if (first.MimeType.StartsWith("image/", StringComparison.Ordinal))
        {
            <img class="document-preview" src="/dateien/@first.FileId" alt="Seite 1" />
        }
        else if (first.MimeType == "application/pdf")
        {
            <iframe class="document-preview" src="/dateien/@first.FileId" title="Seite 1"></iframe>
        }
    }
    <form method="post" enctype="multipart/form-data" @formname="upload" @onsubmit="UploadAsync" class="form-row">
        <AntiforgeryToken />
        <div class="field">
            <label for="more">Seiten hinzufügen</label>
            <input type="file" id="more" name="Additional" accept="application/pdf,image/*" multiple required />
        </div>
        <div class="field field-action"><button type="submit" class="button">Hochladen</button></div>
    </form>
</section>

@if (selection is not null)
{
    <section>
        <h2>Angaben</h2>
        <EditForm Model="Data" FormName="receipt" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ReceiptFields Data="Data!" Options="selection" />
            <button type="submit" class="button button-primary">Speichern</button>
        </EditForm>
    </section>
}

<section>
    <h2>Löschen</h2>
    <DangerAction Text="Beleg löschen" Confirmation="Der Beleg wird logisch gelöscht; die Dateien bleiben im Archiv." ConfirmText="Ja, löschen" FormName="delete" Confirmed="DeleteAsync" />
</section>

<ChangeHistory EntityType="@nameof(Receipt)" EntityId="Id" />

@code {
    private ReceiptDetails? receipt;
    private ReceiptOptions? selection;
    private IReadOnlyList<string>? errors;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "receipt")]
    private ReceiptInput? Data { get; set; }

    [SupplyParameterFromForm(FormName = "item")]
    private CostItemInput? Position { get; set; }

    [SupplyParameterFromForm(FormName = "items")]
    private Guid? PositionId { get; set; }

    [SupplyParameterFromForm(FormName = "files")]
    private Guid? FileId { get; set; }

    [SupplyParameterFromForm(FormName = "upload")]
    private IFormFileCollection? Additional { get; set; }

    private string Target => $"/verwaltung/belege/{Id}";

    protected override async Task OnInitializedAsync()
    {
        var form = Data;
        Data ??= new();
        Position ??= new();
        receipt = await Receipts.GetAsync(Id);
        selection = await Receipts.OptionsAsync();
        if (form is null && receipt is not null)
        {
            Data = receipt.Data;
        }
    }

    private Task SaveAsync() => ExecuteAsync(Receipts.UpdateAsync(Id, Data!), "Die Angaben wurden gespeichert.");

    private Task AddItemAsync() => ExecuteAsync(Receipts.AddItemAsync(Id, Position!), "Die Position wurde hinzugefügt.");

    private Task RemoveCostItemAsync() => PositionId is { } id ? ExecuteAsync(Receipts.RemoveCostItemAsync(Id, id), "Die Position wurde entfernt.") : Task.CompletedTask;

    private Task RemoveFileAsync() => FileId is { } id ? ExecuteAsync(Receipts.RemoveFileAsync(Id, id), "Die Seite wurde entfernt.") : Task.CompletedTask;

    private Task DeleteAsync() => ExecuteAsync(Receipts.DeleteAsync(Id), "Der Beleg wurde gelöscht.", "/verwaltung/belege");

    private async Task UploadAsync()
    {
        try
        {
            var ids = new List<Guid>();
            foreach (var file in Additional?.Where(d => d.Length > 0) ?? [])
            {
                await using var content = file.OpenReadStream();
                ids.Add((await Storage.SaveAsync(content, file.FileName)).Id);
            }

            await ExecuteAsync(Receipts.AddFilesAsync(Id, ids), ids.Count == 1 ? "Die Seite wurde hinzugefügt." : $"{ids.Count} Seiten wurden hinzugefügt.");
        }
        catch (FileRejectedException ex)
        {
            errors = [ex.Message];
        }
    }

    private async Task ExecuteAsync(Task<Result> command, string success, string? destination = null)
    {
        var result = await command;
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage(destination ?? Target, success, HttpContext);
        }
        else
        {
            errors = result.Errors;
        }
    }
}
