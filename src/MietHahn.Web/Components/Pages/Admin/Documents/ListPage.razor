@page "/verwaltung/dokumente"
@inject IDocumentLibrary Storage

<PageHeader Title="Dokumente" Subtitle="Verträge, Protokolle, Rechnungen, Versicherungen und mehr, je Objekt, Einheit, Vertrag oder Person.">
    <Actions>
        <a class="knopf knopf-primaer" href="/verwaltung/dokumente/neu">Dokument hochladen</a>
    </Actions>
</PageHeader>

<StatusMessage />

<form method="get" class="formular-zeile suchleiste" role="search">
    <div class="feld">
        <label for="suche">Suche</label>
        <input id="suche" type="search" name="q" value="@Q" placeholder="Titel, Schlagwort, Dateiname" />
    </div>
    <div class="feld">
        <label for="kategorie">Kategorie</label>
        <select id="kategorie" name="kategorie">
            <option value="" selected="@(Category is null)">Alle</option>
            @foreach (var value in Enum.GetValues<DocumentCategory>())
            {
                <option value="@value" selected="@(Category == value)">@Labels.From(value)</option>
            }
        </select>
    </div>
    <div class="feld feld-aktion">
        <button type="submit" class="knopf">Suchen</button>
    </div>
</form>

@if (lines is { Count: 0 })
{
    <EmptyState Text="@(!string.IsNullOrWhiteSpace(Q) || Category is not null ? "Keine passenden Dokumente." : "Noch keine Dokumente.")" />
}
else if (lines is not null)
{
    <DocumentTable Rows="lines" />
}

@code {
    private IReadOnlyList<DocumentRow>? lines;

    [SupplyParameterFromQuery]
    private string? Q { get; set; }

    // Enums cannot be bound directly from the query string.
    [SupplyParameterFromQuery(Name = "kategorie")]
    private string? CategoryText { get; set; }

    private DocumentCategory? Category => Enum.TryParse<DocumentCategory>(CategoryText, out var value) ? value : null;

    protected override async Task OnParametersSetAsync() =>
        lines = await Storage.SearchAsync(new DocumentQuery(Q, Category));
}
