@page "/verwaltung/dokumente"
@rendermode InteractiveServer
@using MudBlazor
@inject IDocumentLibrary Storage

<InteractiveShell>
    <PageHeader Title="Dokumente" Subtitle="Verträge, Protokolle, Rechnungen, Versicherungen und mehr, je Objekt, Einheit, Vertrag oder Person.">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile" Href="/verwaltung/dokumente/neu">Dokument hochladen</MudButton>
        </Actions>
    </PageHeader>

    <div class="form-row search-bar" role="search">
        <AppTextField Value="search" Label="Suche" Type="search" Placeholder="Titel, Schlagwort, Dateiname" Immediate="true" DebounceMilliseconds="300" OnDebounced="OnSearchChanged" Clearable="true" />
        <AppSelect T="DocumentCategory?" Value="category" ValueChanged="OnCategoryChanged" Label="Kategorie" Items="categories" Text="@(v => v is { } c ? Labels.From(c) : "")" EmptyText="Alle" />
    </div>

    @if (lines is { Count: 0 })
    {
        <EmptyState Text="@(!string.IsNullOrWhiteSpace(search) || category is not null ? "Keine passenden Dokumente." : "Noch keine Dokumente.")" />
    }
    else if (lines is not null)
    {
        <DocumentTable Rows="lines" />
    }
</InteractiveShell>

@code {
    private static readonly IReadOnlyList<DocumentCategory?> categories = Enum.GetValues<DocumentCategory>().Select(c => (DocumentCategory?)c).ToList();

    private IReadOnlyList<DocumentRow>? lines;
    private string? search;
    private DocumentCategory? category;

    // The query string only provides the start values (see ADR 0005).
    [SupplyParameterFromQuery(Name = "q")]
    private string? InitialSearch { get; set; }

    [SupplyParameterFromQuery(Name = "kategorie")]
    private string? InitialCategory { get; set; }

    protected override async Task OnInitializedAsync()
    {
        search = InitialSearch;
        category = Enum.TryParse<DocumentCategory>(InitialCategory, out var initial) ? initial : null;
        await LoadAsync();
    }

    private async Task OnSearchChanged(string? text)
    {
        search = text;
        await LoadAsync();
    }

    private async Task OnCategoryChanged(DocumentCategory? value)
    {
        category = value;
        await LoadAsync();
    }

    private async Task LoadAsync() => lines = await Storage.SearchAsync(new DocumentQuery(search, category));
}
