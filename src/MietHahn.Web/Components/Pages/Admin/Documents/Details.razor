@page "/verwaltung/dokumente/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor
@inject IDocumentLibrary Storage
@inject NavigationManager Navigation
@inject Notifier Notify
@inject Confirmations Confirm

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (document is null)
{
    <PageHeader Title="Dokument nicht gefunden" Back="/verwaltung/dokumente" BackText="Alle Dokumente" />
}
else
{

<PageHeader Title="@document.Document.Title" Subtitle="@($"{Labels.From(document.Document.Category)} · {document.Document.Reference}")" Back="/verwaltung/dokumente" BackText="Alle Dokumente">
    <Actions>
        <MudButton Variant="Variant.Outlined" Href="@($"/dateien/{document.Document.FileId}?download=true")">Herunterladen</MudButton>
    </Actions>
</PageHeader>

<ErrorList Errors="errors" />

<dl class="details">
    <dt>Datei</dt><dd>@document.FileName (@Size(document.Document.Size))</dd>
    <dt>Hochgeladen</dt><dd>@Format.Timestamp(document.UploadedAt)@(document.UploadedBy is null ? "" : $" von {document.UploadedBy}")</dd>
    <dt>Freigabe</dt><dd>@DocumentTable.Share(document.Document)</dd>
    @if (document.Document.ForTenants)
    {
        <dt>Geöffnet im Portal</dt>
        <dd>
            @if (reads is { Count: > 0 })
            {
                @string.Join("; ", reads.Select(l => $"{l.Name} am {Format.Timestamp(l.ReadAt)}"))
            }
            else
            {
                <span>noch nicht</span>
            }
        </dd>
    }
</dl>

@if (document.Document.MimeType.StartsWith("image/", StringComparison.Ordinal))
{
    <img class="document-preview" src="/dateien/@document.Document.FileId" alt="Vorschau: @document.Document.Title" />
}
else if (document.Document.MimeType == "application/pdf")
{
    <iframe class="document-preview" src="/dateien/@document.Document.FileId" title="Vorschau: @document.Document.Title"></iframe>
}

@if (selection is not null && data is not null)
{
    <section>
        <h2>Angaben</h2>
        <EditForm Model="data" OnValidSubmit="SaveAsync" novalidate>
            <DataAnnotationsValidator />
            <DocumentEditor Data="data" Options="selection" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
        </EditForm>
    </section>
}

<section>
    <h2>Löschen</h2>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync">Dokument löschen</MudButton>
</section>

<ChangeHistory EntityType="@nameof(Document)" EntityId="Id" />
}
</InteractiveShell>

@code {
    private DocumentDetails? document;
    private DocumentInput? data;
    private ReferenceOptions? selection;
    private IReadOnlyList<string>? errors;
    private IReadOnlyList<DocumentReadView>? reads;
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        document = await Storage.GetAsync(Id);
        data = document?.Data;
        reads = document is null ? null : await Storage.ReadsAsync(Id);
        selection = await Storage.ReferenceOptionsAsync();
        loaded = true;
    }

    private async Task SaveAsync()
    {
        var result = await Storage.UpdateAsync(Id, data!);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success("Die Angaben wurden gespeichert.");
            document = await Storage.GetAsync(Id);
        }
    }

    private async Task DeleteAsync()
    {
        if (!await Confirm.AskAsync("Dokument löschen", "Das Dokument wird aus der Ablage entfernt und ist für Mieter und Hausmeister nicht mehr sichtbar.", "Ja, löschen"))
        {
            return;
        }

        var result = await Storage.DeleteAsync(Id);
        if (result.Succeeded)
        {
            Navigation.NavigateTo("/verwaltung/dokumente?meldung=geloescht");
        }
        else
        {
            errors = result.Errors;
        }
    }

    private static string Size(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB" : $"{bytes / 1024.0 / 1024.0:0.#} MB";
}
