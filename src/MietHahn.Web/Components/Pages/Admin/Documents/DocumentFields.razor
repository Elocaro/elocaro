@* Input fields of a document; sits inside an EditForm with Model = Data. *@
<div class="form-grid">
    <FormField Id="document-title" Label="Titel" For="() => Data.Title" Required="@TitleRequired" Hint="@(TitleRequired ? null : "Leer lassen für den Dateinamen.")">
        <InputText id="document-title" @bind-Value="Data.Title" />
    </FormField>
    <FormField Id="document-category" Label="Kategorie" For="() => Data.Category">
        <InputSelect id="document-category" @bind-Value="Data.Category">
            @foreach (var value in Enum.GetValues<DocumentCategory>())
            {
                <option value="@value">@Labels.From(value)</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="document-date" Label="Datum des Dokuments" For="() => Data.Date">
        <InputDate id="document-date" @bind-Value="Data.Date" />
    </FormField>
    <FormField Id="document-expiry" Label="Gültig bis" For="() => Data.ExpiresOn" Hint="Erinnerung 60 Tage vorher, z. B. Energieausweis, Versicherung.">
        <InputDate id="document-expiry" @bind-Value="Data.ExpiresOn" />
    </FormField>
    <FormField Id="document-tags" Label="Schlagworte" For="() => Data.Tags" Hint="Kommagetrennt, z. B. „Heizung, Wartung 2026“">
        <InputText id="document-tags" @bind-Value="Data.Tags" />
    </FormField>
</div>

<h3>Bezug</h3>
<p class="small">Mindestens ein Bezug. Dokumente eines Vertrags erscheinen auch bei der Einheit und dem Objekt.</p>
<div class="form-grid">
    <FormField Id="document-property" Label="Objekt" For="() => Data.PropertyId">
        <InputSelect id="document-property" @bind-Value="Data.PropertyId">
            <option value="">–</option>
            @foreach (var option in Options.Properties)
            {
                <option value="@option.Id">@option.Name</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="document-unit" Label="Einheit" For="() => Data.UnitId">
        <InputSelect id="document-unit" @bind-Value="Data.UnitId">
            <option value="">–</option>
            @foreach (var option in Options.Units)
            {
                <option value="@option.Id">@option.Name</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="document-lease" Label="Vertrag" For="() => Data.LeaseId">
        <InputSelect id="document-lease" @bind-Value="Data.LeaseId">
            <option value="">–</option>
            @foreach (var option in Options.Leases)
            {
                <option value="@option.Id">@option.Name</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="document-person" Label="Person" For="() => Data.PersonId">
        <InputSelect id="document-person" @bind-Value="Data.PersonId">
            <option value="">–</option>
            @foreach (var option in Options.People)
            {
                <option value="@option.Id">@option.Name</option>
            }
        </InputSelect>
    </FormField>
</div>

<div class="form-row">
    <div class="field field-checkbox">
        <InputCheckbox id="document-tenant" @bind-Value="Data.SharedWithTenants" />
        <label for="document-tenant">Für Mieter freigeben</label>
    </div>
    <div class="field field-checkbox">
        <InputCheckbox id="document-caretaker" @bind-Value="Data.SharedWithCaretakers" />
        <label for="document-caretaker">Für Hausmeister freigeben</label>
    </div>
</div>
<p class="small">Mieter sehen freigegebene Dokumente ihres Vertrags, ihrer Person und des Hauses bzw. der Wohnung, in der sie aktuell wohnen. Hausmeister sehen freigegebene Dokumente ihrer zugeordneten Objekte.</p>

<FormField Id="document-note" Label="Notiz" For="() => Data.Note">
    <InputTextArea id="document-note" @bind-Value="Data.Note" rows="3" />
</FormField>

@code {
    [Parameter, EditorRequired]
    public DocumentInput Data { get; set; } = default!;

    [Parameter, EditorRequired]
    public ReferenceOptions Options { get; set; } = default!;

    [Parameter]
    public bool TitleRequired { get; set; } = true;
}
