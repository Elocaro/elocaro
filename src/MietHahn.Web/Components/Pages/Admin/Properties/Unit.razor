@page "/verwaltung/einheiten/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor
@inject IPropertyService Admin
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject Notifier Notify
@inject Confirmations Confirm

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (unit is null)
{
    <PageHeader Title="Einheit nicht gefunden" Back="/verwaltung/objekte" BackText="Alle Objekte" />
}
else
{

<PageHeader Title="@unit.Data.Name" Subtitle="@Subtitle" Back="@($"/verwaltung/objekte/{unit.PropertyId}")" BackText="@unit.PropertyName" />

<ErrorList Errors="errors" />
@foreach (var hint in unit.ValidationHints)
{
    <Notice Level="NoticeLevel.Info">@hint</Notice>
}

@if (!unit.IsSharedFlat)
{
    <section>
        <h2>Belegung</h2>
        <p><OccupancyDisplay Occupancy="unit.Occupancy" /></p>
    </section>
    <LeaseHistory RentalUnitId="Id" />
}

<section>
    <h2>Zimmer (WG)</h2>
    @if (unit.IsSharedFlat)
    {
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Zimmer</th><th>Möblierung</th><th class="number">Fläche</th><th class="number">Anteil Gemeinschaft</th><th>Belegung</th></tr></thead>
                <tbody>
                    @foreach (var room in unit.Room)
                    {
                        <tr>
                            <td><a href="/verwaltung/zimmer/@room.Id">@room.Name</a></td>
                            <td>@Labels.From(room.Furnishing)</td>
                            <td class="number">@Format.Area(room.Area?.Area)</td>
                            <td class="number">@Format.Area(room.Area?.SecondaryArea)</td>
                            <td><OccupancyDisplay Occupancy="room.Occupancy" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="small">Wird die Wohnung als WG zimmerweise vermietet, hier die Zimmer anlegen. Danach sind nur noch die Zimmer einzeln vermietbar.</p>
    }
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddRoomAsync">Zimmer hinzufügen</MudButton>
</section>

<AreaSection Save="input => Admin.SetUnitAreaAsync(Id, input)" OnSaved="LoadAsync" Current="unit.Area" History="unit.AreaHistory"
                 AreaText="Wohnfläche" AdditionalText="Heizfläche" AdditionalHint="Leer lassen, wenn gleich der Wohnfläche." />

<section>
    <h2>Angaben &amp; Ausstattung</h2>
    <EditForm Model="data" OnValidSubmit="SaveAsync" novalidate>
        <DataAnnotationsValidator />
        <UnitEditor Data="data" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
    </EditForm>
</section>

@if (!unit.IsSharedFlat)
{
    <section>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync">Einheit löschen</MudButton>
    </section>
}

<DocumentsSection UnitId="Id" />

<ChangeHistory EntityType="@nameof(MietHahn.Domain.Properties.Unit)" EntityId="Id" />
}
</InteractiveShell>

@code {
    private UnitDetails? unit;
    private UnitInput data = new();
    private IReadOnlyList<string>? errors;
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    private string Subtitle => $"{Labels.From(unit!.Data.Type)}{(unit.Data.Location is { } level ? ", " + level : "")} · {unit.PropertyName}";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        unit = await Admin.GetUnitAsync(Id);
        if (unit is not null)
        {
            data = unit.Data;
        }

        loaded = true;
    }

    private async Task AddRoomAsync()
    {
        var dialog = await Dialogs.ShowAsync<RoomDialog>("Zimmer hinzufügen", new DialogParameters { ["UnitId"] = Id }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task SaveAsync()
    {
        var result = await Admin.UpdateUnitAsync(Id, data);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success("Die Angaben wurden gespeichert.");
            await LoadAsync();
        }
    }

    private async Task DeleteAsync()
    {
        if (!await Confirm.AskAsync("Einheit löschen", "Die Einheit wird gelöscht. Fortfahren?", "Ja, löschen"))
        {
            return;
        }

        var propertyId = unit!.PropertyId;
        var result = await Admin.DeleteUnitAsync(Id);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"/verwaltung/objekte/{propertyId}?meldung=geloescht");
        }
        else
        {
            errors = result.Errors;
        }
    }
}
