@if (Occupancy is null)
{
    <StatusChip Level="StatusLevel.Warning">Leerstand</StatusChip>
}
else
{
    <a href="/verwaltung/vertraege/@Occupancy.LeaseId">@Occupancy.Tenant</a>
    <span class="small">seit @Format.Date(Occupancy.Start)@(Occupancy.End is { } end ? $", bis {Format.Date(end)}" : "")</span>
}

@code {
    [Parameter]
    public Occupancy? Occupancy { get; set; }
}
