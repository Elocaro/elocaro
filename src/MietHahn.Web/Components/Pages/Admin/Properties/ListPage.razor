@page "/verwaltung/objekte"
@inject IPropertyService Admin

<PageHeader Title="Objekte" Subtitle="Häuser mit ihren Wohnungen und WG-Zimmern.">
    <Actions>
        <a class="button button-primary" href="/verwaltung/objekte/neu">Objekt anlegen</a>
    </Actions>
</PageHeader>

<StatusMessage />

@if (properties is { Count: 0 })
{
    <EmptyState Text="Noch keine Objekte. Lege zuerst ein Haus an, danach die Wohnungen." />
}
else if (properties is not null)
{
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr><th>Objekt</th><th>Anschrift</th><th class="number">Einheiten</th><th class="number">Wohnfläche</th><th>Belegung</th></tr>
            </thead>
            <tbody>
                @foreach (var property in properties)
                {
                    <tr>
                        <td><a href="/verwaltung/objekte/@property.Id">@property.Name</a></td>
                        <td>@property.Address</td>
                        <td class="number">@property.Units</td>
                        <td class="number">@Format.Area(property.LivingArea)</td>
                        <td>
                            @property.Rented von @property.RentalUnits vermietet
                            @if (property.Vacancy > 0)
                            {
                                <StatusChip Level="StatusLevel.Warning">@property.Vacancy leer</StatusChip>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<PropertyOverview>? properties;

    protected override async Task OnInitializedAsync() => properties = await Admin.ListAsync();
}
