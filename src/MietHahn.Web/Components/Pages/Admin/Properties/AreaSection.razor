@* Current area, "new value from …" form and history. The page processes the form (FormName "flaeche"). *@
<section>
    <h2>Flächen</h2>
    @if (Current is null)
    {
        <Notice Level="NoticeLevel.Info">Noch keine Fläche hinterlegt.</Notice>
    }
    else
    {
        <dl class="details">
            <dt>@AreaText</dt><dd>@Format.Area(Current.Area)</dd>
            <dt>@AdditionalText</dt><dd>@Format.Area(Current.SecondaryArea)</dd>
            <dt>Gültig</dt><dd>@Format.Period(Current.Validity)</dd>
        </dl>
    }

    <details class="disclosure" open="@(Current is null)">
        <summary>@(Current is null ? "Fläche erfassen" : "Fläche ändern (neuer Stand ab Stichtag)")</summary>
        <EditForm Model="Input" FormName="area" OnValidSubmit="OnSave" class="form-row">
            <DataAnnotationsValidator />
            <FormField Id="area-valid-from" Label="Gültig ab" For="() => Input.From" Required="true">
                <InputDate id="area-valid-from" @bind-Value="Input.From" />
            </FormField>
            <FormField Id="area-value" Label="@(AreaText + " (m²)")" For="() => Input.Area" Required="true">
                <InputArea id="area-value" @bind-Value="Input.Area" />
            </FormField>
            <FormField Id="area-supplement" Label="@(AdditionalText + " (m²)")" For="() => Input.SecondaryArea" Hint="@AdditionalHint">
                <InputArea id="area-supplement" @bind-Value="Input.SecondaryArea" />
            </FormField>
            <div class="field field-action">
                <button type="submit" class="button">Fläche speichern</button>
            </div>
        </EditForm>
        <p class="small">Der bisherige Stand endet am Tag vor dem Stichtag und bleibt für frühere Abrechnungen erhalten.</p>
    </details>

    @if (History.Count > 1)
    {
        <h3>Verlauf</h3>
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Zeitraum</th><th class="number">@AreaText</th><th class="number">@AdditionalText</th></tr></thead>
                <tbody>
                    @foreach (var entry in History)
                    {
                        <tr>
                            <td>@Format.Period(entry.Validity)</td>
                            <td class="number">@Format.Area(entry.Area)</td>
                            <td class="number">@Format.Area(entry.SecondaryArea)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public AreaInput Input { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public AreaReading? Current { get; set; }

    [Parameter]
    public IReadOnlyList<AreaReading> History { get; set; } = [];

    [Parameter, EditorRequired]
    public string AreaText { get; set; } = "";

    [Parameter, EditorRequired]
    public string AdditionalText { get; set; } = "";

    [Parameter]
    public string? AdditionalHint { get; set; }
}
