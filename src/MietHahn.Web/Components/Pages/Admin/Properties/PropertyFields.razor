@* Input fields of a property; sits inside an EditForm with Model = Data. *@
<div class="form-grid">
    <FormField Id="designation" Label="Bezeichnung" For="() => Data.Name" Required="true" Hint="z. B. „Lindenweg 3“">
        <InputText id="designation" @bind-Value="Data.Name" />
    </FormField>
    <FormField Id="street" Label="Straße und Hausnummer" For="() => Data.Street" Required="true">
        <InputText id="street" @bind-Value="Data.Street" autocomplete="street-address" />
    </FormField>
    <FormField Id="postal-code" Label="PLZ" For="() => Data.PostalCode" Required="true">
        <InputText id="postal-code" @bind-Value="Data.PostalCode" inputmode="numeric" autocomplete="postal-code" />
    </FormField>
    <FormField Id="city" Label="Ort" For="() => Data.City" Required="true">
        <InputText id="city" @bind-Value="Data.City" autocomplete="address-level2" />
    </FormField>
    <FormField Id="year-built" Label="Baujahr" For="() => Data.YearBuilt">
        <InputNumber id="year-built" @bind-Value="Data.YearBuilt" inputmode="numeric" />
    </FormField>
    <FormField Id="heating-type" Label="Heizungsart" For="() => Data.HeatingType">
        <InputSelect id="heating-type" @bind-Value="Data.HeatingType">
            @foreach (var value in Enum.GetValues<HeatingType>())
            {
                <option value="@value">@Labels.From(value)</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="energy-source" Label="Energieträger" For="() => Data.EnergySource" Hint="Wichtig für die CO₂-Kostenaufteilung.">
        <InputSelect id="energy-source" @bind-Value="Data.EnergySource">
            @foreach (var value in Enum.GetValues<EnergySource>())
            {
                <option value="@value">@Labels.From(value)</option>
            }
        </InputSelect>
    </FormField>
    <FormField Id="cadastral-district" Label="Gemarkung" For="() => Data.CadastralDistrict">
        <InputText id="cadastral-district" @bind-Value="Data.CadastralDistrict" />
    </FormField>
    <FormField Id="parcel" Label="Flur/Flurstück" For="() => Data.ParcelNumber">
        <InputText id="parcel" @bind-Value="Data.ParcelNumber" />
    </FormField>
    <FormField Id="property-tax" Label="Grundsteuer-Aktenzeichen" For="() => Data.PropertyTaxReference">
        <InputText id="property-tax" @bind-Value="Data.PropertyTaxReference" />
    </FormField>
</div>
<FormField Id="notes" Label="Notizen" For="() => Data.Notes">
    <InputTextArea id="notes" @bind-Value="Data.Notes" rows="3" />
</FormField>

@code {
    [Parameter, EditorRequired]
    public PropertyInput Data { get; set; } = default!;
}
