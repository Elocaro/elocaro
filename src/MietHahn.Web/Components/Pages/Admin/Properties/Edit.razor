@page "/verwaltung/objekte/{Id:guid}/bearbeiten"
@using MietHahn.Application.Files
@inject IPropertyService Admin
@inject IFileStore Storage
@inject Redirector Redirector

@if (property is null)
{
    <PageHeader Title="Objekt nicht gefunden" Back="/verwaltung/objekte" BackText="Alle Objekte" />
    return;
}

<PageHeader Title="@($"{property.Data.Name} bearbeiten")" Back="@($"/verwaltung/objekte/{Id}")" BackText="Zum Objekt" />

<ErrorList Errors="errors" />

<EditForm Model="Data" FormName="property" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <PropertyFields Data="Data!" />
    <button type="submit" class="button button-primary">Speichern</button>
</EditForm>

<section>
    <h2>Foto</h2>
    @if (property.ImageFileId is { } image)
    {
        <img class="property-image" src="/dateien/@image" alt="Aktuelles Foto" />
    }
    <form method="post" enctype="multipart/form-data" @formname="image" @onsubmit="UploadImageAsync" class="form-row">
        <AntiforgeryToken />
        <div class="field">
            <label for="image">@(property.ImageFileId is null ? "Foto hochladen" : "Foto ersetzen")</label>
            <input type="file" id="image" name="Image" accept="image/jpeg,image/png,image/webp,image/heic" capture="environment" required />
            <span class="field-hint">Fotos werden verkleinert, gedreht und ohne Metadaten (GPS) gespeichert.</span>
        </div>
        <div class="field field-action">
            <button type="submit" class="button">Hochladen</button>
        </div>
    </form>
    @if (property.ImageFileId is not null)
    {
        <DangerAction Text="Foto entfernen" Confirmation="Soll das Foto des Objekts entfernt werden?" ConfirmText="Ja, Foto entfernen" FormName="image-remove" Confirmed="RemoveImageAsync" />
    }
</section>

@code {
    private PropertyDetails? property;
    private IReadOnlyList<string>? errors;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "property")]
    private PropertyInput? Data { get; set; }

    [SupplyParameterFromForm(FormName = "image")]
    private IFormFile? Image { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var form = Data;
        Data ??= new();
        property = await Admin.GetAsync(Id);
        if (form is null && property is not null)
        {
            Data = property.Data;
        }
    }

    private Task SaveAsync() => ExecuteAsync(Admin.UpdateAsync(Id, Data!), $"/verwaltung/objekte/{Id}", "Die Angaben wurden gespeichert.");

    private async Task UploadImageAsync()
    {
        if (Image is null || Image.Length == 0)
        {
            errors = ["Bitte ein Foto auswählen."];
            return;
        }

        try
        {
            await using var content = Image.OpenReadStream();
            var file = await Storage.SaveAsync(content, Image.FileName);
            await ExecuteAsync(Admin.SetImageAsync(Id, file.Id), $"/verwaltung/objekte/{Id}", "Das Foto wurde gespeichert.");
        }
        catch (FileRejectedException ex)
        {
            errors = [ex.Message];
        }
    }

    private Task RemoveImageAsync() => ExecuteAsync(Admin.SetImageAsync(Id, null), $"/verwaltung/objekte/{Id}/bearbeiten", "Das Foto wurde entfernt.");

    private async Task ExecuteAsync(Task<Result> command, string destination, string success)
    {
        var result = await command;
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage(destination, success, HttpContext);
        }
        else
        {
            errors = result.Errors;
        }
    }
}
