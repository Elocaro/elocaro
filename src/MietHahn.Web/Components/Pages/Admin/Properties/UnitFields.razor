@* Input fields of a unit; sits inside an EditForm with Model = Data. *@
<div class="form-grid">
    <FormField Id="unit-designation" Label="Bezeichnung" For="() => Data.Name" Required="true" Hint="z. B. „Wohnung 1“">
        <InputText id="unit-designation" @bind-Value="Data.Name" />
    </FormField>
    <FormField Id="unit-location" Label="Lage" For="() => Data.Location" Hint="z. B. „EG links“">
        <InputText id="unit-location" @bind-Value="Data.Location" />
    </FormField>
    <FormField Id="unit-type" Label="Art" For="() => Data.Type">
        <InputSelect id="unit-type" @bind-Value="Data.Type">
            @foreach (var value in Enum.GetValues<UnitType>())
            {
                <option value="@value">@Labels.From(value)</option>
            }
        </InputSelect>
    </FormField>
    @if (WithFeatures)
    {
        <FormField Id="unit-room-count" Label="Zimmeranzahl" For="() => Data.RoomCount" Hint="z. B. 2,5">
            <InputArea id="unit-room-count" @bind-Value="Data.RoomCount" />
        </FormField>
        <FormField Id="unit-bathroom" Label="Bad" For="() => Data.Bathroom" Hint="z. B. „Wanne und Dusche, Fenster“">
            <InputText id="unit-bathroom" @bind-Value="Data.Bathroom" />
        </FormField>
        <FormField Id="unit-energy" Label="Energiestandard" For="() => Data.EnergyStandard">
            <InputText id="unit-energy" @bind-Value="Data.EnergyStandard" />
        </FormField>
    }
</div>
@if (WithFeatures)
{
    <div class="form-row">
        <div class="field field-checkbox">
            <InputCheckbox id="unit-balcony" @bind-Value="Data.Balcony" />
            <label for="unit-balcony">Balkon/Terrasse</label>
        </div>
        <div class="field field-checkbox">
            <InputCheckbox id="unit-fitted-kitchen" @bind-Value="Data.FittedKitchen" />
            <label for="unit-fitted-kitchen">Einbauküche</label>
        </div>
    </div>
    <FormField Id="unit-equipment" Label="Weitere Ausstattung" For="() => Data.Amenities">
        <InputTextArea id="unit-equipment" @bind-Value="Data.Amenities" rows="2" />
    </FormField>
}

@code {
    [Parameter, EditorRequired]
    public UnitInput Data { get; set; } = default!;

    /// <summary>For quick creation only name, location and type.</summary>
    [Parameter]
    public bool WithFeatures { get; set; } = true;
}
