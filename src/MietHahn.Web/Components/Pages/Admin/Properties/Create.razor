@page "/verwaltung/objekte/neu"
@inject IPropertyService Admin
@inject Redirector Redirector

<PageHeader Title="Objekt anlegen" Back="/verwaltung/objekte" BackText="Alle Objekte" />

<ErrorList Errors="errors" />

<EditForm Model="Data" FormName="property" OnValidSubmit="CreateAsync">
    <DataAnnotationsValidator />
    <PropertyFields Data="Data!" />
    <button type="submit" class="button button-primary">Objekt anlegen</button>
</EditForm>

@code {
    private IReadOnlyList<string>? errors;

    [SupplyParameterFromForm(FormName = "property")]
    private PropertyInput? Data { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized() => Data ??= new() { HeatingType = HeatingType.CentralHeating };

    private async Task CreateAsync()
    {
        var result = await Admin.CreateAsync(Data!);
        if (result.Succeeded)
        {
            Redirector.RedirectWithMessage($"/verwaltung/objekte/{result.Id}", "Das Objekt wurde angelegt. Jetzt Flächen und Einheiten erfassen.", HttpContext);
        }
        else
        {
            errors = result.Errors;
        }
    }
}
