@page "/verwaltung/objekte/neu"
@rendermode InteractiveServer
@using MudBlazor
@using MietHahn.Application.Admin
@inject IPropertyService Admin
@inject ILandlordProfileService LandlordProfiles
@inject NavigationManager Navigation

<InteractiveShell>
    <PageHeader Title="Objekt anlegen" Back="/verwaltung/objekte" BackText="Alle Objekte" />

    <ErrorList Errors="errors" />

    <EditForm Model="data" OnValidSubmit="CreateAsync" novalidate>
        <DataAnnotationsValidator />
        <PropertyEditor Data="data" Profiles="profiles" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Objekt anlegen</MudButton>
    </EditForm>
</InteractiveShell>

@code {
    private readonly PropertyInput data = new() { HeatingType = HeatingType.CentralHeating };
    private IReadOnlyList<string>? errors;
    private IReadOnlyList<LandlordProfileRow> profiles = [];

    protected override async Task OnInitializedAsync() => profiles = await LandlordProfiles.ListAsync();

    private async Task CreateAsync()
    {
        var result = await Admin.CreateAsync(data);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"/verwaltung/objekte/{result.Id}?meldung=objekt-angelegt");
        }
        else
        {
            errors = result.Errors;
        }
    }
}
