@* Input fields of a shared-flat room; sits inside an EditForm with Model = Data. *@
<div class="form-grid">
    <FormField Id="room-designation" Label="Bezeichnung" For="() => Data.Name" Required="true" Hint="z. B. „Zimmer 1“">
        <InputText id="room-designation" @bind-Value="Data.Name" />
    </FormField>
    <FormField Id="room-furnishing" Label="Möblierung" For="() => Data.Furnishing">
        <InputSelect id="room-furnishing" @bind-Value="Data.Furnishing">
            @foreach (var value in Enum.GetValues<Furnishing>())
            {
                <option value="@value">@Labels.From(value)</option>
            }
        </InputSelect>
    </FormField>
</div>
@if (WithNotes)
{
    <FormField Id="room-notes" Label="Notizen" For="() => Data.Notes">
        <InputTextArea id="room-notes" @bind-Value="Data.Notes" rows="2" />
    </FormField>
}

@code {
    [Parameter, EditorRequired]
    public RoomInput Data { get; set; } = default!;

    [Parameter]
    public bool WithNotes { get; set; } = true;
}
