@page "/verwaltung/zimmer/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor
@inject IPropertyService Admin
@inject NavigationManager Navigation
@inject Notifier Notify
@inject Confirmations Confirm

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (room is null)
{
    <PageHeader Title="Zimmer nicht gefunden" Back="/verwaltung/objekte" BackText="Alle Objekte" />
}
else
{

<PageHeader Title="@room.Data.Name" Subtitle="@($"{room.UnitName} · {room.PropertyName}")"
            Back="@($"/verwaltung/einheiten/{room.UnitId}")" BackText="@room.UnitName" />

<ErrorList Errors="errors" />

<section>
    <h2>Belegung</h2>
    <p><OccupancyDisplay Occupancy="room.Occupancy" /></p>
</section>

<LeaseHistory RentalUnitId="Id" />

<AreaSection Save="input => Admin.SetRoomAreaAsync(Id, input)" OnSaved="LoadAsync" Current="room.Area" History="room.AreaHistory"
                 AreaText="Zimmerfläche" AdditionalText="Anteil Gemeinschaftsfläche" AdditionalHint="Anteil an Küche, Bad, Flur der WG (für Umlagen nach Fläche)." />

<section>
    <h2>Angaben</h2>
    <EditForm Model="data" OnValidSubmit="SaveAsync" novalidate>
        <DataAnnotationsValidator />
        <RoomEditor Data="data" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
    </EditForm>
</section>

<section>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync">Zimmer löschen</MudButton>
</section>

<ChangeHistory EntityType="@nameof(MietHahn.Domain.Properties.Room)" EntityId="Id" />
}
</InteractiveShell>

@code {
    private RoomDetails? room;
    private RoomInput data = new();
    private IReadOnlyList<string>? errors;
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        room = await Admin.GetRoomAsync(Id);
        if (room is not null)
        {
            data = room.Data;
        }

        loaded = true;
    }

    private async Task SaveAsync()
    {
        var result = await Admin.UpdateRoomAsync(Id, data);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success("Die Angaben wurden gespeichert.");
            await LoadAsync();
        }
    }

    private async Task DeleteAsync()
    {
        if (!await Confirm.AskAsync("Zimmer löschen", "Das Zimmer wird gelöscht. Fortfahren?", "Ja, löschen"))
        {
            return;
        }

        var unitId = room!.UnitId;
        var result = await Admin.DeleteRoomAsync(Id);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"/verwaltung/einheiten/{unitId}?meldung=geloescht");
        }
        else
        {
            errors = result.Errors;
        }
    }
}
