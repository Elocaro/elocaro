@page "/verwaltung"
@attribute [StreamRendering]
@using MietHahn.Application.Todos
@inject IEnumerable<ITodoSource> Sources

<PageHeader Title="Was ist zu tun?" />

@if (todos is null)
{
    <p class="laedt" role="status">Aufgaben werden geladen …</p>
}
else if (todos.Count == 0)
{
    <EmptyState Text="Alles erledigt – es gibt gerade nichts zu tun." />
}
else
{
    @foreach (var area in todos.GroupBy(a => a.Area))
    {
        <section class="aufgaben-bereich">
            <h2>@area.Key</h2>
            <ul class="aufgaben">
                @foreach (var todo in area.OrderByDescending(a => a.Urgency).ThenBy(a => a.Due))
                {
                    <li class="aufgabe aufgabe-@todo.Urgency.ToString().ToLowerInvariant()">
                        <a href="@todo.Link">@todo.Title</a>
                        @if (todo.Due is { } due)
                        {
                            <span class="klein">fällig am @Format.Date(due)</span>
                        }
                        @if (todo.Details is not null)
                        {
                            <p class="klein">@todo.Details</p>
                        }
                    </li>
                }
            </ul>
        </section>
    }
}

@code {
    private IReadOnlyList<TodoItem>? todos;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var all = new List<TodoItem>();
        foreach (var source in Sources)
        {
            all.AddRange(await source.TodosAsync(HttpContext.User));
        }

        todos = all;
    }
}
