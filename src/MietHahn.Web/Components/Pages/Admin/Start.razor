@page "/verwaltung"
@attribute [StreamRendering]
@using MietHahn.Application.Admin
@using MietHahn.Application.Todos
@inject IEnumerable<ITodoSource> Sources
@inject IPortfolioFigures Portfolio

<PageHeader Title="Was ist zu tun?" Subtitle="Aufgaben und Fristen aus allen Bereichen, die dringendsten zuerst." />

@if (figures is not null)
{
    <div class="kpis" role="group" aria-label="Kennzahlen" id="kpis">
        <div class="kpi">
            <p class="kpi-label">Mieteingang im @Format.Month(figures.Month)</p>
            <p class="kpi-value">@Format.Money(figures.PaidThisMonth)<small> von @Format.Money(figures.MonthlyRent) Soll</small></p>
        </div>
        <a class="kpi @(figures.Arrears > 0 ? "is-warning" : null)" href="/verwaltung/finanzen/offene-posten">
            <span class="kpi-label">Rückstände</span>
            <span class="kpi-value">@Format.Money(figures.Arrears)<small>@(figures.ArrearsLeases == 0 ? " keine" : $" bei {figures.ArrearsLeases} Mietverhältnis{(figures.ArrearsLeases == 1 ? "" : "sen")}")</small></span>
        </a>
        <div class="kpi @(figures.Vacant > 0 ? "is-info" : null)">
            <p class="kpi-label">Belegung</p>
            <p class="kpi-value">@figures.Occupied von @figures.Units vermietet<small>@(figures.Vacant == 0 ? "" : $" · {figures.Vacant} leer")</small></p>
        </div>
    </div>
}

@if (todos is null)
{
    <p class="loading" role="status">Aufgaben werden geladen …</p>
}
else if (todos.Count == 0)
{
    <EmptyState Text="Alles erledigt – es gibt gerade nichts zu tun." />
}
else
{
    <div class="dashboard-summary" aria-label="Zusammenfassung">
        @if (Count(Urgency.Urgent) > 0)
        {
            <StatusChip Level="StatusLevel.Error">@Count(Urgency.Urgent) dringend</StatusChip>
        }
        @if (Count(Urgency.Soon) > 0)
        {
            <StatusChip Level="StatusLevel.Warning">@Count(Urgency.Soon) bald fällig</StatusChip>
        }
        <StatusChip>@todos.Count Aufgaben insgesamt</StatusChip>
    </div>
    <div class="dashboard">
        @foreach (var area in todos.GroupBy(a => a.Area).OrderByDescending(g => g.Max(a => a.Urgency)).ThenBy(g => g.Key))
        {
            <section class="panel">
                <header>
                    <h2>@area.Key</h2>
                    <span class="count-badge" aria-label="@area.Count() Aufgaben">@area.Count()</span>
                </header>
                @{
                    var entries = TodoGroups.Build(area.OrderByDescending(a => a.Urgency).ThenBy(a => a.Due));
                }
                <ul class="todos">
                    @foreach (var entry in entries.Take(VisiblePerArea))
                    {
                        @EntryView(entry)
                    }
                </ul>
                @if (entries.Count > VisiblePerArea)
                {
                    <details class="todos-more">
                        <summary>@(entries.Count - VisiblePerArea) weitere anzeigen</summary>
                        <ul class="todos">
                            @foreach (var entry in entries.Skip(VisiblePerArea))
                            {
                                @EntryView(entry)
                            }
                        </ul>
                    </details>
                }
            </section>
        }
    </div>
}

@* Charts after the tasks: on a phone the work comes first. An all-zero history (new installation) shows no empty chart. *@
    @if (figures?.History is { Count: > 0 } history && history.Any(m => m.Due != 0 || m.Paid != 0 || m.OpenAtEnd != 0))
    {
        <MonthChart History="history" />
    }
    @if (figures?.Costs is { Count: > 0 } costs)
    {
        <figure class="cost-chart" id="year-costs" aria-label="Kosten je Jahr">
            <figcaption class="small">Kosten aus den Belegen je Abrechnungsjahr</figcaption>
            @foreach (var year in costs)
            {
                <div class="cost-chart-row">
                    <span class="cost-chart-label">@year.Year</span>
                    <span class="cost-chart-track"><span class="cost-chart-bar tenant" style="width:@((year.Amount / Math.Max(1m, costs.Max(c => c.Amount)) * 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                    <span class="cost-chart-value">@Format.Money(year.Amount)</span>
                </div>
            }
        </figure>
    }

@code {
    private const int VisiblePerArea = 4;

    private IReadOnlyList<TodoItem>? todos;
    private PortfolioFigures? figures;

    private RenderFragment TodoItemView(TodoItem todo) => @<li class="todo todo-@todo.Urgency.ToString().ToLowerInvariant()">
        <a href="@todo.Link">@todo.Title</a>
        @if (todo.Due is { } due)
        {
            <span class="small">fällig am @Format.Date(due)</span>
        }
        @if (todo.Details is not null)
        {
            <p class="small">@todo.Details</p>
        }
    </li>;

    private RenderFragment EntryView(TodoEntry entry) => entry.Items.Count == 1 ? TodoItemView(entry.First) : GroupView(entry);

    private RenderFragment GroupView(TodoEntry entry) => @<li class="todo todo-@entry.First.Urgency.ToString().ToLowerInvariant() todo-group">
        <details>
            <summary>@entry.Heading <span class="small">(@entry.Items.Count)@(entry.First.Due is { } due ? $" · fällig am {Format.Date(due)}" : "")</span></summary>
            @if (entry.First.Details is not null)
            {
                <p class="small">@entry.First.Details</p>
            }
            <ul class="todo-group-items">
                @foreach (var item in entry.Items)
                {
                    <li><a href="@item.Link">@TodoGroups.Rest(item, entry.Heading)</a></li>
                }
            </ul>
        </details>
    </li>;

    private int Count(Urgency urgency) => todos?.Count(t => t.Urgency == urgency) ?? 0;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        figures = await Portfolio.FiguresAsync(HttpContext.User);
        var all = new List<TodoItem>();
        foreach (var source in Sources)
        {
            all.AddRange(await source.TodosAsync(HttpContext.User));
        }

        todos = all;
    }
}
