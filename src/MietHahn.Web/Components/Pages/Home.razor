@page "/"
@attribute [Authorize]
@using MietHahn.Web.AccessControl
@inject NavigationManager Navigation

@* Redirects to the matching area depending on the role. *@
<PageTitle>MietHahn</PageTitle>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized() => Navigation.NavigateTo(AccessControlExtensions.HomePage(HttpContext.User));
}
