@page "/"
@using MietHahn.Web.AccessControl
@inject NavigationManager Navigation

@* Leitet je nach Rolle in den passenden Bereich. *@
<PageTitle>MietHahn</PageTitle>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized() => Navigation.NavigateTo(AccessControlExtensions.HomePage(HttpContext.User));
}
