@page "/service/tickets/{Id:guid}"
@rendermode InteractiveServer
@using MietHahn.Application.Files
@using MietHahn.Application.Tickets
@using MietHahn.Web.Components.Controls
@inject ITicketWork Work
@inject IFileStore Files
@inject AuthenticationStateProvider Authentication
@inject Notifier Notify

<InteractiveShell>
    <PageHeader Title="Auftrag" Back="/service" BackText="Meine Aufträge" />
    <TicketThread Id="Id" />
    <ErrorList Errors="errors" />
    @if (view is not null)
    {
        <TicketWorkPanel @key="version" View="view" Add="AddWorkAsync" OnInvoice="InvoiceAsync" />
    }
</InteractiveShell>

@code {
    private TicketWorkView? view;
    private IReadOnlyList<string>? errors;
    private int version;

    [Parameter]
    public Guid Id { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task<System.Security.Claims.ClaimsPrincipal> UserAsync() => (await Authentication.GetAuthenticationStateAsync()).User;

    private async Task LoadAsync() => view = await Work.GetAsync(await UserAsync(), Id);

    private async Task<IReadOnlyList<string>?> AddWorkAsync(WorkInput input)
    {
        var result = await Work.AddWorkAsync(await UserAsync(), Id, input);
        if (!result.Succeeded)
        {
            return result.Errors;
        }

        Notify.Success("Die Arbeit ist eingetragen.");
        await LoadAsync();
        version++;
        return null;
    }

    private async Task InvoiceAsync(IReadOnlyList<FileSelection> files)
    {
        if (files.Count == 0)
        {
            return;
        }

        try
        {
            await using var content = files[0].Open();
            var stored = await Files.SaveAsync(content, files[0].Name);
            var result = await Work.AddInvoiceAsync(await UserAsync(), Id, stored.Id);
            errors = result.Succeeded ? null : result.Errors;
            if (result.Succeeded)
            {
                Notify.Success("Die Rechnung ist hochgeladen.");
                await LoadAsync();
                version++;
            }
        }
        catch (FileRejectedException ex)
        {
            errors = [ex.Message];
        }
    }
}
