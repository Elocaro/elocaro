@page "/service/objekte/{Id:guid}"
@using MietHahn.Application.Documents
@using MietHahn.Application.Properties
@using MietHahn.Web.Components.Pages.Admin.Documents
@using MietHahn.Web.AccessControl
@inject IPropertyService Admin
@inject IDocumentLibrary Documents
@inject IAuthorizationService AccessControl

@if (property is null)
{
    <PageHeader Title="Objekt nicht gefunden" Back="/service/objekte" BackText="Meine Objekte" />
    return;
}

@* Hausmeister sehen das Haus und seine Einheiten, aber keine Mieterdaten. *@
<PageHeader Title="@property.Data.Name" Subtitle="@property.Address" Back="/service/objekte" BackText="Meine Objekte" />

<dl class="angaben">
    <dt>Heizung</dt><dd>@Labels.From(property.Data.HeatingType), @Labels.From(property.Data.EnergySource)</dd>
    @if (property.Data.Notes is not null)
    {
        <dt>Notizen</dt><dd>@property.Data.Notes</dd>
    }
</dl>

<section>
    <h2>Einheiten</h2>
    <div class="tabellen-rahmen">
        <table class="tabelle">
            <thead><tr><th>Einheit</th><th>Lage</th><th>Art</th></tr></thead>
            <tbody>
                @foreach (var unit in property.Units)
                {
                    <tr>
                        <td>@unit.Name@(unit.IsSharedFlat ? $" (WG, {unit.RentalUnits.Count} Zimmer)" : "")</td>
                        <td>@unit.Location</td>
                        <td>@Labels.From(unit.Type)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (documents is { Count: > 0 })
{
    <section>
        <h2>Dokumente</h2>
        <DocumentTable Rows="documents" Internal="false" WithRelation="false" />
    </section>
}

@code {
    private PropertyDetails? property;
    private IReadOnlyList<DocumentRow>? documents;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Ressourcenbasiert: nicht zugeordnete Objekte verhalten sich wie unbekannte (keine Auskunft über ihre Existenz).
        if ((await AccessControl.AuthorizeAsync(HttpContext.User, new PropertyResource(Id), PropertyReadRequirement.Requirement)).Succeeded)
        {
            property = await Admin.GetAsync(Id);
            documents = await Documents.SharedAsync(HttpContext.User, Id);
        }
    }
}
