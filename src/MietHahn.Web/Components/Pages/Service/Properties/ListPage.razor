@page "/service/objekte"
@using System.Security.Claims
@using MietHahn.Application.Properties
@inject IPropertyService Admin
@inject IPropertyAssignments Assignments

<PageHeader Title="Meine Objekte" Subtitle="Häuser, die Sie betreuen." />

@if (properties is { Count: 0 })
{
    <EmptyState Text="Ihnen sind noch keine Objekte zugeordnet." />
}
else if (properties is not null)
{
    <ul class="aufgaben">
        @foreach (var property in properties)
        {
            <li class="aufgabe">
                <a href="/service/objekte/@property.Id">@property.Name</a>
                <p class="klein">@property.Address · @property.Units Einheiten</p>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<PropertyOverview>? properties;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var ids = Guid.TryParse(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId)
            ? await Assignments.PropertiesOfAsync(userId)
            : [];
        properties = ids.Count == 0 ? [] : await Admin.ListAsync(ids);
    }
}
