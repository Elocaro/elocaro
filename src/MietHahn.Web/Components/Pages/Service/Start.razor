@page "/service"
@attribute [StreamRendering]
@using MietHahn.Application.Tickets
@inject ITickets Tickets

<PageHeader Title="Meine Aufträge" Subtitle="Die Ihnen zugewiesenen Aufträge." />

@if (rows is null)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else
{
    <TicketTable Rows="rows" BasePath="/service/tickets" EmptyText="Ihnen ist derzeit nichts zugewiesen." />
}

@code {
    private IReadOnlyList<TicketRow>? rows;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync() => rows = await Tickets.ListAsync(HttpContext.User);
}
