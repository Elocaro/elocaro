@page "/portal"
@attribute [StreamRendering]
@using System.Security.Claims
@using MietHahn.Application.Documents
@using MietHahn.Application.Admin
@using MietHahn.Application.Portal
@using MietHahn.Application.Notices
@using MietHahn.Application.Tickets
@inject ITenantPortal Portal
@inject IDocumentLibrary Documents
@inject ITickets Tickets
@inject INotices Notices
@inject IMessages Messages
@inject ILandlordProfileService Landlord

<PageHeader Title="Willkommen" Subtitle="Hier finden Sie Ihre Dokumente und Vertragsdaten." />

@if (leases is null)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else
{
    <div class="dashboard">
        <section class="panel">
            <header>
                <h2>Neue Dokumente</h2>
                @if (unread.Count > 0)
                {
                    <span class="count-badge" aria-label="@unread.Count ungelesen">@unread.Count</span>
                }
            </header>
            @if (unread.Count == 0)
            {
                <p class="small">Keine ungelesenen Dokumente.</p>
            }
            else
            {
                <ul class="todos">
                    @foreach (var document in unread.Take(5))
                    {
                        <li class="todo">
                            <a href="/dateien/@document.FileId">@document.Title</a>
                            <span class="small">@Labels.From(document.Category) · @Format.Date(document.Date)</span>
                        </li>
                    }
                </ul>
            }
            <p><a href="/portal/dokumente">Alle Dokumente</a></p>
        </section>

        @if (notices.Count > 0)
        {
            <section class="panel">
                <header>
                    <h2>Aushänge</h2>
                    @if (notices.Any(n => !n.Read && n.RequiresAcknowledgement))
                    {
                        <span class="count-badge" aria-label="Bitte bestätigen">!</span>
                    }
                </header>
                <ul class="todos">
                    @foreach (var notice in notices.Take(5))
                    {
                        <li class="todo">
                            <a href="/portal/aushaenge">@notice.Title</a>
                            <span class="small">@notice.Property · @Format.Date(notice.ValidFrom)@(notice.ValidUntil is { } until ? $" bis {Format.Date(until)}" : "")@(notice.RequiresAcknowledgement && !notice.Read ? " · bitte bestätigen" : "")</span>
                        </li>
                    }
                </ul>
                <p><a href="/portal/aushaenge">Alle Aushänge</a></p>
            </section>
        }

        <section class="panel">
            <header>
                <h2>Nachrichten</h2>
                @if (unreadMessages > 0)
                {
                    <span class="count-badge" aria-label="@unreadMessages ungelesen">@unreadMessages</span>
                }
            </header>
            <p><a class="button" href="/portal/nachrichten/neu">Nachricht schreiben</a></p>
            <p><a href="/portal/nachrichten">Alle Nachrichten (@unreadMessages neu)</a></p>
        </section>

        <section class="panel">
            <header><h2>Meldungen</h2></header>
            <p><a class="button button-primary" href="/portal/tickets/neu">Problem melden</a></p>
            <p><a href="/portal/tickets">Meine Meldungen (@openTickets offen)</a></p>
            @if (emergency is not null)
            {
                <div class="emergency"><strong>Notdienst</strong><p>@emergency</p></div>
            }
        </section>

        <section class="panel">
            <header><h2>Mein Mietverhältnis</h2></header>
            @if (leases.Count == 0)
            {
                <p class="small">Ihrem Konto ist noch kein Mietverhältnis zugeordnet. Bitte wenden Sie sich an Ihren Vermieter.</p>
            }
            else
            {
                <ul class="todos">
                    @foreach (var lease in leases)
                    {
                        <li class="todo">
                            <a href="/portal/vertrag/@lease.Id">@lease.RentalUnit</a>
                            <span class="small">@lease.Property · @Labels.From(lease.Status) · Miete @Format.Money(lease.MonthlyRent) im Monat</span>
                        </li>
                    }
                </ul>
            }
        </section>

        @if (contacts is not null)
        {
            <section class="panel">
                <header><h2>Ansprechpartner</h2></header>
                @if (contacts.Responsible.Count == 0)
                {
                    <p class="small">Es sind noch keine Ansprechpartner hinterlegt.</p>
                }
                else
                {
                    <ul class="todos">
                        @foreach (var contact in contacts.Responsible)
                        {
                            <li class="todo">
                                <strong>@contact.Role</strong>: @contact.Name
                                @if (contact.Phone is not null)
                                {
                                    <span class="small"><a href="tel:@contact.Phone.Replace(" ", "")">@contact.Phone</a></span>
                                }
                                @if (contact.Email is not null)
                                {
                                    <span class="small"><a href="mailto:@contact.Email">@contact.Email</a></span>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    </div>
}

@code {
    private IReadOnlyList<PortalLeaseRow>? leases;
    private PortalContacts? contacts;
    private List<DocumentRow> unread = [];
    private int openTickets;
    private int unreadMessages;
    private IReadOnlyList<TenantNotice> notices = [];
    private string? emergency;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = HttpContext.User;
        leases = await Portal.LeasesAsync(user);
        contacts = await Portal.ContactsAsync(user);
        openTickets = (await Tickets.ListAsync(user)).Count;
        notices = await Notices.CurrentAsync(user);
        unreadMessages = (await Messages.ListAsync(user)).Count(t => t.Unread);
        emergency = (await Landlord.GetAsync())?.EmergencyInfo;
        var read = await Portal.ReadDocumentsAsync(user);
        unread = (await Documents.SharedAsync(user)).Where(d => !read.Contains(d.Id)).ToList();
    }
}
