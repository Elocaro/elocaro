@page "/portal/vertrag"
@page "/portal/vertrag/{Id:guid}"
@using MietHahn.Application.Portal
@inject ITenantPortal Portal
@inject NavigationManager Navigation

@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (Id is null)
{
    <PageHeader Title="Vertragsdaten" Subtitle="Die wichtigsten Angaben Ihres Mietvertrags im Überblick." />
    @if (leases is { Count: 0 })
    {
        <EmptyState Text="Ihrem Konto ist noch kein Mietverhältnis zugeordnet. Bitte wenden Sie sich an Ihren Vermieter." />
    }
    else
    {
        <ul class="todos">
            @foreach (var row in leases!)
            {
                <li class="todo">
                    <a href="/portal/vertrag/@row.Id">@row.RentalUnit</a>
                    <span class="small">@row.Property · @Labels.From(row.Status) · seit @Format.Date(row.Start)</span>
                </li>
            }
        </ul>
    }
}
else if (lease is null)
{
    <PageHeader Title="Vertrag nicht gefunden" Back="/portal/vertrag" BackText="Meine Verträge" />
}
else
{
    <PageHeader Title="@lease.RentalUnit" Subtitle="@lease.Property" Back="@(leases!.Count > 1 ? "/portal/vertrag" : null)" BackText="Meine Verträge" />
    <p class="small">Diese Angaben sind nur zur Ansicht. Änderungen am Vertrag nimmt Ihr Vermieter vor.</p>

    <dl class="details">
        <dt>Mieter</dt><dd>@string.Join(", ", lease.Tenants)</dd>
        <dt>Status</dt><dd>@Labels.From(lease.Status)</dd>
        <dt>Mietbeginn</dt><dd>@Format.Date(lease.Start)</dd>
        @if (lease.FixedTermUntil is { } fixedTerm)
        {
            <dt>Befristet bis</dt><dd>@Format.Date(fixedTerm)</dd>
        }
        @if (lease.End is { } end)
        {
            <dt>Mietende</dt><dd>@Format.Date(end)</dd>
        }
        <dt>Abrechnung der Nebenkosten</dt><dd>@Labels.From(lease.BillingType)</dd>
        <dt>Miete fällig</dt><dd>bis zum @lease.DueOnWorkingDay. Werktag des Monats (@Labels.From(lease.PaymentMethod))</dd>
        @if (lease.Deposit is { } deposit)
        {
            <dt>Kaution</dt><dd>@Format.Money(deposit)</dd>
        }
    </dl>

    <section>
        <h2>Monatliche Miete@(lease.Status == MietHahn.Domain.Leases.LeaseStatus.Future ? $" ab {Format.Date(lease.RentDate)}" : "")</h2>
        <div class="table-wrapper">
            <table class="data-table" data-nostack>
                <tbody>
                    @foreach (var component in lease.Components)
                    {
                        <tr><td>@(component.Name ?? Labels.From(component.Kind))</td><td class="number">@Format.Money(component.Amount)</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th>Gesamt</th><th class="number">@Format.Money(lease.MonthlyRent)</th></tr>
                </tfoot>
            </table>
        </div>
    </section>
}

@code {
    private IReadOnlyList<PortalLeaseRow>? leases;
    private PortalLease? lease;
    private bool loaded;

    [Parameter]
    public Guid? Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        leases = await Portal.LeasesAsync(HttpContext.User);
        if (Id is null && leases.Count == 1)
        {
            Navigation.NavigateTo($"/portal/vertrag/{leases[0].Id}", replace: true);
            return;
        }

        if (Id is { } id)
        {
            lease = await Portal.GetLeaseAsync(HttpContext.User, id);
            if (lease is null)
            {
                // A foreign or unknown id looks the same: not found.
                HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            }
        }

        loaded = true;
    }
}
