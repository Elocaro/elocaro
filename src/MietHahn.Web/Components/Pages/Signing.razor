@page "/unterschrift/{Token}"
@attribute [AllowAnonymous]
@layout MietHahn.Web.Components.Layout.AccountLayout
@using MietHahn.Application.Leases
@inject IContractSignatures Signatures

<PageTitle>Vertrag unterschreiben – MietHahn</PageTitle>

@if (view is null)
{
    <h1>Link ungültig</h1>
    <p>Dieser Link ist nicht (mehr) gültig. Bitte wenden Sie sich an Ihren Vermieter und lassen Sie sich einen neuen Link schicken.</p>
}
else if (done)
{
    <h1>Danke, Ihre Unterschrift ist gespeichert</h1>
    <Notice Level="NoticeLevel.Success">@(note ?? "Alle Beteiligten haben unterschrieben. Der unterschriebene Vertrag liegt jetzt bei Ihrem Vermieter und, soweit freigegeben, in Ihrem Mieterportal.")</Notice>
}
else if (view.IsSigned)
{
    <h1>Bereits unterschrieben</h1>
    <p>Sie haben diesen Vertrag schon unterschrieben. Weitere Schritte sind nicht nötig.</p>
}
else if (!view.ContractOpen)
{
    <h1>Nicht mehr offen</h1>
    <p>Dieser Vertrag ist nicht mehr zur Unterschrift offen. Bitte fragen Sie Ihren Vermieter.</p>
}
else if (view.Expired)
{
    <h1>Link abgelaufen</h1>
    <p>Dieser Link ist abgelaufen. Bitte lassen Sie sich von Ihrem Vermieter einen neuen Link schicken.</p>
}
else
{
    <h1>@view.Title</h1>
    <p>Guten Tag @view.SignerName, bitte lesen Sie den Vertrag und unterschreiben Sie darunter.</p>
    <p><a href="/unterschrift/@Token/dokument" target="_blank" rel="noopener">Vertrag als PDF öffnen</a></p>
    <iframe class="document-preview" src="/unterschrift/@Token/dokument" title="Vertrag zum Lesen"></iframe>

    @if (errors is not null)
    {
        <ErrorList Errors="errors" />
    }

    <EditForm Model="Input" FormName="unterschrift" OnValidSubmit="SubmitAsync" novalidate>
        <DataAnnotationsValidator />
        <div class="field">
            <label for="typed-name">Ihr vollständiger Name</label>
            <InputText id="typed-name" @bind-Value="Input.TypedName" autocomplete="name" />
            <ValidationMessage For="() => Input.TypedName" />
        </div>
        <div id="signature-draw" hidden>
            <p class="small">Optional: Unterschrift mit Finger, Stift oder Maus zeichnen.</p>
            <canvas id="signature-canvas" class="signature-field" aria-label="Unterschrift zeichnen"></canvas>
            <button type="button" id="signature-clear" class="button-link">Löschen</button>
        </div>
        <input type="hidden" id="signature-data" name="Input.SignatureData" />
        <div class="field">
            <label><InputCheckbox @bind-Value="Input.Accepted" /> Ich habe den Vertrag gelesen und unterschreibe ihn mit meinem Namen.</label>
            <ValidationMessage For="() => Input.Accepted" />
        </div>
        <p class="small">Es wird Ihr Name, der Zeitpunkt, Ihre IP-Adresse und eine Prüfsumme des Dokuments gespeichert. Dies ist eine einfache elektronische Unterschrift, keine qualifizierte Signatur.</p>
        <button type="submit" class="button primary">Verbindlich unterschreiben</button>
    </EditForm>
    <script src="/js/contract-signature.js"></script>
}

@code {
    [Parameter]
    public string Token { get; set; } = "";

    [CascadingParameter]
    private HttpContext? Context { get; set; }

    [SupplyParameterFromForm(FormName = "unterschrift")]
    private SigningInput Input { get; set; } = default!;

    private SigningView? view;
    private IReadOnlyList<string>? errors;
    private bool done;
    private string? note;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        view = await Signatures.ForSigningAsync(Token);
    }

    private async Task SubmitAsync()
    {
        var evidence = new SigningEvidence(Context?.Connection.RemoteIpAddress?.ToString(), Context?.Request.Headers.UserAgent.ToString());
        var result = await Signatures.SignAsync(Token, Input, evidence);
        if (result.Succeeded)
        {
            done = true;
            note = result.Note;
        }
        else
        {
            errors = result.Errors;
        }
    }
}
