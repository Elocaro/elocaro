@page "/verwaltung/benutzer/{Id:guid}"
@using Microsoft.AspNetCore.Identity
@using MietHahn.Infrastructure.Identitaet
@inject IBenutzerverwaltung Verwaltung
@inject UserManager<Benutzer> BenutzerManager
@inject Weiterleitung Weiterleitung

<PageTitle>@(benutzer?.Anzeigename ?? "Benutzer") – MietHahn</PageTitle>

@if (benutzer is null)
{
    <h1>Konto nicht gefunden</h1>
    <p><a href="/verwaltung/benutzer">Zur Übersicht</a></p>
    return;
}

<p><a href="/verwaltung/benutzer">← Alle Benutzer</a></p>
<h1>@benutzer.Anzeigename</h1>

<StatusMeldung />
<FehlerListe Fehler="fehler" />

<dl class="angaben">
    <dt>E-Mail</dt><dd>@benutzer.Email</dd>
    <dt>Rolle</dt><dd>@Rollen.Anzeigename(benutzer.Rolle)</dd>
    <dt>Status</dt><dd>@(benutzer.Gesperrt ? "gesperrt" : benutzer.EinladungAngenommen ? "aktiv" : "eingeladen")</dd>
    <dt>Anmeldung</dt><dd>@(benutzer.HatPasswort ? "Passwort" : "Anmeldelink")@(benutzer.ZweiFaktorAktiv ? " + Zwei-Faktor" : "")</dd>
    <dt>Angelegt</dt><dd>@Format.Zeitpunkt(benutzer.ErstelltAm)</dd>
    <dt>Letzte Anmeldung</dt><dd>@Format.Zeitpunkt(benutzer.LetzteAnmeldungAm)</dd>
</dl>

<section>
    <h2>Rolle</h2>
    <EditForm Model="RolleEingabe" FormName="rolle" OnSubmit="RolleAendernAsync" class="formular-zeile">
        <InputSelect id="rolle" @bind-Value="RolleEingabe!.Rolle" aria-label="Rolle">
            @foreach (var rolle in Rollen.Alle)
            {
                <option value="@rolle">@Rollen.Anzeigename(rolle)</option>
            }
        </InputSelect>
        <button type="submit" class="knopf">Rolle ändern</button>
    </EditForm>
</section>

@if (benutzer.Rolle == Rollen.Verwalter)
{
    <section>
        <h2>Rechte</h2>
        <EditForm Model="RechteEingabe" FormName="rechte" OnSubmit="RechteSetzenAsync">
            @foreach (var recht in Rechte.Alle)
            {
                <div class="feld feld-checkbox">
                    <input type="checkbox" id="recht-@recht" name="RechteEingabe.Auswahl" value="@recht" checked="@benutzer.Rechte.Contains(recht)" />
                    <label for="recht-@recht">@Rechte.Anzeigename(recht)</label>
                </div>
            }
            <button type="submit" class="knopf">Rechte speichern</button>
        </EditForm>
    </section>
}

@if (!istEigenesKonto)
{
    <section>
        <h2>Zugang</h2>
        <form method="post" @formname="sperren" @onsubmit="SperrenUmschaltenAsync">
            <AntiforgeryToken />
            @if (benutzer.Gesperrt)
            {
                <button type="submit" class="knopf">Konto entsperren</button>
            }
            else
            {
                <p class="klein">Ein gesperrtes Konto wird sofort abgemeldet und kann sich nicht mehr anmelden.</p>
                <button type="submit" class="knopf">Konto sperren</button>
            }
        </form>
    </section>
}

<AenderungsHistorie EntitaetTyp="Benutzer" EntitaetId="Id" />

@code {
    private BenutzerUebersicht? benutzer;
    private bool istEigenesKonto;
    private IReadOnlyList<string>? fehler;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "rolle")]
    private RollenModell? RolleEingabe { get; set; }

    [SupplyParameterFromForm(FormName = "rechte")]
    private RechteModell? RechteEingabe { get; set; }

    protected override async Task OnInitializedAsync()
    {
        benutzer = await Verwaltung.LadenAsync(Id);
        RolleEingabe ??= new() { Rolle = benutzer?.Rolle ?? Rollen.Mieter };
        RechteEingabe ??= new();
        istEigenesKonto = BenutzerManager.GetUserId(HttpContext.User) == Id.ToString();
    }

    private async Task RolleAendernAsync() =>
        await AusfuehrenAsync(Verwaltung.RolleAendernAsync(Id, RolleEingabe!.Rolle), "Die Rolle wurde geändert.");

    private async Task RechteSetzenAsync() =>
        await AusfuehrenAsync(Verwaltung.RechteSetzenAsync(Id, RechteEingabe!.Auswahl), "Die Rechte wurden gespeichert.");

    private async Task SperrenUmschaltenAsync() =>
        await AusfuehrenAsync(
            benutzer!.Gesperrt ? Verwaltung.EntsperrenAsync(Id) : Verwaltung.SperrenAsync(Id),
            benutzer.Gesperrt ? "Das Konto wurde entsperrt." : "Das Konto wurde gesperrt.");

    private async Task AusfuehrenAsync(Task<KontoErgebnis> aktion, string erfolg)
    {
        var ergebnis = await aktion;
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung($"/verwaltung/benutzer/{Id}", erfolg, HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
            benutzer = await Verwaltung.LadenAsync(Id);
        }
    }

    private sealed class RollenModell
    {
        public string Rolle { get; set; } = Rollen.Mieter;
    }

    private sealed class RechteModell
    {
        public List<Recht> Auswahl { get; set; } = [];
    }
}
