@page "/verwaltung/benutzer"
@using System.ComponentModel.DataAnnotations
@inject IBenutzerverwaltung Verwaltung
@inject IKontoverwaltung Konten

<Seitenkopf Titel="Benutzer" Untertitel="Wer Zugang zu MietHahn hat – Verwaltung, Hausmeister, Handwerker und Mieter." />

<StatusMeldung />
<StatusMeldung Meldung="@meldung" />
<FehlerListe Fehler="fehler" />

<section>
    <h2>Person einladen</h2>
    <EditForm Model="Einladung" FormName="einladen" OnValidSubmit="EinladenAsync" class="formular-raster">
        <DataAnnotationsValidator />
        <FormularFeld Id="name" Beschriftung="Name" Fuer="() => Einladung!.Anzeigename" Pflicht="true">
            <InputText id="name" @bind-Value="Einladung!.Anzeigename" autocomplete="off" />
        </FormularFeld>
        <FormularFeld Id="email" Beschriftung="E-Mail-Adresse" Fuer="() => Einladung!.Email" Pflicht="true">
            <InputText id="email" type="email" @bind-Value="Einladung!.Email" autocomplete="off" />
        </FormularFeld>
        <FormularFeld Id="rolle" Beschriftung="Rolle" Fuer="() => Einladung!.Rolle">
            <InputSelect id="rolle" @bind-Value="Einladung!.Rolle">
                @foreach (var rolle in Rollen.Alle)
                {
                    <option value="@rolle">@Rollen.Anzeigename(rolle)</option>
                }
            </InputSelect>
        </FormularFeld>
        <div class="feld feld-aktion">
            <button type="submit" class="knopf knopf-primaer">Einladung senden</button>
        </div>
    </EditForm>
</section>

<section>
    <h2>Konten</h2>
    <div class="tabellen-rahmen">
        <table class="tabelle">
            <thead>
                <tr><th>Name</th><th>E-Mail</th><th>Rolle</th><th>Status</th><th>Letzte Anmeldung</th></tr>
            </thead>
            <tbody>
                @foreach (var b in benutzer)
                {
                    <tr>
                        <td><a href="/verwaltung/benutzer/@b.Id">@b.Anzeigename</a></td>
                        <td>@b.Email</td>
                        <td>@Rollen.Anzeigename(b.Rolle)</td>
                        <td>
                            @if (b.Gesperrt)
                            {
                                <span class="status status-fehler">gesperrt</span>
                            }
                            else if (!b.EinladungAngenommen)
                            {
                                <span class="status status-wartend">eingeladen</span>
                            }
                            else
                            {
                                <span class="status status-ok">aktiv</span>
                            }
                            @if (b.ZweiFaktorAktiv)
                            {
                                <span class="status" title="Zwei-Faktor-Anmeldung aktiv">2FA</span>
                            }
                        </td>
                        <td>@Format.Zeitpunkt(b.LetzteAnmeldungAm)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private IReadOnlyList<BenutzerUebersicht> benutzer = [];
    private string? meldung;
    private IReadOnlyList<string>? fehler;

    [SupplyParameterFromForm(FormName = "einladen")]
    private EinladungEingabe? Einladung { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Einladung ??= new();
        benutzer = await Verwaltung.ListeAsync();
    }

    private async Task EinladenAsync()
    {
        var ergebnis = await Konten.EinladenAsync(Einladung!.Email.Trim(), Einladung.Anzeigename.Trim(), Einladung.Rolle);
        if (ergebnis.Erfolgreich)
        {
            meldung = $"Die Einladung an {Einladung.Email} wurde verschickt.";
            Einladung = new();
            benutzer = await Verwaltung.ListeAsync();
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }

    private sealed class EinladungEingabe
    {
        [Required(ErrorMessage = "Bitte einen Namen angeben.")]
        [StringLength(200)]
        public string Anzeigename { get; set; } = "";

        [Required(ErrorMessage = "Bitte eine E-Mail-Adresse angeben.")]
        [EmailAddress(ErrorMessage = "Bitte eine gültige E-Mail-Adresse angeben.")]
        public string Email { get; set; } = "";

        [Required]
        public string Rolle { get; set; } = Rollen.Mieter;
    }
}
