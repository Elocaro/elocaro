@page "/verwaltung/dokumente"
@inject IDokumentablage Ablage

<Seitenkopf Titel="Dokumente" Untertitel="Verträge, Protokolle, Rechnungen, Versicherungen und mehr, je Objekt, Einheit, Vertrag oder Person.">
    <Aktionen>
        <a class="knopf knopf-primaer" href="/verwaltung/dokumente/neu">Dokument hochladen</a>
    </Aktionen>
</Seitenkopf>

<StatusMeldung />

<form method="get" class="formular-zeile suchleiste" role="search">
    <div class="feld">
        <label for="suche">Suche</label>
        <input id="suche" type="search" name="q" value="@Q" placeholder="Titel, Schlagwort, Dateiname" />
    </div>
    <div class="feld">
        <label for="kategorie">Kategorie</label>
        <select id="kategorie" name="kategorie">
            <option value="" selected="@(Kategorie is null)">Alle</option>
            @foreach (var wert in Enum.GetValues<Dokumentkategorie>())
            {
                <option value="@wert" selected="@(Kategorie == wert)">@Bezeichnungen.Von(wert)</option>
            }
        </select>
    </div>
    <div class="feld feld-aktion">
        <button type="submit" class="knopf">Suchen</button>
    </div>
</form>

@if (zeilen is { Count: 0 })
{
    <Leerzustand Text="@(!string.IsNullOrWhiteSpace(Q) || Kategorie is not null ? "Keine passenden Dokumente." : "Noch keine Dokumente.")" />
}
else if (zeilen is not null)
{
    <DokumentTabelle Zeilen="zeilen" />
}

@code {
    private IReadOnlyList<DokumentZeile>? zeilen;

    [SupplyParameterFromQuery]
    private string? Q { get; set; }

    // Enums lassen sich nicht direkt aus dem Query-String binden.
    [SupplyParameterFromQuery(Name = "kategorie")]
    private string? KategorieText { get; set; }

    private Dokumentkategorie? Kategorie => Enum.TryParse<Dokumentkategorie>(KategorieText, out var wert) ? wert : null;

    protected override async Task OnParametersSetAsync() =>
        zeilen = await Ablage.SucheAsync(new DokumentSuche(Q, Kategorie));
}
