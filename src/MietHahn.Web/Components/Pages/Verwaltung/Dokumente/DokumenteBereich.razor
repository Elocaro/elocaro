@inherits DatenKomponente

@* Dokumente eines Objekts, einer Einheit, eines Vertrags oder einer Person (genau ein Parameter gesetzt). *@
<section>
    <h2>Dokumente</h2>
    @if (zeilen is { Count: 0 })
    {
        <p class="klein">Noch keine Dokumente.</p>
    }
    else if (zeilen is not null)
    {
        <DokumentTabelle Zeilen="zeilen" />
    }
    <p><a class="knopf" href="/verwaltung/dokumente/neu?@Abfrage">Dokument hochladen</a></p>
</section>

@code {
    private IReadOnlyList<DokumentZeile>? zeilen;

    [Parameter]
    public Guid? ObjektId { get; set; }

    [Parameter]
    public Guid? EinheitId { get; set; }

    [Parameter]
    public Guid? MietvertragId { get; set; }

    [Parameter]
    public Guid? PersonId { get; set; }

    private string Abfrage => ObjektId is { } o ? $"objekt={o}" : EinheitId is { } e ? $"einheit={e}" : MietvertragId is { } v ? $"vertrag={v}" : $"person={PersonId}";

    protected override async Task OnParametersSetAsync() =>
        zeilen = await LadenAsync<IDokumentablage, IReadOnlyList<DokumentZeile>>(a => a.SucheAsync(new DokumentSuche(ObjektId: ObjektId, EinheitId: EinheitId, MietvertragId: MietvertragId, PersonId: PersonId)));
}
