@* Dokumentliste; intern mit Link auf die Detailseite, sonst direkt auf die Datei. *@
<div class="tabellen-rahmen">
    <table class="tabelle">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Kategorie</th>
                <th>Datum</th>
                @if (MitBezug)
                {
                    <th>Bezug</th>
                }
                @if (Intern)
                {
                    <th>Freigabe</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var dokument in Zeilen)
            {
                <tr>
                    <td>
                        <a href="@(Intern ? $"/verwaltung/dokumente/{dokument.Id}" : $"/dateien/{dokument.DateiId}")">@dokument.Titel</a>
                        @foreach (var tag in dokument.Tags)
                        {
                            <span class="status">@tag</span>
                        }
                        @if (dokument.AblaufAm is { } ablauf)
                        {
                            <span class="klein"> gültig bis @Format.Datum(ablauf)</span>
                        }
                    </td>
                    <td>@Bezeichnungen.Von(dokument.Kategorie)</td>
                    <td>@Format.Datum(dokument.Datum)</td>
                    @if (MitBezug)
                    {
                        <td>@dokument.Bezug</td>
                    }
                    @if (Intern)
                    {
                        <td>@Freigabe(dokument)</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DokumentZeile> Zeilen { get; set; } = [];

    [Parameter]
    public bool Intern { get; set; } = true;

    [Parameter]
    public bool MitBezug { get; set; } = true;

    internal static string Freigabe(DokumentZeile dokument) => (dokument.FuerMieter, dokument.FuerHausmeister) switch
    {
        (true, true) => "Mieter, Hausmeister",
        (true, false) => "Mieter",
        (false, true) => "Hausmeister",
        _ => "intern",
    };
}
