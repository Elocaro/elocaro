@page "/verwaltung/dokumente/neu"
@using MietHahn.Application.Dateien
@inject IDokumentablage Ablage
@inject IDateiablage Dateien
@inject Weiterleitung Weiterleitung

<Seitenkopf Titel="Dokument hochladen" Zurueck="/verwaltung/dokumente" ZurueckText="Alle Dokumente" />

<FehlerListe Fehler="fehler" />

@if (auswahl is not null)
{
    <EditForm EditContext="kontext" FormName="dokument" OnSubmit="HochladenAsync" enctype="multipart/form-data">
        <DataAnnotationsValidator />
        <div class="feld">
            <label for="datei">Datei *</label>
            <input type="file" id="datei" name="Datei" accept="application/pdf,image/*" required />
            <span class="feld-hinweis">PDF oder Foto. Fotos werden verkleinert und ohne Metadaten (GPS) gespeichert.</span>
        </div>
        <DokumentFelder Daten="Daten!" Auswahl="auswahl" TitelPflicht="false" />
        <button type="submit" class="knopf knopf-primaer">Hochladen</button>
    </EditForm>
}

@code {
    private BezugAuswahl? auswahl;
    private EditContext? kontext;
    private IReadOnlyList<string>? fehler;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "dokument")]
    private DokumentDaten? Daten { get; set; }

    [SupplyParameterFromForm(FormName = "dokument")]
    private IFormFile? Datei { get; set; }

    [SupplyParameterFromQuery(Name = "objekt")]
    private Guid? ObjektId { get; set; }

    [SupplyParameterFromQuery(Name = "einheit")]
    private Guid? EinheitId { get; set; }

    [SupplyParameterFromQuery(Name = "vertrag")]
    private Guid? VertragId { get; set; }

    [SupplyParameterFromQuery(Name = "person")]
    private Guid? PersonId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Daten ??= new() { ObjektId = ObjektId, EinheitId = EinheitId, MietvertragId = VertragId, PersonId = PersonId };
        kontext = new EditContext(Daten);
        auswahl = await Ablage.BezugAuswahlAsync();
    }

    private async Task HochladenAsync()
    {
        if (Datei is null || Datei.Length == 0)
        {
            fehler = ["Bitte eine Datei auswählen."];
            return;
        }

        // Ohne Titel gilt der Dateiname.
        if (string.IsNullOrWhiteSpace(Daten!.Titel))
        {
            Daten.Titel = Path.GetFileNameWithoutExtension(Datei.FileName);
        }

        if (!kontext!.Validate())
        {
            return;
        }

        try
        {
            await using var inhalt = Datei.OpenReadStream();
            var datei = await Dateien.SpeichernAsync(inhalt, Datei.FileName);
            var ergebnis = await Ablage.AnlegenAsync(datei.Id, Daten);
            if (ergebnis.Erfolgreich)
            {
                Weiterleitung.ZuMitMeldung($"/verwaltung/dokumente/{ergebnis.Id}", "Das Dokument wurde abgelegt.", HttpContext);
            }
            else
            {
                fehler = ergebnis.Fehler;
            }
        }
        catch (DateiAbgelehntException ex)
        {
            fehler = [ex.Message];
        }
    }
}
