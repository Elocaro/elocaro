@page "/verwaltung/dokumente/{Id:guid}"
@inject IDokumentablage Ablage
@inject Weiterleitung Weiterleitung

@if (dokument is null)
{
    <Seitenkopf Titel="Dokument nicht gefunden" Zurueck="/verwaltung/dokumente" ZurueckText="Alle Dokumente" />
    return;
}

<Seitenkopf Titel="@dokument.Dokument.Titel" Untertitel="@($"{Bezeichnungen.Von(dokument.Dokument.Kategorie)} · {dokument.Dokument.Bezug}")" Zurueck="/verwaltung/dokumente" ZurueckText="Alle Dokumente">
    <Aktionen>
        <a class="knopf" href="/dateien/@dokument.Dokument.DateiId?download=true">Herunterladen</a>
    </Aktionen>
</Seitenkopf>

<StatusMeldung />
<FehlerListe Fehler="fehler" />

<dl class="angaben">
    <dt>Datei</dt><dd>@dokument.Dateiname (@Groesse(dokument.Dokument.Groesse))</dd>
    <dt>Hochgeladen</dt><dd>@Format.Zeitpunkt(dokument.HochgeladenAm)@(dokument.HochgeladenVon is null ? "" : $" von {dokument.HochgeladenVon}")</dd>
    <dt>Freigabe</dt><dd>@DokumentTabelle.Freigabe(dokument.Dokument)</dd>
</dl>

@if (dokument.Dokument.MimeTyp.StartsWith("image/", StringComparison.Ordinal))
{
    <img class="dokument-vorschau" src="/dateien/@dokument.Dokument.DateiId" alt="Vorschau: @dokument.Dokument.Titel" />
}
else if (dokument.Dokument.MimeTyp == "application/pdf")
{
    <iframe class="dokument-vorschau" src="/dateien/@dokument.Dokument.DateiId" title="Vorschau: @dokument.Dokument.Titel"></iframe>
}

<section>
    <h2>Angaben</h2>
    <EditForm Model="Daten" FormName="dokument" OnValidSubmit="SpeichernAsync">
        <DataAnnotationsValidator />
        <DokumentFelder Daten="Daten!" Auswahl="auswahl!" />
        <button type="submit" class="knopf knopf-primaer">Speichern</button>
    </EditForm>
</section>

<section>
    <h2>Löschen</h2>
    <GefahrenAktion Text="Dokument löschen" Rueckfrage="Das Dokument wird aus der Ablage entfernt und ist für Mieter und Hausmeister nicht mehr sichtbar." BestaetigenText="Ja, löschen" FormName="loeschen" Bestaetigt="LoeschenAsync" />
</section>

<AenderungsHistorie EntitaetTyp="@nameof(Dokument)" EntitaetId="Id" />

@code {
    private DokumentDetails? dokument;
    private BezugAuswahl? auswahl;
    private IReadOnlyList<string>? fehler;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "dokument")]
    private DokumentDaten? Daten { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var formular = Daten;
        Daten ??= new();
        dokument = await Ablage.LadenAsync(Id);
        auswahl = await Ablage.BezugAuswahlAsync();
        if (formular is null && dokument is not null)
        {
            Daten = dokument.Daten;
        }
    }

    private async Task SpeichernAsync()
    {
        var ergebnis = await Ablage.AendernAsync(Id, Daten!);
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung($"/verwaltung/dokumente/{Id}", "Die Angaben wurden gespeichert.", HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }

    private async Task LoeschenAsync()
    {
        var ergebnis = await Ablage.LoeschenAsync(Id);
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung("/verwaltung/dokumente", "Das Dokument wurde gelöscht.", HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }

    private static string Groesse(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB" : $"{bytes / 1024.0 / 1024.0:0.#} MB";
}
