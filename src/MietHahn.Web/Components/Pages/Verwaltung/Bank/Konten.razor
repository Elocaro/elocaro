@page "/verwaltung/bank/konten"
@inject IBankverwaltung Bank

<Seitenkopf Titel="Bankkonten" Untertitel="Konten für Mieteingänge, Darlehen und Rücklagen; Umsätze per Datei-Import.">
    <Aktionen>
        <a class="knopf" href="/verwaltung/bank/csv-profile">CSV-Profile</a>
        <a class="knopf knopf-primaer" href="/verwaltung/bank/konten/neu">Konto anlegen</a>
    </Aktionen>
</Seitenkopf>

<StatusMeldung />

@if (konten is { Count: 0 })
{
    <Leerzustand Text="Noch keine Bankkonten." />
}
else if (konten is not null)
{
    <div class="tabellen-rahmen">
        <table class="tabelle">
            <thead><tr><th>Konto</th><th>IBAN</th><th>Art</th><th>Objekte</th><th>Umsätze</th></tr></thead>
            <tbody>
                @foreach (var konto in konten)
                {
                    <tr>
                        <td><a href="/verwaltung/bank/konten/@konto.Id">@konto.Name</a>@if (konto.Bank is not null) {<span class="klein"> @konto.Bank</span>}</td>
                        <td>@konto.Iban</td>
                        <td>@Bezeichnungen.Von(konto.Typ)</td>
                        <td>@(konto.Objekte.Count == 0 ? "alle" : string.Join(", ", konto.Objekte))</td>
                        <td>
                            <a href="/verwaltung/bank/umsaetze?konto=@konto.Id">@(konto.LetzterUmsatz is { } letzter ? $"bis {Format.Datum(letzter)}" : "keine")</a>
                            @if (konto.OffeneUmsaetze > 0)
                            {
                                <span class="status status-wartend">@konto.OffeneUmsaetze offen</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<BankkontoZeile>? konten;

    protected override async Task OnInitializedAsync() => konten = await Bank.KontenAsync();
}
