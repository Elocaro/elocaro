@page "/verwaltung/bank/konten/neu"
@using MietHahn.Application.Objekte
@inject IBankverwaltung Bank
@inject IObjektVerwaltung ObjektVerwaltung
@inject Weiterleitung Weiterleitung

<Seitenkopf Titel="Bankkonto anlegen" Zurueck="/verwaltung/bank/konten" ZurueckText="Alle Konten" />

<FehlerListe Fehler="fehler" />

<EditForm Model="Daten" FormName="konto" OnValidSubmit="SpeichernAsync">
    <DataAnnotationsValidator />
    <KontoFelder Daten="Daten!" Objekte="objekte" />
    <button type="submit" class="knopf knopf-primaer">Anlegen</button>
</EditForm>

@code {
    private IReadOnlyList<ObjektUebersicht> objekte = [];
    private IReadOnlyList<string>? fehler;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "konto")]
    private BankkontoDaten? Daten { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Daten ??= new();
        objekte = await ObjektVerwaltung.ListeAsync(null);
    }

    private async Task SpeichernAsync()
    {
        var ergebnis = await Bank.KontoAnlegenAsync(Daten!);
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung($"/verwaltung/bank/konten/{ergebnis.Id}", "Das Konto wurde angelegt. Jetzt einen Kontoauszug importieren.", HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }
}
