@page "/verwaltung/system/mails"
@using System.ComponentModel.DataAnnotations
@using MietHahn.Application.Gemeinsam
@using MietHahn.Application.Kommunikation
@using MietHahn.Domain.Kommunikation
@inject IMailVerwaltung MailVerwaltung
@inject IMailVersand MailVersand
@inject IAktuellerBenutzer Benutzer
@inject TimeProvider Uhr

<Seitenkopf Titel="E-Mail-Versand" Untertitel="Ausgehende Nachrichten und ihr Zustellstatus." />

@if (meldung is not null)
{
    <p class="meldung meldung-ok" role="status">@meldung</p>
}

<section>
    <h2>Testnachricht senden</h2>
    <EditForm Model="Test" FormName="testmail" OnValidSubmit="TestSendenAsync" class="formular-zeile">
        <DataAnnotationsValidator />
        <FormularFeld Id="empfaenger" Beschriftung="Empfänger" Fuer="() => Test!.Empfaenger">
            <InputText id="empfaenger" @bind-Value="Test!.Empfaenger" type="email" autocomplete="email" />
        </FormularFeld>
        <button type="submit" class="knopf">Testnachricht einreihen</button>
    </EditForm>
</section>

<section>
    <h2>Letzte Nachrichten</h2>
    @if (mails is { Count: 0 })
    {
        <Leerzustand Text="Noch keine Nachrichten." />
    }
    else if (mails is not null)
    {
        <div class="tabellen-rahmen">
        <table class="tabelle">
            <thead>
                <tr><th>Erstellt</th><th>An</th><th>Betreff</th><th>Status</th><th>Versuche</th><th>Gesendet / nächster Versuch</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var mail in mails)
                {
                    <tr>
                        <td>@Format.Zeitpunkt(mail.ErstelltAm)</td>
                        <td>@string.Join(", ", mail.An)</td>
                        <td>@mail.Betreff</td>
                        <td><span class="status @StatusKlasse(mail.Status)" title="@mail.LetzterFehler">@StatusText(mail.Status)</span></td>
                        <td>@mail.Versuche</td>
                        <td>@(mail.Status == MailStatus.Gesendet ? Format.Zeitpunkt(mail.GesendetAm) : Format.Zeitpunkt(mail.NaechsterVersuchAm))</td>
                        <td>
                            @if (mail.Status != MailStatus.Gesendet)
                            {
                                <form method="post" @formname="erneut" @onsubmit="ErneutVersuchenAsync" data-enhance>
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ErneutId" value="@mail.Id" />
                                    <button type="submit" class="knopf">Erneut senden</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</section>

@code {
    private IReadOnlyList<MailUebersicht>? mails;
    private string? meldung;

    [SupplyParameterFromForm(FormName = "testmail")]
    private TestModell? Test { get; set; }

    [SupplyParameterFromForm(FormName = "erneut")]
    private Guid? ErneutId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Test ??= new();
        mails = await MailVerwaltung.LetzteAsync(100);
    }

    private async Task TestSendenAsync()
    {
        await MailVersand.EinreihenAsync(new MailAuftrag(
            [Test!.Empfaenger!],
            "test",
            new { GesendetAm = DateOnly.FromDateTime(Uhr.GetLocalNow().DateTime), AusgeloestVon = Benutzer.Kennung }));
        meldung = $"Testnachricht an {Test!.Empfaenger} wurde eingereiht und wird in Kürze versendet.";
        Test = new();
        mails = await MailVerwaltung.LetzteAsync(100);
    }

    private async Task ErneutVersuchenAsync()
    {
        if (ErneutId is { } id)
        {
            await MailVerwaltung.ErneutVersuchenAsync(id);
            meldung = "Die Nachricht wird erneut versendet.";
            mails = await MailVerwaltung.LetzteAsync(100);
        }
    }

    private static string StatusText(MailStatus status) => status switch
    {
        MailStatus.Gesendet => "gesendet",
        MailStatus.Fehlgeschlagen => "fehlgeschlagen",
        _ => "ausstehend",
    };

    private static string StatusKlasse(MailStatus status) => status switch
    {
        MailStatus.Gesendet => "status-ok",
        MailStatus.Fehlgeschlagen => "status-fehler",
        _ => "status-wartend",
    };

    private sealed class TestModell
    {
        [Required(ErrorMessage = "Bitte eine E-Mail-Adresse angeben.")]
        [EmailAddress(ErrorMessage = "Bitte eine gültige E-Mail-Adresse angeben.")]
        public string? Empfaenger { get; set; }
    }
}
