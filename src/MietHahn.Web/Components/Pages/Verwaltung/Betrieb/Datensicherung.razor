@page "/verwaltung/system/datensicherung"
@using MietHahn.Application.Betrieb
@using MietHahn.Web.Betrieb
@inject IBackupStatus BackupStatus

<Seitenkopf Titel="Datensicherung" Untertitel="Nächtliches Backup, Wiederherstellung und Vollexport aller Daten." />

<section>
    <h2>Letzte Sicherung</h2>
    @if (zustand is not null)
    {
        <p class="meldung @MeldungKlasse(zustand.Lage)" role="status">@zustand.Beschreibung</p>
        @if (zustand.Zeitpunkt is not null)
        {
            <dl class="angaben">
                <dt>Zeitpunkt</dt>
                <dd>@Format.Zeitpunkt(zustand.Zeitpunkt)</dd>
                <dt>Ergebnis</dt>
                <dd>
                    @if (zustand.Lage == BackupLage.Fehlgeschlagen)
                    {
                        <span class="status status-fehler">fehlgeschlagen</span>
                    }
                    else
                    {
                        <span class="status status-ok">erfolgreich</span>
                    }
                </dd>
                @if (zustand.Snapshot is not null)
                {
                    <dt>Snapshot</dt>
                    <dd><code>@zustand.Snapshot[..Math.Min(8, zustand.Snapshot.Length)]</code></dd>
                }
                @if (zustand.DauerSekunden is not null)
                {
                    <dt>Dauer</dt>
                    <dd>@zustand.DauerSekunden s</dd>
                }
                @if (!string.IsNullOrWhiteSpace(zustand.Meldung))
                {
                    <dt>Meldung</dt>
                    <dd>@zustand.Meldung</dd>
                }
            </dl>
        }

        @if (zustand.Lage == BackupLage.NichtEingerichtet)
        {
            <p>Der Backup-Container aus <code>deploy/docker-compose.yml</code> meldet hier sein Ergebnis, sobald
            <code>Backup__StatusDatei</code> gesetzt ist. Einrichtung: <code>docs/betrieb.md</code>, Abschnitt „Backup“.</p>
        }
        else if (zustand.BrauchtAufmerksamkeit)
        {
            <p>Logs prüfen und eine Sicherung von Hand anstoßen:</p>
            <pre><code>docker compose -f deploy/docker-compose.yml --env-file deploy/.env logs backup
docker compose -f deploy/docker-compose.yml --env-file deploy/.env run --rm backup sichern</code></pre>
            <p>Solange das Problem besteht, erhalten Administratoren täglich um 8 Uhr eine Warnung per E-Mail.</p>
        }
    }
</section>

<section>
    <h2>Vollexport</h2>
    <p>Alle Daten als ZIP: jede Tabelle als JSON und CSV (für Excel), dazu alle hochgeladenen Dateien und eine
    Beschreibung des Formats. Der Export ist ohne MietHahn lesbar, enthält aber keine Passwörter oder Anmeldetokens.
    Er enthält alle personenbezogenen Daten: sicher aufbewahren. Der Export wird im Audit-Log vermerkt.</p>
    <form method="post" action="@ExportEndpunkt.Pfad">
        <AntiforgeryToken />
        <button type="submit" class="knopf knopf-primaer">Vollexport herunterladen</button>
    </form>
</section>

<section>
    <h2>Wiederherstellen</h2>
    <p>Eine Sicherung wird auf dem Server eingespielt, nicht hier in der Oberfläche: App stoppen, dann
    <code>run --rm backup wiederherstellen</code>. Die Schritt-für-Schritt-Anleitung (auch für einen neuen Server)
    steht in <code>docs/betrieb.md</code>.</p>
</section>

@code {
    private BackupZustand? zustand;

    protected override async Task OnInitializedAsync() => zustand = await BackupStatus.AbfragenAsync();

    private static string MeldungKlasse(BackupLage lage) => lage switch
    {
        BackupLage.Ok => "meldung-ok",
        BackupLage.NichtEingerichtet => "meldung-hinweis",
        _ => "meldung-fehler",
    };
}
