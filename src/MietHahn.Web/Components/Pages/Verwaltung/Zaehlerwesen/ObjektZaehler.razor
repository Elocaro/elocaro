@page "/verwaltung/objekte/{ObjektId:guid}/zaehler"
@inject IZaehlerVerwaltung Verwaltung
@inject IObjektVerwaltung Objekte
@inject Weiterleitung Weiterleitung
@inject TimeProvider Uhr

@if (objekt is null)
{
    <Seitenkopf Titel="Objekt nicht gefunden" Zurueck="/verwaltung/objekte" ZurueckText="Alle Objekte" />
    return;
}

<Seitenkopf Titel="Zähler" Untertitel="@objekt.Daten.Bezeichnung" Zurueck="@($"/verwaltung/objekte/{ObjektId}")" ZurueckText="@objekt.Daten.Bezeichnung">
    <Aktionen>
        @if (zaehler.Count > 0)
        {
            <a class="knopf knopf-primaer" href="/verwaltung/objekte/@ObjektId/ablesung">Ablese-Runde starten</a>
        }
    </Aktionen>
</Seitenkopf>

<StatusMeldung />
<FehlerListe Fehler="fehler" />

@if (zaehler.Count == 0)
{
    <Leerzustand Text="Noch keine Zähler. Lege Hauptzähler, Wohnungszähler und Allgemeinstrom an." />
}
else
{
    <div class="tabellen-rahmen">
        <table class="tabelle">
            <thead><tr><th>Zähler</th><th>Zuordnung</th><th class="zahl">Letzter Stand</th><th>Eichfrist</th></tr></thead>
            <tbody>
                @foreach (var z in zaehler)
                {
                    <tr>
                        <td>
                            <a href="/verwaltung/zaehler/@z.Id">@z.Bezeichnung</a>
                            <span class="klein">@Bezeichnungen.Von(z.Typ) · @z.Nummer@(z.HauptzaehlerId is not null ? " · Unterzähler" : "")</span>
                        </td>
                        <td>@z.Zuordnung</td>
                        <td class="zahl">@Format.Menge(z.LetzterStand?.Wert, Bezeichnungen.Von(z.Messeinheit))<br /><span class="klein">@Format.Datum(z.LetzterStand?.Datum)</span></td>
                        <td>
                            @if (z.EichfristBis is { } frist)
                            {
                                <span class="@(frist < heute ? "status status-fehler" : frist <= heute.AddDays(90) ? "status status-wartend" : "")">@Format.Datum(frist)</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<section>
    <details class="aufklapper" open="@(zaehler.Count == 0)">
        <summary>Zähler hinzufügen</summary>
        <EditForm Model="Daten" FormName="zaehler" OnValidSubmit="AnlegenAsync">
            <DataAnnotationsValidator />
            <ZaehlerFelder Daten="Daten!" Einheiten="objekt.Einheiten" Hauptzaehler="zaehler" />
            <div class="formular-raster">
                <FormularFeld Id="einbau" Beschriftung="Eingebaut am" Fuer="() => Anlage!.EingebautAm" Pflicht="true" Hinweis="Bei vorhandenen Zählern: Tag der ersten Ablesung">
                    <InputDate id="einbau" @bind-Value="Anlage!.EingebautAm" />
                </FormularFeld>
                <FormularFeld Id="anfangsstand" Beschriftung="Stand an diesem Tag" Fuer="() => Anlage!.Anfangsstand" Pflicht="true">
                    <InputFlaeche id="anfangsstand" @bind-Value="Anlage!.Anfangsstand" step="0.001" />
                </FormularFeld>
            </div>
            <button type="submit" class="knopf">Zähler anlegen</button>
        </EditForm>
    </details>
</section>

@code {
    private ObjektDetails? objekt;
    private IReadOnlyList<ZaehlerZeile> zaehler = [];
    private IReadOnlyList<string>? fehler;
    private DateOnly heute;

    [Parameter]
    public Guid ObjektId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Ein Formular, zwei Modelle: Daten.* (ZaehlerFelder) und Anlage.* (Einbau, Anfangsstand)
    [SupplyParameterFromForm(FormName = "zaehler")]
    private ZaehlerDaten? Daten { get; set; }

    [SupplyParameterFromForm(FormName = "zaehler")]
    private ZaehlerAnlage? Anlage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        heute = MietHahn.Domain.Gemeinsam.Zeitzone.Heute(Uhr.GetUtcNow());
        Daten ??= new();
        Anlage ??= new() { EingebautAm = heute };
        objekt = await Objekte.LadenAsync(ObjektId);
        if (objekt is not null)
        {
            zaehler = await Verwaltung.ListeAsync(ObjektId);
        }
    }

    private async Task AnlegenAsync()
    {
        if (Anlage!.EingebautAm is null || Anlage.Anfangsstand is null)
        {
            fehler = ["Bitte Einbaudatum und Stand angeben."];
            zaehler = await Verwaltung.ListeAsync(ObjektId);
            return;
        }

        Anlage.Daten = Daten!;
        var ergebnis = await Verwaltung.AnlegenAsync(ObjektId, Anlage);
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung($"/verwaltung/objekte/{ObjektId}/zaehler", "Der Zähler wurde angelegt.", HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
            zaehler = await Verwaltung.ListeAsync(ObjektId);
        }
    }
}
