@page "/verwaltung/vpi"
@inject IVpiVerwaltung Verwaltung
@inject Weiterleitung Weiterleitung

<Seitenkopf Titel="Verbraucherpreisindex" Untertitel="Monatswerte für Indexmieten (Destatis, Basis 2020 = 100, Tabelle 61111-0002)." />

<StatusMeldung />
<FehlerListe Fehler="fehler" />

<section>
    <h2>Wert erfassen</h2>
    <EditForm Model="Eingabe" FormName="vpi" OnValidSubmit="SpeichernAsync" class="formular-zeile">
        <DataAnnotationsValidator />
        <FormularFeld Id="vpi-monat" Beschriftung="Monat" Fuer="() => Eingabe!.Monat" Pflicht="true">
            <InputText id="vpi-monat" type="month" @bind-Value="Eingabe!.Monat" />
        </FormularFeld>
        <FormularFeld Id="vpi-wert" Beschriftung="Indexwert" Fuer="() => Eingabe!.Wert" Pflicht="true">
            <InputFlaeche id="vpi-wert" @bind-Value="Eingabe!.Wert" step="0.1" />
        </FormularFeld>
        <div class="feld feld-aktion"><button type="submit" class="knopf">Speichern</button></div>
    </EditForm>
</section>

<section>
    <h2>Import</h2>
    <p class="klein">
        In <a href="https://www-genesis.destatis.de/datenbank/online/table/61111-0002" rel="noopener" target="_blank">GENESIS-Online, Tabelle 61111-0002</a>
        die Monatswerte als CSV herunterladen und den Inhalt hier einfügen. Vorhandene Monate werden aktualisiert.
    </p>
    <EditForm Model="Import" FormName="vpi-import" OnValidSubmit="ImportierenAsync">
        <FormularFeld Id="vpi-csv" Beschriftung="CSV-Inhalt" Fuer="() => Import!.Csv">
            <InputTextArea id="vpi-csv" @bind-Value="Import!.Csv" rows="6" placeholder="2026;Januar;121,2&#10;2026;Februar;121,9" />
        </FormularFeld>
        <button type="submit" class="knopf">Importieren</button>
    </EditForm>
</section>

<section>
    <h2>Werte</h2>
    @if (werte is { Count: 0 })
    {
        <Leerzustand Text="Noch keine Indexwerte." />
    }
    else if (werte is not null)
    {
        <div class="tabellen-rahmen">
            <table class="tabelle">
                <thead><tr><th>Monat</th><th class="zahl">Wert</th><th>Quelle</th></tr></thead>
                <tbody>
                    @foreach (var wert in werte)
                    {
                        <tr>
                            <td>@wert.Monat.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))</td>
                            <td class="zahl">@Format.Zahl(wert.Wert)</td>
                            <td>@wert.Quelle</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private IReadOnlyList<VpiAnsicht>? werte;
    private IReadOnlyList<string>? fehler;

    [SupplyParameterFromForm(FormName = "vpi")]
    private VpiEingabe? Eingabe { get; set; }

    [SupplyParameterFromForm(FormName = "vpi-import")]
    private ImportEingabe? Import { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Eingabe ??= new();
        Import ??= new();
        werte = await Verwaltung.ListeAsync();
    }

    private async Task SpeichernAsync()
    {
        if (!DateOnly.TryParseExact(Eingabe!.Monat + "-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var monat))
        {
            fehler = ["Bitte einen Monat wählen."];
            return;
        }

        var ergebnis = await Verwaltung.SetzenAsync(monat, Eingabe.Wert!.Value);
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung("/verwaltung/vpi", "Der Indexwert wurde gespeichert.", HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }

    private async Task ImportierenAsync()
    {
        var ergebnis = await Verwaltung.ImportierenAsync(Import!.Csv ?? "");
        var meldung = $"Import: {ergebnis.Neu} neu, {ergebnis.Geaendert} geändert, {ergebnis.Unveraendert} unverändert.";
        if (ergebnis.Fehler.Count > 0)
        {
            fehler = [meldung, .. ergebnis.Fehler];
            werte = await Verwaltung.ListeAsync();
            return;
        }

        Weiterleitung.ZuMitMeldung("/verwaltung/vpi", meldung, HttpContext);
    }

    private sealed class VpiEingabe
    {
        [Required(ErrorMessage = "Bitte einen Monat wählen.")]
        public string? Monat { get; set; }

        [Required(ErrorMessage = "Bitte den Indexwert angeben.")]
        [Range(typeof(decimal), "1", "1000", ErrorMessage = "Bitte einen Indexwert wie 121,7 angeben.", ParseLimitsInInvariantCulture = true)]
        public decimal? Wert { get; set; }
    }

    private sealed class ImportEingabe
    {
        public string? Csv { get; set; }
    }
}
