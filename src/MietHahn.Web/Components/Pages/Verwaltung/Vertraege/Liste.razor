@page "/verwaltung/vertraege"
@inject IVertragsVerwaltung Verwaltung

<Seitenkopf Titel="Mietverträge" Untertitel="@(Alle ? "Alle Verträge, auch beendete." : "Laufende und künftige Verträge.")">
    <Aktionen>
        <a class="knopf knopf-primaer" href="/verwaltung/vertraege/neu">Vertrag anlegen</a>
    </Aktionen>
</Seitenkopf>

<StatusMeldung />

<p>
    @if (Alle)
    {
        <a href="/verwaltung/vertraege">Nur laufende anzeigen</a>
    }
    else
    {
        <a href="/verwaltung/vertraege?alle=true">Auch beendete anzeigen</a>
    }
</p>

@if (vertraege is { Count: 0 })
{
    <Leerzustand Text="Keine Verträge. Lege zuerst Objekte und Personen an, dann den ersten Vertrag." />
}
else if (vertraege is not null)
{
    <div class="tabellen-rahmen">
        <table class="tabelle">
            <thead>
                <tr><th>Mietobjekt</th><th>Mieter</th><th>Laufzeit</th><th>Status</th><th class="zahl">Monatsmiete</th></tr>
            </thead>
            <tbody>
                @foreach (var vertrag in vertraege)
                {
                    <tr>
                        <td><a href="/verwaltung/vertraege/@vertrag.Id">@vertrag.Mietobjekt</a> <span class="klein">@vertrag.Objekt</span></td>
                        <td>@vertrag.Mieter</td>
                        <td>@Format.Datum(vertrag.Beginn) – @(vertrag.Ende is null ? "unbefristet" : Format.Datum(vertrag.Ende))</td>
                        <td><span class="status @Bezeichnungen.StatusKlasse(vertrag.Status)">@Bezeichnungen.Von(vertrag.Status)</span></td>
                        <td class="zahl">@Format.Geld(vertrag.Monatsmiete)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<VertragUebersicht>? vertraege;

    [SupplyParameterFromQuery]
    private bool Alle { get; set; }

    protected override async Task OnParametersSetAsync() => vertraege = await Verwaltung.ListeAsync(!Alle);
}
