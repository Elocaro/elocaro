@page "/verwaltung/vertraege/{Id:guid}/auszug"
@inject IVertragsVerwaltung Verwaltung
@inject Weiterleitung Weiterleitung

@if (vertrag is null)
{
    <Seitenkopf Titel="Vertrag nicht gefunden" Zurueck="/verwaltung/vertraege" ZurueckText="Alle Verträge" />
    return;
}

<Seitenkopf Titel="Mieterwechsel" Untertitel="@($"{vertrag.Mietobjekt}, {vertrag.Objekt}")" Zurueck="@($"/verwaltung/vertraege/{Id}")" ZurueckText="Zum Vertrag" />

<FehlerListe Fehler="fehler" />

@if (Fertig)
{
    <p class="meldung meldung-ok" role="status">Das Mietverhältnis endet am @Format.Datum(vertrag.Laufzeit.Bis).</p>
    <ol class="schritte">
        <li class="erledigt">Auszug erfasst</li>
        <li><a href="/verwaltung/objekte/@vertrag.ObjektId/ablesung?einheit=@vertrag.EinheitId&datum=@(vertrag.Laufzeit.Bis?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))&art=Zwischenablesung">Zählerstände zum Auszug ablesen</a> (Zwischenablesung für die Abrechnung)</li>
        <li><a class="knopf knopf-primaer" href="/verwaltung/vertraege/neu?mietobjekt=@vertrag.MietobjektId&beginn=@(vertrag.Laufzeit.Bis?.AddDays(1).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))">Neuen Vertrag anlegen</a></li>
    </ol>
    <p class="klein">Bis zum nächsten Vertrag steht das Mietobjekt leer; Leerstandszeiten erscheinen automatisch in der Vertragshistorie und gehen in die Abrechnung zulasten des Vermieters.</p>
    return;
}

<ol class="schritte">
    <li class="aktiv">Auszug: letzter Tag und neue Anschrift</li>
    <li>Zählerstände ablesen</li>
    <li>Neuer Vertrag (Einzug)</li>
</ol>

<EditForm Model="Eingabe" FormName="auszug" OnValidSubmit="AuszugAsync">
    <DataAnnotationsValidator />
    <FormularFeld Id="ende" Beschriftung="Letzter Tag des Mietverhältnisses" Fuer="() => Eingabe!.Ende" Pflicht="true">
        <InputDate id="ende" @bind-Value="Eingabe!.Ende" />
    </FormularFeld>
    <h2>Neue Anschrift der Mieter</h2>
    <p class="klein">Für die Zustellung der Nebenkostenabrechnung und der Kautionsabrechnung. Gilt ab dem Tag nach dem Auszug.</p>
    <div class="formular-raster">
        <FormularFeld Id="neue-strasse" Beschriftung="Straße und Hausnummer" Fuer="() => Eingabe!.NeueStrasse">
            <InputText id="neue-strasse" @bind-Value="Eingabe!.NeueStrasse" autocomplete="off" />
        </FormularFeld>
        <FormularFeld Id="neue-plz" Beschriftung="PLZ" Fuer="() => Eingabe!.NeuePlz">
            <InputText id="neue-plz" @bind-Value="Eingabe!.NeuePlz" inputmode="numeric" autocomplete="off" />
        </FormularFeld>
        <FormularFeld Id="neuer-ort" Beschriftung="Ort" Fuer="() => Eingabe!.NeuerOrt">
            <InputText id="neuer-ort" @bind-Value="Eingabe!.NeuerOrt" autocomplete="off" />
        </FormularFeld>
    </div>
    <button type="submit" class="knopf knopf-primaer">Auszug erfassen</button>
</EditForm>

@code {
    private VertragDetails? vertrag;
    private IReadOnlyList<string>? fehler;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery]
    private bool Fertig { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "auszug")]
    private AuszugEingabe? Eingabe { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Eingabe ??= new();
        vertrag = await Verwaltung.LadenAsync(Id);
        Eingabe.Ende ??= vertrag?.Laufzeit.Bis;
    }

    private async Task AuszugAsync()
    {
        var ergebnis = await Verwaltung.AuszugAsync(Id, Eingabe!);
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung($"/verwaltung/vertraege/{Id}/auszug?fertig=true", "Der Auszug wurde erfasst.", HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }
}
