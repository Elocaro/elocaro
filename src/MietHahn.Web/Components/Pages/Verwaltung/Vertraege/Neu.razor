@page "/verwaltung/vertraege/neu"
@inject IVertragsVerwaltung Verwaltung
@inject IPersonenVerwaltung Personen
@inject Weiterleitung Weiterleitung

<Seitenkopf Titel="Mietvertrag anlegen" Zurueck="/verwaltung/vertraege" ZurueckText="Alle Verträge" />

<FehlerListe Fehler="fehler" />

@if (mietobjekte.Count == 0 || personen.Count == 0)
{
    <p class="meldung meldung-hinweis">
        Für einen Vertrag braucht es ein vermietbares <a href="/verwaltung/objekte">Objekt</a> und mindestens eine <a href="/verwaltung/personen/neu">Person</a>.
    </p>
}

<EditForm Model="Formular" FormName="vertrag" OnValidSubmit="AnlegenAsync">
    <DataAnnotationsValidator />
    <h2>Mietobjekt &amp; Laufzeit</h2>
    <div class="formular-raster">
        <FormularFeld Id="mietobjekt" Beschriftung="Mietobjekt" Fuer="() => Formular!.MietobjektId" Pflicht="true">
            <InputSelect id="mietobjekt" @bind-Value="Formular!.MietobjektId">
                <option value="">– bitte wählen –</option>
                @foreach (var gruppe in mietobjekte.GroupBy(m => m.Objekt))
                {
                    <optgroup label="@gruppe.Key">
                        @foreach (var m in gruppe)
                        {
                            <option value="@m.Id">@m.Bezeichnung@(m.AktuellBelegt is { } belegt ? $" (vermietet{(belegt.Bis is { } bis ? " bis " + Format.Datum(bis) : "")})" : " (frei)")</option>
                        }
                    </optgroup>
                }
            </InputSelect>
        </FormularFeld>
        <FormularFeld Id="beginn" Beschriftung="Mietbeginn" Fuer="() => Formular!.Beginn" Pflicht="true">
            <InputDate id="beginn" @bind-Value="Formular!.Beginn" />
        </FormularFeld>
        <FormularFeld Id="befristet" Beschriftung="Befristet bis" Fuer="() => Formular!.BefristetBis" Hinweis="Nur bei Zeitmietverträgen (§ 575 BGB).">
            <InputDate id="befristet" @bind-Value="Formular!.BefristetBis" />
        </FormularFeld>
    </div>

    <h2>Mieter</h2>
    <div class="formular-raster">
        <FormularFeld Id="mieter1" Beschriftung="Mieter" Fuer="() => Formular!.Mieter1" Pflicht="true">
            <PersonAuswahlFeld Id="mieter1" @bind-Value="Formular!.Mieter1" Personen="personen" />
        </FormularFeld>
        <FormularFeld Id="mieter2" Beschriftung="Weiterer Mieter" Fuer="() => Formular!.Mieter2" Hinweis="Gesamtschuldnerisch; weitere später im Vertrag.">
            <PersonAuswahlFeld Id="mieter2" @bind-Value="Formular!.Mieter2" Personen="personen" />
        </FormularFeld>
        <FormularFeld Id="buerge" Beschriftung="Bürge" Fuer="() => Formular!.Buerge">
            <PersonAuswahlFeld Id="buerge" @bind-Value="Formular!.Buerge" Personen="personen" />
        </FormularFeld>
    </div>
    <p class="klein"><a href="/verwaltung/personen/neu">Neue Person anlegen</a> (danach diese Seite neu laden)</p>

    <h2>Miete</h2>
    <div class="formular-raster">
        <FormularFeld Id="abrechnungsart" Beschriftung="Nebenkosten" Fuer="() => Formular!.Abrechnungsart">
            <InputSelect id="abrechnungsart" @bind-Value="Formular!.Abrechnungsart">
                @foreach (var wert in Enum.GetValues<Abrechnungsart>())
                {
                    <option value="@wert">@Bezeichnungen.Von(wert)</option>
                }
            </InputSelect>
        </FormularFeld>
        <FormularFeld Id="kaltmiete" Beschriftung="Kaltmiete (€/Monat)" Fuer="() => Formular!.Kaltmiete" Pflicht="true">
            <InputBetrag id="kaltmiete" @bind-Value="Formular!.Kaltmiete" />
        </FormularFeld>
        <FormularFeld Id="bk" Beschriftung="Betriebskosten-Vorauszahlung" Fuer="() => Formular!.BetriebskostenVorauszahlung">
            <InputBetrag id="bk" @bind-Value="Formular!.BetriebskostenVorauszahlung" />
        </FormularFeld>
        <FormularFeld Id="hk" Beschriftung="Heizkosten-Vorauszahlung" Fuer="() => Formular!.HeizkostenVorauszahlung">
            <InputBetrag id="hk" @bind-Value="Formular!.HeizkostenVorauszahlung" />
        </FormularFeld>
        <FormularFeld Id="pauschale" Beschriftung="Betriebskostenpauschale" Fuer="() => Formular!.Betriebskostenpauschale" Hinweis="Nur bei „Pauschale“, z. B. WG-Zimmer.">
            <InputBetrag id="pauschale" @bind-Value="Formular!.Betriebskostenpauschale" />
        </FormularFeld>
        <FormularFeld Id="personen" Beschriftung="Personen im Haushalt" Fuer="() => Formular!.Personen">
            <InputNumber id="personen" @bind-Value="Formular!.Personen" min="1" max="20" />
        </FormularFeld>
    </div>
    <div class="feld feld-checkbox">
        <InputCheckbox id="hk-verbrauch" @bind-Value="Formular!.HeizkostenVerbrauchsabhaengig" />
        <label for="hk-verbrauch">Heizkosten trotz Pauschale verbrauchsabhängig abrechnen (HeizkostenV)</label>
    </div>

    <h2>Weitere Angaben</h2>
    <div class="formular-raster">
        <FormularFeld Id="werktag" Beschriftung="Fällig am … Werktag" Fuer="() => Formular!.FaelligAmWerktag">
            <InputNumber id="werktag" @bind-Value="Formular!.FaelligAmWerktag" min="1" max="10" />
        </FormularFeld>
        <FormularFeld Id="zahlungsart" Beschriftung="Zahlungsart" Fuer="() => Formular!.Zahlungsart">
            <InputSelect id="zahlungsart" @bind-Value="Formular!.Zahlungsart">
                @foreach (var wert in Enum.GetValues<Zahlungsart>())
                {
                    <option value="@wert">@Bezeichnungen.Von(wert)</option>
                }
            </InputSelect>
        </FormularFeld>
        <FormularFeld Id="frist" Beschriftung="Kündigungsfrist Mieter (Monate)" Fuer="() => Formular!.KuendigungsfristMonate">
            <InputNumber id="frist" @bind-Value="Formular!.KuendigungsfristMonate" min="1" max="24" />
        </FormularFeld>
        <FormularFeld Id="kaution" Beschriftung="Kaution (€)" Fuer="() => Formular!.Kaution">
            <InputBetrag id="kaution" @bind-Value="Formular!.Kaution" />
        </FormularFeld>
        <FormularFeld Id="kaution-notiz" Beschriftung="Kaution – Notiz" Fuer="() => Formular!.KautionNotiz" Hinweis="z. B. „Bürgschaft Sparkasse“">
            <InputText id="kaution-notiz" @bind-Value="Formular!.KautionNotiz" />
        </FormularFeld>
    </div>
    <FormularFeld Id="notizen" Beschriftung="Notizen" Fuer="() => Formular!.Notizen">
        <InputTextArea id="notizen" @bind-Value="Formular!.Notizen" rows="2" />
    </FormularFeld>

    <button type="submit" class="knopf knopf-primaer">Vertrag anlegen</button>
</EditForm>

@code {
    private IReadOnlyList<MietobjektAuswahl> mietobjekte = [];
    private IReadOnlyList<PersonAuswahl> personen = [];
    private IReadOnlyList<string>? fehler;

    [SupplyParameterFromForm(FormName = "vertrag")]
    private VertragFormular? Formular { get; set; }

    [SupplyParameterFromQuery]
    private Guid? Mietobjekt { get; set; }

    [SupplyParameterFromQuery]
    private DateOnly? Beginn { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Formular ??= new() { MietobjektId = Mietobjekt, Beginn = Beginn };
        mietobjekte = await Verwaltung.MietobjekteAsync();
        personen = await Personen.AuswahlAsync();
    }

    private async Task AnlegenAsync()
    {
        var f = Formular!;
        var anlage = new VertragAnlage
        {
            MietobjektId = f.MietobjektId,
            Beginn = f.Beginn,
            BefristetBis = f.BefristetBis,
            MieterIds = new[] { f.Mieter1, f.Mieter2 }.OfType<Guid>().Distinct().ToList(),
            BuergenIds = f.Buerge is { } b ? [b] : [],
            Abrechnungsart = f.Abrechnungsart,
            HeizkostenVerbrauchsabhaengig = f.HeizkostenVerbrauchsabhaengig,
            Kaltmiete = f.Kaltmiete,
            BetriebskostenVorauszahlung = f.BetriebskostenVorauszahlung,
            HeizkostenVorauszahlung = f.HeizkostenVorauszahlung,
            Betriebskostenpauschale = f.Betriebskostenpauschale,
            Personen = f.Personen,
            Daten = new VertragDaten
            {
                FaelligAmWerktag = f.FaelligAmWerktag,
                Zahlungsart = f.Zahlungsart,
                KuendigungsfristMonate = f.KuendigungsfristMonate,
                Abrechnungsart = f.Abrechnungsart,
                HeizkostenVerbrauchsabhaengig = f.HeizkostenVerbrauchsabhaengig,
                Kaution = f.Kaution,
                KautionNotiz = f.KautionNotiz,
                Notizen = f.Notizen,
            },
        };
        var ergebnis = await Verwaltung.AnlegenAsync(anlage);
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung($"/verwaltung/vertraege/{ergebnis.Id}", "Der Vertrag wurde angelegt.", HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }

    /// <summary>Flaches Formularmodell (eine Ebene, damit Feldnamen und Validierung einfach bleiben).</summary>
    private sealed class VertragFormular
    {
        [Required(ErrorMessage = "Bitte das Mietobjekt wählen.")]
        public Guid? MietobjektId { get; set; }

        [Required(ErrorMessage = "Bitte den Mietbeginn angeben.")]
        public DateOnly? Beginn { get; set; }

        public DateOnly? BefristetBis { get; set; }

        [Required(ErrorMessage = "Bitte den Mieter wählen.")]
        public Guid? Mieter1 { get; set; }

        public Guid? Mieter2 { get; set; }

        public Guid? Buerge { get; set; }

        public Abrechnungsart Abrechnungsart { get; set; }

        public bool HeizkostenVerbrauchsabhaengig { get; set; }

        [Required(ErrorMessage = "Bitte die Kaltmiete angeben.")]
        [Range(typeof(decimal), "0", "100000", ErrorMessage = "Bitte einen Betrag zwischen 0 und 100.000 € angeben.", ParseLimitsInInvariantCulture = true)]
        public decimal? Kaltmiete { get; set; }

        [Range(typeof(decimal), "0", "100000", ErrorMessage = "Bitte einen Betrag zwischen 0 und 100.000 € angeben.", ParseLimitsInInvariantCulture = true)]
        public decimal? BetriebskostenVorauszahlung { get; set; }

        [Range(typeof(decimal), "0", "100000", ErrorMessage = "Bitte einen Betrag zwischen 0 und 100.000 € angeben.", ParseLimitsInInvariantCulture = true)]
        public decimal? HeizkostenVorauszahlung { get; set; }

        [Range(typeof(decimal), "0", "100000", ErrorMessage = "Bitte einen Betrag zwischen 0 und 100.000 € angeben.", ParseLimitsInInvariantCulture = true)]
        public decimal? Betriebskostenpauschale { get; set; }

        [Range(1, 20, ErrorMessage = "Bitte eine Personenanzahl zwischen 1 und 20 angeben.")]
        public int Personen { get; set; } = 1;

        [Range(1, 10, ErrorMessage = "Bitte einen Werktag zwischen 1 und 10 angeben.")]
        public int FaelligAmWerktag { get; set; } = 3;

        public Zahlungsart Zahlungsart { get; set; }

        [Range(1, 24, ErrorMessage = "Bitte eine Kündigungsfrist zwischen 1 und 24 Monaten angeben.")]
        public int KuendigungsfristMonate { get; set; } = 3;

        [Range(typeof(decimal), "0", "100000", ErrorMessage = "Bitte einen Betrag zwischen 0 und 100.000 € angeben.", ParseLimitsInInvariantCulture = true)]
        public decimal? Kaution { get; set; }

        [StringLength(1000)]
        public string? KautionNotiz { get; set; }

        [StringLength(4000)]
        public string? Notizen { get; set; }
    }
}
