@page "/verwaltung/belege/neu"
@using MietHahn.Application.Dateien
@inject IBelegverwaltung Belege
@inject IDateiablage Ablage
@inject Weiterleitung Weiterleitung

<Seitenkopf Titel="Beleg erfassen" Zurueck="/verwaltung/belege" ZurueckText="Alle Belege" />

<FehlerListe Fehler="fehler" />

@if (auswahl is not null)
{
    <EditForm Model="Daten" FormName="beleg" OnValidSubmit="SpeichernAsync" enctype="multipart/form-data">
        <DataAnnotationsValidator />
        <div class="feld">
            <label for="dateien">Rechnung (PDF oder Fotos)</label>
            <input type="file" id="dateien" name="Dateien" accept="application/pdf,image/*" multiple />
            <span class="feld-hinweis">Mehrere Seiten auf einmal möglich; auf dem Handy öffnet sich die Kamera zur Auswahl.</span>
        </div>
        <BelegFelder Daten="Daten!" Auswahl="auswahl" />
        <h2>Kostenart</h2>
        <p class="klein">Für eine Rechnung mit einer Kostenart. Aufteilen auf mehrere Kostenarten oder Objekte geht danach.</p>
        <PositionFelder Position="Position!" Auswahl="auswahl" MitDetails="false" Pflicht="false" />
        <button type="submit" class="knopf knopf-primaer">Speichern</button>
    </EditForm>
}

@code {
    private BelegAuswahl? auswahl;
    private IReadOnlyList<string>? fehler;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "beleg")]
    private BelegDaten? Daten { get; set; }

    [SupplyParameterFromForm(FormName = "beleg")]
    private PositionEingabe? Position { get; set; }

    [SupplyParameterFromForm(FormName = "beleg")]
    private IFormFileCollection? Dateien { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Daten ??= new();
        Position ??= new();
        auswahl = await Belege.AuswahlAsync();
    }

    private async Task SpeichernAsync()
    {
        try
        {
            var dateiIds = new List<Guid>();
            foreach (var datei in Dateien?.Where(d => d.Length > 0) ?? [])
            {
                await using var inhalt = datei.OpenReadStream();
                dateiIds.Add((await Ablage.SpeichernAsync(inhalt, datei.FileName)).Id);
            }

            var ergebnis = await Belege.AnlegenAsync(Daten!, dateiIds, Position);
            if (ergebnis.Erfolgreich)
            {
                Weiterleitung.ZuMitMeldung($"/verwaltung/belege/{ergebnis.Id}", "Der Beleg wurde gespeichert.", HttpContext);
            }
            else
            {
                fehler = ergebnis.Fehler;
            }
        }
        catch (DateiAbgelehntException ex)
        {
            fehler = [ex.Message];
        }
    }
}
