@page "/verwaltung/belege/{Id:guid}"
@using MietHahn.Application.Dateien
@inject IBelegverwaltung Belege
@inject IDateiablage Ablage
@inject Weiterleitung Weiterleitung

@if (beleg is null)
{
    <Seitenkopf Titel="Beleg nicht gefunden" Zurueck="/verwaltung/belege" ZurueckText="Alle Belege" />
    return;
}

<Seitenkopf Titel="@($"{beleg.Lieferant} {Format.Geld(beleg.Daten.Brutto)}")" Untertitel="@($"Rechnung {beleg.Daten.Rechnungsnummer} vom {Format.Datum(beleg.Daten.Rechnungsdatum)}")" Zurueck="/verwaltung/belege" ZurueckText="Alle Belege" />

<StatusMeldung />
<FehlerListe Fehler="fehler" />

<section>
    <h2>Kostenaufteilung</h2>
    @if (beleg.Offen != 0)
    {
        <p class="meldung meldung-hinweis" role="status">Noch @Format.Geld(beleg.Offen) nicht aufgeteilt (aufgeteilt @Format.Geld(beleg.Aufgeteilt) von @Format.Geld(beleg.Daten.Brutto)).</p>
    }
    @if (beleg.Positionen.Count > 0)
    {
        <form method="post" @formname="positionen" @onsubmit="PositionEntfernenAsync">
            <AntiforgeryToken />
            <div class="tabellen-rahmen">
                <table class="tabelle">
                    <thead><tr><th>Kostenart</th><th>Objekt</th><th>Zeitraum</th><th class="zahl">Betrag</th><th>§ 35a</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in beleg.Positionen)
                        {
                            <tr>
                                <td>@p.KostenartText @if (!p.Umlagefaehig) {<span class="status">nicht umlagefähig</span>}</td>
                                <td>@p.Objekt@(p.Einheit is null ? "" : $", {p.Einheit}")</td>
                                <td>@Format.Zeitraum(p.Abrechnungszeitraum)</td>
                                <td class="zahl">@Format.Geld(p.Betrag)</td>
                                <td>@(p.Paragraf35a == Paragraf35a.Keine ? "–" : $"{Bezeichnungen.Von(p.Paragraf35a)}: {Format.Geld(p.Arbeitskosten)}")</td>
                                <td><button type="submit" class="knopf knopf-gefahr" name="PositionId" value="@p.Id" aria-label="Position @p.KostenartText entfernen">Entfernen</button></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th colspan="3">Summe</th><th class="zahl">@Format.Geld(beleg.Aufgeteilt)</th><th colspan="2"></th></tr></tfoot>
                </table>
            </div>
        </form>
    }
    @* Beim statischen Rendern kann ein Zwischenstand gerendert werden, bevor die Auswahllisten geladen sind. *@
    @if (beleg.Offen != 0 && auswahl is not null)
    {
        <h3>Position hinzufügen</h3>
        <EditForm Model="Position" FormName="position" OnValidSubmit="PositionHinzufuegenAsync">
            <DataAnnotationsValidator />
            <PositionFelder Position="Position!" Auswahl="auswahl" />
            <button type="submit" class="knopf">Position hinzufügen</button>
        </EditForm>
    }
</section>

<section>
    <h2>Dateien</h2>
    @if (beleg.Dateien.Count == 0)
    {
        <p class="klein">Noch keine Datei.</p>
    }
    else
    {
        <form method="post" @formname="dateien" @onsubmit="DateiEntfernenAsync">
            <AntiforgeryToken />
            <ul>
                @foreach (var d in beleg.Dateien)
                {
                    <li>
                        Seite @d.Seite: <a href="/dateien/@d.DateiId" target="_blank" rel="noopener">@d.Name</a>
                        (<a href="/dateien/@d.DateiId?download=true">herunterladen</a>)
                        <button type="submit" class="knopf knopf-gefahr" name="DateiId" value="@d.DateiId" aria-label="Seite @d.Seite entfernen">Entfernen</button>
                    </li>
                }
            </ul>
        </form>
        var erste = beleg.Dateien[0];
        @if (erste.MimeTyp.StartsWith("image/", StringComparison.Ordinal))
        {
            <img class="dokument-vorschau" src="/dateien/@erste.DateiId" alt="Seite 1" />
        }
        else if (erste.MimeTyp == "application/pdf")
        {
            <iframe class="dokument-vorschau" src="/dateien/@erste.DateiId" title="Seite 1"></iframe>
        }
    }
    <form method="post" enctype="multipart/form-data" @formname="hochladen" @onsubmit="HochladenAsync" class="formular-zeile">
        <AntiforgeryToken />
        <div class="feld">
            <label for="weitere">Seiten hinzufügen</label>
            <input type="file" id="weitere" name="Weitere" accept="application/pdf,image/*" multiple required />
        </div>
        <div class="feld feld-aktion"><button type="submit" class="knopf">Hochladen</button></div>
    </form>
</section>

@if (auswahl is not null)
{
    <section>
        <h2>Angaben</h2>
        <EditForm Model="Daten" FormName="beleg" OnValidSubmit="SpeichernAsync">
            <DataAnnotationsValidator />
            <BelegFelder Daten="Daten!" Auswahl="auswahl" />
            <button type="submit" class="knopf knopf-primaer">Speichern</button>
        </EditForm>
    </section>
}

<section>
    <h2>Löschen</h2>
    <GefahrenAktion Text="Beleg löschen" Rueckfrage="Der Beleg wird logisch gelöscht; die Dateien bleiben im Archiv." BestaetigenText="Ja, löschen" FormName="loeschen" Bestaetigt="LoeschenAsync" />
</section>

<AenderungsHistorie EntitaetTyp="@nameof(Beleg)" EntitaetId="Id" />

@code {
    private BelegDetails? beleg;
    private BelegAuswahl? auswahl;
    private IReadOnlyList<string>? fehler;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "beleg")]
    private BelegDaten? Daten { get; set; }

    [SupplyParameterFromForm(FormName = "position")]
    private PositionEingabe? Position { get; set; }

    [SupplyParameterFromForm(FormName = "positionen")]
    private Guid? PositionId { get; set; }

    [SupplyParameterFromForm(FormName = "dateien")]
    private Guid? DateiId { get; set; }

    [SupplyParameterFromForm(FormName = "hochladen")]
    private IFormFileCollection? Weitere { get; set; }

    private string Ziel => $"/verwaltung/belege/{Id}";

    protected override async Task OnInitializedAsync()
    {
        var formular = Daten;
        Daten ??= new();
        Position ??= new();
        beleg = await Belege.LadenAsync(Id);
        auswahl = await Belege.AuswahlAsync();
        if (formular is null && beleg is not null)
        {
            Daten = beleg.Daten;
        }
    }

    private Task SpeichernAsync() => AusfuehrenAsync(Belege.AendernAsync(Id, Daten!), "Die Angaben wurden gespeichert.");

    private Task PositionHinzufuegenAsync() => AusfuehrenAsync(Belege.PositionHinzufuegenAsync(Id, Position!), "Die Position wurde hinzugefügt.");

    private Task PositionEntfernenAsync() => PositionId is { } id ? AusfuehrenAsync(Belege.PositionEntfernenAsync(Id, id), "Die Position wurde entfernt.") : Task.CompletedTask;

    private Task DateiEntfernenAsync() => DateiId is { } id ? AusfuehrenAsync(Belege.DateiEntfernenAsync(Id, id), "Die Seite wurde entfernt.") : Task.CompletedTask;

    private Task LoeschenAsync() => AusfuehrenAsync(Belege.LoeschenAsync(Id), "Der Beleg wurde gelöscht.", "/verwaltung/belege");

    private async Task HochladenAsync()
    {
        try
        {
            var ids = new List<Guid>();
            foreach (var datei in Weitere?.Where(d => d.Length > 0) ?? [])
            {
                await using var inhalt = datei.OpenReadStream();
                ids.Add((await Ablage.SpeichernAsync(inhalt, datei.FileName)).Id);
            }

            await AusfuehrenAsync(Belege.DateienHinzufuegenAsync(Id, ids), ids.Count == 1 ? "Die Seite wurde hinzugefügt." : $"{ids.Count} Seiten wurden hinzugefügt.");
        }
        catch (DateiAbgelehntException ex)
        {
            fehler = [ex.Message];
        }
    }

    private async Task AusfuehrenAsync(Task<Ergebnis> befehl, string erfolg, string? ziel = null)
    {
        var ergebnis = await befehl;
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung(ziel ?? Ziel, erfolg, HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }
}
