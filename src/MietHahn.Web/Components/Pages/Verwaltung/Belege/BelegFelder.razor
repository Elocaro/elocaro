@* Eingabefelder eines Belegs; steht innerhalb eines EditForm mit Model = Daten. *@
<div class="formular-raster">
    <FormularFeld Id="beleg-lieferant" Beschriftung="Lieferant (Kontakt)" Fuer="() => Daten.LieferantId" Hinweis="Kontakte unter Personen anlegen; sonst unten den Namen eintragen.">
        <InputSelect id="beleg-lieferant" @bind-Value="Daten.LieferantId">
            <option value="">–</option>
            @foreach (var l in Auswahl.Lieferanten)
            {
                <option value="@l.Id">@l.Bezeichnung</option>
            }
        </InputSelect>
    </FormularFeld>
    <FormularFeld Id="beleg-lieferant-name" Beschriftung="oder Name" Fuer="() => Daten.LieferantName">
        <InputText id="beleg-lieferant-name" @bind-Value="Daten.LieferantName" />
    </FormularFeld>
    <FormularFeld Id="beleg-nummer" Beschriftung="Rechnungsnummer" Fuer="() => Daten.Rechnungsnummer">
        <InputText id="beleg-nummer" @bind-Value="Daten.Rechnungsnummer" />
    </FormularFeld>
    <FormularFeld Id="beleg-datum" Beschriftung="Rechnungsdatum" Fuer="() => Daten.Rechnungsdatum" Pflicht="true">
        <InputDate id="beleg-datum" @bind-Value="Daten.Rechnungsdatum" />
    </FormularFeld>
    <FormularFeld Id="beleg-von" Beschriftung="Leistung von" Fuer="() => Daten.LeistungVon">
        <InputDate id="beleg-von" @bind-Value="Daten.LeistungVon" />
    </FormularFeld>
    <FormularFeld Id="beleg-bis" Beschriftung="Leistung bis" Fuer="() => Daten.LeistungBis">
        <InputDate id="beleg-bis" @bind-Value="Daten.LeistungBis" />
    </FormularFeld>
    <FormularFeld Id="beleg-brutto" Beschriftung="Brutto" Fuer="() => Daten.Brutto" Pflicht="true" Hinweis="Gutschriften negativ">
        <InputBetrag id="beleg-brutto" @bind-Value="Daten.Brutto" />
    </FormularFeld>
    <FormularFeld Id="beleg-netto" Beschriftung="Netto" Fuer="() => Daten.Netto">
        <InputBetrag id="beleg-netto" @bind-Value="Daten.Netto" />
    </FormularFeld>
    <FormularFeld Id="beleg-ust" Beschriftung="Umsatzsteuer" Fuer="() => Daten.Umsatzsteuer">
        <InputBetrag id="beleg-ust" @bind-Value="Daten.Umsatzsteuer" />
    </FormularFeld>
    <FormularFeld Id="beleg-faellig" Beschriftung="Fällig am" Fuer="() => Daten.FaelligAm">
        <InputDate id="beleg-faellig" @bind-Value="Daten.FaelligAm" />
    </FormularFeld>
    <FormularFeld Id="beleg-bezahlt" Beschriftung="Bezahlt am" Fuer="() => Daten.BezahltAm" Hinweis="Bei Bankumsätzen später über die Zuordnung.">
        <InputDate id="beleg-bezahlt" @bind-Value="Daten.BezahltAm" />
    </FormularFeld>
</div>
<details class="feld">
    <summary>Brennstoff (Menge, CO₂)</summary>
    <div class="formular-raster">
        <FormularFeld Id="beleg-menge" Beschriftung="Menge" Fuer="() => Daten.Brennstoffmenge">
            <InputNumber id="beleg-menge" @bind-Value="Daten.Brennstoffmenge" step="0.001" />
        </FormularFeld>
        <FormularFeld Id="beleg-einheit" Beschriftung="Einheit" Fuer="() => Daten.Brennstoffeinheit" Hinweis="l, kWh, kg, m³">
            <InputText id="beleg-einheit" @bind-Value="Daten.Brennstoffeinheit" />
        </FormularFeld>
        <FormularFeld Id="beleg-co2" Beschriftung="CO₂ (kg)" Fuer="() => Daten.Co2Kg" Hinweis="Pflichtangabe des Lieferanten (CO2KostAufG)">
            <InputNumber id="beleg-co2" @bind-Value="Daten.Co2Kg" step="0.001" />
        </FormularFeld>
    </div>
</details>
<FormularFeld Id="beleg-notiz" Beschriftung="Notiz" Fuer="() => Daten.Notiz">
    <InputTextArea id="beleg-notiz" @bind-Value="Daten.Notiz" rows="2" />
</FormularFeld>

@code {
    [Parameter, EditorRequired]
    public BelegDaten Daten { get; set; } = default!;

    [Parameter, EditorRequired]
    public BelegAuswahl Auswahl { get; set; } = default!;
}
