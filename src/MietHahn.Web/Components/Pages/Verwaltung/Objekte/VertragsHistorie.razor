@using MietHahn.Application.Vertraege
@inherits DatenKomponente

@* Verträge und Leerstandszeiten eines Mietobjekts (Einheit ohne Zimmer oder WG-Zimmer). *@
<section>
    <h2>Verträge</h2>
    @if (eintraege is { Count: 0 })
    {
        <p class="klein">Noch kein Vertrag.</p>
    }
    else if (eintraege is not null)
    {
        <div class="tabellen-rahmen">
            <table class="tabelle">
                <thead><tr><th>Zeitraum</th><th>Mieter</th><th class="zahl">Kaltmiete bei Beginn</th></tr></thead>
                <tbody>
                    @foreach (var eintrag in eintraege)
                    {
                        <tr>
                            <td>@Format.Zeitraum(eintrag.Zeitraum)</td>
                            <td>
                                @if (eintrag.IstLeerstand)
                                {
                                    <span class="status status-wartend">Leerstand</span>
                                }
                                else
                                {
                                    <a href="/verwaltung/vertraege/@eintrag.VertragId">@eintrag.Mieter</a>
                                }
                            </td>
                            <td class="zahl">@Format.Geld(eintrag.Kaltmiete)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <p><a class="knopf" href="/verwaltung/vertraege/neu?mietobjekt=@MietobjektId">Vertrag anlegen</a></p>
</section>

@code {
    private IReadOnlyList<VertragsHistorieEintrag>? eintraege;

    [Parameter, EditorRequired]
    public Guid MietobjektId { get; set; }

    protected override async Task OnParametersSetAsync() =>
        eintraege = await LadenAsync<IVertragsVerwaltung, IReadOnlyList<VertragsHistorieEintrag>>(v => v.HistorieAsync(MietobjektId));
}
