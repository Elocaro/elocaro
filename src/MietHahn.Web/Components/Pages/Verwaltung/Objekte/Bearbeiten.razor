@page "/verwaltung/objekte/{Id:guid}/bearbeiten"
@using MietHahn.Application.Dateien
@inject IObjektVerwaltung Verwaltung
@inject IDateiablage Ablage
@inject Weiterleitung Weiterleitung

@if (objekt is null)
{
    <Seitenkopf Titel="Objekt nicht gefunden" Zurueck="/verwaltung/objekte" ZurueckText="Alle Objekte" />
    return;
}

<Seitenkopf Titel="@($"{objekt.Daten.Bezeichnung} bearbeiten")" Zurueck="@($"/verwaltung/objekte/{Id}")" ZurueckText="Zum Objekt" />

<FehlerListe Fehler="fehler" />

<EditForm Model="Daten" FormName="objekt" OnValidSubmit="SpeichernAsync">
    <DataAnnotationsValidator />
    <ObjektFelder Daten="Daten!" />
    <button type="submit" class="knopf knopf-primaer">Speichern</button>
</EditForm>

<section>
    <h2>Foto</h2>
    @if (objekt.BildDateiId is { } bild)
    {
        <img class="objektbild" src="/dateien/@bild" alt="Aktuelles Foto" />
    }
    <form method="post" enctype="multipart/form-data" @formname="bild" @onsubmit="BildHochladenAsync" class="formular-zeile">
        <AntiforgeryToken />
        <div class="feld">
            <label for="bild">@(objekt.BildDateiId is null ? "Foto hochladen" : "Foto ersetzen")</label>
            <input type="file" id="bild" name="Bild" accept="image/jpeg,image/png,image/webp,image/heic" capture="environment" required />
            <span class="feld-hinweis">Fotos werden verkleinert, gedreht und ohne Metadaten (GPS) gespeichert.</span>
        </div>
        <div class="feld feld-aktion">
            <button type="submit" class="knopf">Hochladen</button>
        </div>
    </form>
    @if (objekt.BildDateiId is not null)
    {
        <form method="post" @formname="bild-entfernen" @onsubmit="BildEntfernenAsync">
            <AntiforgeryToken />
            <button type="submit" class="knopf knopf-gefahr">Foto entfernen</button>
        </form>
    }
</section>

@code {
    private ObjektDetails? objekt;
    private IReadOnlyList<string>? fehler;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "objekt")]
    private ObjektDaten? Daten { get; set; }

    [SupplyParameterFromForm(FormName = "bild")]
    private IFormFile? Bild { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var formular = Daten;
        Daten ??= new();
        objekt = await Verwaltung.LadenAsync(Id);
        if (formular is null && objekt is not null)
        {
            Daten = objekt.Daten;
        }
    }

    private Task SpeichernAsync() => AusfuehrenAsync(Verwaltung.AendernAsync(Id, Daten!), $"/verwaltung/objekte/{Id}", "Die Angaben wurden gespeichert.");

    private async Task BildHochladenAsync()
    {
        if (Bild is null || Bild.Length == 0)
        {
            fehler = ["Bitte ein Foto auswählen."];
            return;
        }

        try
        {
            await using var inhalt = Bild.OpenReadStream();
            var datei = await Ablage.SpeichernAsync(inhalt, Bild.FileName);
            await AusfuehrenAsync(Verwaltung.BildSetzenAsync(Id, datei.Id), $"/verwaltung/objekte/{Id}", "Das Foto wurde gespeichert.");
        }
        catch (DateiAbgelehntException ex)
        {
            fehler = [ex.Message];
        }
    }

    private Task BildEntfernenAsync() => AusfuehrenAsync(Verwaltung.BildSetzenAsync(Id, null), $"/verwaltung/objekte/{Id}/bearbeiten", "Das Foto wurde entfernt.");

    private async Task AusfuehrenAsync(Task<Ergebnis> befehl, string ziel, string erfolg)
    {
        var ergebnis = await befehl;
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung(ziel, erfolg, HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }
}
