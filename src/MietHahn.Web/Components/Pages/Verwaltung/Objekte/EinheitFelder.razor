@* Eingabefelder einer Einheit; steht innerhalb eines EditForm mit Model = Daten. *@
<div class="formular-raster">
    <FormularFeld Id="einheit-bezeichnung" Beschriftung="Bezeichnung" Fuer="() => Daten.Bezeichnung" Pflicht="true" Hinweis="z. B. „Wohnung 1“">
        <InputText id="einheit-bezeichnung" @bind-Value="Daten.Bezeichnung" />
    </FormularFeld>
    <FormularFeld Id="einheit-lage" Beschriftung="Lage" Fuer="() => Daten.Lage" Hinweis="z. B. „EG links“">
        <InputText id="einheit-lage" @bind-Value="Daten.Lage" />
    </FormularFeld>
    <FormularFeld Id="einheit-typ" Beschriftung="Art" Fuer="() => Daten.Typ">
        <InputSelect id="einheit-typ" @bind-Value="Daten.Typ">
            @foreach (var wert in Enum.GetValues<Einheitstyp>())
            {
                <option value="@wert">@Bezeichnungen.Von(wert)</option>
            }
        </InputSelect>
    </FormularFeld>
    @if (MitAusstattung)
    {
        <FormularFeld Id="einheit-zimmeranzahl" Beschriftung="Zimmeranzahl" Fuer="() => Daten.Zimmeranzahl" Hinweis="z. B. 2,5">
            <InputFlaeche id="einheit-zimmeranzahl" @bind-Value="Daten.Zimmeranzahl" />
        </FormularFeld>
        <FormularFeld Id="einheit-bad" Beschriftung="Bad" Fuer="() => Daten.Bad" Hinweis="z. B. „Wanne und Dusche, Fenster“">
            <InputText id="einheit-bad" @bind-Value="Daten.Bad" />
        </FormularFeld>
        <FormularFeld Id="einheit-energie" Beschriftung="Energiestandard" Fuer="() => Daten.Energiestandard">
            <InputText id="einheit-energie" @bind-Value="Daten.Energiestandard" />
        </FormularFeld>
    }
</div>
@if (MitAusstattung)
{
    <div class="formular-zeile">
        <div class="feld feld-checkbox">
            <InputCheckbox id="einheit-balkon" @bind-Value="Daten.Balkon" />
            <label for="einheit-balkon">Balkon/Terrasse</label>
        </div>
        <div class="feld feld-checkbox">
            <InputCheckbox id="einheit-ebk" @bind-Value="Daten.Einbaukueche" />
            <label for="einheit-ebk">Einbauküche</label>
        </div>
    </div>
    <FormularFeld Id="einheit-ausstattung" Beschriftung="Weitere Ausstattung" Fuer="() => Daten.Ausstattung">
        <InputTextArea id="einheit-ausstattung" @bind-Value="Daten.Ausstattung" rows="2" />
    </FormularFeld>
}

@code {
    [Parameter, EditorRequired]
    public EinheitDaten Daten { get; set; } = default!;

    /// <summary>Beim schnellen Anlegen nur Bezeichnung, Lage und Art.</summary>
    [Parameter]
    public bool MitAusstattung { get; set; } = true;
}
