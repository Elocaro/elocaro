@page "/verwaltung/objekte/neu"
@inject IObjektVerwaltung Verwaltung
@inject Weiterleitung Weiterleitung

<Seitenkopf Titel="Objekt anlegen" Zurueck="/verwaltung/objekte" ZurueckText="Alle Objekte" />

<FehlerListe Fehler="fehler" />

<EditForm Model="Daten" FormName="objekt" OnValidSubmit="AnlegenAsync">
    <DataAnnotationsValidator />
    <ObjektFelder Daten="Daten!" />
    <button type="submit" class="knopf knopf-primaer">Objekt anlegen</button>
</EditForm>

@code {
    private IReadOnlyList<string>? fehler;

    [SupplyParameterFromForm(FormName = "objekt")]
    private ObjektDaten? Daten { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized() => Daten ??= new() { Heizungsart = Heizungsart.Zentralheizung };

    private async Task AnlegenAsync()
    {
        var ergebnis = await Verwaltung.AnlegenAsync(Daten!);
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung($"/verwaltung/objekte/{ergebnis.Id}", "Das Objekt wurde angelegt. Jetzt Flächen und Einheiten erfassen.", HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }
}
