@page "/verwaltung/zimmer/{Id:guid}"
@inject IObjektVerwaltung Verwaltung
@inject Weiterleitung Weiterleitung

@if (zimmer is null)
{
    <Seitenkopf Titel="Zimmer nicht gefunden" Zurueck="/verwaltung/objekte" ZurueckText="Alle Objekte" />
    return;
}

<Seitenkopf Titel="@zimmer.Daten.Bezeichnung" Untertitel="@($"{zimmer.EinheitBezeichnung} · {zimmer.ObjektBezeichnung}")"
            Zurueck="@($"/verwaltung/einheiten/{zimmer.EinheitId}")" ZurueckText="@zimmer.EinheitBezeichnung" />

<StatusMeldung />
<FehlerListe Fehler="fehler" />

<section>
    <h2>Belegung</h2>
    <p><BelegungAnzeige Belegung="zimmer.Belegung" /></p>
</section>

<FlaechenBereich Eingabe="Flaeche!" OnSpeichern="FlaecheSpeichernAsync" Aktuell="zimmer.Flaeche" Historie="zimmer.Flaechenhistorie"
                 FlaecheText="Zimmerfläche" ZusatzText="Anteil Gemeinschaftsfläche" ZusatzHinweis="Anteil an Küche, Bad, Flur der WG (für Umlagen nach Fläche)." />

<section>
    <h2>Angaben</h2>
    <EditForm Model="Daten" FormName="zimmer" OnValidSubmit="SpeichernAsync">
        <DataAnnotationsValidator />
        <ZimmerFelder Daten="Daten!" />
        <button type="submit" class="knopf knopf-primaer">Speichern</button>
    </EditForm>
</section>

<section>
    <GefahrenAktion Text="Zimmer löschen" FormName="loeschen" Bestaetigt="LoeschenAsync"
                    Rueckfrage="Das Zimmer wird gelöscht. Fortfahren?" BestaetigenText="Ja, löschen" />
</section>

<AenderungsHistorie EntitaetTyp="@nameof(MietHahn.Domain.Objekte.Zimmer)" EntitaetId="Id" />

@code {
    private ZimmerDetails? zimmer;
    private IReadOnlyList<string>? fehler;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "zimmer")]
    private ZimmerDaten? Daten { get; set; }

    [SupplyParameterFromForm(FormName = "flaeche", Name = "Eingabe")] // Feldnamen kommen aus FlaechenBereich
    private FlaechenEingabe? Flaeche { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var formular = Daten;
        Daten ??= new();
        Flaeche ??= new();
        zimmer = await Verwaltung.ZimmerLadenAsync(Id);
        if (zimmer is not null)
        {
            Daten = formular ?? zimmer.Daten;
            if (Flaeche.Ab is null)
            {
                Flaeche.Flaeche ??= zimmer.Flaeche?.Flaeche;
                Flaeche.Zusatz ??= zimmer.Flaeche?.Zusatz;
            }
        }
    }

    private Task SpeichernAsync() => AusfuehrenAsync(Verwaltung.ZimmerAendernAsync(Id, Daten!), "Die Angaben wurden gespeichert.");

    private Task FlaecheSpeichernAsync() => AusfuehrenAsync(Verwaltung.ZimmerFlaecheSetzenAsync(Id, Flaeche!), "Die Fläche wurde gespeichert.");

    private async Task LoeschenAsync()
    {
        var einheitId = zimmer!.EinheitId;
        var ergebnis = await Verwaltung.ZimmerLoeschenAsync(Id);
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung($"/verwaltung/einheiten/{einheitId}", "Das Zimmer wurde gelöscht.", HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
        }
    }

    private async Task AusfuehrenAsync(Task<Ergebnis> befehl, string erfolg)
    {
        var ergebnis = await befehl;
        if (ergebnis.Erfolgreich)
        {
            Weiterleitung.ZuMitMeldung($"/verwaltung/zimmer/{Id}", erfolg, HttpContext);
        }
        else
        {
            fehler = ergebnis.Fehler;
            zimmer = await Verwaltung.ZimmerLadenAsync(Id);
        }
    }
}
