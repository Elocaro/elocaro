@page "/verwaltung/objekte"
@inject IObjektVerwaltung Verwaltung

<Seitenkopf Titel="Objekte" Untertitel="Häuser mit ihren Wohnungen und WG-Zimmern.">
    <Aktionen>
        <a class="knopf knopf-primaer" href="/verwaltung/objekte/neu">Objekt anlegen</a>
    </Aktionen>
</Seitenkopf>

<StatusMeldung />

@if (objekte is { Count: 0 })
{
    <Leerzustand Text="Noch keine Objekte. Lege zuerst ein Haus an, danach die Wohnungen." />
}
else if (objekte is not null)
{
    <div class="tabellen-rahmen">
        <table class="tabelle">
            <thead>
                <tr><th>Objekt</th><th>Anschrift</th><th class="zahl">Einheiten</th><th class="zahl">Wohnfläche</th><th>Belegung</th></tr>
            </thead>
            <tbody>
                @foreach (var objekt in objekte)
                {
                    <tr>
                        <td><a href="/verwaltung/objekte/@objekt.Id">@objekt.Bezeichnung</a></td>
                        <td>@objekt.Anschrift</td>
                        <td class="zahl">@objekt.Einheiten</td>
                        <td class="zahl">@Format.Flaeche(objekt.Wohnflaeche)</td>
                        <td>
                            @objekt.Vermietet von @objekt.Mietobjekte vermietet
                            @if (objekt.Leerstand > 0)
                            {
                                <span class="status status-wartend">@objekt.Leerstand leer</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<ObjektUebersicht>? objekte;

    protected override async Task OnInitializedAsync() => objekte = await Verwaltung.ListeAsync();
}
