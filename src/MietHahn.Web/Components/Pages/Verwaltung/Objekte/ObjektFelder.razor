@* Eingabefelder eines Objekts; steht innerhalb eines EditForm mit Model = Daten. *@
<div class="formular-raster">
    <FormularFeld Id="bezeichnung" Beschriftung="Bezeichnung" Fuer="() => Daten.Bezeichnung" Pflicht="true" Hinweis="z. B. „Lindenweg 3“">
        <InputText id="bezeichnung" @bind-Value="Daten.Bezeichnung" />
    </FormularFeld>
    <FormularFeld Id="strasse" Beschriftung="Straße und Hausnummer" Fuer="() => Daten.Strasse" Pflicht="true">
        <InputText id="strasse" @bind-Value="Daten.Strasse" autocomplete="street-address" />
    </FormularFeld>
    <FormularFeld Id="plz" Beschriftung="PLZ" Fuer="() => Daten.Plz" Pflicht="true">
        <InputText id="plz" @bind-Value="Daten.Plz" inputmode="numeric" autocomplete="postal-code" />
    </FormularFeld>
    <FormularFeld Id="ort" Beschriftung="Ort" Fuer="() => Daten.Ort" Pflicht="true">
        <InputText id="ort" @bind-Value="Daten.Ort" autocomplete="address-level2" />
    </FormularFeld>
    <FormularFeld Id="baujahr" Beschriftung="Baujahr" Fuer="() => Daten.Baujahr">
        <InputNumber id="baujahr" @bind-Value="Daten.Baujahr" inputmode="numeric" />
    </FormularFeld>
    <FormularFeld Id="heizungsart" Beschriftung="Heizungsart" Fuer="() => Daten.Heizungsart">
        <InputSelect id="heizungsart" @bind-Value="Daten.Heizungsart">
            @foreach (var wert in Enum.GetValues<Heizungsart>())
            {
                <option value="@wert">@Bezeichnungen.Von(wert)</option>
            }
        </InputSelect>
    </FormularFeld>
    <FormularFeld Id="energietraeger" Beschriftung="Energieträger" Fuer="() => Daten.Energietraeger" Hinweis="Wichtig für die CO₂-Kostenaufteilung.">
        <InputSelect id="energietraeger" @bind-Value="Daten.Energietraeger">
            @foreach (var wert in Enum.GetValues<Energietraeger>())
            {
                <option value="@wert">@Bezeichnungen.Von(wert)</option>
            }
        </InputSelect>
    </FormularFeld>
    <FormularFeld Id="gemarkung" Beschriftung="Gemarkung" Fuer="() => Daten.Gemarkung">
        <InputText id="gemarkung" @bind-Value="Daten.Gemarkung" />
    </FormularFeld>
    <FormularFeld Id="flurstueck" Beschriftung="Flur/Flurstück" Fuer="() => Daten.Flurstueck">
        <InputText id="flurstueck" @bind-Value="Daten.Flurstueck" />
    </FormularFeld>
    <FormularFeld Id="grundsteuer" Beschriftung="Grundsteuer-Aktenzeichen" Fuer="() => Daten.GrundsteuerAktenzeichen">
        <InputText id="grundsteuer" @bind-Value="Daten.GrundsteuerAktenzeichen" />
    </FormularFeld>
</div>
<FormularFeld Id="notizen" Beschriftung="Notizen" Fuer="() => Daten.Notizen">
    <InputTextArea id="notizen" @bind-Value="Daten.Notizen" rows="3" />
</FormularFeld>

@code {
    [Parameter, EditorRequired]
    public ObjektDaten Daten { get; set; } = default!;
}
