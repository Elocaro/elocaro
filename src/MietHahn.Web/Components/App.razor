@using MietHahn.Web.Account
@using MietHahn.Web.Operations
<!DOCTYPE html>
<html lang="de" data-theme="@Theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#a73f17" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="icon.svg" />
    <link rel="apple-touch-icon" href="icon.svg" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preload" href="fonts/roboto-flex-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap nonce="@Nonce" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    @* Replaces Blazor's English default for a lost connection (see js/reconnect.js); the state classes come from the framework. *@
    <dialog id="components-reconnect-modal" class="reconnect-modal" data-nosnippet aria-live="assertive">
        <div class="reconnect-card">
            <div class="reconnect-state reconnect-show reconnect-retrying">
                <span class="reconnect-spinner" aria-hidden="true"></span>
                <p class="reconnect-title">Verbindung unterbrochen</p>
                <p class="reconnect-text">Die Verbindung zum Server wird wiederhergestellt. Eingaben, die noch nicht gespeichert wurden, bleiben so lange erhalten.</p>
            </div>
            <div class="reconnect-state reconnect-failed">
                <p class="reconnect-title">Keine Verbindung</p>
                <p class="reconnect-text">Der Server ist gerade nicht erreichbar. Prüfen Sie Ihre Internetverbindung und versuchen Sie es erneut.</p>
                <button type="button" id="components-reconnect-button" class="button button-primary">Erneut versuchen</button>
            </div>
            <div class="reconnect-state reconnect-ended">
                <p class="reconnect-title">Sitzung beendet</p>
                <p class="reconnect-text">Die Sitzung ist abgelaufen oder der Server wurde neu gestartet. Laden Sie die Seite neu, um weiterzuarbeiten.</p>
                <button type="button" id="components-reload-button" class="button button-primary">Seite neu laden</button>
            </div>
        </div>
    </dialog>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/shell.js"]"></script>
    <script src="@Assets["js/reconnect.js"]"></script>
    <script src="@Assets["js/pwa.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? Nonce => HttpContext?.Items[OperationsExtensions.CspNonceKey] as string;

    private string? Theme => ThemePreference.Read(HttpContext);
}
