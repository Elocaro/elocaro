@page "/konto/einrichtung"
@inject IAccountService Accounts
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> Login
@inject Redirector Redirector

<PageTitle>Ersteinrichtung – MietHahn</PageTitle>

<h1>Ersteinrichtung</h1>
<p>Willkommen! Legen Sie das Administrator-Konto an. Anschließend richten Sie die Zwei-Faktor-Anmeldung ein.</p>

<ErrorList Errors="errors" />

<EditForm Model="Input" FormName="einrichtung" OnValidSubmit="CreateAsync">
    <DataAnnotationsValidator />
    <div class="feld">
        <label for="anzeigename">Ihr Name</label>
        <InputText id="anzeigename" @bind-Value="Input!.DisplayName" autocomplete="name" />
        <ValidationMessage For="() => Input!.DisplayName" />
    </div>
    <div class="feld">
        <label for="email">E-Mail-Adresse</label>
        <InputText id="email" type="email" @bind-Value="Input!.Email" autocomplete="username" />
        <ValidationMessage For="() => Input!.Email" />
    </div>
    <div class="feld">
        <label for="passwort">Passwort (mindestens 12 Zeichen)</label>
        <InputText id="passwort" type="password" @bind-Value="Input!.Password" autocomplete="new-password" />
        <ValidationMessage For="() => Input!.Password" />
    </div>
    <div class="feld">
        <label for="passwort2">Passwort wiederholen</label>
        <InputText id="passwort2" type="password" @bind-Value="Input!.PasswordConfirmation" autocomplete="new-password" />
        <ValidationMessage For="() => Input!.PasswordConfirmation" />
    </div>
    <button type="submit" class="knopf knopf-primaer">Administrator anlegen</button>
</EditForm>

@code {
    private IReadOnlyList<string>? errors;

    [SupplyParameterFromForm(FormName = "einrichtung")]
    private SetupInput? Input { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (!await Accounts.InitialSetupPossibleAsync())
        {
            Redirector.To("/konto/anmelden");
        }
    }

    private async Task CreateAsync()
    {
        var result = await Accounts.CreateFirstAdminAsync(Input!.Email, Input.DisplayName, Input.Password);
        if (!result.Succeeded)
        {
            errors = result.Errors;
            return;
        }

        var user = await UserManager.FindByIdAsync(result.UserId!.Value.ToString());
        await Login.SignInAsync(user!, isPersistent: false);
        Redirector.To(AccountExtensions.TwoFactorSetupPath);
    }

    private sealed class SetupInput
    {
        [Required(ErrorMessage = "Bitte Ihren Namen angeben.")]
        [StringLength(200)]
        public string DisplayName { get; set; } = "";

        [Required(ErrorMessage = "Bitte eine E-Mail-Adresse angeben.")]
        [EmailAddress(ErrorMessage = "Bitte eine gültige E-Mail-Adresse angeben.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Bitte ein Passwort angeben.")]
        [StringLength(200, MinimumLength = 12, ErrorMessage = "Das Passwort muss mindestens 12 Zeichen lang sein.")]
        public string Password { get; set; } = "";

        [Compare(nameof(Password), ErrorMessage = "Die Passwörter stimmen nicht überein.")]
        public string PasswordConfirmation { get; set; } = "";
    }
}
