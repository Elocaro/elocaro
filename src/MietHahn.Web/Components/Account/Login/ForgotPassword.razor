@page "/konto/passwort-vergessen"
@inject IAccountService Accounts

<PageTitle>Passwort vergessen – MietHahn</PageTitle>

<h1>Passwort vergessen</h1>

@if (sent)
{
    <p class="meldung meldung-ok" role="status">
        Falls ein passendes Konto existiert, haben wir Ihnen einen Link zum Zurücksetzen geschickt. Er ist 2 Stunden gültig.
    </p>
}
else
{
    <EditForm Model="Input" FormName="passwort-vergessen" OnValidSubmit="RequestAsync">
        <DataAnnotationsValidator />
        <div class="feld">
            <label for="email">E-Mail-Adresse</label>
            <InputText id="email" type="email" @bind-Value="Input!.Email" autocomplete="email" />
            <ValidationMessage For="() => Input!.Email" />
        </div>
        <button type="submit" class="knopf knopf-primaer">Link senden</button>
    </EditForm>
}

<div class="konto-links"><a href="/konto/anmelden">Zurück zur Anmeldung</a></div>

@code {
    private bool sent;

    [SupplyParameterFromForm(FormName = "passwort-vergessen")]
    private EmailInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task RequestAsync()
    {
        await Accounts.RequestPasswordResetAsync(Input!.Email.Trim());
        sent = true;
    }

    private sealed class EmailInput
    {
        [Required(ErrorMessage = "Bitte die E-Mail-Adresse angeben.")]
        [EmailAddress(ErrorMessage = "Bitte eine gültige E-Mail-Adresse angeben.")]
        public string Email { get; set; } = "";
    }
}
