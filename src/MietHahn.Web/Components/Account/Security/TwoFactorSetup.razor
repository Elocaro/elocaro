@page "/konto/sicherheit/zwei-faktor"
@using QRCoder
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> Login

<PageTitle>Zwei-Faktor-Anmeldung – MietHahn</PageTitle>

<h1>Zwei-Faktor-Anmeldung</h1>

@if (codes is not null)
{
    <p class="meldung meldung-ok" role="status">Die Zwei-Faktor-Anmeldung ist jetzt aktiv.</p>
    <RecoveryCodes Codes="codes" />
    <div class="konto-links"><a href="/">Weiter zu MietHahn</a></div>
}
else if (user?.TwoFactorEnabled == true)
{
    <p>Die Zwei-Faktor-Anmeldung ist aktiv. Bei der Anmeldung fragen wir nach dem Code aus Ihrer Authenticator-App.</p>
    <div class="konto-links">
        <a href="/konto/sicherheit/wiederherstellungscodes">Neue Wiederherstellungscodes erzeugen</a>
        <a href="/konto/sicherheit">Zurück</a>
    </div>
}
else if (user is not null)
{
    @if (required)
    {
        <p class="meldung meldung-hinweis" role="status">Für Ihre Rolle ist die Zwei-Faktor-Anmeldung vorgeschrieben. Bitte richten Sie sie jetzt ein.</p>
    }

    <ol class="schritte">
        <li>Installieren Sie eine Authenticator-App (z. B. Aegis, 2FAS, Google oder Microsoft Authenticator).</li>
        <li>
            Scannen Sie den QR-Code oder geben Sie den Schlüssel manuell ein:
            <div class="qr-code">@((MarkupString)qrSvg)</div>
            <p><code class="schluessel">@KeyFormatted</code></p>
        </li>
        <li>Geben Sie den 6-stelligen Code aus der App ein.</li>
    </ol>

    <StatusMessage Message="@errors" IsError="true" />

    <EditForm Model="Input" FormName="zwei-faktor-einrichten" OnValidSubmit="ActivateAsync">
        <DataAnnotationsValidator />
        <div class="feld">
            <label for="code">Code aus der App</label>
            <InputText id="code" @bind-Value="Input!.Code" autocomplete="one-time-code" inputmode="numeric" />
            <ValidationMessage For="() => Input!.Code" />
        </div>
        <button type="submit" class="knopf knopf-primaer">Aktivieren</button>
    </EditForm>
}

@code {
    private ApplicationUser? user;
    private string secretKey = "";
    private string qrSvg = "";
    private bool required;
    private string? errors;
    private IReadOnlyList<string>? codes;

    [SupplyParameterFromForm(FormName = "zwei-faktor-einrichten")]
    private CodeInput? Input { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string KeyFormatted => string.Join(' ', secretKey.Chunk(4).Select(c => new string(c))).ToLowerInvariant();

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null || user.TwoFactorEnabled)
        {
            return;
        }

        required = (await UserManager.GetRolesAsync(user)).Any(Roles.RequiringTwoFactor.Contains);
        var key = await UserManager.GetAuthenticatorKeyAsync(user);
        if (string.IsNullOrEmpty(key))
        {
            await UserManager.ResetAuthenticatorKeyAsync(user);
            key = await UserManager.GetAuthenticatorKeyAsync(user);

            // Das Erzeugen des Schlüssels erneuert den Security-Stamp; ohne neues Cookie wäre die Sitzung ungültig.
            await Login.RefreshSignInAsync(user);
        }

        secretKey = key!;
        var uri = $"otpauth://totp/{Uri.EscapeDataString("MietHahn:" + user.Email)}?secret={secretKey}&issuer=MietHahn&digits=6";
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(uri, QRCodeGenerator.ECCLevel.Q);
        qrSvg = new SvgQRCode(data).GetGraphic(4);
    }

    private async Task ActivateAsync()
    {
        var code = Input!.Code.Replace(" ", "", StringComparison.Ordinal).Replace("-", "", StringComparison.Ordinal);
        if (!await UserManager.VerifyTwoFactorTokenAsync(user!, UserManager.Options.Tokens.AuthenticatorTokenProvider, code))
        {
            errors = "Der Code ist ungültig. Bitte prüfen Sie die Uhrzeit Ihres Geräts und versuchen Sie es erneut.";
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user!, true);
        codes = [.. await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user!, 10) ?? []];
        await Login.RefreshSignInAsync(user!); // Claim „2FA aktiv“ aktualisieren
    }

    private sealed class CodeInput
    {
        [Required(ErrorMessage = "Bitte den Code eingeben.")]
        [StringLength(7, MinimumLength = 6, ErrorMessage = "Der Code hat 6 Ziffern.")]
        public string Code { get; set; } = "";
    }
}
