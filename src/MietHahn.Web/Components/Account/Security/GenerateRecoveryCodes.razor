@page "/konto/sicherheit/wiederherstellungscodes"
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Wiederherstellungscodes – MietHahn</PageTitle>

<h1>Wiederherstellungscodes</h1>

@if (codes is not null)
{
    <RecoveryCodes Codes="codes" />
}
else if (active)
{
    <p>Neue Codes ersetzen alle bisherigen Wiederherstellungscodes.</p>
    <form method="post" @formname="codes-erzeugen" @onsubmit="GenerateAsync">
        <AntiforgeryToken />
        <button type="submit" class="knopf knopf-primaer">Neue Codes erzeugen</button>
    </form>
}
else
{
    <p>Richten Sie zuerst die <a href="/konto/sicherheit/zwei-faktor">Zwei-Faktor-Anmeldung</a> ein.</p>
}

<div class="konto-links"><a href="/konto/sicherheit">Zurück</a></div>

@code {
    private bool active;
    private IReadOnlyList<string>? codes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync() =>
        active = (await UserManager.GetUserAsync(HttpContext.User))?.TwoFactorEnabled == true;

    private async Task GenerateAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user?.TwoFactorEnabled == true)
        {
            codes = [.. await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10) ?? []];
        }
    }
}
