@using MietHahn.Application.Admin
@using MietHahn.Application.Portfolio

<figure class="trend-chart" id="trend-chart">
    <figcaption class="small">Mieteingang gegen Soll, letzte 12 Monate: <span class="swatch landlord"></span> Soll <span class="swatch tenant"></span> Eingang · Linie: offener Saldo am Monatsende</figcaption>
    <svg viewBox="0 0 @Width @Height" role="img" aria-label="@Summary" preserveAspectRatio="none">
        @for (var i = 0; i < History.Count; i++)
        {
            var month = History[i];
            var x = i * Step + 4;
            <rect class="bar-due" x="@F(x)" y="@F(Y(month.Due))" width="@F(BarWidth)" height="@F(Base - Y(month.Due))"><title>@($"{Format.Month(month.Month)}: Soll {Format.Money(month.Due)}")</title></rect>
            <rect class="bar-paid" x="@F(x + BarWidth)" y="@F(Y(month.Paid))" width="@F(BarWidth)" height="@F(Base - Y(month.Paid))"><title>@($"{Format.Month(month.Month)}: Eingang {Format.Money(month.Paid)}")</title></rect>
        }
        <polyline class="line-open" points="@Points" fill="none" />
    </svg>
    <div class="trend-axis small"><span>@Format.Month(History[0].Month)</span><span>@Format.Month(History[^1].Month)</span></div>
</figure>

@code {
    private const double Width = 480;
    private const double Height = 110;
    private const double Base = 100;

    [Parameter, EditorRequired]
    public IReadOnlyList<MonthFigure> History { get; set; } = [];

    private double Step => Width / Math.Max(1, History.Count);

    private double BarWidth => Step / 2 - 3;

    private decimal Max => Math.Max(1m, History.Max(m => Math.Max(Math.Max(m.Due, m.Paid), Math.Abs(m.OpenAtEnd))));

    private double Y(decimal value) => Base - (double)(Math.Max(0m, value) / Max) * (Base - 8);

    private string Points => string.Join(' ', History.Select((m, i) => $"{F(i * Step + Step / 2)},{F(Y(m.OpenAtEnd))}"));

    private string Summary => $"Mieteingang gegen Soll: {string.Join("; ", History.Select(m => $"{Format.Month(m.Month)} {Format.Money(m.Paid)} von {Format.Money(m.Due)}"))}";

    private static string F(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
