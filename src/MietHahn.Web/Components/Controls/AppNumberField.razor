@typeparam T
@using System.Linq.Expressions
@using MudBlazor
@* Number input (int, decimal, double; also nullable) with German notation. Suffix: unit text such as "m²" or "€". *@
<MudNumericField T="T" Value="Value" ValueChanged="ValueChanged" For="ValueExpression" Label="@Label" HelperText="@Hint" Required="Required" Disabled="Disabled"
                 Min="@Min" Max="@Max" Culture="German" HideSpinButtons="true" Adornment="@(Suffix is null ? Adornment.None : Adornment.End)" AdornmentText="@Suffix"
                 Variant="Variant.Outlined" ShrinkLabel="true" />

@code {
    private static readonly System.Globalization.CultureInfo German = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    [Parameter]
    public T? Value { get; set; }

    [Parameter]
    public EventCallback<T?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<T?>>? ValueExpression { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Suffix { get; set; }

    [Parameter]
    public T? Min { get; set; }

    [Parameter]
    public T? Max { get; set; }
}
