<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>{{ titel }}</title>
<style>
  /* A4, DIN 5008 Form B. Seitenränder links/rechts als Padding, damit Anschriftfeld und Falzmarken
     in Seitenkoordinaten positioniert werden können (Chromium beschneidet am Seitenrand). */
  @page { size: A4; margin: 20mm 0 25mm 0; }
  @page :first { margin-top: {{ if empfaenger }}0{{ else }}20mm{{ end }}; }
  html, body { margin: 0; }
  body {
    padding: 0 20mm 0 25mm;
    font-family: "Noto Sans", "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    font-size: 10.5pt; line-height: 1.45; color: #000;
  }
  h1 { font-size: 13pt; margin: 0 0 6mm 0; }
  h2 { font-size: 11pt; margin: 6mm 0 2mm 0; }
  p { margin: 0 0 3mm 0; }
  table { width: 100%; border-collapse: collapse; page-break-inside: auto; margin: 2mm 0 5mm 0; }
  thead { display: table-header-group; }   /* Kopf auf jeder Seite wiederholen */
  tfoot { display: table-row-group; }      /* Summen nur am Ende, nicht auf jeder Seite */
  tr { page-break-inside: avoid; }
  th, td { text-align: left; padding: 1.2mm 1.5mm; border-bottom: 0.3pt solid #999; vertical-align: top; }
  th { font-weight: 600; border-bottom: 0.6pt solid #000; }
  td.zahl, th.zahl { text-align: right; white-space: nowrap; }
  tfoot td { font-weight: 600; border-top: 0.6pt solid #000; border-bottom: none; }
  .klein { font-size: 8.5pt; }
  .seitenumbruch { page-break-before: always; }

  .erste-seite { position: relative; margin: 0 -20mm 0 -25mm; height: 100mm; }
  .briefkopf { position: absolute; top: 15mm; right: 20mm; text-align: right; font-size: 9pt; }
  .briefkopf .name { font-size: 14pt; font-weight: 700; }
  .anschrift { position: absolute; top: 45mm; left: 20mm; width: 85mm; height: 45mm; }
  .ruecksende { height: 5mm; line-height: 5mm; font-size: 7pt; border-bottom: 0.3pt solid #000; white-space: nowrap; overflow: hidden; }
  .vermerk { height: 12.7mm; font-size: 8pt; display: flex; align-items: flex-end; }
  .empfaenger { height: 27.3mm; overflow: hidden; }
  .infoblock { position: absolute; top: 50mm; left: 125mm; width: 65mm; font-size: 9pt; }
  .falzmarke { position: absolute; left: 0; width: 5mm; border-top: 0.3pt solid #000; }
  .lochmarke { width: 8mm; }
</style>
</head>
<body>
{{~ if empfaenger ~}}
<div class="erste-seite">
  <div class="falzmarke" style="top:105mm"></div>
  <div class="falzmarke lochmarke" style="top:148.5mm"></div>
  <div class="falzmarke" style="top:210mm"></div>
  <div class="briefkopf">
    <div class="name">{{ absender.name }}</div>
    {{~ if absender.zusatz ~}}<div>{{ absender.zusatz }}</div>{{~ end ~}}
    <div>{{ absender.strasse }} · {{ absender.plz }} {{ absender.ort }}</div>
    {{~ if absender.telefon ~}}<div>Telefon {{ absender.telefon }}</div>{{~ end ~}}
    {{~ if absender.email ~}}<div>{{ absender.email }}</div>{{~ end ~}}
  </div>
  <div class="anschrift">
    <div class="ruecksende">{{ absender.ruecksendezeile }}</div>
    <div class="vermerk">{{ empfaenger.vermerk }}</div>
    <div class="empfaenger">
      {{~ for zeile in empfaenger.zeilen ~}}<div>{{ zeile }}</div>{{~ end ~}}
    </div>
  </div>
  <div class="infoblock">
    <div>Datum: {{ datum datum_brief }}</div>
  </div>
</div>
{{~ else ~}}
<div class="klein" style="text-align:right;margin-bottom:6mm">{{ absender.name }} · {{ datum datum_brief }}</div>
{{~ end ~}}
<h1>{{ titel }}</h1>
{{ inhalt }}
</body>
</html>
