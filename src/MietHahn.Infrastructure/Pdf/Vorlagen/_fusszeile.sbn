<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { margin: 0 20mm 0 25mm; width: 100%; font-family: "Noto Sans", "DejaVu Sans", Arial, sans-serif; font-size: 7.5pt; color: #444; }
  .zeile { display: flex; justify-content: space-between; width: 165mm; border-top: 0.3pt solid #999; padding-top: 1.5mm; }
</style>
</head>
<body>
<div class="zeile">
  <span>{{ absender.name }}{{ if absender.iban }} · IBAN {{ absender.iban }}{{ end }}{{ if absender.bank }} · {{ absender.bank }}{{ end }}{{ if absender.steuernummer }} · St.-Nr. {{ absender.steuernummer }}{{ end }}</span>
  <span>Seite <span class="pageNumber"></span> von <span class="totalPages"></span></span>
</div>
</body>
</html>
