@if (FileIds.Count > 0)
{
    <div class="ticket-photos">
        @foreach (var id in FileIds)
        {
            <a href="@Base/@id" target="_blank" rel="noopener"><img src="@Base/@id" alt="Foto zur Meldung" loading="lazy" /></a>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Guid> FileIds { get; set; } = [];

    /// <summary>Path the files are served from (contractor links use their own, token-scoped one).</summary>
    [Parameter]
    public string Base { get; set; } = "/dateien";
}
