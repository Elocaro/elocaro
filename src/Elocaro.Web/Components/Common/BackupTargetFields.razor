@implements IDisposable
@using Elocaro.Application.Operations
@using Elocaro.Domain.Operations
@using QRCoder
@inject IGoogleDriveAuthorization Google
@inject TimeProvider Clock
@* Entry of a backup target: where it lies (cards), what it needs to get there (access), and the password of the backup. Shared by the
   target dialog and the restore during the initial setup. Secrets are never shown; where one is stored, an empty entry keeps it.
   For Google Drive the access comes from signing in at Google (device code). *@
<div class="backup-fields">
    <section class="dialog-section">
        <h3>Wohin soll gesichert werden?</h3>
        <div class="choice-cards" role="radiogroup" aria-label="Ablage">
            @foreach (var option in Choices)
            {
                var selected = option.Provider == Input.Provider;
                <button type="button" role="radio" aria-checked="@(selected ? "true" : "false")" id="provider-@option.Provider.ToString().ToLowerInvariant()"
                        class="choice-card @(selected ? "selected" : null)" @onclick="() => ProviderChangedAsync(option.Provider)">
                    <Icon Path="@option.Icon" />
                    <span class="choice-title">@option.Title</span>
                    <span class="choice-text">@option.Text</span>
                </button>
            }
        </div>
    </section>

    @if (Input.Provider == BackupProvider.Local)
    {
        <Notice Level="NoticeLevel.Warning">@LocalWarning</Notice>
    }
    else
    {
        <section class="dialog-section">
            <h3>@AccessTitle</h3>
            @if (Input.Provider == BackupProvider.GoogleDrive)
            {
                <div class="drive-connect" id="drive-connect">
                    @if (device is not null)
                    {
                        <Notice Level="NoticeLevel.Info" id="drive-device">
                            <strong>So melden Sie sich bei Google an:</strong>
                            <ol>
                                <li>Scannen Sie den QR-Code mit dem Handy oder öffnen Sie <a id="drive-link" href="@deviceLink" target="_blank" rel="noopener noreferrer">@device.VerificationUrl</a> in einem anderen Fenster.</li>
                                <li>Der Code wird dabei übernommen. Falls nicht, geben Sie ihn ein: <strong id="drive-code" class="device-code">@device.UserCode</strong></li>
                                <li>Melden Sie sich an und erlauben Sie den Zugriff. Elocaro sieht dabei nur Dateien, die es selbst in Ihrem Drive anlegt.</li>
                            </ol>
                            <div class="qr-code" id="drive-qr" role="img" aria-label="QR-Code zur Anmeldung bei Google">@((MarkupString)deviceQr)</div>
                            <span>Warte auf die Bestätigung …</span>
                        </Notice>
                        <button type="button" class="button button-outlined" id="drive-cancel" @onclick="CancelConnect">Abbrechen</button>
                    }
                    else
                    {
                        @if (Connected)
                        {
                            <Notice Level="NoticeLevel.Success" id="drive-connected">Bei Google angemeldet. @(justConnected ? "Mit „Speichern“ übernehmen." : "")</Notice>
                        }

                        <button type="button" class="button @(Connected ? "button-outlined" : "button-primary")" id="drive-connect-button" @onclick="ConnectAsync" disabled="@(!googleAvailable)">@(Connected ? "Neu anmelden" : "Mit Google anmelden")</button>
                        @if (!googleAvailable)
                        {
                            <p class="help" id="drive-not-configured">Google Drive ist auf diesem Server nicht eingerichtet. Wie ein Administrator das nachholt, steht in der <a href="@AppInfo.Docs("betrieb.md", "google-drive")" target="_blank" rel="noopener noreferrer">Betriebsanleitung (Google Drive)</a>.</p>
                        }
                        else if (!Connected)
                        {
                            <p class="help">Sie erhalten einen Code, geben ihn bei Google ein und erlauben den Zugriff. Elocaro sieht nur Dateien, die es selbst in Ihrem Drive anlegt.</p>
                        }

                        @if (connectError is not null)
                        {
                            <Notice Level="NoticeLevel.Error" id="drive-error">@connectError</Notice>
                        }
                    }
                </div>

                <details class="explain">
                    <summary>Ordner in Google Drive: <strong>@Input.Location</strong></summary>
                    <AppTextField Value="@Input.Location" ValueChanged="SetLocationAsync" Label="@BackupProviders.LocationLabel(Input.Provider)" Hint="@BackupProviders.LocationHint(Input.Provider)" Required="true" Immediate="true" />
                </details>
            }
            else
            {
                <div class="form-grid">
                    <div class="span-all">
                        <AppTextField Value="@Input.Location" ValueChanged="SetLocationAsync" Label="@BackupProviders.LocationLabel(Input.Provider)" Hint="@BackupProviders.LocationHint(Input.Provider)" Required="true" Immediate="true" />
                    </div>
                    @foreach (var field in BackupProviders.Fields(Input.Provider))
                    {
                        <AppTextField Value="@Credential(field.Key)" ValueChanged="v => SetCredentialAsync(field.Key, v)" Immediate="true" Label="@(field.Required ? field.Label : field.Label + " (optional)")" Type="@(field.Secret ? "password" : "text")"
                                      Required="@(field.Required && !Stored(field.Key))" Hint="@(Stored(field.Key) ? "Gespeichert. Leer lassen, um den Wert zu behalten." : field.Hint)" Autocomplete="off" />
                    }
                </div>
            }
        </section>
    }

    <section class="dialog-section">
        <h3>Verschlüsselung</h3>
        <AppTextField Value="@Input.Password" ValueChanged="SetPasswordAsync" Immediate="true" Label="Passwort der Sicherung" Type="password" Required="@(!HasPassword)" Autocomplete="off"
                      Hint="@(HasPassword ? "Gespeichert. Leer lassen, um es zu behalten." : PasswordHint)" />
    </section>
</div>

@code {
    private sealed record ProviderChoice(BackupProvider Provider, string Icon, string Title, string Text);

    private static readonly ProviderChoice[] Choices =
    [
        new(BackupProvider.GoogleDrive, MudBlazor.Icons.Material.Outlined.AddToDrive, "Google Drive", "Am einfachsten: mit dem Google-Konto anmelden"),
        new(BackupProvider.S3, MudBlazor.Icons.Material.Outlined.Storage, "S3-Speicher", "AWS, Hetzner, MinIO und andere"),
        new(BackupProvider.Azure, MudBlazor.Icons.Material.Outlined.Cloud, "Azure Blob Storage", "Cloudspeicher von Microsoft"),
        new(BackupProvider.Sftp, MudBlazor.Icons.Material.Outlined.Dns, "SFTP oder NAS", "Eigener Server oder Gerät im Netz"),
        new(BackupProvider.Local, MudBlazor.Icons.Material.Outlined.Computer, "Dieser Server", "Nur zum Ausprobieren"),
    ];

    private bool googleAvailable;
    private DeviceAuthorization? device;
    private string deviceLink = "";
    private string deviceQr = "";
    private string? connectError;
    private bool justConnected;
    private CancellationTokenSource? polling;

    [Parameter, EditorRequired]
    public BackupSettingsInput Input { get; set; } = new();

    /// <summary>Names of the credentials that are already stored (their entry may stay empty).</summary>
    [Parameter]
    public IReadOnlySet<string> StoredCredentials { get; set; } = new HashSet<string>(StringComparer.Ordinal);

    [Parameter]
    public bool HasPassword { get; set; }

    [Parameter]
    public string LocalWarning { get; set; } = "Die Sicherung liegt auf demselben Server wie die Daten. Bei einem Serverausfall ist beides weg: nur zum Ausprobieren, für den Alltag ein externes Ziel wählen.";

    [Parameter]
    public string PasswordHint { get; set; } = "Verschlüsselt die Sicherung. OHNE DIESES PASSWORT GIBT ES KEINE WIEDERHERSTELLUNG: zusätzlich im Passwortmanager aufbewahren.";

    /// <summary>Called after an entry changed (the dialog decides whether saving is possible).</summary>
    [Parameter]
    public EventCallback InputChanged { get; set; }

    /// <summary>Called after the provider changed (location and credentials are already cleared).</summary>
    [Parameter]
    public EventCallback<BackupProvider> ProviderChanged { get; set; }

    /// <summary>Short name for a new target of this provider (it can be changed).</summary>
    public static string DefaultName(BackupProvider provider) => provider switch
    {
        BackupProvider.GoogleDrive => "Google Drive",
        BackupProvider.S3 => "S3-Speicher",
        BackupProvider.Azure => "Azure",
        BackupProvider.Sftp => "NAS",
        _ => "Dieser Server",
    };

    private string AccessTitle => Input.Provider switch
    {
        BackupProvider.GoogleDrive => "Anmeldung bei Google",
        BackupProvider.Azure => "Zugang zu Azure",
        BackupProvider.Sftp => "Zugang zum Server",
        _ => "Zugang zum Speicher",
    };

    /// <summary>Signed in to Google, or a token entered/stored.</summary>
    private bool Connected => Stored(BackupProviders.DriveTokenKey) || !string.IsNullOrWhiteSpace(Credential(BackupProviders.DriveTokenKey));

    protected override async Task OnInitializedAsync() => googleAvailable = await Google.IsAvailableAsync();

    protected override void OnParametersSet()
    {
        // The folder in Google Drive has a sensible default, so that nothing but the sign-in is left to do.
        if (Input.Provider == BackupProvider.GoogleDrive && string.IsNullOrWhiteSpace(Input.Location))
        {
            Input.Location = BackupProviders.DefaultDriveFolder;
        }
    }

    private Task SetLocationAsync(string? value)
    {
        Input.Location = value ?? string.Empty;
        return InputChanged.InvokeAsync();
    }

    private Task SetPasswordAsync(string? value)
    {
        Input.Password = value;
        return InputChanged.InvokeAsync();
    }

    private Task SetCredentialAsync(string key, string? value)
    {
        Input.Credentials[key] = value ?? string.Empty;
        return InputChanged.InvokeAsync();
    }

    private string Credential(string key) => Input.Credentials.GetValueOrDefault(key) ?? string.Empty;

    private bool Stored(string key) => StoredCredentials.Contains(key);

    private async Task ProviderChangedAsync(BackupProvider provider)
    {
        if (provider == Input.Provider)
        {
            return;
        }

        CancelConnect();
        Input.Provider = provider;
        Input.Location = provider == BackupProvider.GoogleDrive ? BackupProviders.DefaultDriveFolder : string.Empty;
        Input.Credentials.Clear();
        connectError = null;
        justConnected = false;
        await ProviderChanged.InvokeAsync(provider);
        await InputChanged.InvokeAsync();
    }

    private async Task ConnectAsync()
    {
        connectError = null;
        justConnected = false;
        var start = await Google.StartAsync();
        if (start.Authorization is not { } authorization)
        {
            connectError = start.Error;
            return;
        }

        device = authorization;
        deviceLink = DeviceLink(authorization);
        using var generator = new QRCodeGenerator();
        using var qr = generator.CreateQrCode(deviceLink, QRCodeGenerator.ECCLevel.M);
        deviceQr = new SvgQRCode(qr).GetGraphic(4);
        _ = PollAsync(authorization);
    }

    /// <summary>Address at Google with the code already filled in (what the QR code holds).</summary>
    public static string DeviceLink(DeviceAuthorization authorization)
    {
        ArgumentNullException.ThrowIfNull(authorization);
        var separator = authorization.VerificationUrl.Contains('?', StringComparison.Ordinal) ? '&' : '?';
        return $"{authorization.VerificationUrl}{separator}user_code={Uri.EscapeDataString(authorization.UserCode)}";
    }

    /// <summary>Asks Google at the pace it names until the person confirmed, refused or the code ran out.</summary>
    private async Task PollAsync(DeviceAuthorization authorization)
    {
        polling?.Cancel();
        polling = new CancellationTokenSource();
        var token = polling.Token;
        var interval = authorization.IntervalSeconds;
        var deadline = Clock.GetUtcNow().AddSeconds(authorization.ExpiresInSeconds);
        try
        {
            while (!token.IsCancellationRequested && Clock.GetUtcNow() < deadline)
            {
                await Task.Delay(TimeSpan.FromSeconds(interval), token);
                var result = await Google.PollAsync(authorization.DeviceCode, token);
                if (result.State == DeviceAuthorizationState.Pending)
                {
                    continue;
                }

                if (result.State == DeviceAuthorizationState.SlowDown)
                {
                    interval += 5;
                    continue;
                }

                await InvokeAsync(() =>
                {
                    if (result.State == DeviceAuthorizationState.Authorized && result.Credentials is not null)
                    {
                        foreach (var (key, value) in result.Credentials)
                        {
                            Input.Credentials[key] = value;
                        }

                        justConnected = true;
                        _ = InputChanged.InvokeAsync();
                    }
                    else
                    {
                        connectError = result.Message ?? "Die Anmeldung bei Google ist fehlgeschlagen.";
                    }

                    device = null;
                    StateHasChanged();
                });
                return;
            }

            await InvokeAsync(() =>
            {
                connectError = "Der Code ist abgelaufen. Bitte erneut anmelden.";
                device = null;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // cancelled or page closed
        }
    }

    private void CancelConnect()
    {
        polling?.Cancel();
        device = null;
    }

    public void Dispose() => polling?.Cancel();
}
