<section id="glossar">
    <h2>Begriffe einfach erklärt</h2>
    <dl class="details">
        @foreach (var (term, text) in Entries)
        {
            <dt>@term</dt>
            <dd>@text</dd>
        }
    </dl>
</section>

@code {
    /// <summary>Terms for the tenants (portal) only.</summary>
    [Parameter]
    public bool TenantsOnly { get; set; }

    private IEnumerable<(string Term, string Text)> Entries => TenantsOnly ? Glossary.Tenant : [.. Glossary.Tenant, .. Glossary.Landlord];
}
