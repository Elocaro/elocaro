@using Elocaro.Application.Notices
@if (Rows.Count == 0)
{
    <EmptyState Text="@EmptyText" />
}
else
{
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr><th>Betreff</th><th>Mietverhältnis</th>@if (WithPeople){<th>Mieter</th>}<th>Letzte Nachricht</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        <td>
                            <a href="@BasePath/@row.Id">@row.Subject</a>
                            @if (row.Unread)
                            {
                                <StatusChip Level="StatusLevel.Warning">neu</StatusChip>
                            }
                        </td>
                        <td>@row.Unit@(row.Property.Length > 0 ? $", {row.Property}" : "")</td>
                        @if (WithPeople)
                        {
                            <td>@row.Tenants</td>
                        }
                        <td>@Format.Timestamp(row.LastMessageAt)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ThreadRow> Rows { get; set; } = [];

    [Parameter, EditorRequired]
    public string BasePath { get; set; } = "";

    [Parameter]
    public bool WithPeople { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "Keine Nachrichten.";
}
