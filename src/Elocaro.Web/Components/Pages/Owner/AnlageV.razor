@page "/eigentuemer/objekte/{PropertyId:guid}/anlage-v"
@attribute [StreamRendering]
@using Elocaro.Application.Portal
@using Elocaro.Application.Tax
@inject IOwnerPortal Owner
@inject TimeProvider Clock

@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (report is null)
{
    <PageHeader Title="Keine Auswertung" Subtitle="@($"Für {Year} liegt kein Eigentum an diesem Objekt vor.")" Back="/eigentuemer" BackText="Meine Objekte" />
    <FilterBar SubmitText="Anzeigen" AllowReset="false">
        <div class="field">
            <label for="jahr">Steuerjahr</label>
            <input id="jahr" type="number" name="jahr" value="@Year" min="2000" max="2100" />
        </div>
    </FilterBar>
}
else
{
    <PageHeader Title="@($"Anlage V {report.Year}")" Subtitle="@($"{report.PropertyName} · Ihr Anteil {report.OwnerSharePercent:0.####} %")" Back="/eigentuemer" BackText="Meine Objekte">
        <Actions>
            <a class="button" href="/eigentuemer/objekte/@PropertyId/anlage-v.csv?jahr=@Year">CSV</a>
        </Actions>
    </PageHeader>

    <FilterBar SubmitText="Anzeigen" AllowReset="false">
        <div class="field">
            <label for="jahr">Steuerjahr</label>
            <input id="jahr" type="number" name="jahr" value="@Year" min="2000" max="2100" />
        </div>
    </FilterBar>

    @if (report.Warnings.Count > 0)
    {
        <Notice Level="NoticeLevel.Warning">
            <ul>
                @foreach (var warning in report.Warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </Notice>
    }

    <section>
        <h2>Einnahmen</h2>
        <LineTable Lines="report.Result.Income" Total="report.Result.IncomeTotal" TotalText="Summe der Einnahmen" />
    </section>
    <section>
        <h2>Werbungskosten</h2>
        <LineTable Lines="report.Result.Expenses" Total="report.Result.ExpenseTotal" TotalText="Summe der Werbungskosten" />
    </section>
    <dl class="summary">
        @if (report.Result.Reduction != 0)
        {
            <dt>Kürzung der Werbungskosten (verbilligte Vermietung)</dt><dd>@Format.Money(-report.Result.Reduction)</dd>
        }
        <dt>Überschuss</dt><dd>@Format.Money(report.Result.Surplus)</dd>
    </dl>
    <p class="small">Ausfüllhilfe, keine Steuerberatung. Bitte die Werte mit dem Steuerberater abstimmen.</p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> Authentication { get; set; } = default!;

    private AnlageVReport? report;
    private bool loaded;

    [Parameter]
    public Guid PropertyId { get; set; }

    [SupplyParameterFromQuery(Name = "jahr")]
    private int? SelectedYear { get; set; }

    private int Year => SelectedYear is >= 2000 and <= 2100 ? SelectedYear.Value : Elocaro.Domain.Common.GermanTime.Today(Clock.GetUtcNow()).Year - 1;

    protected override async Task OnInitializedAsync()
    {
        report = await Owner.AnlageVAsync((await Authentication).User, PropertyId, Year);
        loaded = true;
    }
}
