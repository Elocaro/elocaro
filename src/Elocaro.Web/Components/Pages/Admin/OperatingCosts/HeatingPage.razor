@page "/verwaltung/objekte/{PropertyId:guid}/heizung"
@using Elocaro.Application.Heating
@rendermode InteractiveServer
@using MudBlazor
@inject IHeatingSettings Settings
@inject Notifier Notify
@inject IDialogService Dialogs
@inject TimeProvider Clock

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (view is null)
{
    <PageHeader Title="Objekt nicht gefunden" Back="/verwaltung/objekte" BackText="Alle Objekte" />
}
else
{

<PageHeader Title="Heizkosten (HeizkostenV)" Back="@($"/verwaltung/objekte/{PropertyId}")" BackText="@view.PropertyName" />

<ErrorList Errors="errors" />

@if (!view.Saved)
{
    <Notice Level="NoticeLevel.Info" id="defaults-notice">
        Noch nichts gespeichert: Die Vorschau rechnet mit Standardwerten (siehe „So heizt dieses Haus“). Prüfen Sie sie und speichern Sie.
    </Notice>
}

<details class="explain">
    <summary>Kurz erklärt: Was brauche ich für die Heizkosten?</summary>
    <p class="small">
        Die Heizkostenverordnung schreibt vor, die Heizkosten zum größeren Teil nach dem tatsächlichen Verbrauch zu verteilen (50 bis 70 %), den Rest nach Fläche.
        Eine Abrechnung nur nach Fläche oder nur nach Verbrauch ist nicht zulässig. Elocaro rechnet das, wenn drei Dinge vorliegen:
    </p>
    <ol class="small">
        <li><strong>Zähler und Ablesungen:</strong> je Wohnung ein Wärmezähler (kWh) und ein Warmwasserzähler (m³), abgelesen zum Ende des Abrechnungsjahres (Bereich „Zähler“ des Objekts).</li>
        <li><strong>Rechnungen als Belege:</strong> Brennstoff, Wartung, Abgasmessung und Zählermiete. Bei einer gemeinsamen Anlage für Heizung und Warmwasser buchen Sie alles unter der Kostenart „6. Verbundene Heizungs- und Warmwasseranlagen“.</li>
        <li><strong>Diese Seite:</strong> Bestätigen Sie unten, womit geheizt wird und ob die Anlage auch das Warmwasser erzeugt. Der Rest hat sinnvolle Voreinstellungen.</li>
    </ol>
</details>

<EditForm Model="Data" OnValidSubmit="SaveAsync" novalidate>
    <DataAnnotationsValidator />

    <MudTabs Elevation="0" Rounded="false" TabPanelsClass="mt-4" Class="detail-tabs" KeepPanelsAlive="true">
    <MudTabPanel Text="Verteilung">
    <section>
        <h2>So heizt dieses Haus</h2>
        <Notice Level="NoticeLevel.Info" id="heating-summary">
            Aktuell gilt: <strong>@FuelShort(Data.Fuel)</strong>, @(Data.JointPlant ? "eine Anlage für Heizung und Warmwasser" : "Heizung und Warmwasser getrennt"),
            <strong>@Format.Number(Data.ConsumptionPercent ?? 70m) % nach Verbrauch</strong> und @Format.Number(100m - (Data.ConsumptionPercent ?? 70m)) % nach Fläche.
            Für die meisten Häuser passt das so; ändern Sie nur, was bei Ihnen anders ist.
        </Notice>
        <div class="form-grid">
            <AppSelect T="HeatingFuel" @bind-Value="Data.Fuel" Label="Energieträger" Items="Enum.GetValues<HeatingFuel>()" Text="Labels.From" Hint="Womit wird geheizt? Davon hängt ab, woher der Verbrauch kommt (Rechnung des Versorgers oder Tankbestand)." />
        </div>
        <fieldset class="field">
            <legend>Erzeugt dieselbe Anlage auch das Warmwasser?</legend>
            <AppRadioGroup T="bool" @bind-Value="Data.JointPlant" Items="new[] { true, false }" Text="@(v => v ? "Ja, eine Anlage für beides (üblich bei einer Zentralheizung)" : "Nein, das Warmwasser wird getrennt erzeugt (z. B. Durchlauferhitzer)")" />
            <span class="field-hint">Bei einer gemeinsamen Anlage teilt Elocaro die Brennstoffkosten selbst auf Heizung und Warmwasser auf (§ 9 HeizkostenV).</span>
        </fieldset>
        <div class="form-grid">
            <AppNumberField T="decimal?" @bind-Value="Data.ConsumptionPercent" Label="Anteil nach Verbrauch (%)" Required="true" Min="50" Max="70" Hint="Gesetzlich 50 bis 70 %, üblich sind 70 %. Der Rest wird nach Fläche verteilt." />
        </div>
        <div class="form-row">
            <MudButton Variant="Variant.Text" OnClick="() => Data.ConsumptionPercent = 70m">70 % (üblich)</MudButton>
            <MudButton Variant="Variant.Text" OnClick="() => Data.ConsumptionPercent = 60m">60 %</MudButton>
            <MudButton Variant="Variant.Text" OnClick="() => Data.ConsumptionPercent = 50m">50 %</MudButton>
        </div>

        <details class="explain" id="heating-more">
            <summary>Weitere Angaben (meist nicht nötig)</summary>
            <p class="small">Nur ausfüllen, wenn die Rechnung des Versorgers die Werte nicht selbst nennt.</p>
            <div class="form-grid">
                <AppNumberField T="decimal?" @bind-Value="Data.FuelKwhPerUnit" Label="Energieinhalt je Einheit (kWh)" Hint="Nur nötig, wenn die Rechnung die Menge nicht in kWh nennt (m³ Gas, l Öl: bei Öl gilt 10 kWh/l)." />
                <p class="small">Zur Aufteilung der CO₂-Kosten siehe <HelpTerm Term="Emissionsfaktor" />.</p>
                <AppNumberField T="decimal?" @bind-Value="Data.CarbonKgPerKwh" Label="Emissionsfaktor (kg CO₂/kWh)" Hint="Leer = Erdgas 0,2016. Wird aus dem Tarif berechnet, wenn die Rechnung keine CO₂-Menge nennt." />
            </div>
        </details>

        <details class="explain" id="heating-station">
            <summary>Mieterwechsel ohne Zwischenablesung@(string.IsNullOrEmpty(Data.DegreeDayStationId) ? "" : $": Station {StationName(Data.DegreeDayStationId)}")</summary>
            <p class="small">
                Fehlt beim Mieterwechsel eine Zwischenablesung, verteilt Elocaro den Heizverbrauch nach den Gradtagen (§ 9b HeizkostenV). Dafür braucht es die nächstgelegene
                Wetterstation des Deutschen Wetterdienstes; die Liste beginnt mit der nächsten zur Postleitzahl des Objekts. Die Werte holt Elocaro automatisch. Ohne Station gilt ein mitgelieferter Platzhalter.
            </p>
            @if (view.DegreeDayStations.Count == 0)
            {
                <Notice Level="NoticeLevel.Info" id="degree-day-empty">Es sind noch keine Stationsdaten abgerufen. Der Abruf läuft alle 12 Stunden; er braucht Internetzugang zu opendata.dwd.de.</Notice>
            }
            else
            {
                @if (suggestedStation is { } suggestion && Data.DegreeDayStationId == suggestion.Id)
                {
                    <Notice Level="NoticeLevel.Info" id="degree-day-suggestion">Vorgeschlagen: die nächstgelegene Station zur Postleitzahl des Objekts, @suggestion.Name (rund @suggestion.DistanceKm km). Sie gilt, sobald Sie die Einstellungen speichern.</Notice>
                }
                <div class="form-grid">
                    <AppSelect T="string" @bind-Value="Data.DegreeDayStationId" Label="Wetterstation (Gradtage)" Items="view.DegreeDayStations.Select(s => s.Id).ToList()" Text="StationName" EmptyText="Platzhalter (keine Station)" Hint="@($"Stand der Tabelle: {view.DegreeDayTableVersion}")" />
                </div>
            }
        </details>
    </section>
    @if (Data.JointPlant)
    {
        <section>
            <h2>Aufteilung Heizung und Warmwasser (§ 9)</h2>
            <div class="form-grid">
                <OptionSelect @bind-Value="Data.HotWaterHeatMeterId" Label="Wärmezähler im Warmwasserkreis" Options="view.HeatMeters.Select(m => (m.Id, m.Name)).ToList()" />
                <AppNumberField T="decimal?" @bind-Value="Data.HotWaterFormulaFactor" Label="Formelfaktor (kWh je m³ und K)" Hint="Standard 2,5 (Heizwert). Bei Abrechnung nach Brennwert den Faktor prüfen." />
                <AppNumberField T="decimal?" @bind-Value="Data.HotWaterTemperature" Label="Warmwassertemperatur (°C)" Hint="Standard 60 °C." />
            </div>
            <AppRadioGroup T="HotWaterSplitBasis" @bind-Value="Data.SplitBasis" Items="Enum.GetValues<HotWaterSplitBasis>()" Text="Labels.From" />
            <details class="explain">
                <summary>So wird die Wärme aufgeteilt</summary>
                <p class="small">Die Summe der Wärmezähler nimmt die Wärmezähler der Wohnungen als Heizungswärme; der Zähler im Warmwasserkreis (oder die Formel) liefert die Warmwasserwärme. Die Brennstoffenergie braucht die Brennstoffmenge am Beleg.</p>
            </details>
            <p class="small">Ohne Zähler im Warmwasserkreis gilt die Formel Q = Faktor × V × (t − 10 °C) mit dem Warmwasserverbrauch V aller Wohnungen.</p>
        </section>
    }
    </MudTabPanel>
    <MudTabPanel Text="@(Data.Fuel == HeatingFuel.Oil ? "Heizöl" : "Brennwert je Jahr")" Visible="@(Data.Fuel is HeatingFuel.Gas or HeatingFuel.Oil)">
    @if (Data.Fuel == HeatingFuel.Gas)
    {
        <section id="energy-years">
            <h2>Brennwert und Zustandszahl je Jahr</h2>
            <details class="explain">
                <summary>Wie wird Gas umgerechnet?</summary>
                <p class="small">Gas wird nach m³ geliefert und nach Brennwert × Zustandszahl in kWh umgerechnet (steht auf der Jahresrechnung des Versorgers). Ein Eintrag für das Abrechnungsjahr ersetzt den festen Energieinhalt oben; ohne Eintrag gilt der feste Wert.</p>
            </details>
            @if (Data.EnergyYears.Count == 0)
            {
                <EmptyState Text="Noch kein Jahr erfasst. Es gilt der feste Energieinhalt je Einheit." />
            }
            else
            {
                <MudTable T="FuelEnergyYearInput" Items="Data.EnergyYears.OrderByDescending(e => e.Year)" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Dense="true" id="energy-year-table">
                    <HeaderContent>
                        <MudTh>Jahr</MudTh><MudTh Style="text-align:right">Brennwert (kWh/m³)</MudTh><MudTh Style="text-align:right">Zustandszahl</MudTh><MudTh Style="text-align:right">CO₂-Preis (€/t)</MudTh><MudTh>Quelle / Notiz</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd DataLabel="Jahr">@row.Year</MudTd>
                        <MudTd DataLabel="Brennwert" Style="text-align:right">@Format.Number(row.CalorificValue)</MudTd>
                        <MudTd DataLabel="Zustandszahl" Style="text-align:right">@Format.Number(row.StateNumber)</MudTd>
                        <MudTd DataLabel="CO₂-Preis" Style="text-align:right">@Format.Number(row.CarbonPricePerTon)</MudTd>
                        <MudTd DataLabel="Notiz">@row.Note</MudTd>
                        <MudTd Style="text-align:right; white-space:nowrap">
                            <MudButton Variant="Variant.Text" OnClick="() => EditYearAsync(row)" aria-label="@($"Jahr {row.Year} bearbeiten")">Bearbeiten</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => Data.EnergyYears.Remove(row)" aria-label="@($"Jahr {row.Year} entfernen")">Entfernen</MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            <p class="small">Änderungen an der Liste gelten mit „Einstellungen speichern“.</p>
            <MudButton Variant="Variant.Outlined" OnClick="AddYearAsync">Jahr hinzufügen</MudButton>
        </section>
    }

    @if (Data.Fuel == HeatingFuel.Oil)
    {
        <section>
            <h2>Heizöl</h2>
            <details class="explain">
                <summary>So wird der Ölverbrauch ermittelt</summary>
                <p class="small">Bei Heizöl ergibt sich der Verbrauch aus Anfangsbestand + Lieferungen − Endbestand. Die Bestände sind Ablesungen eines Tankzählers (Typ Öl, Einheit Liter) zum Tag vor Beginn und zum Ende des Abrechnungszeitraums.</p>
            </details>
            <div class="form-grid">
                <OptionSelect @bind-Value="Data.OilTankMeterId" Label="Tankzähler" Options="view.OilMeters.Select(m => (m.Id, m.Name)).ToList()" />
                <AppSelect T="OilValuation" @bind-Value="Data.OilValuation" Label="Bewertung" Items="Enum.GetValues<OilValuation>()" Text="Labels.From" />
                <AppNumberField T="decimal?" @bind-Value="Data.OilOpeningPricePerLiter" Label="Preis des Anfangsbestands (€/l)" Hint="Jährlich anpassen; leer = Preis der ersten Lieferung." />
            </div>
        </section>
    }
    </MudTabPanel>
    <MudTabPanel Text="CO₂-Kosten" Visible="@(Data.Fuel != HeatingFuel.Other)">
    @if (Data.Fuel != HeatingFuel.Other)
    {
        <section id="carbon-settings">
            <h2>CO₂-Kostenaufteilung (CO2KostAufG)</h2>
            <Notice Level="NoticeLevel.Warning" id="legal-notice">
                <strong>Stand/prüfen:</strong> Die Stufentabelle (@view.CarbonTableVersion: @view.CarbonTableStatus) und die Gradtagszahlen
                (@view.DegreeDayTableVersion: @view.DegreeDayTableStatus) sind versionierte Daten, die vor dem Versand einer Abrechnung gegen die
                amtlichen Quellen geprüft werden müssen. Elocaro gibt keine Rechtssicherheit.
            </Notice>
            <div class="form-grid">
                <AppCheckBox @bind-Value="Data.ApplyCarbonCosts" Label="CO₂-Kosten zwischen Vermieter und Mieter aufteilen" />
                <AppSelect T="CarbonSpecialCase" @bind-Value="Data.CarbonSpecialCase" Label="Sonderfall" Items="Enum.GetValues<CarbonSpecialCase>()" Text="Labels.From" Hint="Wird nur als Warnung ausgewiesen, nicht gerechnet." />
                <AppTextField @bind-Value="Data.CarbonNote" Label="Notiz zum Sonderfall" />
            </div>
            <p class="small">Die CO₂-Menge (kg) steht auf dem Brennstoffbeleg, die CO₂-Kosten erfassen Sie als eigene Position der Art „CO₂-Kosten laut Lieferant“.</p>
        </section>
    }
    </MudTabPanel>
    </MudTabs>

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Einstellungen speichern</MudButton>
</EditForm>
}
</InteractiveShell>

@code {
    private HeatingSettingsView? view;

    private static string FuelShort(HeatingFuel fuel) => fuel switch { HeatingFuel.Oil => "Heizöl", HeatingFuel.Other => "Sonstiger Energieträger (kWh laut Beleg)", _ => "Gas" };

    private string StationName(string? id) => view?.DegreeDayStations.FirstOrDefault(s => s.Id == id) is { } station
        ? station.Name + (station.DistanceKm is { } km ? $" ({km} km)" : "")
        : "";

    /// <summary>The nearest station was preselected because none had been chosen yet.</summary>
    private DegreeDayStationOption? suggestedStation;
    private IReadOnlyList<string>? errors;
    private HeatingSettingsInput Data { get; set; } = new();
    private bool loaded;

    [Parameter]
    public Guid PropertyId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        view = await Settings.GetAsync(PropertyId);
        if (view is not null)
        {
            Data = view.Input;
            if (string.IsNullOrEmpty(Data.DegreeDayStationId) && view.DegreeDayStations.FirstOrDefault() is { DistanceKm: not null } nearest)
            {
                Data.DegreeDayStationId = nearest.Id;
                suggestedStation = nearest;
            }
        }

        loaded = true;
    }

    private async Task AddYearAsync()
    {
        var year = Data.EnergyYears.Count == 0 ? GermanTime.Today(Clock.GetUtcNow()).Year - 1 : Data.EnergyYears.Max(e => e.Year) + 1;
        var dialog = await Dialogs.ShowAsync<EnergyYearDialog>("Brennwert eines Jahres", new DialogParameters { ["DefaultYear"] = year, ["Rows"] = Data.EnergyYears }, DialogOptions);
        if (await dialog.Result is { Canceled: false, Data: FuelEnergyYearInput added })
        {
            Data.EnergyYears.Add(added);
        }
    }

    private async Task EditYearAsync(FuelEnergyYearInput row)
    {
        var dialog = await Dialogs.ShowAsync<EnergyYearDialog>($"Brennwert {row.Year}", new DialogParameters { ["Existing"] = row, ["Rows"] = Data.EnergyYears }, DialogOptions);
        if (await dialog.Result is { Canceled: false, Data: FuelEnergyYearInput changed })
        {
            Data.EnergyYears[Data.EnergyYears.IndexOf(row)] = changed;
        }
    }

    private static readonly DialogOptions DialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    private async Task SaveAsync()
    {
        var result = await Settings.SaveAsync(PropertyId, Data);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success("Die Heizungseinstellungen wurden gespeichert.");
            view = await Settings.GetAsync(PropertyId);
        }
    }
}
