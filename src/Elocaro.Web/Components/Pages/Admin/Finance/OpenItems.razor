@page "/verwaltung/finanzen/offene-posten"
@inject ITenantAccounts Accounts
@inject IDunning Dunning

<PageHeader Title="Offene Posten" Subtitle="Fällige, nicht vollständig bezahlte Forderungen, nach Mietverhältnis gruppiert.">
    <Actions>
        <a class="button" href="/verwaltung/finanzen/offene-posten.csv">CSV exportieren</a>
    </Actions>
</PageHeader>

@if (items is { Count: 0 })
{
    <EmptyState Text="Keine offenen Posten. Alles bezahlt." />
}
else if (items is not null)
{
    var leases = items.GroupBy(p => p.LeaseId).OrderByDescending(g => g.Sum(p => p.Open)).ToList();
    <p><strong>Summe offen: @Format.Money(items.Sum(p => p.Open))</strong> <span class="small">in @items.Count Posten bei @leases.Count @(leases.Count == 1 ? "Mietverhältnis" : "Mietverhältnissen")</span></p>
    <SegmentBar id="open-items-age" Caption="Alter der offenen Posten" Segments="Ages" />
    <p class="help">Hier steht alles, was bereits fällig war und noch nicht bezahlt ist. Im Mieterkonto (Link in jeder Gruppe) lassen sich Zahlungen buchen. Mahnvorschläge für alle Mietverhältnisse stehen im <a href="/verwaltung/finanzen/mahnungen">Mahnwesen</a>.</p>
    @foreach (var lease in leases)
    {
        var first = lease.First();
        <details class="group" open="@(leases.Count <= 3)">
            <summary>
                <span>@first.Tenant</span>
                <span class="small">@first.RentalUnit · @lease.Count() Posten, ältester seit @lease.Max(p => p.DaysOverdue) Tagen überfällig</span>
                <span class="group-sum">@Format.Money(lease.Sum(p => p.Open))</span>
            </summary>
            <p class="group-link"><a class="button button-text" href="/verwaltung/vertraege/@first.LeaseId/konto?zahlung=erfassen">Zahlung erfassen</a> · <a href="/verwaltung/vertraege/@first.LeaseId/konto">Zum Mieterkonto von @first.Tenant</a>@(levels.GetValueOrDefault(first.LeaseId) is { } level ? $" · zuletzt: {Labels.From(level)}" : "")</p>
            @{ var rows = lease.OrderBy(p => p.Due).ToList(); }
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr><th>Forderung</th><th>Fällig</th><th class="number">Betrag</th><th class="number">Offen</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in rows.Take(Visible))
                        {
                            <tr>
                                <td>@p.Text</td>
                                <td>@Format.Date(p.Due) <span class="small">(@p.DaysOverdue Tage)</span></td>
                                <td class="number">@Format.Money(p.Amount)</td>
                                <td class="number">@Format.Money(p.Open)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (rows.Count > Visible)
            {
                <details class="disclosure">
                    <summary>@(rows.Count - Visible) weitere Posten anzeigen</summary>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr><th>Forderung</th><th>Fällig</th><th class="number">Betrag</th><th class="number">Offen</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in rows.Skip(Visible))
                        {
                            <tr>
                                <td>@p.Text</td>
                                <td>@Format.Date(p.Due) <span class="small">(@p.DaysOverdue Tage)</span></td>
                                <td class="number">@Format.Money(p.Amount)</td>
                                <td class="number">@Format.Money(p.Open)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
                </details>
            }
        </details>
    }
}

@code {
    private const int Visible = 12;

    private IReadOnlyList<OpenItem>? items;

    private Dictionary<Guid, Elocaro.Domain.Finance.DunningLevel> levels = [];

    private List<ChartSegment> Ages =>
    [
        Age("bis 30 Tage", 0, 30, ChartTone.Tertiary),
        Age("31 bis 60 Tage", 31, 60, ChartTone.Warning),
        Age("über 60 Tage", 61, int.MaxValue, ChartTone.Error),
    ];

    private ChartSegment Age(string label, int from, int to, ChartTone tone)
    {
        var sum = items!.Where(p => p.DaysOverdue >= from && p.DaysOverdue <= to).Sum(p => p.Open);
        return new ChartSegment(label, sum, Format.Money(sum), tone);
    }

    protected override async Task OnInitializedAsync()
    {
        items = await Accounts.OpenItemsAsync();
        levels = (await Dunning.OverviewAsync()).Issued
            .GroupBy(d => d.LeaseId)
            .ToDictionary(g => g.Key, g => g.Max(d => d.Level));
    }
}
