@page "/verwaltung/vertraege/{Id:guid}/konto"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Domain.Common
@using Elocaro.Domain.Leases
@inject ITenantAccounts Accounts
@inject IDunning Dunning
@inject Notifier Notify
@inject Confirmations Confirm
@inject IDialogService Dialogs
@inject TimeProvider Clock

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (account is null)
{
    <PageHeader Title="Vertrag nicht gefunden" Back="/verwaltung/finanzen/offene-posten" BackText="Offene Posten" />
}
else
{
    <PageHeader Title="@($"Mieterkonto {account.Tenant}")" Back="@($"/verwaltung/vertraege/{Id}")" BackText="Zum Vertrag">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="PaymentAsync">Zahlung erfassen</MudButton>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Weitere Aktionen" Dense="true">
                <MudMenuItem OnClick="OpenChargeDialog">Forderung oder Gutschrift buchen</MudMenuItem>
                <MudMenuItem OnClick="RefreshAsync">Fehlende Monatsmieten nachtragen</MudMenuItem>
            </MudMenu>
        </Actions>
    </PageHeader>

    <ErrorList Errors="errors" />

    @if (account.AccountingStart is null)
    {
        <Notice Level="NoticeLevel.Warning">Noch kein Buchhaltungsbeginn festgelegt, daher entstehen keine Monatsmieten. <a href="/verwaltung/finanzen/einstellungen">Jetzt festlegen</a></Notice>
    }

    @if (dunning?.TerminationHint is { } hint)
    {
        <Notice Level="NoticeLevel.Warning">
            <strong>Hinweis Kündigungsrelevanz:</strong> Mietrückstand @Format.Money(hint.OpenRent) bei einer Monatsmiete von @Format.Money(hint.MonthlyRent)
            (§ 543 Abs. 2 Nr. 3 BGB). Nur ein Hinweis, keine Automatik; bitte rechtlich prüfen lassen.
        </Notice>
    }

    @if (dunning?.Proposal is { } proposal)
    {
        <Notice Level="NoticeLevel.Info" id="dunning-proposal">
            Mahnvorschlag: <strong>@Labels.From(proposal.Level)</strong> über @Format.Money(proposal.Principal).
            <a href="/verwaltung/finanzen/mahnungen/@proposal.Id">Prüfen und freigeben</a>
        </Notice>
    }

    <div class="summary-card">
        <dl class="details">
            <dt>Saldo</dt>
            <dd><strong>@Format.Money(Math.Abs(account.Balance))</strong> @(account.Balance > 0 ? "Rückstand" : account.Balance < 0 ? "Guthaben des Mieters" : "ausgeglichen")</dd>
            <dt>Davon fällig</dt><dd>@Format.Money(account.Due)</dd>
            <dt>Verrechnung</dt><dd>@Labels.From(account.Allocation)</dd>
        </dl>
    </div>

    <MudTabs Elevation="0" Rounded="false" TabPanelsClass="mt-4" Class="detail-tabs" KeepPanelsAlive="true">
        <MudTabPanel Text="@($"Buchungen ({account.Entries.Count})")">
            <section>
                <div class="form-row search-bar">
                    <AppSelect T="int?" @bind-Value="year" Label="Jahr" Items="years" Text="@(y => y?.ToString() ?? "")" EmptyText="Alle Jahre" />
                    <AppCheckBox @bind-Value="onlyOpen" Label="Nur offene Posten" />
                </div>
                <p class="help"><HelpTerm Term="Soll und Haben" Text="Soll und Haben" />: Soll ist, was der Mieter zahlen muss, Haben, was er gezahlt hat. Die Monatsmieten entstehen jede Nacht automatisch.</p>
                @if (account.Entries.Count == 0)
                {
                    <EmptyState Compact="true" Text="Noch keine Buchungen." />
                }
                else
                {
                    <MudTable T="AccountEntry" Class="account-rows" Items="VisibleEntries" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" RowsPerPage="25">
                        <HeaderContent>
                            <MudTh>Datum</MudTh>
                            <MudTh>Buchung</MudTh>
                            <MudTh Style="text-align: right">Soll</MudTh>
                            <MudTh Style="text-align: right">Haben</MudTh>
                            <MudTh Style="text-align: right">Saldo</MudTh>
                            <MudTh>Offen</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Datum">@Format.Date(context.Date)</MudTd>
                            <MudTd DataLabel="Buchung">@context.Text</MudTd>
                            <MudTd DataLabel="Soll" Style="text-align: right">@(context.Debit == 0 ? "" : Format.Money(context.Debit))</MudTd>
                            <MudTd DataLabel="Haben" Style="text-align: right">@(context.Credit == 0 ? "" : Format.Money(context.Credit))</MudTd>
                            <MudTd DataLabel="Saldo" Style="text-align: right">@Format.Money(context.Balance)</MudTd>
                            <MudTd DataLabel="Offen">
                                @if (context.Open is 0m)
                                {
                                    <StatusChip Level="StatusLevel.Success">bezahlt</StatusChip>
                                }
                                else if (context.Open is { } open && open == context.Debit)
                                {
                                    <StatusChip Level="StatusLevel.Warning">offen</StatusChip>
                                }
                                else if (context.Open is { } part)
                                {
                                    <StatusChip Level="StatusLevel.Warning">@Format.Money(part) offen</StatusChip>
                                }
                            </MudTd>
                            <MudTd>
                                @if (!context.Automatic && context.Origin is null or PaymentOrigin.Manual)
                                {
                                    <MudButton Variant="Variant.Text" OnClick="() => EditAsync(context)" aria-label="@($"{context.Text} bearbeiten")">Bearbeiten</MudButton>
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="@($"Weitere Aktionen für {context.Text}")" Dense="true">
                                        <MudMenuItem OnClick="() => DeleteAsync(context)">Löschen</MudMenuItem>
                                    </MudMenu>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <EmptyState Text="Keine Buchungen in dieser Auswahl." />
                        </NoRecordsContent>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" RowsPerPageString="Zeilen pro Seite" InfoFormat="{first_item}–{last_item} von {all_items}" AllItemsText="Alle" />
                        </PagerContent>
                    </MudTable>
                }
            </section>
        </MudTabPanel>

        <MudTabPanel Text="@(dunning?.Proposal is null ? "Mahnwesen" : "Mahnwesen (Vorschlag)")">
            <section id="mahnwesen" aria-label="Mahnwesen">
                @if (dunning is not null)
                {
                    @if (dunning.Proposal is { } open)
                    {
                        <DunningLevelTrack Current="open.Level" />
                    }
                    else if (dunning.Issued.Count > 0)
                    {
                        <DunningLevelTrack Current="dunning.Issued.Max(d => d.Level)" Issued="true" />
                    }

                    @if (dunning.Issued.Count > 0)
                    {
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead><tr><th>Datum</th><th>Stufe</th><th class="number">Gesamt</th><th>Zahlbar bis</th><th>Versand</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var m in dunning.Issued)
                                    {
                                        <tr>
                                            <td>@Format.Date(m.Date)</td>
                                            <td>@Labels.From(m.Level)</td>
                                            <td class="number">@Format.Money(m.Principal + m.Fee + m.Interest)</td>
                                            <td>@Format.Date(m.Deadline)</td>
                                            <td>@(m.SentByMail ? "E-Mail" : "Post (PDF)")</td>
                                            <td><a href="/verwaltung/finanzen/mahnungen/@m.Id">Ansehen</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (dunning.Proposal is null)
                    {
                        <p class="small">Bisher wurde nicht gemahnt.</p>
                    }

                    <h3>Mahnsperre</h3>
                    @if (dunning.Holds.Count > 0)
                    {
                        <ul>
                            @foreach (var h in dunning.Holds)
                            {
                                <li>
                                    @h.Reason (@(h.Until is { } until ? "bis " + Format.Date(until) : "bis auf Weiteres"))
                                    <MudButton Variant="Variant.Outlined" OnClick="() => EndHoldAsync(h)" aria-label="@($"Mahnsperre „{h.Reason}“ aufheben")">Aufheben</MudButton>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="small">Keine aktive Mahnsperre. Mit einer Sperre (z. B. Ratenvereinbarung) gibt es keine Mahnvorschläge für dieses Mietverhältnis.</p>
                    }

                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="HoldAsync">Mahnsperre setzen</MudButton>
                }
            </section>
        </MudTabPanel>

        <MudTabPanel Text="Auswertung">
            <section>
    <LineChart id="balance-chart" Caption="Saldo im Zeitverlauf (über null: Rückstand, unter null: Guthaben)" LabelHeading="Monatsende" ValueHeading="Saldo" Points="BalancePoints" />
    <details class="explain">
        <summary>So funktioniert das Mieterkonto</summary>
        <p>Jeden Monat entsteht je Bestandteil (Kaltmiete, Vorauszahlungen) eine <HelpTerm Term="Sollstellung" /> (<HelpTerm Term="Soll und Haben" Text="„Soll“" />). Jede Zahlung („Haben“) wird nach der eingestellten Verrechnung auf offene Forderungen angerechnet. Ein positiver Saldo ist ein Rückstand, ein negativer ein Guthaben des Mieters. „Fällig“ zählt nur, was bis heute zu zahlen war.</p>
    </details>
                @if (account.AnnualValues.Count == 0)
                {
                    <EmptyState Compact="true" Text="Noch keine Monatsmieten." />
                }
                else
                {
                    <CostBars id="inflow-years" Caption="Zahlungseingang je Kalenderjahr" Rows="InflowRows" />
                    <p class="help">Soll nach Leistungsmonat, davon bezahlt (für die Nebenkostenabrechnung) und im Kalenderjahr <HelpTerm Term="Zufluss" Text="zugeflossen" /> (Zahlungsdatum, § 11 EStG).</p>
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead><tr><th>Jahr</th><th>Bestandteil</th><th class="number">Soll</th><th class="number">davon bezahlt</th><th class="number">Zufluss im Jahr</th></tr></thead>
                            <tbody>
                                @foreach (var w in account.AnnualValues)
                                {
                                    <tr>
                                        <td>@w.Year</td>
                                        <td>@Labels.From(w.Component)</td>
                                        <td class="number">@Format.Money(w.Debit)</td>
                                        <td class="number">@Format.Money(w.Settled)</td>
                                        <td class="number">@Format.Money(w.Inflow)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </MudTabPanel>
    </MudTabs>
}
</InteractiveShell>

@code {
    /// <summary>The balance at the end of each of the last 24 months with bookings.</summary>
    private List<ChartPoint> BalancePoints => [.. account!.Entries
        .GroupBy(e => new DateOnly(e.Date.Year, e.Date.Month, 1))
        .OrderBy(g => g.Key)
        .TakeLast(24)
        .Select(g => new ChartPoint(Format.Month(g.Key), g.Last().Balance))];

    private List<ChartBar> InflowRows => [.. account!.AnnualValues.GroupBy(v => v.Year).OrderBy(g => g.Key)
        .Select(g => new ChartBar(g.Key.ToString(System.Globalization.CultureInfo.InvariantCulture), g.Sum(v => v.Inflow)))];

    private TenantAccount? account;
    private LeaseDunning? dunning;
    private IReadOnlyList<string>? errors;
    private PaymentInput payment = new();
    private ChargeInput charge = new();
    private DunningHoldInput hold = new();
    private IReadOnlyList<Guid?> openChargeIds = [];
    private IReadOnlyList<int?> years = [];
    private int? year;
    private bool onlyOpen;
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    /// <summary>"erfassen" opens the payment dialog on arrival (link from the open items).</summary>
    [SupplyParameterFromQuery(Name = "zahlung")]
    private string? PaymentRequest { get; set; }

    private IEnumerable<AccountEntry> VisibleEntries => account is null ? [] : account.Entries.Reverse()
        .Where(b => (year is null || b.Date.Year == year) && (!onlyOpen || b.Open > 0));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private bool paymentOpened;

    // Not on the first render: the account is still loading then.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!paymentOpened && account is not null && PaymentRequest == "erfassen")
        {
            paymentOpened = true;
            await PaymentAsync();
        }
    }

    private async Task LoadAsync()
    {
        account = await Accounts.GetAsync(Id);
        if (account is not null)
        {
            dunning = await Dunning.ForLeaseAsync(Id);
            openChargeIds = account.Entries.Where(b => b.Open > 0).Select(b => (Guid?)b.Id).ToList();
            years = account.Entries.Select(b => (int?)b.Date.Year).Distinct().OrderDescending().ToList();
        }

        loaded = true;
    }

    private string ChargeText(Guid? id) => account?.Entries.FirstOrDefault(b => b.Id == id) is { } b ? $"{b.Text} ({Format.Money(b.Open)})" : "";

    private async Task RefreshAsync()
    {
        var count = await Accounts.GenerateChargesAsync(Id);
        if (account?.AccountingStart is null)
        {
            Notify.Warning("Es ist noch kein Buchhaltungsbeginn festgelegt, daher entstehen keine Monatsmieten (Forderungen → Einstellungen).");
        }
        else
        {
            Notify.Success(count == 0 ? "Die Monatsmieten sind aktuell." : $"{count} Sollstellungen angelegt oder angeglichen.");
        }

        await LoadAsync();
    }

    private async Task PaymentAsync()
    {
        // Prefilled for the common case: today, the amount that is due (the whole arrears if nothing is due yet).
        var amount = account!.Due > 0 ? account.Due : account.Balance > 0 ? account.Balance : (decimal?)null;
        payment = new() { Date = GermanTime.Today(Clock.GetUtcNow()), Amount = amount };
        RenderFragment fields = @<text>
            <p class="help">Für Zahlungen, die nicht über den Bankimport kommen (Barzahlung, Überweisung auf ein anderes Konto). Ohne Auswahl bei „Zahlt auf“ wird nach der eingestellten Verrechnung gebucht.</p>
            <AppDateField @bind-Value="payment.Date" Label="Datum" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="payment.Amount" Label="Betrag" Suffix="€" Required="true" />
            <AppTextField @bind-Value="payment.Purpose" Label="Verwendungszweck" />
            <AppSelect T="Guid?" @bind-Value="payment.ChargeId" Label="Zahlt auf (optional)" Hint="Nur wenn der Mieter das bestimmt hat (z. B. „Kaution“)." Items="openChargeIds" Text="ChargeText" EmptyText="– automatisch verrechnen –" />
            <AppCheckBox @bind-Value="payment.Payout" Label="Auszahlung an den Mieter (z. B. Guthaben überwiesen)" />
        </text>;
        await ShowFormAsync("Zahlung erfassen", payment, fields, () => Accounts.RecordPaymentAsync(Id, payment), "Die Zahlung wurde gebucht.", "Zahlung buchen");
    }

    private async Task ShowFormAsync(string title, object model, RenderFragment fields, Func<Task<Result>> save, string success, string submit = "Buchen")
    {
        if (await Dialogs.ShowFormAsync(title, model, fields, save, submit))
        {
            Notify.Success(success);
            await LoadAsync();
        }
    }

    /// <summary>Starts the dialog without waiting for it, so the menu closes at once instead of staying open behind the dialog.</summary>
    private void OpenChargeDialog() => _ = InvokeAsync(async () =>
    {
        await ChargeAsync();
        StateHasChanged(); // no event callback re-renders after this detached call
    });

    private async Task ChargeAsync()
    {
        charge = new();
        RenderFragment fields = @<text>
            <AppSelect @bind-Value="charge.Kind" Label="Art" Items="Enum.GetValues<ChargeType>().Where(a => a != ChargeType.Rent).ToList()" Text="@(v => Labels.From(v))" />
            <AppDateField @bind-Value="charge.Due" Label="Fällig am" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="charge.Amount" Label="Betrag" Suffix="€" Required="true" Hint="Immer positiv, eine Erstattung wird als Guthaben gebucht." />
            <AppTextField @bind-Value="charge.Name" Label="Bezeichnung" Hint="z. B. „Nachzahlung Betriebskosten 2025“" />
        </text>;
        await ShowFormAsync("Sonstige Forderung oder Gutschrift", charge, fields, () => Accounts.CreateChargeAsync(Id, charge), "Die Buchung wurde angelegt.");
    }

    private async Task HoldAsync()
    {
        hold = new();
        RenderFragment fields = @<text>
            <AppTextField @bind-Value="hold.Reason" Label="Grund" Required="true" />
            <AppDateField @bind-Value="hold.Until" Label="Bis (optional)" Hint="Leer = bis zur Aufhebung." />
        </text>;
        await ShowFormAsync("Mahnsperre setzen", hold, fields, () => Dunning.AddHoldAsync(Id, hold), "Die Mahnsperre wurde gesetzt.", "Mahnsperre setzen");
    }

    private async Task EndHoldAsync(DunningHoldRow row)
    {
        if (await Confirm.AskAsync("Mahnsperre aufheben", "Soll die Mahnsperre aufgehoben werden?", "Ja, aufheben"))
        {
            await ExecuteAsync(Dunning.EndHoldAsync(row.Id), "Die Mahnsperre wurde aufgehoben.");
        }
    }

    private async Task EditAsync(AccountEntry entry)
    {
        var open = account!.Entries.Where(b => b.Open > 0).Select(b => (b.Id, ChargeText(b.Id))).ToList();
        var dialog = await Dialogs.ShowAsync<AccountEntryDialog>(
            entry.EntryType == EntryType.Payment ? "Zahlung bearbeiten" : "Forderung bearbeiten",
            new DialogParameters { ["Entry"] = entry, ["OpenCharges"] = (IReadOnlyList<(Guid, string)>)open },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(AccountEntry entry)
    {
        if (!await Confirm.AskAsync("Buchung löschen", $"Soll die Buchung „{entry.Text}“ gelöscht werden?", "Ja, löschen"))
        {
            return;
        }

        await ExecuteAsync(entry.EntryType == EntryType.Payment ? Accounts.DeletePaymentAsync(entry.Id) : Accounts.DeleteChargeAsync(entry.Id), "Die Buchung wurde gelöscht.");
    }

    private async Task ExecuteAsync(Task<Result> command, string success, Action? reset = null)
    {
        var result = await command;
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            reset?.Invoke();
            Notify.Success(success);
            await LoadAsync();
        }
    }
}
