@page "/verwaltung/belege/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Application.Files
@using Elocaro.Application.Tickets
@inject IReceiptService Receipts
@inject ITicketWork TicketWork
@inject AuthenticationStateProvider Authentication
@inject IReceiptExtraction Extraction
@inject IFileStore Storage
@inject NavigationManager Navigation
@inject Notifier Notify
@inject Confirmations Confirm
@inject IDialogService Dialogs

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (receipt is null)
{
    <PageHeader Title="Beleg nicht gefunden" Back="/verwaltung/belege" BackText="Alle Belege" />
}
else
{

<PageHeader Title="@($"{receipt.Supplier} {Format.Money(receipt.Data.Gross)}")" Subtitle="@ReceiptSubtitle()" Back="/verwaltung/belege" BackText="Alle Belege">
    <Actions>
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Weitere Aktionen" Dense="true">
            <MudMenuItem OnClick="DeleteAsync">Beleg löschen</MudMenuItem>
        </MudMenu>
    </Actions>
</PageHeader>

<ErrorList Errors="errors" />

<div class="split">
    <div class="split-main">
        <MudTabs Elevation="0" Rounded="false" TabPanelsClass="mt-4" Class="detail-tabs" KeepPanelsAlive="true">
            <MudTabPanel Text="Angaben">
@if (selection is not null)
{
    <section>
        <h2>Angaben</h2>
        @if (Extraction.Info.Ready && receipt.Files.Count > 0)
        {
            <Notice Level="NoticeLevel.Info" id="extraction-notice">@Extraction.Info.Notice</Notice>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExtractAsync">Vorschlag aus Beleg auslesen</MudButton>
            <ExtractionPanel Info="Extraction.Info" Outcome="outcome" />
        }
        <EditForm Model="data" OnValidSubmit="SaveAsync" novalidate>
            <DataAnnotationsValidator />
            <ReceiptEditor Data="data" Options="selection" Uncertain="uncertain" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
        </EditForm>
    </section>
}
            </MudTabPanel>
            <MudTabPanel Text="@($"Kostenaufteilung{(receipt.Open != 0 ? " (offen)" : "")}")">
<section>
    <h2>Kostenaufteilung</h2>
    @if (receipt.Open != 0)
    {
        <Notice Level="NoticeLevel.Info">Noch @Format.Money(receipt.Open) nicht aufgeteilt (aufgeteilt @Format.Money(receipt.Allocated) von @Format.Money(receipt.Data.Gross)).</Notice>
    }
    @if (receipt.Items.Count > 0)
    {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Kostenart</th><th>Objekt</th><th>Zeitraum</th><th class="number">Betrag</th><th>§ 35a</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in receipt.Items)
                        {
                            <tr>
                                <td>@p.CostTypeText@(p.Subtype is { } sub ? $" – {sub}" : "")@(p.HeatingKind is { } kind ? $" ({Labels.From(kind)})" : "") @if (!p.Allocable) {<StatusChip>nicht umlagefähig</StatusChip>}</td>
                                <td>@p.Property@(p.Unit is null ? "" : $", {p.Unit}")</td>
                                <td>@Format.Period(p.BillingPeriod)</td>
                                <td class="number">@Format.Money(p.Amount)</td>
                                <td>@(p.Section35a == Section35a.None ? "–" : $"{Labels.From(p.Section35a)}: {Format.Money(p.LaborCosts)}")</td>
                                <td>
                                    <MudButton Variant="Variant.Text" OnClick="() => EditCostItemAsync(p)" aria-label="@($"Position {p.CostTypeText} bearbeiten")">Bearbeiten</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveCostItemAsync(p)" aria-label="@($"Position {p.CostTypeText} entfernen")">Entfernen</MudButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th colspan="3">Summe</th><th class="number">@Format.Money(receipt.Allocated)</th><th colspan="2"></th></tr></tfoot>
                </table>
            </div>
    }
    @if (receipt.Open != 0 && selection is not null)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddItemAsync">Position hinzufügen</MudButton>
    }
</section>
            </MudTabPanel>
            @if (tickets.Count > 0)
            {
                <MudTabPanel Text="Auftrag">
                    @foreach (var ticket in tickets)
                    {
                        <section>
                            <h2><a href="/verwaltung/tickets/@ticket.Id">@ticket.Title</a> <span class="small">· @Labels.From(ticket.Status)</span></h2>
                            @if (ticket.Work.Count == 0)
                            {
                                <EmptyState Text="Auf dem Auftrag ist noch keine Arbeit eingetragen." />
                            }
                            else
                            {
                                <p>Gemeldete Arbeitszeit: <strong>@Format.Hours(ticket.Minutes)</strong></p>
                                <div class="table-wrapper">
                                    <table class="data-table">
                                        <thead><tr><th>Datum</th><th>Dauer</th><th>Material</th><th>Bemerkung</th><th>Von</th></tr></thead>
                                        <tbody>
                                            @foreach (var row in ticket.Work)
                                            {
                                                <tr><td>@Format.Date(row.WorkedOn)</td><td>@Format.Hours(row.Minutes)</td><td>@row.Material</td><td>@row.Note</td><td>@row.Author</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </section>
                    }
                </MudTabPanel>
            }
            <MudTabPanel Text="Verlauf">
<ChangeHistory EntityType="@nameof(Receipt)" EntityId="Id" />
            </MudTabPanel>
        </MudTabs>
    </div>
    <aside class="split-side" aria-label="Belegdateien">
<section>
    <h2>Dateien</h2>
    @if (receipt.Files.Count == 0)
    {
        <EmptyState Compact="true" Text="Noch keine Datei." />
    }
    else
    {
            <ul>
                @foreach (var d in receipt.Files)
                {
                    <li>
                        Seite @d.Page: <a href="/dateien/@d.FileId" target="_blank" rel="noopener">@d.Name</a>
                        (<a href="/dateien/@d.FileId?download=true">herunterladen</a>)
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveFileAsync(d)" aria-label="@($"Seite {d.Page} entfernen")">Entfernen</MudButton>
                    </li>
                }
            </ul>
        var first = receipt.Files[0];
        @if (first.MimeType.StartsWith("image/", StringComparison.Ordinal))
        {
            <img class="document-preview" src="/dateien/@first.FileId" alt="Seite 1" />
        }
        else if (first.MimeType == "application/pdf")
        {
            <iframe class="document-preview" src="/dateien/@first.FileId" title="Seite 1"></iframe>
        }
    }
    <div class="form-row">
        <AppFileUpload Multiple="true" Text="Seiten hinzufügen" Accept="application/pdf,image/*" OnSelectedMany="UploadAsync" />
    </div>
</section>
    </aside>
</div>
}
</InteractiveShell>

@code {
    // The property the receipt is booked to belongs in the header: it is the first thing one wants to know about a receipt.
    private string ReceiptSubtitle()
    {
        var properties = receipt!.Items.Select(i => i.Property).Distinct().ToList();
        var invoice = $"Rechnung {receipt.Data.InvoiceNumber} vom {Format.Date(receipt.Data.InvoiceDate)}";
        return properties.Count == 0 ? invoice : $"{string.Join(", ", properties)} · {invoice}";
    }

    private ReceiptDetails? receipt;
    private ReceiptOptions? selection;
    private ReceiptInput data = new();
    private CostItemInput position = new();
    private IReadOnlyList<string>? errors;
    private ExtractionOutcome? outcome;
    private IReadOnlySet<string>? uncertain;
    private bool loaded;
    private IReadOnlyList<ReceiptTicket> tickets = [];

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        selection = await Receipts.OptionsAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        receipt = await Receipts.GetAsync(Id);
        tickets = await TicketWork.ForReceiptAsync((await Authentication.GetAuthenticationStateAsync()).User, Id);
        if (receipt is not null)
        {
            data = receipt.Data;
        }

        loaded = true;
    }

    /// <summary>Reads a suggestion from the existing pages and pre-fills the form (not saved until the user confirms).</summary>
    private async Task ExtractAsync()
    {
        if (receipt is null)
        {
            return;
        }

        outcome = await Extraction.SuggestAsync(receipt.Files.Select(d => d.FileId).ToList());
        if (outcome.Suggestion is { } suggestion)
        {
            data = SuggestionMapping.Apply(SuggestionMapping.Copy(receipt.Data), suggestion, outcome.SupplierId);
            uncertain = suggestion.UncertainFields();
            errors = null;
        }
        else
        {
            errors = [outcome.Error ?? "Die Belegauslesung hat kein Ergebnis geliefert."];
        }
    }

    private Task SaveAsync() => ExecuteAsync(Receipts.UpdateAsync(Id, data), "Die Angaben wurden gespeichert.");

    private async Task AddItemAsync()
    {
        position = new();
        RenderFragment fields = @<CostItemEditor Position="position" Options="selection!" />;
        if (await Dialogs.ShowFormAsync("Position hinzufügen", position, fields, () => Receipts.AddItemAsync(Id, position), "Position hinzufügen"))
        {
            Notify.Success("Die Position wurde hinzugefügt.");
            await LoadAsync();
        }
    }

    private async Task EditCostItemAsync(CostItemView item)
    {
        var dialog = await Dialogs.ShowAsync<CostItemDialog>(
            "Position bearbeiten",
            new DialogParameters { ["ReceiptId"] = Id, ["Item"] = item, ["Options"] = selection },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task RemoveCostItemAsync(CostItemView item)
    {
        if (await Confirm.AskAsync("Position entfernen", $"Soll die Position „{item.CostTypeText}“ entfernt werden?", "Ja, entfernen"))
        {
            await ExecuteAsync(Receipts.RemoveCostItemAsync(Id, item.Id), "Die Position wurde entfernt.");
        }
    }

    private async Task RemoveFileAsync(ReceiptFileView file)
    {
        if (await Confirm.AskAsync("Seite entfernen", $"Soll Seite {file.Page} entfernt werden?", "Ja, entfernen"))
        {
            await ExecuteAsync(Receipts.RemoveFileAsync(Id, file.FileId), "Die Seite wurde entfernt.");
        }
    }

    private async Task DeleteAsync()
    {
        if (!await Confirm.AskAsync("Beleg löschen", "Der Beleg wird logisch gelöscht; die Dateien bleiben im Archiv.", "Ja, löschen"))
        {
            return;
        }

        var result = await Receipts.DeleteAsync(Id);
        if (result.Succeeded)
        {
            Navigation.NavigateTo("/verwaltung/belege?meldung=geloescht");
        }
        else
        {
            errors = result.Errors;
        }
    }

    private async Task UploadAsync(IReadOnlyList<FileSelection> files)
    {
        try
        {
            var ids = new List<Guid>();
            foreach (var file in files.Where(d => d.Length > 0))
            {
                await using var content = file.Open();
                ids.Add((await Storage.SaveAsync(content, file.Name)).Id);
            }

            await ExecuteAsync(Receipts.AddFilesAsync(Id, ids), ids.Count == 1 ? "Die Seite wurde hinzugefügt." : $"{ids.Count} Seiten wurden hinzugefügt.");
        }
        catch (FileRejectedException ex)
        {
            errors = [ex.Message];
        }
    }

    private async Task ExecuteAsync(Task<Result> command, string success, Action? reset = null)
    {
        var result = await command;
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            reset?.Invoke();
            Notify.Success(success);
            await LoadAsync();
        }
    }
}
