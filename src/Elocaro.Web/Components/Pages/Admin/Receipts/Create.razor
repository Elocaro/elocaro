@page "/verwaltung/belege/neu"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Application.Files
@inject IReceiptService Receipts
@inject IReceiptExtraction Extraction
@inject IFileStore Storage
@inject NavigationManager Navigation
@inject Confirmations Confirm

<InteractiveShell>
    <PageHeader Title="Beleg erfassen" Subtitle="Rechnung oder Kostenbeleg mit Datei erfassen und gleich der Kostenart und dem Objekt zuordnen; so fließt der Betrag in Abrechnung und Steuer ein." Back="/verwaltung/belege" BackText="Alle Belege" />

    <ErrorList Errors="errors" />

    @if (selection is not null)
    {
        <div class="form-row">
            <AppFileUpload Multiple="true" Text="@(selected.Count == 0 ? "Rechnung (PDF oder Fotos)" : "Seiten ändern")" Accept="application/pdf,image/*" OnSelectedMany="OnFilesSelected" />
        </div>
        <p class="small">Mehrere Seiten auf einmal möglich; auf dem Handy öffnet sich die Kamera zur Auswahl.</p>

        <section>
            <h2>Beleg automatisch auslesen</h2>
            <p class="small" id="einvoice-hint">E-Rechnungen (ZUGFeRD-/Factur-X-PDF) werden direkt aus ihren eingebetteten Daten gelesen: genau, ohne KI, und nichts verlässt den Server.</p>
            @if (Extraction.Info.Enabled)
            {
                <Notice Level="NoticeLevel.Info" id="extraction-notice">@Extraction.Info.Notice</Notice>
                @if (!Extraction.Info.Ready)
                {
                    <p class="small" id="extraction-problem">@Extraction.Info.Problem</p>
                }
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExtractAsync" Disabled="@(selected.Count == 0)">Vorschlag aus Beleg auslesen</MudButton>
        </section>
        <ExtractionPanel Info="Extraction.Info" Outcome="outcome" />

        <EditForm EditContext="editContext" OnValidSubmit="SaveAsync" novalidate>
            <DataAnnotationsValidator />
            <h2>1 · Rechnung</h2>
            <ReceiptEditor Data="data" Options="selection" Uncertain="uncertain" CostTypes="positions.Select(p => p.CostType)" />
            <h2>2 · Zuordnung zu Kostenart und Objekt</h2>
            <p class="small">Hier entscheidet sich, in welche Abrechnung der Betrag fließt. Ohne Kostenart und Objekt fehlt der Beleg in der Nebenkostenabrechnung und in der Anlage V.</p>
            <AllocationEditor Rows="positions" Options="selection" Gross="data.Gross" Uncertain="uncertain" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
            <MudButton Variant="Variant.Text" Href="/verwaltung/belege">Abbrechen</MudButton>
        </EditForm>
    }
</InteractiveShell>

@code {
    private ReceiptOptions? selection;
    private IReadOnlyList<string>? errors;
    private ExtractionOutcome? outcome;
    private IReadOnlySet<string>? uncertain;
    private ReceiptInput data = new();
    private EditContext editContext = default!;
    private List<CostItemInput> positions = [new()];
    private IReadOnlyList<FileSelection> selected = [];
    private List<Guid> storedIds = [];

    protected override async Task OnInitializedAsync()
    {
        selection = await Receipts.OptionsAsync();
        positions = [NewPosition()];
        UseData(new ReceiptInput());
    }

    // The parts of the form depend on each other (amount, cost types, special fields): every change redraws the whole page.
    private void UseData(ReceiptInput input)
    {
        data = input;
        editContext = new EditContext(data);
        editContext.OnFieldChanged += (_, _) => StateHasChanged();
    }

    /// <summary>An empty item; with only one property that property is already chosen.</summary>
    private CostItemInput NewPosition() => new() { PropertyId = selection!.Properties.Count == 1 ? selection.Properties[0].Id : null };

    private void OnFilesSelected(IReadOnlyList<FileSelection> files)
    {
        selected = files;
        storedIds = []; // a new selection replaces files stored for an earlier attempt
    }

    /// <summary>Stores the chosen files once (an extraction and the save share them).</summary>
    private async Task<bool> StoreAsync()
    {
        if (storedIds.Count > 0 || selected.Count == 0)
        {
            return true;
        }

        try
        {
            foreach (var file in selected.Where(f => f.Length > 0))
            {
                await using var content = file.Open();
                storedIds.Add((await Storage.SaveAsync(content, file.Name)).Id);
            }

            return true;
        }
        catch (FileRejectedException ex)
        {
            errors = [ex.Message];
            storedIds = [];
            return false;
        }
    }

    private async Task ExtractAsync()
    {
        errors = null;
        if (!await StoreAsync())
        {
            return;
        }

        outcome = await Extraction.SuggestAsync(storedIds);
        if (outcome.Suggestion is { } suggestion)
        {
            UseData(SuggestionMapping.Apply(new ReceiptInput(), suggestion, outcome.SupplierId));
            positions = [SuggestionMapping.ToPosition(suggestion, selection!)];
            uncertain = suggestion.UncertainFields();
        }
        else
        {
            errors = [outcome.Error ?? "Die Belegauslesung hat kein Ergebnis geliefert."];
        }
    }

    private async Task SaveAsync()
    {
        errors = null;
        var items = AllocationEditor.Filled(positions);
        var problems = new List<string>();
        if (items.Any(p => p.PropertyId is null))
        {
            problems.Add("Bitte bei jeder Position das Objekt wählen.");
        }

        if (items.Count(p => p.Amount is null) > 1)
        {
            problems.Add("Bei mehreren Positionen darf nur eine ohne Betrag bleiben (sie erhält den Rest).");
        }

        if (problems.Count > 0)
        {
            errors = problems;
            return;
        }

        var open = AllocationEditor.Open(items, data.Gross ?? 0m);
        if (data.Gross is not null && open != 0m && !await Confirm.AskAsync(
                "Beleg nicht vollständig verteilt",
                $"{(items.Count == 0 ? "Der Beleg hat noch keine Kostenart und kein Objekt" : $"Es sind noch {Format.Money(open)} nicht verteilt")}. Der Betrag fehlt dann in Nebenkostenabrechnung und Anlage V. Der Beleg erscheint als Aufgabe auf der Startseite und in der Liste unter „nicht aufgeteilt“.",
                "Trotzdem speichern"))
        {
            return;
        }

        if (!await StoreAsync())
        {
            return;
        }

        var result = await Receipts.CreateWithItemsAsync(data, storedIds, items);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"/verwaltung/belege/{result.Id}?meldung=gespeichert");
        }
        else
        {
            errors = result.Errors;
        }
    }
}
