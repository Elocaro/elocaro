@using Elocaro.Application.Portfolio
@using Elocaro.Domain.Portfolio
@using Microsoft.AspNetCore.Components.Authorization
@inject IPropertyKeyFigures KeyFigures
@inject TimeProvider Clock
@* Key figures of the property for one year, calculated from the books (Anlage V, loans, acquisition, leases), with the way they are calculated. *@
<section id="key-figures" aria-label="Kennzahlen">
    <div class="form-grid">
        <AppSelect T="int" Value="year" ValueChanged="YearChangedAsync" Label="Jahr" Items="years" />
    </div>
    @if (figures is null)
    {
        <p class="loading" role="status">Wird geladen …</p>
    }
    else
    {
        <div class="kpi-row">
            <KpiTile Label="Nettomietrendite" Value="@(figures.NetYield is { } yield ? Percent(yield) : "–")" Note="@(figures.NetYield is null ? "Kaufpreis unter Steuer → Anschaffung erfassen" : null)" />
            <KpiTile Label="Cashflow" Value="@Format.Money(figures.Cashflow)" Level="@(figures.Cashflow < 0m ? NoticeLevel.Warning : null)" />
            <KpiTile Label="Leerstand" Value="@(figures.VacancyPercent is { } vacancy ? Percent(vacancy) : "–")" />
            <KpiTile Label="Rückstände" Value="@(figures.ArrearsPercent is { } arrears ? Percent(arrears) : "–")" />
        </div>
        @if (series.Count >= 2)
        {
            <section id="key-figures-history" aria-label="Verlauf der Kennzahlen">
                <div class="form-grid">
                    <AppSelect T="Metric" @bind-Value="metric" Label="Kennzahl im Diagramm" Items="Enum.GetValues<Metric>()" Text="MetricLabel" />
                </div>
                @if (ChartPoints is { Count: >= 2 } points)
                {
                    <LineChart id="history-chart" Caption="@(MetricLabel(metric) + " je Jahr")" LabelHeading="Jahr" ValueHeading="@MetricLabel(metric)" Points="points" FormatValue="@(metric == Metric.Cashflow ? null : Percent)" />
                }
                else
                {
                    <p class="small">Für diese Kennzahl gibt es in weniger als zwei Jahren einen Wert.</p>
                }
                <div class="table-wrapper">
                    <table class="data-table" id="history-table" data-nostack>
                        <caption class="small">Alle Kennzahlen im Verlauf</caption>
                        <thead><tr><th>Jahr</th><th class="number">Nettomietrendite</th><th class="number">Cashflow</th><th class="number">Leerstand</th><th class="number">Rückstände</th></tr></thead>
                        <tbody>
                            @foreach (var row in series)
                            {
                                <tr>
                                    <td>@row.Year</td>
                                    <td class="number">@(row.NetYield is { } y ? Percent(y) : "–")</td>
                                    <td class="number">@Format.Money(row.Cashflow)</td>
                                    <td class="number">@(row.VacancyPercent is { } v ? Percent(v) : "–")</td>
                                    <td class="number">@(row.ArrearsPercent is { } a ? Percent(a) : "–")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        else
        {
            <p><button type="button" class="button" @onclick="ShowHistoryAsync" disabled="@loadingHistory">Verlauf der Kennzahlen anzeigen</button></p>
        }
        <p class="small"><a class="button" href="@($"/verwaltung/objekte/{PropertyId}/kennzahlen.csv")">CSV exportieren</a></p>
        <details class="explain">
            <summary>So werden die Kennzahlen berechnet</summary>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Größe</th><th class="number">Wert</th><th>Rechenweg</th></tr></thead>
                    <tbody>
                        @foreach (var step in figures.Steps)
                        {
                            <tr><td>@step.Label</td><td class="number">@(step.Label.EndsWith("(%)", StringComparison.Ordinal) ? Percent(step.Amount) : Format.Money(step.Amount))</td><td>@step.Formula</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="small">
                Einnahmen und Kosten stammen aus der Anlage V desselben Jahres (Zuflussprinzip), Zinsen und Tilgung aus den Darlehen des Objekts.
                Umlagefähige Kosten (Betriebskosten, Grundsteuer, Versicherung) zählen nicht zur Nettomiete. Erhaltungsaufwand steht wie in der Anlage V im Jahr der Verteilung.
            </p>
        </details>
        @* Only now: both read through the same context of the request, so they must not load at the same time. *@
        <RentPotentialSection PropertyId="PropertyId" />
    }
</section>

@code {
    private enum Metric
    {
        Cashflow,
        NetYield,
        Vacancy,
        Arrears,
    }

    private List<PropertyKeyFigures> series = [];
    private Metric metric;
    private bool loadingHistory;
    private PropertyKeyFigures? figures;
    private int year;
    private IReadOnlyList<int> years = [];

    [Parameter, EditorRequired]
    public Guid PropertyId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> Authentication { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var thisYear = Clock.GetLocalNow().Year;
        years = [.. Enumerable.Range(thisYear - 4, 5).Reverse()];
        year = thisYear - 1;
        await LoadAsync();
    }

    private async Task YearChangedAsync(int value)
    {
        year = value;
        await LoadAsync();
    }

    private async Task LoadAsync() => figures = await KeyFigures.GetAsync((await Authentication).User, PropertyId, year);

    /// <summary>On request only: the years are calculated one after the other and share the context of the circuit with the rest of the page.</summary>
    private async Task ShowHistoryAsync()
    {
        loadingHistory = true;
        try
        {
            var user = (await Authentication).User;
            var rows = new List<PropertyKeyFigures>();
            foreach (var y in years.Reverse())
            {
                if (await KeyFigures.GetAsync(user, PropertyId, y) is { } row)
                {
                    rows.Add(row);
                }
            }

            series = rows;
        }
        finally
        {
            loadingHistory = false;
        }
    }

    private static string MetricLabel(Metric value) => value switch
    {
        Metric.Cashflow => "Cashflow",
        Metric.NetYield => "Nettomietrendite",
        Metric.Vacancy => "Leerstandsquote",
        _ => "Rückstandsquote",
    };

    private List<ChartPoint>? ChartPoints => [.. series.Select(r => (r.Year, Value: metric switch
    {
        Metric.Cashflow => r.Cashflow,
        Metric.NetYield => r.NetYield,
        Metric.Vacancy => r.VacancyPercent,
        _ => r.ArrearsPercent,
    })).Where(x => x.Value is not null).Select(x => new ChartPoint(x.Year.ToString(System.Globalization.CultureInfo.InvariantCulture), x.Value!.Value))];

    private static string Percent(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("de-DE")) + " %";
}
