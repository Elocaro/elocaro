@page "/verwaltung/system/neuigkeiten"
@using Elocaro.Application.Operations
@using Elocaro.Web.Display
@using Elocaro.Web.Operations
@inject IUpdateInfo Updates

<PageTitle>Neuigkeiten – Elocaro</PageTitle>
<PageHeader Title="Neuigkeiten" Subtitle="Welche Version läuft, ob eine neuere da ist und was sich geändert hat." />

@if (info is null)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else
{
    <section class="news-hero @HeroClass" aria-labelledby="news-heading">
        <div class="news-version">
            <span class="news-version-label">Installierte Version</span>
            <strong id="news-current">@(info.CurrentVersion ?? "Entwicklung")</strong>
        </div>
        <div class="news-status" id="news-status">
            <h2 id="news-heading">@HeroTitle</h2>
            @if (!info.Enabled)
            {
                <p>Die Prüfung auf neue Versionen ist abgeschaltet (<code>UpdateCheck__Enabled=false</code>). Neue Versionen und ihre Änderungen stehen unter <a href="@ReleasesUrl" rel="noopener">GitHub Releases</a>.</p>
            }
            else if (info.CurrentVersion is null)
            {
                <p>Dies ist ein Entwicklungsstand ohne Versionsnummer, ein Vergleich mit den Veröffentlichungen ist nicht möglich.</p>
            }
            else if (info.UpdateAvailable)
            {
                <p>Elocaro aktualisiert sich nicht selbst. Auf dem Server, im Ordner der Installation:</p>
                <div class="news-command">
                    <pre id="news-command"><code>@UpdateInfo.UpdateCommand(info.Latest!.Version)</code></pre>
                    <button type="button" class="button secondary" data-copy="#news-command">Kopieren</button>
                </div>
                <p class="small">Das Skript sichert vorher die Daten und merkt sich die bisherige Version. Einzelheiten: <a href="@UpdateDocs" rel="noopener">Dokumentation Update</a>.</p>
            }
            else if (info.CheckedAt is null)
            {
                <p>@(info.Failed ? "Die Prüfung ist fehlgeschlagen (GitHub nicht erreichbar?). Sie wird automatisch wiederholt." : "Die erste Prüfung steht noch aus.")</p>
            }
            else if (info.Failed)
            {
                <p>Die letzte Prüfung ist fehlgeschlagen, der Stand ist von @Format.Timestamp(info.CheckedAt).</p>
            }
            @if (info.CheckedAt is { } checkedAt && info.Failed is false)
            {
                <p class="small">Zuletzt geprüft: @Format.Timestamp(checkedAt)</p>
            }
            @if (info.Enabled && info.CurrentVersion is not null)
            {
                <form method="post" action="@UpdateCheckEndpoint.Path" data-enhance="false" id="news-check-form">
                    <AntiforgeryToken />
                    <button type="submit" class="button button-outlined" id="news-check">Jetzt prüfen</button>
                </form>
            }
        </div>
    </section>

    @if (info.Releases.Count > 0)
    {
        <h2 class="news-list-title">Versionen und Änderungen</h2>
        <div class="release-list">
            @foreach (var release in info.Releases)
            {
                @ReleaseView(release)
            }
        </div>
    }
}

@code {
    private const string ReleasesUrl = "https://github.com/elocaro/elocaro/releases";
    private const string UpdateDocs = "https://github.com/elocaro/elocaro/blob/HEAD/docs/betrieb.md#update";

    private UpdateInfo? info;

    protected override async Task OnInitializedAsync() => info = await Updates.GetAsync();

    private string HeroClass => info switch
    {
        { Enabled: true, CurrentVersion: not null, UpdateAvailable: true } => "is-update",
        { Enabled: true, CurrentVersion: not null, CheckedAt: not null } => "is-current",
        { Failed: true } => "is-update",
        _ => "",
    };

    private string HeroTitle => info switch
    {
        { Enabled: true, CurrentVersion: not null, UpdateAvailable: true } => $"Version {info.Latest!.Version} ist verfügbar",
        { Enabled: true, CurrentVersion: not null, CheckedAt: not null } => "Elocaro ist auf dem neuesten Stand",
        _ => "Prüfung auf neue Versionen",
    };

    private RenderFragment ReleaseView(ReleaseNotes release) => @<article class="release" data-version="@release.Version">
        <header>
            <h3>Version @release.Version</h3>
            @if (info!.CurrentVersion is not null && ReleaseVersion.Compare(release.Version, info.CurrentVersion) == 0)
            {
                <span class="release-badge is-installed">Installiert</span>
            }
            else if (info.UpdateAvailable && info.Newer.Contains(release))
            {
                <span class="release-badge is-new">Neu</span>
            }
            @if (release.Date is { } date)
            {
                <span class="release-date">@Format.Date(date)</span>
            }
            <a class="release-link" href="@release.Url" rel="noopener">Auf GitHub</a>
        </header>
        @if (string.IsNullOrWhiteSpace(release.Body))
        {
            <p class="small">Zu dieser Version gibt es keine Beschreibung.</p>
        }
        else
        {
            <div class="release-body">@ReleaseMarkdown.ToMarkup(release.Body)</div>
        }
    </article>;
}
