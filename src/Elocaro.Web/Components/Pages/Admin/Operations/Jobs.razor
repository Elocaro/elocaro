@page "/verwaltung/system/jobs"
@using Elocaro.Application.Operations
@inject IJobOverview JobOverview

<PageHeader Title="Hintergrundjobs" Subtitle="Geplante Aufgaben, die Elocaro regelmäßig selbst erledigt." />

@if (jobs is null)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (jobs.Count == 0)
{
    <EmptyState Text="Der Scheduler ist deaktiviert oder es sind keine Jobs geplant." />
}
else
{
    <div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr><th>Job</th><th>Beschreibung</th><th>Nächste Ausführung</th><th>Letzter Lauf</th><th>Ergebnis</th></tr>
        </thead>
        <tbody>
            @foreach (var job in jobs)
            {
                <tr>
                    <td><code>@job.Name</code></td>
                    <td>@job.Description</td>
                    <td>@Format.Timestamp(job.NextRun)</td>
                    <td>@Format.Timestamp(job.LastRunAt)</td>
                    <td>
                        @switch (job.LastRunSucceeded)
                        {
                            case true: <StatusChip Level="StatusLevel.Success">erfolgreich</StatusChip> break;
                            case false: <StatusChip Level="StatusLevel.Error" title="@job.LastError">fehlgeschlagen</StatusChip> break;
                            default: <StatusChip>–</StatusChip> break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private IReadOnlyList<JobStatus>? jobs;

    protected override async Task OnInitializedAsync() => jobs = await JobOverview.GetAsync();
}
