        }
    }

    /// <summary>
    /// Reads the backups of every target, one after the other; the list grows as each target answers. Runs in a scope of its own (the page
    /// keeps using its database context meanwhile). Never while the backup service works on a repository (a backup or restore holds it):
    /// the list follows when the run is over. A request that comes in while the list is being read repeats it afterwards.
    /// </summary>
    private async Task LoadSnapshotsAsync()
    {
        if (snapshotsLoading)
        {
            snapshotsDirty = true;
            return;
        }

        if (progress.Running || !progress.Available)
        {
            return;
        }

        snapshotsLoading = true;
        try
        {
            do
            {
                snapshotsDirty = false;
                var wanted = (environment is not null ? new[] { (Id: (Guid?)null, Name: "Server-Konfiguration") } : [])
                    .Concat(targets.Select(t => (Id: (Guid?)t.Id, t.Name))).ToList();
                var entries = new List<SnapshotEntry>();
                var failures = new Dictionary<string, string>();
                await using var scope = Scopes.CreateAsyncScope();
                var control = scope.ServiceProvider.GetRequiredService<IBackupControl>();
                foreach (var (id, name) in wanted)
                {
                    try
                    {
                        var rows = id is { } targetId ? await control.SnapshotsAsync(targetId) : await control.EnvironmentSnapshotsAsync();
                        entries.AddRange(rows.Select(row => new SnapshotEntry(id, name, row)));
                    }
                    catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
                    {
                        failures[name] = ex.Message;
                    }

                    snapshots = entries.OrderByDescending(e => e.Row.Time).ToList();
                    snapshotErrors = new Dictionary<string, string>(failures);
                    await InvokeAsync(StateHasChanged);
                }

                snapshotsLoaded = true;
            }
            while (snapshotsDirty && !progress.Running);
        }
        finally
        {
            snapshotsLoading = false;
            snapshotsLoaded = true;
            if (selected is not null && !snapshots.Any(e => e.TargetId == selected.TargetId && e.Row.Id == selected.Row.Id))
            {
                selected = null;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private static string ExportKey(BackupFileInfo file) => file.Name + "|" + file.Created.ToString("O", CultureInfo.InvariantCulture);

    private async Task ReloadSnapshotsAsync()
    {
        busy = true;
        try
        {
            await LoadSnapshotsAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void CloseSnapshots() => selected = null;

    private void Select(SnapshotEntry entry)
    {
        selected = entry;
        confirmation = string.Empty;
    }

    private async Task ExportAsync(SnapshotEntry entry)
    {
        listErrors = null;
        busy = true;
        try
        {
            var result = entry.TargetId is { } targetId
                ? await Control.StartExportAsync(targetId, entry.Row.Id)
                : await Control.StartEnvironmentExportAsync(entry.Row.Id);
            if (!result.Succeeded)
            {
                listErrors = result.Errors;
                return;
            }

            awaitingDownload = true;
            await RefreshAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DiscardExportAsync()
    {
        await Control.DiscardExportAsync();
        await RefreshAsync();
    }

    private async Task InspectUploadAsync()
    {
        busy = true;
        try
        {
            uploadConfirmation = string.Empty;
            uploadCheck = await Control.InspectUploadAsync(uploadPassword);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DiscardUploadAsync()
    {
        await Control.DiscardUploadAsync();
        uploadPassword = string.Empty;
        uploadCheck = null;
        await RefreshAsync();
    }

    private async Task RestoreUploadAsync()
    {
        if (!string.Equals(uploadConfirmation.Trim(), "WIEDERHERSTELLEN", StringComparison.Ordinal))
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Control.StartRestoreUploadAsync(uploadPassword);
            if (!result.Succeeded)
            {
                listErrors = result.Errors;
                return;
            }

            uploadPassword = string.Empty;
            uploadCheck = null;
            // Started here: a restore that finishes between two polls (small installations) must still restart the app.
            sawRestore = true;
            await RefreshAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteSnapshotAsync(SnapshotEntry entry)
    {
        var only = snapshots.Count(s => s.TargetId == entry.TargetId) == 1;
        var text = $"Soll die Sicherung vom {Format.Timestamp(entry.Row.Time)} aus „{entry.TargetName}“ endgültig gelöscht werden? Das lässt sich nicht rückgängig machen."
            + (only ? " Es ist die einzige Sicherung an diesem Ziel: danach gibt es dort keine mehr." : "");
        if (!await Confirm.AskAsync("Sicherung löschen", text, "Ja, löschen"))
        {
            return;
        }

        listErrors = null;
        busy = true;
        try
        {
            var result = entry.TargetId is { } targetId
                ? await Control.StartDeleteSnapshotAsync(targetId, entry.Row.Id)
                : await Control.StartEnvironmentDeleteSnapshotAsync(entry.Row.Id);
            if (!result.Succeeded)
            {
                listErrors = result.Errors;
                return;
            }

            Notify.Success("Die Sicherung wird gelöscht.");
            await RefreshAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RestoreAsync()
    {
        if (selected is null || !string.Equals(confirmation.Trim(), "WIEDERHERSTELLEN", StringComparison.Ordinal))
        {
            return;
        }

        busy = true;
        try
        {
            var result = selected.TargetId is { } targetId
                ? await Control.StartRestoreAsync(targetId, selected.Row.Id)
                : await Control.StartEnvironmentRestoreAsync(selected.Row.Id);
            if (!result.Succeeded)
            {
                listErrors = result.Errors;
                return;
            }

            CloseSnapshots();
            // Started here: a restore that finishes between two polls (small installations) must still restart the app.
            sawRestore = true;
            await RefreshAsync();
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose() => polling?.Cancel();

    private static NoticeLevel Level(BackupState level) => level switch
    {
        BackupState.Ok => NoticeLevel.Success,
        BackupState.NotConfigured => NoticeLevel.Info,
        _ => NoticeLevel.Error,
    };
