@page "/verwaltung/system/datensicherung"
@rendermode InteractiveServer
@implements IDisposable
@using System.Data.Common
@using System.Globalization
@using MudBlazor
@using Elocaro.Application.Operations
@using Elocaro.Domain.Operations
@using Elocaro.Web.Operations
@inject IBackupStatus BackupStatus
@inject IBackupSettings Settings
@inject IBackupControl Control
@inject Notifier Notify
@inject IDialogService Dialogs
@inject Confirmations Confirm
@inject NavigationManager Navigation
@inject IServiceScopeFactory Scopes
@inject IAppRestart Restart

<InteractiveShell>
    <PageHeader Title="Datensicherung" Subtitle="Wohin und wann gesichert wird, Wiederherstellung und Vollexport aller Daten.">
        <Actions>
            <button type="button" class="button button-primary" id="backup-add" @onclick="NewTargetAsync">Ziel hinzufügen</button>
        </Actions>
    </PageHeader>

    <section>
        <h2>@(targets.Count == 0 && environment is null && !progress.Available ? "Letzte Sicherung" : "Sicherungsziele")</h2>
        @if (targets.Count == 0 && environment is null && progress.Available)
        {
            <div class="empty-setup" id="backup-empty">
                <Icon Path="@MudBlazor.Icons.Material.Outlined.CloudUpload" />
                <div>
                    <strong>Noch keine Sicherung eingerichtet</strong>
                    <p>Richten Sie ein Ziel ein, damit Elocaro Ihre Daten regelmäßig sichert, z. B. in Google Drive oder auf einem NAS. Es sind mehrere Ziele möglich.</p>
                </div>
                <button type="button" class="button button-primary" id="backup-empty-add" @onclick="NewTargetAsync">Ziel hinzufügen</button>
            </div>
        }
        else if (state is not null && environment is null)
        {
            <Notice Level="Level(state.State)">@state.Description</Notice>
            @if (targets.Count == 0)
            {
                @if (state.Timestamp is not null)
                {
                    <dl class="details">
                        <dt>Zeitpunkt</dt>
                        <dd>@Format.Timestamp(state.Timestamp)</dd>
                        <dt>Ergebnis</dt>
                        <dd>
                            @if (state.State == BackupState.Failed)
                            {
                                <StatusChip Level="StatusLevel.Error">fehlgeschlagen</StatusChip>
                            }
                            else
                            {
                                <StatusChip Level="StatusLevel.Success">erfolgreich</StatusChip>
                            }
                        </dd>
                        @if (state.Snapshot is not null)
                        {
                            <dt>Snapshot</dt>
                            <dd><code>@state.Snapshot[..Math.Min(8, state.Snapshot.Length)]</code></dd>
                        }
                        @if (state.DurationSeconds is not null)
                        {
                            <dt>Dauer</dt>
                            <dd>@state.DurationSeconds s</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(state.Message))
                        {
                            <dt>Meldung</dt>
                            <dd>@state.Message</dd>
                        }
                    </dl>
                }

                @if (state.State == BackupState.NotConfigured)
                {
                    <p>Der Backup-Container aus <code>deploy/docker-compose.yml</code> meldet hier sein Ergebnis, sobald
                    <code>Backup__StatusFile</code> gesetzt ist. Einrichtung: <a href="@AppInfo.Docs("betrieb.md", "backup")" target="_blank" rel="noopener noreferrer">Betriebsanleitung (Backup)</a>.</p>
                }
                else if (state.NeedsAttention)
                {
                    <p>Logs prüfen und eine Sicherung von Hand anstoßen:</p>
                    <pre><code>docker compose -f deploy/docker-compose.yml --env-file deploy/.env logs backup
docker compose -f deploy/docker-compose.yml --env-file deploy/.env run --rm backup backup</code></pre>
                    <p>Solange das Problem besteht, erhalten Administratoren täglich um 8 Uhr eine Warnung per E-Mail.</p>
                }
            }
        }

        @if (!progress.Available)
        {
            <Notice Level="NoticeLevel.Warning" id="backup-unavailable">Der Backup-Dienst ist von hier aus nicht erreichbar. Ziele lassen sich erst einrichten und sichern,
            wenn der Container „backup“ läuft und <code>BACKUP_API_TOKEN</code> in <code>deploy/.env</code> gesetzt ist.</Notice>
        }
        else if (targets.Count == 0 && environment is not null)
        {
            <Notice Level="NoticeLevel.Info" id="backup-environment">Die Sicherung läuft derzeit nach der Server-Konfiguration. Richten Sie mit „Ziel hinzufügen“ ein Ziel ein, dann verwalten Sie Ziele und Zeitplan hier,
            sehen alle Sicherungen und können daraus wiederherstellen. Es sind mehrere Ziele möglich, z. B. Google Drive und ein NAS.</Notice>
        }

        @if (progress.Running)
        {
            <div class="backup-progress" id="backup-running" role="status">
                <strong>@RunningText</strong>
                @if (progress.Detail is { } run)
                {
                    <MudProgressLinear Value="@((run.Percent ?? 0) * 100)" Color="Color.Primary" Rounded="true" Size="Size.Medium" aria-label="Fortschritt" />
                    <span class="small">Schritt @run.StepNumber von @run.StepCount: @run.Step@(string.IsNullOrEmpty(run.Detail) ? "" : " (" + run.Detail + ")")@(run.Percent is { } done ? $", insgesamt {(int)Math.Round(done * 100)} %" : "")</span>
                }
                else
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Size="Size.Medium" aria-label="Fortschritt" />
                }
            </div>
        }
        else if (progress.Last is { Kind: "Restore" } restored)
        {
            <Notice Level="@(restored.Succeeded ? NoticeLevel.Success : NoticeLevel.Error)" id="restore-result">
                @(restored.Succeeded ? (restarting ? "Die Wiederherstellung ist abgeschlossen. Die App startet in wenigen Sekunden neu, danach bitte neu anmelden." : "Die Wiederherstellung ist abgeschlossen. Bitte die App neu starten und danach neu anmelden: docker compose … restart app") : "Die Wiederherstellung ist fehlgeschlagen: " + restored.Message)
            </Notice>
        }

        @if (targets.Count == 0 && environment is not null)
        {
            <div class="table-wrapper">
                <table class="data-table" id="backup-environment-target">
                    <thead><tr><th>Ziel</th><th>Ort</th><th>Zeitplan</th><th>Aufbewahrung</th><th>Stand</th><th></th></tr></thead>
                    <tbody>
                        <tr data-target="Server-Konfiguration">
                            <td><strong>Server-Konfiguration</strong><br /><span class="small">aus <code>deploy/.env</code></span></td>
                            <td><code>@environment.Repository</code></td>
                            <td>täglich um @environment.Time</td>
                            <td>@Retention(environment.KeepDaily, environment.KeepWeekly, environment.KeepMonthly)</td>
                            <td>
                                @if (state is not null)
                                {
                                    <StatusChip Level="Chip(state.State)">@ChipText(state.State)</StatusChip>
                                    <span class="small">@state.Description</span>
                                    @if (state.Snapshot is not null)
                                    {
                                        <span class="small">Kennung <code>@state.Snapshot[..Math.Min(8, state.Snapshot.Length)]</code>@(state.DurationSeconds is { } seconds ? $", {seconds} s" : "")</span>
                                    }
                                }
                            </td>
                            <td class="row-actions">
                                <button type="button" class="button button-text" id="environment-backup" @onclick="StartEnvironmentBackupAsync" disabled="@(progress.Running || busy || !progress.Available)">Jetzt sichern</button>
                                @if (BackupProviders.Parse(environment.Repository) is not null)
                                {
                                    <button type="button" class="button button-text" id="environment-edit" @onclick="TakeOverEnvironmentAsync" disabled="@busy">Bearbeiten</button>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }

        @if (targets.Count > 0)
        {
            <div class="table-wrapper">
                <table class="data-table" id="backup-targets">
                    <thead><tr><th>Ziel</th><th>Ort</th><th>Zeitplan</th><th>Aufbewahrung</th><th>Stand</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var target in targets)
                        {
                            var status = states.GetValueOrDefault(target.Id);
                            <tr data-target="@target.Name">
                                <td><strong>@target.Name</strong></td>
                                <td>@BackupProviders.Label(target.Provider)@(string.IsNullOrWhiteSpace(target.Location) ? "" : ": ")<code>@target.Location</code></td>
                                <td>@Schedule(target)</td>
                                <td>@Retention(target.KeepDaily, target.KeepWeekly, target.KeepMonthly)</td>
                                <td>
                                    @if (!target.Enabled)
                                    {
                                        <StatusChip Level="StatusLevel.Neutral">ausgeschaltet</StatusChip>
                                    }
                                    else if (status is not null)
                                    {
                                        <StatusChip Level="Chip(status.Status.State)">@ChipText(status.Status.State)</StatusChip>
                                        <span class="small">@status.Status.Description</span>
                                    }
                                </td>
                                <td class="row-actions">
                                    <button type="button" class="button button-text" @onclick="() => StartBackupAsync(target)" disabled="@(progress.Running || busy || !progress.Available)">Jetzt sichern</button>
                                    <button type="button" class="button button-text" @onclick="() => EditTargetAsync(target)" disabled="@busy">Bearbeiten</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <ErrorList Errors="listErrors" />
    </section>

    @if ((targets.Count > 0 || environment is not null) && progress.Available)
    {
        <section id="backup-snapshots">
            <h2>Vorhandene Sicherungen</h2>
            @foreach (var failed in snapshotErrors)
            {
                <Notice Level="NoticeLevel.Warning">Sicherungen von „@failed.Key“ konnten nicht gelesen werden: @failed.Value</Notice>
            }
            @if (progress.Export is { } export && ExportKey(export) != startedDownload && !progress.Running)
            {
                @* Normally the download starts by itself; this is for a file that is still waiting (another session, a download that was cancelled) *@
                <Notice Level="NoticeLevel.Info" id="backup-download">
                    Eine vorbereitete Sicherung wartet auf den Download: <strong>@export.Name</strong> (@Format.Size(export.Size)). Sie bleibt mit dem Passwort der Sicherung verschlüsselt.
                    <span class="form-actions">
                        <a class="button button-outlined" id="backup-download-link" href="@BackupFileEndpoints.DownloadPath" download="@export.Name">Datei herunterladen</a>
                        <button type="button" class="button button-text" id="backup-download-discard" @onclick="DiscardExportAsync" disabled="@busy">Verwerfen</button>
                    </span>
                </Notice>
            }
            @if (progress.Last is { Kind: "Export" or "Delete", Succeeded: false } failedRun && !progress.Running)
            {
                <Notice Level="NoticeLevel.Error" id="backup-run-failed">@(failedRun.Kind == "Export" ? "Die Sicherung konnte nicht für den Download vorbereitet werden: " : "Die Sicherung konnte nicht gelöscht werden: ")@failedRun.Message</Notice>
            }
            @if (snapshots.Count == 0 && !snapshotsLoaded)
            {
                <div class="snapshots-loading" id="snapshots-loading" role="status">
                    <span class="small">Sicherungen werden geladen …</span>
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Size="Size.Small" aria-label="Sicherungen werden geladen" />
                </div>
            }
            else if (snapshots.Count == 0 && snapshotErrors.Count == 0)
            {
                <EmptyState Text="Am Ziel liegt noch keine Sicherung." />
            }
            else if (snapshots.Count > 0)
            {
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Zeitpunkt</th><th>Ziel</th><th>Größe</th><th>Kennung</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var entry in snapshots)
                            {
                                <tr>
                                    <td>@Format.Timestamp(entry.Row.Time)</td>
                                    <td>@entry.TargetName</td>
                                    <td>@Format.Size(entry.Row.Size)</td>
                                    <td><code>@entry.Row.ShortId</code></td>
                                    <td class="row-actions">
                                        <button type="button" class="button button-text" @onclick="() => ExportAsync(entry)" disabled="@(progress.Running || busy)">Herunterladen</button>
                                        <button type="button" class="button button-text" @onclick="() => Select(entry)" disabled="@(progress.Running || busy)">Wiederherstellen</button>
                                        <button type="button" class="button button-text danger" @onclick="() => DeleteSnapshotAsync(entry)" disabled="@(progress.Running || busy)">Löschen</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (selected is not null)
            {
                <div class="danger-action-content" role="alertdialog" aria-label="Wiederherstellen" id="restore-confirm">
                    <p><strong>Alle aktuellen Daten und Dateien werden durch den Stand vom @Format.Timestamp(selected.Row.Time) ersetzt.</strong>
                    Was seitdem erfasst wurde, geht verloren. Die App ist währenddessen nicht nutzbar und startet danach von selbst neu.
                    Laden Sie vorher am besten den Vollexport herunter.</p>
                    <AppTextField Value="@confirmation" ValueChanged="v => confirmation = v ?? string.Empty" Label="Zur Bestätigung „WIEDERHERSTELLEN“ eingeben" Immediate="true" />
                    <div class="form-actions">
                        <button type="button" class="button button-primary" id="restore-start" @onclick="RestoreAsync"
                                disabled="@(busy || !string.Equals(confirmation.Trim(), "WIEDERHERSTELLEN", StringComparison.Ordinal))">Ja, jetzt wiederherstellen</button>
                        <button type="button" class="button button-outlined" @onclick="() => selected = null">Abbrechen</button>
                    </div>
                </div>
            }

            <button type="button" class="button button-outlined" id="snapshots-refresh" @onclick="ReloadSnapshotsAsync" disabled="@(busy || progress.Running)">Aktualisieren</button>
        </section>
    }

    @if (progress.Available)
    {
        <section id="backup-upload">
            <h2>Aus Datei wiederherstellen</h2>
            @if (UploadMessage is { } uploadMessage)
            {
                <Notice Level="@(UploadResult == "ok" ? NoticeLevel.Success : NoticeLevel.Error)" id="backup-upload-result">@uploadMessage</Notice>
            }

            @if (progress.Upload is { } upload)
            {
                <div class="backup-progress" id="backup-uploaded">
                    <strong>Hochgeladen: @upload.Name (@Format.Size(upload.Size))</strong>
                    <span class="small">Zum Öffnen braucht Elocaro das Passwort der Sicherung. Die Datei wird erst durch „Jetzt wiederherstellen“ eingespielt.</span>
                    <div class="upload-open">
                        <AppTextField Value="@uploadPassword" ValueChanged="v => { uploadPassword = v ?? string.Empty; uploadCheck = null; }" Label="Passwort der Sicherung" Type="password" Immediate="true" Autocomplete="off" />
                        <div class="form-actions">
                            <button type="button" class="button button-primary" id="upload-inspect" @onclick="InspectUploadAsync" disabled="@(busy || progress.Running || uploadPassword.Length == 0)">Datei öffnen</button>
                            <button type="button" class="button button-text" id="upload-discard" @onclick="DiscardUploadAsync" disabled="@(busy || progress.Running)">Verwerfen</button>
                        </div>
                    </div>
                    @if (uploadCheck is { Succeeded: false } failed)
                    {
                        <Notice Level="NoticeLevel.Error" id="upload-check">@failed.Message</Notice>
                    }
                    else if (uploadCheck is { Snapshots: [var held, ..] })
                    {
                        <div class="danger-action-content" role="alertdialog" aria-label="Wiederherstellen aus Datei" id="upload-confirm">
                            <p><strong>Die Datei enthält die Sicherung vom @Format.Timestamp(held.Time) (@Format.Size(held.Size)).
                            Alle aktuellen Daten und Dateien werden durch diesen Stand ersetzt.</strong>
                            Was seitdem erfasst wurde, geht verloren. Die App ist währenddessen nicht nutzbar und startet danach von selbst neu.</p>
                            <AppTextField Value="@uploadConfirmation" ValueChanged="v => uploadConfirmation = v ?? string.Empty" Label="Zur Bestätigung „WIEDERHERSTELLEN“ eingeben" Immediate="true" />
                            <div class="form-actions">
                                <button type="button" class="button button-primary" id="upload-restore" @onclick="RestoreUploadAsync"
                                        disabled="@(busy || progress.Running || !string.Equals(uploadConfirmation.Trim(), "WIEDERHERSTELLEN", StringComparison.Ordinal))">Ja, jetzt wiederherstellen</button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Eine Sicherungsdatei, die Sie zuvor mit „Herunterladen“ gespeichert haben, hochladen und daraus wiederherstellen, auch von einem anderen Server.</p>
                <form method="post" enctype="multipart/form-data" action="@BackupFileEndpoints.UploadPath" data-enhance="false" id="backup-upload-form" class="upload-form">
                    <AntiforgeryToken />
                    <label class="dropzone @(chosenFile is null ? null : "chosen")">
                        <Icon Path="@MudBlazor.Icons.Material.Outlined.UploadFile" />
                        <span class="dropzone-title">@(chosenFile ?? "Sicherungsdatei auswählen oder hierher ziehen")</span>
                        <span class="dropzone-text">@(chosenFile is null ? "Eine .tar-Datei, die mit „Herunterladen“ entstanden ist" : "Zum Ändern erneut klicken")</span>
                        <input type="file" name="file" accept=".tar,application/x-tar" aria-label="Sicherungsdatei" @onchange="OnFileChosen" />
                    </label>
                    <div class="form-actions">
                        <button type="submit" class="button button-primary" id="upload-send" disabled="@(chosenFile is null)">Datei hochladen</button>
                    </div>
                </form>
            }
        </section>
    }

    <details class="explain" id="backup-more">
        <summary>Weitere Optionen: Vollexport aller Daten</summary>
        <p>Alle Daten als ZIP: jede Tabelle als JSON und CSV (für Excel), dazu alle hochgeladenen Dateien und eine
        Beschreibung des Formats. Der Export ist ohne Elocaro lesbar, enthält aber keine Passwörter oder Anmeldetokens.
        Er enthält alle personenbezogenen Daten: sicher aufbewahren. Der Export wird im Audit-Log vermerkt.
        Zum Wiederherstellen von Elocaro dient die Sicherung, nicht der Vollexport.</p>
        <form method="post" action="@ExportEndpoint.Path" data-enhance="false">
            <AntiforgeryToken />
            <button type="submit" class="button">Vollexport herunterladen</button>
        </form>
    </details>

    <section>
        <h2>Wiederherstellen auf einem neuen Server</h2>
        <p>Auf einem frisch installierten Server fragt die Ersteinrichtung nach einer Datensicherung: entweder aus einem Ziel (Ziel und Passwort eingeben, Stand wählen)
        oder aus einer hier heruntergeladenen Sicherungsdatei. Eine Anleitung für die Konsole steht in der <a href="@AppInfo.Docs("betrieb.md", "auf-einem-neuen-server")" target="_blank" rel="noopener noreferrer">Betriebsanleitung (Auf einem neuen Server)</a>.</p>
    </section>
</InteractiveShell>

@code {
    private BackupSnapshot? state;
    private BackupProgress progress = new(false, false, null, null);
    private IReadOnlyList<BackupSettingsView> targets = [];
    private Dictionary<Guid, BackupTargetStatus> states = [];

    private bool busy;
    private IReadOnlyList<string>? listErrors;

    private string? chosenFile;
    private bool snapshotsLoaded;
    private bool snapshotsLoading;
    private bool snapshotsDirty;

    /// <summary>This page asked for a download: when the file is ready it is fetched at once.</summary>
    private bool awaitingDownload;

    /// <summary>The prepared file whose download was started from here (it disappears while it is sent).</summary>
    private string? startedDownload;

    // The browser reports the chosen file as "C:\fakepath\name.tar": the name is all that is shown
    private void OnFileChosen(ChangeEventArgs e) =>
        chosenFile = (e.Value as string)?.Replace('\\', '/') is { Length: > 0 } path ? Path.GetFileName(path) : null;

    private string uploadPassword = string.Empty;
    private string uploadConfirmation = string.Empty;
    private BackupUploadCheck? uploadCheck;

    /// <summary>Result of the upload form (a fixed word in the address).</summary>
    [SupplyParameterFromQuery(Name = "upload")]
    public string? UploadResult { get; set; }

    private string? UploadMessage => UploadResult switch
    {
        "ok" => "Die Datei wurde hochgeladen. Geben Sie das Passwort der Sicherung ein, um sie zu öffnen.",
        "abgelehnt" => "Die Datei ist keine Sicherungsdatei von Elocaro. Gültig ist eine .tar, die über „Herunterladen“ entstanden ist.",
        "belegt" => "Es läuft gerade eine Sicherung oder Wiederherstellung. Bitte später noch einmal hochladen.",
        "leer" => "Es wurde keine Datei gewählt.",
        null => null,
        _ => "Die Datei konnte nicht hochgeladen werden. Läuft der Backup-Dienst?",
    };

    /// <summary><see cref="TargetId"/> is <c>null</c> for the target of the server configuration.</summary>
    private sealed record SnapshotEntry(Guid? TargetId, string TargetName, BackupSnapshotRow Row);

    private BackupEnvironment? environment;

    private List<SnapshotEntry> snapshots = [];
    private Dictionary<string, string> snapshotErrors = [];
    private SnapshotEntry? selected;
    private string confirmation = string.Empty;
    private CancellationTokenSource? polling;
    private bool sawRestore;
    private bool restarting;

    private string RunningText
    {
        get
        {
            var name = targets.FirstOrDefault(t => t.Id.ToString("N") == progress.RunningTargetId)?.Name;
            return progress.Kind == "Export" ? "Die Sicherung wird für den Download vorbereitet …" : progress.Kind == "Delete" ? "Eine Sicherung wird gelöscht …" : progress.Kind == "Restore" ? "Die Wiederherstellung läuft …" : name is null ? "Eine Sicherung läuft …" : $"Eine Sicherung läuft: {name} …";
        }
    }

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (polling is null)
        {
            _ = PollAsync();
        }
    }

    private async Task RefreshAsync()
    {
        // First what the backup service says (it does not touch the database): during and right after a restore the database is replaced,
        // and what the page has to do then (show the result, restart the app) must not depend on it
        progress = await Control.ProgressAsync();
        if (progress.Export is null)
        {
            startedDownload = null;
        }

        sawRestore |= progress is { Running: true, Kind: "Restore" };
        // Only a restore that ran while this page was open restarts the app (a result from earlier must not do it again).
        if (sawRestore && !restarting && !progress.Running && progress.Last is { Kind: "Restore", Succeeded: true })
        {
            restarting = true;
            Restart.Schedule();
        }

        // The file for a download that this page asked for is ready: fetch it (the page stays, the browser saves the file)
        if (awaitingDownload && !progress.Running)
        {
            awaitingDownload = false;
            if (progress.Export is { } ready)
            {
                startedDownload = ExportKey(ready);
                Notify.Success("Der Download der Sicherung startet.");
                Navigation.NavigateTo(BackupFileEndpoints.DownloadPath, forceLoad: true);
            }
        }

        try
        {
            targets = await Settings.ListAsync();
            state = await BackupStatus.QueryAsync();
            states = (await BackupStatus.QueryTargetsAsync()).ToDictionary(s => s.Id);
            environment = targets.Count == 0 && progress.Available ? await Control.EnvironmentAsync() : null;
        }
        catch (Exception ex) when (ex is DbException or InvalidOperationException or IOException)
        {
            // The database is being replaced by a restore (connections cut): what is shown stays, the next refresh reads again
        }

        // The list of the backups is read from the targets, which can be slow: the page appears first, the list follows
        if (RendererInfo.IsInteractive)
        {
            _ = InvokeAsync(LoadSnapshotsAsync);
        }
    }

    /// <summary>
    /// While an operation runs, the page follows it every two seconds. Otherwise it only asks the backup service every ten seconds
    /// whether something started (scheduled backup, another administrator) and then follows that.
    /// </summary>
    private async Task PollAsync()
    {
        polling = new CancellationTokenSource();
        var token = polling.Token;
        var idleTicks = 0;
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    try
                    {
                        if (progress.Running)
                        {
                            idleTicks = 0;
                            await RefreshAsync();
                        }
                        else if (++idleTicks >= 5)
                        {
                            idleTicks = 0;
                            if ((await Control.ProgressAsync()).Running)
                            {
                                await RefreshAsync();
                            }
                        }
                    }
                    catch (Exception ex) when (ex is DbException or InvalidOperationException or IOException or HttpRequestException)
                    {
                        // A tick that fails (the service or the database is just being replaced) must not end the following of the run: try again at the next
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // page closed
        }
        finally
        {
            polling?.Dispose();
            polling = null;
        }
    }

    private static string Retention(int daily, int weekly, int monthly) => $"{daily} täglich, {weekly} wöchentlich, {monthly} monatlich";

    private async Task StartEnvironmentBackupAsync()
    {
        listErrors = null;
        busy = true;
        try
        {
            var result = await Control.StartEnvironmentBackupAsync();
            if (result.Succeeded)
            {
                Notify.Success("Die Sicherung wurde gestartet.");
            }
            else
            {
                listErrors = result.Errors;
            }

            await RefreshAsync();
        }
        finally
        {
            busy = false;
        }
    }


    private static string Schedule(BackupSettingsView target) =>
        $"{(target.IntervalDays == 1 ? "täglich" : target.IntervalDays == 7 ? (target.Weekday is { } day ? $"wöchentlich {BackupTargetDialog.WeekdayPlural(day)}" : "wöchentlich") : $"alle {target.IntervalDays} Tage")} um {target.Time.ToString("HH:mm", CultureInfo.InvariantCulture)}";

    private static StatusLevel Chip(BackupState state) => state switch
    {
        BackupState.Ok => StatusLevel.Success,
        BackupState.Failed => StatusLevel.Error,
        BackupState.Outdated => StatusLevel.Warning,
        _ => StatusLevel.Neutral,
    };

    private static string ChipText(BackupState state) => state switch
    {
        BackupState.Ok => "aktuell",
        BackupState.Failed => "fehlgeschlagen",
        BackupState.Outdated => "überfällig",
        _ => "noch keine Sicherung",
    };

    private static readonly DialogOptions TargetDialog = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

    private Task NewTargetAsync() => ShowTargetDialogAsync("Ziel hinzufügen", null, null, null);

    private Task EditTargetAsync(BackupSettingsView target) => ShowTargetDialogAsync("Ziel bearbeiten", target, null, null);

    /// <summary>The target of the server configuration becomes a target of the app: provider and place are taken over, credentials and password are entered again.</summary>
    private Task TakeOverEnvironmentAsync()
    {
        if (environment is null || BackupProviders.Parse(environment.Repository) is not { } parsed)
        {
            return Task.CompletedTask;
        }

        var input = new BackupSettingsInput
        {
            Name = "Sicherung",
            Provider = parsed.Provider,
            Location = parsed.Location,
            Time = TimeOnly.TryParseExact(environment.Time, ["HH:mm", "H:mm"], CultureInfo.InvariantCulture, DateTimeStyles.None, out var time) ? time : new TimeOnly(2, 30),
            KeepDaily = environment.KeepDaily,
            KeepWeekly = environment.KeepWeekly,
            KeepMonthly = environment.KeepMonthly,
        };
        return ShowTargetDialogAsync("Ziel in der App verwalten", null, input,
            "Dieses Ziel kommt aus der Server-Konfiguration (deploy/.env). Mit „Speichern“ übernimmt es die App: Ziel, Zeitplan und Aufbewahrung lassen sich dann hier ändern, und die Sicherung nach .env ruht. "
            + "Tragen Sie die Zugangsdaten und das Passwort der bestehenden Sicherung ein; „Verbindung testen“ zeigt, ob sie passen. Die vorhandenen Sicherungen bleiben erhalten.");
    }

    private async Task ShowTargetDialogAsync(string title, BackupSettingsView? existing, BackupSettingsInput? prefill, string? notice)
    {
        listErrors = null;
        var parameters = new DialogParameters<BackupTargetDialog>
        {
            { x => x.Existing, existing },
            { x => x.Prefill, prefill },
            { x => x.Notice, notice },
        };
        var dialog = await Dialogs.ShowAsync<BackupTargetDialog>(title, parameters, TargetDialog);
        if (await dialog.Result is { Canceled: false })
        {
            await RefreshAsync();
        }
    }

    private async Task StartBackupAsync(BackupSettingsView target)
    {
        listErrors = null;
        busy = true;
        try
        {
            var result = await Control.StartBackupAsync(target.Id);
            if (result.Succeeded)
            {
                Notify.Success($"Die Sicherung von „{target.Name}“ wurde gestartet.");
            }
            else
