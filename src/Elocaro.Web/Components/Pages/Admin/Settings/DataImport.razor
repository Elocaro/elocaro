@page "/verwaltung/einstellungen/import"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Application.Admin
@using Elocaro.Application.Setup
@using Elocaro.Web.Components.Controls
@inject IDataImport Import
@inject IDemoData Demo
@inject Confirmations Confirm
@inject Notifier Notify

<InteractiveShell>
    <PageHeader Title="Daten importieren" Subtitle="Bestand aus einer Tabelle übernehmen: Objekte, Wohnungen, Mieter, Verträge und offene Salden." />

    <ErrorList Errors="errors" />

    @if (canLoadDemo)
    {
        <section id="demo-data">
            <h2>Erst einmal ausprobieren?</h2>
            <details class="explain">
                <summary>Was die Beispieldaten enthalten</summary>
                <p class="help">
                Die Beispieldaten legen ein Haus mit vier Wohnungen, drei Mieter mit unterschiedlichem Zahlungsverhalten und einen Beispiel-Vermieter an.
                Das ist für eine Probe-Installation gedacht: Es gibt kein „Entfernen“. Zum Neuanfang wird die Datenbank geleert (siehe Betrieb).
            </p>
            </details>
            <MudButton Variant="Variant.Outlined" OnClick="LoadDemoAsync" Disabled="busy" id="demo-start">Beispieldaten laden</MudButton>
        </section>
    }

    @if (result is { Succeeded: true } done)
    {
        <Notice Level="NoticeLevel.Success" id="import-done">
            Der Import ist abgeschlossen: @Describe(done.Summary).
            <a href="/verwaltung/objekte">Zu den Objekten</a> · <a href="/verwaltung/vertraege">Zu den Verträgen</a>
        </Notice>
    }

    <section>
        <h2>1. Vorlage ausfüllen</h2>
        <details class="explain">
            <summary>Aufbau der Tabelle</summary>
            <p class="help">
            Eine Zeile je vermietete (oder leere) Einheit. Aus Excel speichern Sie die Tabelle als „CSV (Trennzeichen-getrennt)“.
            Pflicht sind nur Objekt und Einheit; Anschrift (nur beim ersten Auftreten eines neuen Objekts), Wohnfläche und die Angaben zum Mieter
            sind für einen vollständigen Bestand nötig. Der Saldo ist ein offener Betrag (positiv) oder ein Guthaben (negativ) aus der Zeit vor Elocaro. Optional und nur bei Bedarf: Mietmodell (Standard, Staffel, Index), Indexmonat (MM.JJJJ) und Indexwert, Staffeln (TT.MM.JJJJ=Betrag, mehrere mit | getrennt), Befristet bis und Personen.
        </p>
        </details>
        <p><a class="button button-outlined" href="/verwaltung/einstellungen/import/vorlage.csv" download>Vorlage herunterladen (CSV)</a></p>
    </section>

    <section>
        <h2>2. Datei prüfen</h2>
        <AppFileUpload Text="Datei auswählen" Accept=".csv,.txt" OnSelected="OnFileSelected" MaxBytes="5242880" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PreviewAsync" Disabled="busy">Prüfen</MudButton>
        <p class="small">Es wird noch nichts gespeichert. Vorhandene Objekte, Einheiten und Personen werden erkannt und nicht doppelt angelegt.</p>
    </section>

    @if (preview is not null)
    {
        <section id="import-preview">
            <h2>3. Ergebnis der Prüfung</h2>
            @foreach (var error in preview.FileErrors)
            {
                <Notice Level="NoticeLevel.Error">@error</Notice>
            }

            @if (preview.Rows.Count > 0)
            {
                <p class="dashboard-summary">
                    <StatusChip>@preview.Summary.NewProperties Objekt(e) neu</StatusChip>
                    <StatusChip>@preview.Summary.NewUnits Einheit(en) neu</StatusChip>
                    <StatusChip>@preview.Summary.NewPeople Person(en) neu</StatusChip>
                    <StatusChip>@preview.Summary.NewLeases Vertrag/Verträge neu</StatusChip>
                    @if (preview.Summary.OpeningBalances > 0)
                    {
                        <StatusChip>@preview.Summary.OpeningBalances Saldovortrag/-träge</StatusChip>
                    }

                    @if (ErrorRows > 0)
                    {
                        <StatusChip Level="StatusLevel.Error">@ErrorRows Zeile(n) mit Fehlern</StatusChip>
                    }
                </p>

                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr><th>Zeile</th><th>Objekt</th><th>Einheit</th><th>Mieter</th><th>Was passiert</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in preview.Rows)
                            {
                                <tr class="@(row.Errors.Count > 0 ? "row-error" : null)">
                                    <td>@row.Line</td>
                                    <td>@row.Property</td>
                                    <td>@row.Unit</td>
                                    <td>@(row.Tenant ?? "–")</td>
                                    <td>
                                        @string.Join(" · ", row.Actions)
                                        @foreach (var error in row.Errors)
                                        {
                                            <p class="field-error" role="alert">@error</p>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (preview.CanImport)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ImportAsync" Disabled="busy" id="import-start">Jetzt importieren</MudButton>
                    <p class="small">Es wird alles oder nichts übernommen. Jede Änderung steht im Änderungsprotokoll.</p>
                }
                else
                {
                    <Notice Level="NoticeLevel.Warning">Bitte die Fehler in der Datei beheben und sie erneut prüfen. Solange es Fehler gibt, wird nichts importiert.</Notice>
                }
            }
        </section>
    }
</InteractiveShell>

@code {
    private FileSelection? file;
    private DataImportPreview? preview;
    private DataImportResult? result;
    private IReadOnlyList<string>? errors;
    private bool busy;
    private bool canLoadDemo;

    protected override async Task OnInitializedAsync() => canLoadDemo = await Demo.CanLoadAsync();

    private async Task LoadDemoAsync()
    {
        if (!await Confirm.AskAsync("Beispieldaten laden", "Es werden ein Beispielhaus mit Wohnungen, Mietern, Verträgen und Zahlungen angelegt. Das lässt sich nicht einzeln wieder entfernen. Fortfahren?", "Ja, laden"))
        {
            return;
        }

        busy = true;
        try
        {
            result = await Demo.LoadAsync();
            if (result.Succeeded)
            {
                Notify.Success("Die Beispieldaten wurden geladen.");
                canLoadDemo = false;
            }
            else
            {
                errors = result.Errors;
            }
        }
        finally
        {
            busy = false;
        }
    }

    private int ErrorRows => preview?.Rows.Count(r => r.Errors.Count > 0) ?? 0;

    private void OnFileSelected(FileSelection selection)
    {
        file = selection;
        preview = null;
        result = null;
        errors = null;
    }

    private async Task<byte[]?> ReadAsync()
    {
        if (file is null || file.Length == 0)
        {
            errors = ["Bitte eine Datei auswählen."];
            return null;
        }

        using var buffer = new MemoryStream();
        await using (var content = file.Open())
        {
            await content.CopyToAsync(buffer);
        }

        return buffer.ToArray();
    }

    private async Task PreviewAsync()
    {
        errors = null;
        result = null;
        if (await ReadAsync() is not { } content)
        {
            return;
        }

        busy = true;
        try
        {
            preview = await Import.PreviewAsync(content);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ImportAsync()
    {
        if (await ReadAsync() is not { } content || preview is null)
        {
            return;
        }

        var summary = preview.Summary;
        if (!await Confirm.AskAsync("Daten importieren", $"Es werden angelegt: {Describe(summary)}. Fortfahren?", "Ja, importieren"))
        {
            return;
        }

        busy = true;
        try
        {
            result = await Import.ImportAsync(content);
            if (result.Succeeded)
            {
                Notify.Success("Der Import ist abgeschlossen.");
                preview = null;
                file = null;
            }
            else
            {
                errors = result.Errors;
            }
        }
        finally
        {
            busy = false;
        }
    }

    private static string Describe(DataImportSummary s) =>
        $"{s.NewProperties} Objekt(e), {s.NewUnits} Einheit(en), {s.NewPeople} Person(en), {s.NewLeases} Vertrag/Verträge" + (s.OpeningBalances > 0 ? $", {s.OpeningBalances} Saldovortrag/-träge" : "");
}
