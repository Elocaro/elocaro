@page "/verwaltung/einstellungen/module"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Application.Admin
@inject IModuleState State
@inject Notifier Notify

<InteractiveShell>
    <PageHeader Title="Module" Subtitle="Schalten Sie ab, was Sie nicht brauchen. Die Daten bleiben erhalten; abgeschaltete Bereiche fehlen im Menü und sind still. Hier schalten Sie sie wieder ein." />

    <details class="explain">
        <summary>Wie Module funktionieren</summary>
        <p class="help">
        Objekte, Personen, Verträge, Mieterkonto, Benutzer und Einstellungen sind immer da.
        Alles andere ist ein Modul: Sie können es jederzeit wieder einschalten und finden alles so vor, wie Sie es verlassen haben.
        <a href="/verwaltung/einrichtung">Einrichtungsassistent starten</a>
    </p>
    </details>

    @if (choices is not null)
    {
        <EditForm Model="choices" OnValidSubmit="SaveAsync" novalidate>
            <div class="module-list">
                @foreach (var choice in choices)
                {
                    var info = ModuleCatalog.Info(choice.Module);
                    <section class="module-card" id="@("module-" + choice.Module.ToString().ToLowerInvariant())">
                        <AppCheckBox Value="choice.On" ValueChanged="on => Toggle(choice, on)" ValueExpression="() => choice.On" Label="@info.Title" />
                        <p class="module-summary">@info.Summary</p>
                        @if (info.Requires.Length > 0)
                        {
                            <p class="small">Braucht: @string.Join(", ", info.Requires.Select(r => ModuleCatalog.Info(r).Title)). Wird automatisch mit eingeschaltet.</p>
                        }
                        @if (choice.On)
                        {
                            @OptionFields(OptionsOf(choice.Module))
                        }
                        <details class="explain">
                            <summary>Wann ist das sinnvoll, was gehört dazu?</summary>
                            <p class="help">@info.Purpose</p>
                            <ul>
                                @foreach (var item in info.Includes)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </details>
                    </section>
                }
                @if (OptionsOf(null).Any())
                {
                    <section class="module-card" id="module-kern">
                        <h3>Immer dabei</h3>
                        <p class="module-summary">Auswahl innerhalb der Grundfunktionen.</p>
                        @OptionFields(OptionsOf(null))
                    </section>
                }
            </div>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
        </EditForm>
    }
</InteractiveShell>

@code {
    private List<ModuleChoice>? choices;
    private List<OptionChoice>? options;

    protected override async Task OnInitializedAsync()
    {
        var selection = await State.GetAsync();
        choices = ModuleCatalog.All.Select(info => new ModuleChoice(info.Module) { On = selection.Enabled.Contains(info.Module) }).ToList();
        options = ModuleCatalog.Options.Select(info => new OptionChoice(info.Option) { On = selection.EnabledOptions.Contains(info.Option) }).ToList();
    }

    private IEnumerable<OptionChoice> OptionsOf(AppModule? module) => options!.Where(o => ModuleCatalog.Info(o.Option).Module == module);

    /// <summary>The options of one module (or of the core), grouped, inside its card: what is switched off disappears from the forms.</summary>
    private RenderFragment OptionFields(IEnumerable<OptionChoice> list) => @<div class="module-options">
        @foreach (var group in list.GroupBy(o => ModuleCatalog.Info(o.Option).Group))
        {
            <fieldset class="module-option-group">
                <legend class="small">@group.Key</legend>
                @foreach (var option in group)
                {
                    var info = ModuleCatalog.Info(option.Option);
                    <AppCheckBox @bind-Value="option.On" Label="@info.Title" />
                    <p class="help">@info.Description</p>
                    @if (!option.On && State.UsageCount(option.Option) is > 0 and var used)
                    {
                        <p class="small">Noch @used @(used == 1 ? "Vertrag verwendet" : "Verträge verwenden") das. Es bleibt dort sichtbar.</p>
                    }
                }
            </fieldset>
        }
    </div>;

    private void Toggle(ModuleChoice choice, bool on)
    {
        choice.On = on;
        if (on)
        {
            // Switching on a module also switches on what it needs.
            var alsoOn = new List<string>();
            foreach (var required in ModuleCatalog.WithRequirements([choice.Module]).Where(r => r != choice.Module))
            {
                var target = choices!.First(c => c.Module == required);
                if (!target.On)
                {
                    alsoOn.Add(ModuleCatalog.Info(required).Title);
                }

                target.On = true;
            }

            if (alsoOn.Count > 0)
            {
                Notify.Info($"{ModuleCatalog.Info(choice.Module).Title} braucht {string.Join(", ", alsoOn)}. Das wurde mit eingeschaltet.");
            }
        }
        else
        {
            // Switching off a module also switches off what needs it.
            var alsoOff = choices!.Where(c => c.On && c.Module != choice.Module && ModuleCatalog.WithRequirements([c.Module]).Contains(choice.Module)).ToList();
            foreach (var other in alsoOff)
            {
                other.On = false;
            }

            if (alsoOff.Count > 0)
            {
                Notify.Info($"{string.Join(", ", alsoOff.Select(o => ModuleCatalog.Info(o.Module).Title))} braucht {ModuleCatalog.Info(choice.Module).Title} und wurde mit ausgeschaltet.");
            }
        }
    }

    private async Task SaveAsync()
    {
        await State.SaveAsync(choices!.Where(c => c.On).Select(c => c.Module), completeSetup: false, options!.Where(o => o.On).Select(o => o.Option));
        Notify.Success("Die Module wurden gespeichert.");
    }

    private sealed class OptionChoice(AppOption option)
    {
        public AppOption Option { get; } = option;

        public bool On { get; set; }
    }

    private sealed class ModuleChoice(AppModule module)
    {
        public AppModule Module { get; } = module;

        public bool On { get; set; }
    }
}
