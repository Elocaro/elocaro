@* Document list; internally linking to the details page, otherwise directly to the file. *@
<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Kategorie</th>
                <th>Datum</th>
                @if (WithRelation)
                {
                    <th>Bezug</th>
                }
                @if (Internal)
                {
                    <th>Freigabe</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var document in Rows)
            {
                <tr>
                    <td>
                        @* One wrapper: in the stacked mobile layout every direct child of the cell would become a column of its own. *@
                        <div class="cell-main">
                            <a href="@(Internal ? $"/verwaltung/dokumente/{document.Id}" : $"/dateien/{document.FileId}")">@document.Title</a>
                            @foreach (var tag in document.Tags)
                            {
                                <StatusChip>@tag</StatusChip>
                            }
                            @if (document.ExpiresOn is { } expiry)
                            {
                                <span class="small">&#32;gültig bis @Format.Date(expiry)</span>
                            }
                        </div>
                    </td>
                    <td>@Labels.From(document.Category)</td>
                    <td>@Format.Date(document.Date)</td>
                    @if (WithRelation)
                    {
                        <td>@document.Reference</td>
                    }
                    @if (Internal)
                    {
                        <td>@Share(document)</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DocumentRow> Rows { get; set; } = [];

    [Parameter]
    public bool Internal { get; set; } = true;

    [Parameter]
    public bool WithRelation { get; set; } = true;

    internal static string Share(DocumentRow document) => (document.ForTenants, document.ForCaretaker) switch
    {
        (true, true) => "Mieter, Hausmeister",
        (true, false) => "Mieter",
        (false, true) => "Hausmeister",
        _ => "intern",
    };
}
