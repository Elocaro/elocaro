@page "/verwaltung/dokumente/schreiben"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Application.Properties
@using Elocaro.Domain.Documents
@using Elocaro.Web.Documents
@attribute [Authorize(Policy = Policies.MasterData)]
@using Elocaro.Application.Documents
@inject IDocumentTemplates Templates
@inject IDocumentReadiness Readiness
@inject ILetters Letters
@inject IPropertyService PropertyService
@inject TemplatePreviews Previews
@inject Confirmations Confirm

<InteractiveShell>
    <PageHeader Title="Schreiben an Mieter" Subtitle="Ein Schreiben aus einer Vorlage an einen oder alle Mieter eines Objekts. Jedes Schreiben wird als PDF bei den Dokumenten abgelegt."
                Back="/verwaltung/dokumente" BackText="Dokumente" />

    <ErrorList Errors="errors" />

    @if (!loaded)
    {
        <p class="loading" role="status">Wird geladen …</p>
    }
    else if (templates.Count == 0)
    {
        <ReadinessNotice Issues="readiness" OnFixed="ReloadAsync" />
    }
    else
    {
        <ReadinessNotice Issues="readiness" OnFixed="ReloadAsync" />
        <div class="form-grid">
            <AppSelect T="Guid" Value="templateId" ValueChanged="v => templateId = v" Label="Vorlage" Required="true" Items="templates.Select(t => t.Id)"
                       Text="@(id => templates.FirstOrDefault(t => t.Id == id)?.Name ?? "")" />
            <AppSelect T="Guid" Value="propertyId" ValueChanged="OnPropertyChangedAsync" Label="Objekt" Required="true" Items="properties.Select(o => o.Id)"
                       Text="@(id => properties.FirstOrDefault(o => o.Id == id)?.Name ?? "")" EmptyText="Objekt wählen" />
        </div>

        @if (templates.FirstOrDefault(t => t.Id == templateId)?.Description is { Length: > 0 } description)
        {
            <p class="help">@description</p>
        }

        @if (propertyId == Guid.Empty)
        {
            <EmptyState Compact="true" Text="Wählen Sie ein Objekt, dann erscheinen die Mieter dieses Objekts als Empfänger." />
        }
        else
        {
            @if (recipients.Count == 0)
            {
                <EmptyState Compact="true" Text="In diesem Objekt gibt es zurzeit keine laufenden Mietverträge." />
            }
            else
            {
                <fieldset class="field">
                    <legend>Empfänger (@selected.Count von @recipients.Count)</legend>
                    <AppCheckBox Value="selected.Count == recipients.Count" ValueChanged="SelectAll" Label="Alle Mieter" />
                    @foreach (var recipient in recipients)
                    {
                        <AppCheckBox Value="selected.Contains(recipient.LeaseId)" ValueChanged="@(on => Toggle(recipient.LeaseId, on))"
                                     Label="@($"{recipient.RentalUnit}: {recipient.Tenants}{(recipient.HasEmail ? "" : " (keine E-Mail-Adresse)")}")" />
                    }
                </fieldset>

                <fieldset class="field">
                    <legend>Zustellung</legend>
                    <AppCheckBox @bind-Value="sendByMail" Label="Zusätzlich per E-Mail senden (PDF im Anhang, wo eine Adresse hinterlegt ist)" />
                    <AppCheckBox @bind-Value="shareWithTenants" Label="Im Mieterportal freigeben" />
                </fieldset>

                <div class="form-row">
                    <MudButton Variant="Variant.Outlined" Disabled="@(Blocked || selected.Count == 0 || templateId == Guid.Empty)" OnClick="PreviewAsync">Vorschau für den ersten Empfänger</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Blocked || selected.Count == 0 || templateId == Guid.Empty)" OnClick="CreateAsync">
                        @selected.Count @(selected.Count == 1 ? "Schreiben" : "Schreiben") erzeugen
                    </MudButton>
                </div>
            }
        }

        @if (previewId is not null)
        {
            <section>
                <h2>Vorschau</h2>
                <iframe class="document-preview" src="/verwaltung/einstellungen/vorlagen/vorschau/@(previewId).pdf" title="Vorschau des Schreibens"></iframe>
            </section>
        }

        @if (result is not null)
        {
            <section>
                <h2>Ergebnis</h2>
                <p><strong>@result.Created Schreiben erzeugt</strong>@(result.Mailed > 0 ? $", {result.Mailed} per E-Mail in den Versand gestellt" : "")@(result.Outcomes.Count(o => !o.Succeeded) is > 0 and var failed ? $", {failed} fehlgeschlagen" : "").</p>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Empfänger</th><th>Ergebnis</th></tr></thead>
                        <tbody>
                            @foreach (var outcome in result.Outcomes)
                            {
                                <tr>
                                    <td>@outcome.Recipient</td>
                                    <td>
                                        @if (outcome.Succeeded)
                                        {
                                            <a href="/verwaltung/dokumente/@outcome.DocumentId">Dokument</a><span class="small">&#32;@(outcome.Mailed ? "· E-Mail im Versand" : "")</span>
                                            @if (outcome.Message is not null) {<span class="small">&#32;@outcome.Message</span>}
                                        }
                                        else
                                        {
                                            <StatusChip Level="StatusLevel.Error">fehlgeschlagen</StatusChip><span class="small">&#32;@outcome.Message</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</InteractiveShell>

@code {
    private IReadOnlyList<TemplateRow> templates = [];
    private IReadOnlyList<PropertyOverview> properties = [];
    private IReadOnlyList<LetterRecipient> recipients = [];
    private readonly HashSet<Guid> selected = [];
    private IReadOnlyList<string>? errors;
    private LetterRunResult? result;
    private Guid templateId;
    private Guid propertyId;
    private Guid? previewId;
    private bool sendByMail;
    private bool shareWithTenants;
    private bool loaded;

    private IReadOnlyList<ReadinessIssue> readiness = [];

    private bool Blocked => readiness.Any(i => i.Blocking);

    private async Task ReloadAsync()
    {
        await OnInitializedAsync();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        readiness = await Readiness.CheckAsync(TemplateKind.Letter);
        templates = (await Templates.ListAsync()).Where(t => t.Kind == TemplateKind.Letter).ToList();
        properties = await PropertyService.ListAsync(null);
        if (templates.Count > 0)
        {
            templateId = templates[0].Id;
        }

        // A landlord with one property does not need to choose it.
        if (properties.Count == 1 && propertyId == Guid.Empty)
        {
            await OnPropertyChangedAsync(properties[0].Id);
        }

        loaded = true;
    }

    private async Task OnPropertyChangedAsync(Guid id)
    {
        propertyId = id;
        previewId = null;
        result = null;
        selected.Clear();
        recipients = id == Guid.Empty ? [] : await Letters.RecipientsAsync(id);
        foreach (var recipient in recipients)
        {
            selected.Add(recipient.LeaseId);
        }
    }

    private void SelectAll(bool on)
    {
        selected.Clear();
        if (on)
        {
            selected.UnionWith(recipients.Select(r => r.LeaseId));
        }
    }

    private void Toggle(Guid leaseId, bool on)
    {
        if (on)
        {
            selected.Add(leaseId);
        }
        else
        {
            selected.Remove(leaseId);
        }
    }

    private async Task PreviewAsync()
    {
        var first = recipients.First(r => selected.Contains(r.LeaseId));
        var preview = await Letters.PreviewAsync(templateId, first.LeaseId);
        errors = preview.Errors.Count > 0 ? preview.Errors : null;
        previewId = preview.Pdf is { } pdf ? Previews.Add(pdf) : null;
    }

    private async Task CreateAsync()
    {
        var count = selected.Count;
        var question = sendByMail
            ? $"{count} Schreiben werden erzeugt und, wo eine E-Mail-Adresse vorhanden ist, per E-Mail an die Mieter gesendet. Das lässt sich nicht zurücknehmen."
            : $"{count} Schreiben werden erzeugt und bei den Dokumenten abgelegt.";
        if (!await Confirm.AskAsync("Schreiben erzeugen", question, "Ja, erzeugen"))
        {
            return;
        }

        errors = null;
        previewId = null;
        result = await Letters.CreateAsync(new LetterRequest
        {
            TemplateId = templateId,
            PropertyId = propertyId,
            LeaseIds = [.. recipients.Where(r => selected.Contains(r.LeaseId)).Select(r => r.LeaseId)],
            SendByMail = sendByMail,
            ShareWithTenants = shareWithTenants,
        });
        errors = result.Errors.Count > 0 ? result.Errors : null;
    }
}
