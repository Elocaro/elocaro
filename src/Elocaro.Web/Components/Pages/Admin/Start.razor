@page "/verwaltung"
@attribute [StreamRendering]
@using Elocaro.Application.Admin
@using Elocaro.Application.Portfolio
@using Elocaro.Application.Todos
@inject IEnumerable<ITodoSource> Sources
@inject IPortfolioFigures Portfolio

<PageHeader Title="Übersicht" Subtitle="Was ist zu tun? Aufgaben und Fristen aus allen Bereichen, die dringendsten zuerst." />

<div class="overview">
    @if (figures is not null)
    {
        <div class="kpis" role="group" aria-label="Kennzahlen" id="kpis">
            <KpiTile Label="@($"Mieteingang im {Format.Month(figures.Month)}")" Value="@Format.Money(figures.PaidThisMonth)" Note="@($"von {Format.Money(figures.MonthlyRent)} Soll")" Href="/verwaltung/bank/umsaetze">
                <ProgressMeter Value="figures.PaidThisMonth" Total="figures.MonthlyRent" Text="@($"{Format.Money(figures.PaidThisMonth)} von {Format.Money(figures.MonthlyRent)} eingegangen")" />
            </KpiTile>
            <KpiTile Label="Rückstände" Value="@Format.Money(figures.Arrears)" Note="@(figures.ArrearsLeases == 0 ? null : $"bei {figures.ArrearsLeases} Mietverhältnis{(figures.ArrearsLeases == 1 ? "" : "sen")}")" Href="/verwaltung/finanzen/offene-posten" Level="@(figures.Arrears > 0 ? NoticeLevel.Warning : null)" />
            <KpiTile Label="Belegung" Value="@($"{figures.Occupied} von {figures.Units} vermietet")" Note="@(figures.Vacant == 0 ? null : $"{figures.Vacant} leer")" Href="/verwaltung/objekte" Level="@(figures.Vacant > 0 ? NoticeLevel.Info : null)" />
        </div>
    }

    <div class="overview-tasks">
        @if (todos is null)
        {
            <p class="loading" role="status">Aufgaben werden geladen …</p>
        }
        else if (todos.Count == 0)
        {
            <EmptyState Text="Alles erledigt – es gibt gerade nichts zu tun." />
        }
        else
        {
            @if (Setup.Count > 0)
            {
                <section class="panel overview-setup" id="setup-steps">
                    <header>
                        <h2>@TodoAreas.Setup</h2>
                        @if (Setup[0].Progress is { } progress)
                        {
                            <span class="small">@progress.Done von @progress.Total Schritten erledigt</span>
                        }
                    </header>
                    @if (Setup[0].Progress is { } bar)
                    {
                        <ProgressMeter Value="bar.Done" Total="bar.Total" Text="@($"{bar.Done} von {bar.Total} Schritten erledigt")" />
                    }
                    <ul class="todos">
                        @foreach (var item in Setup)
                        {
                            @TodoItemView(item, false)
                        }
                    </ul>
                </section>
            }

            @if (Work.Count > 0)
            {
                <div class="dashboard-summary" aria-label="Zusammenfassung">
                    @if (Count(Urgency.Urgent) > 0)
                    {
                        <StatusChip Level="StatusLevel.Error">@Count(Urgency.Urgent) dringend</StatusChip>
                    }
                    @if (Count(Urgency.Soon) > 0)
                    {
                        <StatusChip Level="StatusLevel.Warning">@Count(Urgency.Soon) bald fällig</StatusChip>
                    }
                    <StatusChip>@Work.Count Aufgaben insgesamt</StatusChip>
                </div>
                @if (AreaNames.Count > 1)
                {
                    <nav class="overview-filter" aria-label="Aufgaben nach Bereich filtern">
                        <a class="filter-chip" href="/verwaltung" aria-current="@(ActiveArea is null ? "true" : null)">Alle</a>
                        @foreach (var name in AreaNames)
                        {
                            <a class="filter-chip" href="@($"/verwaltung?bereich={Uri.EscapeDataString(name)}")" aria-current="@(name == ActiveArea ? "true" : null)">@name</a>
                        }
                    </nav>
                }
                <section class="panel" id="tasks">
                    <header>
                        <h2>Aufgaben</h2>
                        <span class="count-badge" aria-label="@Filtered.Count Aufgaben">@Filtered.Count</span>
                    </header>
                    <ul class="todos">
                        @foreach (var entry in Entries.Take(VisibleTasks))
                        {
                            @EntryView(entry)
                        }
                    </ul>
                    @if (Entries.Count > VisibleTasks)
                    {
                        <details class="todos-more">
                            <summary>@(Entries.Count - VisibleTasks) weitere anzeigen</summary>
                            <ul class="todos">
                                @foreach (var entry in Entries.Skip(VisibleTasks))
                                {
                                    @EntryView(entry)
                                }
                            </ul>
                        </details>
                    }
                </section>
            }
        }
    </div>

    @* An all-zero history (new installation) shows no empty chart. *@
    @if (HasCharts)
    {
        <div class="overview-charts">
            @if (figures?.History is { Count: > 0 } history && history.Any(m => m.Due != 0 || m.Paid != 0 || m.OpenAtEnd != 0))
            {
                <MonthChart History="history" />
            }
            @if (figures?.Costs is { Count: > 0 } costs)
            {
                <CostBars id="year-costs" Caption="Kosten aus den Belegen je Abrechnungsjahr" Rows="@(costs.Select(c => new ChartBar(c.Year.ToString(System.Globalization.CultureInfo.InvariantCulture), c.Amount)).ToList())" />
            }
        </div>
    }
</div>

@code {
    private const int VisibleTasks = 10;

    private IReadOnlyList<TodoItem>? todos;
    private PortfolioFigures? figures;

    [SupplyParameterFromQuery(Name = "bereich")]
    private string? AreaFilter { get; set; }

    private List<TodoItem> Setup => [.. (todos ?? []).Where(t => t.Area == TodoAreas.Setup)];

    private List<TodoItem> Work => [.. (todos ?? []).Where(t => t.Area != TodoAreas.Setup).OrderByDescending(t => t.Urgency).ThenBy(t => t.Due ?? DateOnly.MaxValue)];

    private List<string> AreaNames => [.. Work.Select(t => t.Area).Distinct().Order(StringComparer.CurrentCulture)];

    /// <summary>An outdated link to an area without tasks shows everything instead of an empty list.</summary>
    private string? ActiveArea => AreaFilter is not null && AreaNames.Contains(AreaFilter) ? AreaFilter : null;

    private List<TodoItem> Filtered => [.. Work.Where(t => ActiveArea is null || t.Area == ActiveArea)];

    private List<TodoEntry> Entries => TodoGroups.Build(Filtered);

    private bool HasCharts => figures?.Costs is { Count: > 0 } || (figures?.History?.Any(m => m.Due != 0 || m.Paid != 0 || m.OpenAtEnd != 0) ?? false);

    private RenderFragment TodoItemView(TodoItem todo, bool showArea) => @<li class="todo todo-@todo.Urgency.ToString().ToLowerInvariant()">
        <a href="@todo.Link">@todo.Title</a>
        @if (todo.Due is { } due)
        {
            <span class="small todo-due">fällig am @Format.Date(due)</span>
        }
        @if (todo.Details is not null)
        {
            <p class="small">@todo.Details</p>
        }
        @if (showArea)
        {
            <span class="todo-area">@todo.Area</span>
        }
    </li>;

    private RenderFragment EntryView(TodoEntry entry) => entry.Items.Count == 1 ? TodoItemView(entry.First, ActiveArea is null) : GroupView(entry);

    private RenderFragment GroupView(TodoEntry entry) => @<li class="todo todo-@entry.First.Urgency.ToString().ToLowerInvariant() todo-group">
        <details>
            <summary>@entry.Heading <span class="small">(@entry.Items.Count)@(entry.First.Due is { } due ? $" · fällig am {Format.Date(due)}" : "")</span></summary>
            @if (entry.First.Details is not null)
            {
                <p class="small">@entry.First.Details</p>
            }
            <ul class="todo-group-items">
                @foreach (var item in entry.Items)
                {
                    <li><a href="@item.Link">@TodoGroups.Rest(item, entry.Heading)</a></li>
                }
            </ul>
        </details>
        @if (ActiveArea is null)
        {
            <span class="todo-area">@entry.First.Area</span>
        }
    </li>;

    private int Count(Urgency urgency) => Work.Count(t => t.Urgency == urgency);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        figures = await Portfolio.FiguresAsync(HttpContext.User);
        var all = new List<TodoItem>();
        foreach (var source in Sources)
        {
            all.AddRange(await source.TodosAsync(HttpContext.User));
        }

        todos = all;
    }
}
