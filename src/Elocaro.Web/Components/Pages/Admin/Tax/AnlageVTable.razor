@using Elocaro.Web.Display
<div class="table-wrapper">
    <table class="data-table">
        <thead><tr><th>Zeile</th><th>Bezeichnung</th><th class="number">Betrag</th></tr></thead>
        <tbody>
            @foreach (var line in Lines)
            {
                <tr>
                    <td>@line.LineNumber</td>
                    <td>
                        @if (line.Postings.Count == 0)
                        {
                            @line.Info.Label
                        }
                        else
                        {
                            <details>
                                <summary>@line.Info.Label (@line.Postings.Count)</summary>
                                <ul class="plain-list">
                                    @foreach (var posting in line.Postings)
                                    {
                                        <li>@Format.Date(posting.Date) · <a href="@AnlageVLinks.For(posting, PropertyId)">@posting.Text</a> · @Format.Money(posting.Amount)</li>
                                    }
                                </ul>
                            </details>
                        }
                    </td>
                    <td class="number">@Format.Money(line.Amount)</td>
                </tr>
            }
        </tbody>
        <tfoot><tr><td colspan="2">@TotalText</td><td class="number">@Format.Money(Total)</td></tr></tfoot>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<AnlageVLineResult> Lines { get; set; } = [];

    [Parameter]
    public decimal Total { get; set; }

    [Parameter]
    public string TotalText { get; set; } = "";

    [Parameter]
    public Guid PropertyId { get; set; }
}
