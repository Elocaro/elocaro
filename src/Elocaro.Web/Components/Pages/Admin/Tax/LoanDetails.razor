@page "/verwaltung/finanzen/darlehen/{LoanId:guid}"
@rendermode InteractiveServer
@using MudBlazor
@inject ILoanService Admin
@inject IPropertyService Properties
@inject Notifier Notify
@inject IDialogService Dialogs
@inject Confirmations Confirm

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (detail is null)
{
    <PageHeader Title="Darlehen nicht gefunden" Back="/verwaltung/finanzen/darlehen" BackText="Alle Darlehen" />
}
else
{
<PageHeader Title="@detail.Input.Bank" Subtitle="@($"Darlehen für {detail.PropertyName}: Tilgungsplan, Zinsen als Werbungskosten, Zahlungen und Unterlagen der Bank")" Back="/verwaltung/finanzen/darlehen" BackText="Alle Darlehen" />

<ErrorList Errors="errors" />

@if (detail.Plan.Warnings.Count > 0)
{
    <Notice Level="NoticeLevel.Warning">
        <strong>Bitte prüfen:</strong>
        <ul>
            @foreach (var warning in detail.Plan.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </Notice>
}

<MudTabs Elevation="0" Rounded="false" TabPanelsClass="mt-4" Class="detail-tabs" KeepPanelsAlive="true">
    <MudTabPanel Text="Zinsen &amp; Restschuld">
        <section>
            <h2>Zinsen und Restschuld je Jahr</h2>
            <p class="small">Eine Jahreszinsbescheinigung der Bank ersetzt den berechneten Wert. Als Werbungskosten zählt der Anteil Vermietung (@Format.Number(detail.Input.SharePercent ?? 100m) %).</p>
            <LineChart id="loan-balance" Caption="Restschuld am Jahresende" LabelHeading="Jahr" ValueHeading="Restschuld" Points="BalancePoints" />
            <SegmentBar id="loan-split" Caption="Raten im gesamten Zeitraum" Segments="SplitSegments" />
            <div class="table-wrapper">
                <table class="data-table grid-cards">
                    <thead><tr><th>Jahr</th><th class="number">Zinsen (Plan)</th><th class="number">Zinsen (Bescheinigung)</th><th class="number">Tilgung</th><th class="number">Restschuld</th></tr></thead>
                    <tbody>
                        @foreach (var year in detail.Years)
                        {
                            <tr>
                                <td>@year.Year</td>
                                <td class="number">@Format.Money(year.PlanInterest)</td>
                                <td class="number">@(year.CertificateInterest is { } certificate ? Format.Money(certificate) : "–")</td>
                                <td class="number">@Format.Money(year.Repayment)</td>
                                <td class="number">@Format.Money(year.ClosingBalance)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section>
            <h2>Tilgungsplan</h2>
            <details class="disclosure">
                <summary>@detail.Plan.Payments.Count Raten anzeigen</summary>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Fällig</th><th class="number">Zinsen</th><th class="number">Tilgung</th><th class="number">Sondertilgung</th><th class="number">Restschuld</th></tr></thead>
                        <tbody>
                            @foreach (var payment in detail.Plan.Payments)
                            {
                                <tr>
                                    <td>@Format.Date(payment.Date)</td>
                                    <td class="number">@Format.Money(payment.Interest)</td>
                                    <td class="number">@Format.Money(payment.Repayment)</td>
                                    <td class="number">@Format.Money(payment.ExtraRepayment)</td>
                                    <td class="number">@Format.Money(payment.Balance)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        </section>
    </MudTabPanel>

    <MudTabPanel Text="Zahlungen &amp; Kosten">
        @if (detail.Booked.Count > 0)
        {
            <section>
                <h2>Gebuchte Raten</h2>
                <p class="small">Aus den Bankumsätzen zugeordnet; der Zinsanteil stammt aus dem Tilgungsplan oder wurde bei der Zuordnung eingegeben.</p>
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Datum</th><th class="number">Rate</th><th class="number">Zinsen</th><th class="number">Tilgung</th></tr></thead>
                        <tbody>
                            @foreach (var rate in detail.Booked)
                            {
                                <tr>
                                    <td><a href="/verwaltung/bank/umsaetze/@rate.TransactionId/zuordnen">@Format.Date(rate.Date)</a></td>
                                    <td class="number">@Format.Money(rate.Amount)</td>
                                    <td class="number">@Format.Money(rate.Interest)</td>
                                    <td class="number">@Format.Money(rate.Repayment)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr><td>Summe</td><td class="number">@Format.Money(detail.Booked.Sum(r => r.Amount))</td><td class="number">@Format.Money(detail.Booked.Sum(r => r.Interest))</td><td class="number">@Format.Money(detail.Booked.Sum(r => r.Repayment))</td></tr></tfoot>
                    </table>
                </div>
            </section>
        }

        <section>
            <h2>Sondertilgungen</h2>
            <p class="small">Eine Sondertilgung mindert die Restschuld nach der Rate der Periode, in die sie fällt.</p>
            @if (detail.ExtraPayments.Count > 0)
            {
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead><tr><th>Datum</th><th class="number">Betrag</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var extra in detail.ExtraPayments)
                                {
                                    <tr>
                                        <td>@Format.Date(extra.Date)</td>
                                        <td class="number">@Format.Money(extra.Amount)</td>
                                        <td><MudButton Variant="Variant.Text" OnClick="() => EditExtraAsync(extra)" aria-label="@($"Sondertilgung vom {Format.Date(extra.Date)} bearbeiten")">Bearbeiten</MudButton> <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveExtraAsync(extra)" aria-label="@($"Sondertilgung vom {Format.Date(extra.Date)} entfernen")">Entfernen</MudButton></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddExtraAsync">Sondertilgung hinzufügen</MudButton>
        </section>

        <section>
            <h2>Finanzierungskosten</h2>
            <p class="small">Einmalige Kosten wie Disagio, Bereitstellungszinsen oder Grundschuldbestellung sind im Zahlungsjahr Werbungskosten.</p>
            @if (detail.Costs.Count > 0)
            {
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead><tr><th>Datum</th><th>Art</th><th>Beschreibung</th><th class="number">Betrag</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var cost in detail.Costs)
                                {
                                    <tr>
                                        <td>@Format.Date(cost.Date)</td>
                                        <td>@KindText(cost.Kind)</td>
                                        <td>@cost.Description</td>
                                        <td class="number">@Format.Money(cost.Amount)</td>
                                        <td><MudButton Variant="Variant.Text" OnClick="() => EditCostAsync(cost)" aria-label="@($"{cost.Description} bearbeiten")">Bearbeiten</MudButton> <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveCostAsync(cost)" aria-label="@($"{cost.Description} entfernen")">Entfernen</MudButton></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddCostAsync">Kosten hinzufügen</MudButton>
        </section>
    </MudTabPanel>

    <MudTabPanel Text="Unterlagen der Bank">
        <section>
            <h2>Tilgungsplan der Bank (CSV)</h2>
            <p class="small">Die Zinsen des Plans werden je Jahr summiert und wie eine Jahreszinsbescheinigung übernommen. Vorhandene Werte derselben Jahre werden ersetzt.</p>
            <AppFileUpload Text="CSV-Datei wählen" Accept=".csv,.txt" OnSelected="PlanSelectedAsync" />
            @if (plan is not null)
            {
                <ErrorList Errors="plan.Errors" />
                @foreach (var warning in plan.Warnings)
                {
                    <Notice Level="NoticeLevel.Warning">@warning</Notice>
                }

                @if (plan.Years.Count > 0)
                {
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead><tr><th>Jahr</th><th class="number">Raten</th><th class="number">Zinsen</th><th class="number">Restschuld</th></tr></thead>
                            <tbody>
                                @foreach (var year in plan.Years)
                                {
                                    <tr>
                                        <td>@year.Year</td>
                                        <td class="number">@year.Instalments</td>
                                        <td class="number">@Format.Money(year.Interest)</td>
                                        <td class="number">@(year.ClosingBalance is { } balance ? Format.Money(balance) : "–")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (plan.CanImport)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ImportPlanAsync">Als Jahreswerte übernehmen</MudButton>
                }
            }
        </section>

        <section>
            <h2>Jahreszinsbescheinigung</h2>
            @if (detail.Certificates.Count > 0)
            {
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead><tr><th>Jahr</th><th class="number">Zinsen</th><th class="number">Restschuld</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var certificate in detail.Certificates)
                                {
                                    <tr>
                                        <td>@certificate.Year</td>
                                        <td class="number">@Format.Money(certificate.Interest)</td>
                                        <td class="number">@(certificate.ClosingBalance is { } balance ? Format.Money(balance) : "–")</td>
                                        <td><MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveCertificateAsync(certificate)" aria-label="@($"Bescheinigung {certificate.Year} entfernen")">Entfernen</MudButton></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveCertificateAsync">Bescheinigung erfassen</MudButton>
        </section>
    </MudTabPanel>

    <MudTabPanel Text="Darlehensdaten">
        <section>
            <h2>Darlehensdaten</h2>
            <EditForm Model="Data" OnValidSubmit="UpdateAsync" novalidate>
                <DataAnnotationsValidator />
                <LoanEditor Data="Data!" Properties="properties" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
            </EditForm>
        </section>
    </MudTabPanel>
</MudTabs>
}
</InteractiveShell>

@code {
    private List<ChartPoint> BalancePoints => [.. detail!.Years.Select(y => new ChartPoint(
        y.Year.ToString(System.Globalization.CultureInfo.InvariantCulture),
        y.ClosingBalance,
        detail.Input.FixedUntil?.Year == y.Year ? "Zinsbindung endet" : null))];

    private List<ChartSegment> SplitSegments
    {
        get
        {
            var interest = detail!.Years.Sum(y => y.CertificateInterest ?? y.PlanInterest);
            var repayment = detail.Years.Sum(y => y.Repayment);
            return
            [
                new("Zinsen", interest, Format.Money(interest), ChartTone.Tertiary),
                new("Tilgung", repayment, Format.Money(repayment), ChartTone.Primary),
            ];
        }
    }

    private LoanDetail? detail;
    private IReadOnlyList<PropertyOverview> properties = [];
    private IReadOnlyList<string>? errors;

    [Parameter]
    public Guid LoanId { get; set; }

    private LoanInput? Data { get; set; }
    private CertificateInput Certificate { get; set; } = new();
    private ExtraPaymentInput Extra { get; set; } = new();
    private FinancingCostInput Cost { get; set; } = new();
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        properties = await Properties.ListAsync();
        await LoadAsync();
        Data = detail?.Input;
        loaded = true;
    }

    private async Task LoadAsync() => detail = await Admin.GetAsync(LoanId);

    private static string KindText(FinancingCostKind kind) => kind switch
    {
        FinancingCostKind.Disagio => "Disagio",
        FinancingCostKind.CommitmentInterest => "Bereitstellungszinsen",
        FinancingCostKind.LandCharge => "Grundschuldbestellung",
        _ => "Sonstiges",
    };

    private Task UpdateAsync() => ExecuteAsync(Admin.UpdateAsync(LoanId, Data!), "Das Darlehen wurde gespeichert.");

    private BankPlanPreview? plan;
    private byte[]? planFile;

    private async Task PlanSelectedAsync(FileSelection file)
    {
        await using var content = file.Open();
        using var buffer = new MemoryStream();
        await content.CopyToAsync(buffer);
        planFile = buffer.ToArray();
        plan = await Admin.PreviewBankPlanAsync(LoanId, planFile);
    }

    private async Task ImportPlanAsync()
    {
        if (planFile is not null && await ExecuteAsync(Admin.ImportBankPlanAsync(LoanId, planFile), "Die Jahreswerte wurden übernommen."))
        {
            plan = null;
            planFile = null;
        }
    }

    private async Task SaveCertificateAsync()
    {
        Certificate = new();
        RenderFragment fields = @<text>
            <AppYearSelect T="int?" @bind-Value="Certificate.Year" Label="Jahr" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="Certificate.Interest" Label="Zinsen laut Bescheinigung" Suffix="€" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="Certificate.ClosingBalance" Label="Restschuld zum 31.12." Suffix="€" />
        </text>;
        await ShowFormAsync("Jahreszinsbescheinigung erfassen", Certificate, fields, () => Admin.SaveCertificateAsync(LoanId, Certificate), "Die Bescheinigung wurde gespeichert.");
    }

    private async Task ShowFormAsync(string title, object model, RenderFragment fields, Func<Task<Result>> save, string success, string submit = "Speichern")
    {
        if (await Dialogs.ShowFormAsync(title, model, fields, save, submit))
        {
            Notify.Success(success);
            await LoadAsync();
        }
    }

    private async Task RemoveCertificateAsync(CertificateRow item)
    {
        if (await Confirm.AskAsync("Bescheinigung entfernen", $"Soll die Bescheinigung {item.Year} entfernt werden?", "Ja, entfernen"))
        {
            await ExecuteAsync(Admin.RemoveCertificateAsync(LoanId, item.Id), "Die Bescheinigung wurde entfernt.");
        }
    }


    private async Task EditExtraAsync(ExtraPaymentRow item)
    {
        Extra = new ExtraPaymentInput { Date = item.Date, Amount = item.Amount };
        await ShowExtraAsync(item.Id);
    }

    private async Task EditCostAsync(FinancingCostRow item)
    {
        Cost = new FinancingCostInput { Date = item.Date, Amount = item.Amount, Kind = item.Kind, Description = item.Description };
        await ShowCostAsync(item.Id);
    }

    private async Task AddExtraAsync()
    {
        Extra = new();
        await ShowExtraAsync(null);
    }

    private async Task ShowExtraAsync(Guid? id)
    {
        RenderFragment fields = @<text>
            <AppDateField @bind-Value="Extra.Date" Label="Datum" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="Extra.Amount" Label="Betrag" Suffix="€" Required="true" />
        </text>;
        await ShowFormAsync(id is null ? "Sondertilgung hinzufügen" : "Sondertilgung bearbeiten", Extra, fields,
            () => id is { } existing ? Admin.UpdateExtraPaymentAsync(LoanId, existing, Extra) : Admin.AddExtraPaymentAsync(LoanId, Extra),
            id is null ? "Die Sondertilgung wurde hinzugefügt." : "Die Sondertilgung wurde gespeichert.", id is null ? "Hinzufügen" : "Änderung speichern");
    }

    private async Task RemoveExtraAsync(ExtraPaymentRow item)
    {
        if (await Confirm.AskAsync("Sondertilgung entfernen", $"Soll die Sondertilgung vom {Format.Date(item.Date)} entfernt werden?", "Ja, entfernen"))
        {
            await ExecuteAsync(Admin.RemoveExtraPaymentAsync(LoanId, item.Id), "Die Sondertilgung wurde entfernt.");
        }
    }

    private async Task AddCostAsync()
    {
        Cost = new();
        await ShowCostAsync(null);
    }

    private async Task ShowCostAsync(Guid? id)
    {
        RenderFragment fields = @<text>
            <AppDateField @bind-Value="Cost.Date" Label="Datum" Required="true" />
            <AppSelect T="FinancingCostKind" @bind-Value="Cost.Kind" Label="Art" Items="Enum.GetValues<FinancingCostKind>()" Text="KindText" />
            <AppNumberField T="decimal?" @bind-Value="Cost.Amount" Label="Betrag" Suffix="€" Required="true" />
            <AppTextField @bind-Value="Cost.Description" Label="Beschreibung" Required="true" />
        </text>;
        await ShowFormAsync(id is null ? "Finanzierungskosten hinzufügen" : "Finanzierungskosten bearbeiten", Cost, fields,
            () => id is { } existing ? Admin.UpdateFinancingCostAsync(LoanId, existing, Cost) : Admin.AddFinancingCostAsync(LoanId, Cost),
            id is null ? "Die Kosten wurden hinzugefügt." : "Die Kosten wurden gespeichert.", id is null ? "Hinzufügen" : "Änderung speichern");
    }

    private async Task RemoveCostAsync(FinancingCostRow item)
    {
        if (await Confirm.AskAsync("Kosten entfernen", $"Sollen die Kosten „{item.Description}“ entfernt werden?", "Ja, entfernen"))
        {
            await ExecuteAsync(Admin.RemoveFinancingCostAsync(LoanId, item.Id), "Die Kosten wurden entfernt.");
        }
    }

    private async Task<bool> ExecuteAsync(Task<Result> action, string message)
    {
        var result = await action;
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success(message);
        }

        await LoadAsync();
        return result.Succeeded;
    }
}
