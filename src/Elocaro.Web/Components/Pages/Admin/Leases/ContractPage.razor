@page "/verwaltung/vertraege/{Id:guid}/vertragsdokument"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Application.Documents
@using Elocaro.Domain.Documents
@using Elocaro.Web.Documents
@inject ILeaseService Leases
@inject ILeaseContracts Contracts
@inject IContractSignatures Signatures
@inject IDocumentTemplates Templates
@inject IDocumentReadiness Readiness
@inject TemplatePreviews Previews
@inject Notifier Notify
@inject Confirmations Confirm

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (lease is null)
{
    <PageHeader Title="Vertrag nicht gefunden" Back="/verwaltung/vertraege" BackText="Alle Verträge" />
}
else
{
    <PageHeader Title="@($"Vertragsdokument {lease.RentalUnit}")" Subtitle="@lease.Property" Back="@($"/verwaltung/vertraege/{Id}")" BackText="Zum Vertrag" />

    <ErrorList Errors="errors" />

    <section>
        <h2>Entwurf erstellen</h2>
        <ReadinessNotice Issues="readiness" OnFixed="ReloadAsync" />
        @if (templates.Count > 0)
        {
            <p class="small">Der Vertrag wird aus den Stammdaten dieses Vertrags erzeugt (Parteien, Fläche, Miete, Kaution, Kostenarten). Für ein WG-Zimmer die Vorlage „Zimmervertrag“ wählen.</p>
            <div class="form-grid">
                <AppSelect T="Guid" @bind-Value="templateId" Label="Vorlage" Items="templates.Select(t => t.Id)" Text="@(id => templates.FirstOrDefault(t => t.Id == id)?.Name ?? "")" />
            </div>
            <div class="form-row">
                <MudButton Variant="Variant.Outlined" Disabled="Blocked" OnClick="PreviewAsync">Vorschau</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Blocked" OnClick="CreateAsync">Entwurf als PDF erstellen</MudButton>
            </div>
            @if (previewId is not null)
            {
                <iframe class="document-preview" src="/verwaltung/einstellungen/vorlagen/vorschau/@(previewId).pdf" title="Vorschau des Vertrags"></iframe>
            }
        }
    </section>

    <section>
        <h2>Bestehenden Vertrag ablegen</h2>
        <p class="small">Ein schon unterschriebener, älterer Vertrag (Scan oder Foto) braucht keinen Entwurf: Er wird als Dokument „Mietvertrag“ bei diesem Vertrag abgelegt.</p>
        <p><a class="button" href="/verwaltung/dokumente/neu?vertrag=@Id&kategorie=Lease">Unterschriebenen Vertrag hochladen</a></p>
    </section>

    <section>
        <h2>Entwürfe und unterschriebene Verträge</h2>
        @if (rows.Count == 0)
        {
            <EmptyState Compact="true" Text="Noch kein Vertragsdokument." />
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Erstellt</th><th>Vorlage</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td>@Format.Date(row.CreatedOn)</td>
                                <td>@row.TemplateName <span class="small">Fassung @row.TemplateRevision</span></td>
                                <td><StatusChip Level="Labels.Level(row.Status)">@Labels.From(row.Status)</StatusChip>@if (row.SignedOn is not null) {<span class="small">&#32;am @Format.Date(row.SignedOn)</span>}</td>
                                <td>
                                    <a href="/dateien/@row.DraftFileId">Entwurf (PDF)</a>
                                    @if (row.SignedDocumentId is not null) {<text> · </text><a href="/verwaltung/dokumente/@row.SignedDocumentId">Unterschrieben</a>}
                                    @if (row.Status == ContractStatus.Draft) {<text> · </text><MudButton Variant="Variant.Text" OnClick="() => SelectSigned(row.Id)" aria-label="Unterschriebenen Vertrag hochladen">Unterschrieben hochladen</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => WithdrawAsync(row)" aria-label="Vertragsentwurf verwerfen">Verwerfen</MudButton>}
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (draft is not null)
    {
        <section>
            <h2>Digitale Unterschrift</h2>
            @if (signatureRows.Count == 0)
            {
                <details class="explain">
                    <summary>So läuft die Unterschrift</summary>
                    <p class="small">Jeder Mieter erhält einen persönlichen Link per E-Mail, liest den Entwurf und unterschreibt am Bildschirm (Name, optional gezeichnet). Wenn alle unterschrieben haben, wird der Vertrag mit einer Protokollseite (Zeitpunkt, IP-Adresse, Prüfsumme) als unterschrieben abgelegt.</p>
                </details>
                <Notice Level="NoticeLevel.Info">Das ist eine einfache elektronische Signatur, keine qualifizierte (§ 126a BGB) und keine eigenhändige Unterschrift. Ein unbefristeter Wohnraummietvertrag braucht keine Schriftform. Bei einer Befristung über ein Jahr kann der Vertrag ohne Schriftform (§ 550 BGB) als unbefristet gelten: dann besser auf Papier unterschreiben lassen. Siehe docs/digitale-unterschrift.md.</Notice>
                <AppCheckBox @bind-Value="includeLandlord" Label="Ich unterschreibe auch (Sie erhalten einen eigenen Link)" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartSigningAsync">Zur Unterschrift senden</MudButton>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Wer</th><th>Stand</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var signer in signatureRows)
                            {
                                <tr>
                                    <td>@signer.SignerName<br><span class="small">@(signer.Role == SignerRole.Tenant ? "Mieter" : "Vermieter")@(signer.Email is null ? "" : " · " + signer.Email)</span></td>
                                    <td>
                                        @if (signer.SignedAt is { } at)
                                        {
                                            <StatusChip Level="StatusLevel.Success">unterschrieben</StatusChip><span class="small">&#32;@Format.Timestamp(at)</span>
                                        }
                                        else if (signer.Expired)
                                        {
                                            <StatusChip Level="StatusLevel.Error">Link abgelaufen</StatusChip>
                                        }
                                        else
                                        {
                                            <StatusChip Level="StatusLevel.Warning">offen</StatusChip><span class="small">&#32;bis @Format.Timestamp(signer.ExpiresAt)</span>
                                        }
                                    </td>
                                    <td>
                                        @if (signer.SignedAt is null)
                                        {
                                            <MudButton Variant="Variant.Text" OnClick="() => ReissueAsync(signer.Id)" aria-label="Neuen Unterschriftslink erzeugen">Neuer Link@(signer.Email is null ? "" : " senden")</MudButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (signatureRows.All(s => s.SignedAt is not null))
                {
                    <Notice Level="NoticeLevel.Warning">Alle haben unterschrieben, der Vertrag ist aber noch nicht abgelegt (z. B. war der PDF-Dienst nicht erreichbar).</Notice>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CompleteSigningAsync">Vertrag jetzt ablegen</MudButton>
                }
                else if (signatureRows.All(s => s.SignedAt is null))
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelSigningAsync">Anfrage zurückziehen</MudButton>
                }
            }

            @if (signatureLinks.Count > 0)
            {
                <Notice Level="NoticeLevel.Info">Die Links werden nur jetzt angezeigt. Mieter mit E-Mail-Adresse haben ihn per Mail erhalten.</Notice>
                @foreach (var link in signatureLinks)
                {
                    <div class="field">
                        <label for="@($"link-{link.RequestId}")">@link.SignerName@(link.Mailed ? " (per E-Mail gesendet)" : "")</label>
                        <input id="@($"link-{link.RequestId}")" type="text" readonly value="@link.Url" />
                    </div>
                }
            }
        </section>
    }

    @if (signing is not null)
    {
        <section>
            <h2>Unterschriebenen Vertrag ablegen</h2>
            <p class="small">Der Scan oder das Foto des unterschriebenen Vertrags wird bei den Dokumenten des Vertrags abgelegt. Damit gilt der Vertrag als abgeschlossen.</p>
            <EditForm Model="signedData" OnValidSubmit="ConcludeAsync" novalidate>
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <AppFileUpload Text="Datei auswählen *" Accept="application/pdf,image/*" OnSelected="f => signedFile = f" />
                    <AppDateField @bind-Value="signedData.SignedOn" Label="Unterschrieben am" Required="true" />
                </div>
                <AppCheckBox @bind-Value="signedData.ShareWithTenants" Label="Im Mieterportal freigeben" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Ablegen</MudButton>
            </EditForm>
        </section>
    }
}
</InteractiveShell>

@code {
    private LeaseDetails? lease;
    private IReadOnlyList<TemplateRow> templates = [];
    private IReadOnlyList<ReadinessIssue> readiness = [];
    private IReadOnlyList<ContractRow> rows = [];
    private IReadOnlyList<string>? errors;
    private Guid templateId;
    private Guid? previewId;
    private Guid? signing;
    private FileSelection? signedFile;
    private readonly SignedContractInput signedData = new();
    private bool loaded;
    private ContractRow? draft;
    private IReadOnlyList<SignatureRow> signatureRows = [];
    private IReadOnlyList<SignatureLink> signatureLinks = [];
    private bool includeLandlord;

    [Parameter]
    public Guid Id { get; set; }

    private bool Blocked => readiness.Any(i => i.Blocking);

    private async Task ReloadAsync()
    {
        await OnInitializedAsync();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        lease = await Leases.GetAsync(Id);
        if (lease is not null)
        {
            readiness = await Readiness.CheckAsync(TemplateKind.Contract, Id);
            templates = (await Templates.ListAsync()).Where(t => t.Kind == TemplateKind.Contract).ToList();
            // A shared-flat room gets the room contract by default.
            templateId = (lease.RoomId is not null ? templates.FirstOrDefault(t => t.Name.Contains("Zimmer", StringComparison.Ordinal)) : templates.FirstOrDefault())?.Id
                ?? templates.FirstOrDefault()?.Id ?? Guid.Empty;
            rows = await Contracts.ListAsync(Id);
            await LoadSignaturesAsync();
            signedData.SignedOn = DateOnly.FromDateTime(DateTime.Today);
        }

        loaded = true;
    }

    private async Task LoadSignaturesAsync()
    {
        draft = rows.FirstOrDefault(r => r.Status == ContractStatus.Draft);
        signatureRows = draft is null ? [] : await Signatures.ListAsync(draft.Id);
    }

    private async Task StartSigningAsync()
    {
        var result = await Signatures.StartAsync(draft!.Id, includeLandlord);
        errors = result.Succeeded ? null : result.Errors;
        signatureLinks = result.Links;
        await LoadSignaturesAsync();
    }

    private async Task ReissueAsync(Guid requestId)
    {
        var result = await Signatures.ReissueAsync(requestId);
        errors = result.Succeeded ? null : result.Errors;
        signatureLinks = result.Links;
        await LoadSignaturesAsync();
    }

    private async Task CancelSigningAsync()
    {
        var result = await Signatures.CancelAsync(draft!.Id);
        errors = result.Succeeded ? null : result.Errors;
        signatureLinks = [];
        await LoadSignaturesAsync();
    }

    private async Task CompleteSigningAsync()
    {
        var result = await Signatures.CompleteAsync(draft!.Id);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success("Der unterschriebene Vertrag wurde abgelegt.");
        }

        rows = await Contracts.ListAsync(Id);
        await LoadSignaturesAsync();
    }

    private async Task PreviewAsync()
    {
        var preview = await Contracts.PreviewAsync(templateId, Id);
        errors = preview.Errors.Count > 0 ? preview.Errors : null;
        previewId = preview.Pdf is { } pdf ? Previews.Add(pdf) : null;
    }

    private async Task CreateAsync()
    {
        var result = await Contracts.CreateDraftAsync(Id, templateId);
        errors = result.Succeeded ? null : result.Errors;
        previewId = null;
        if (result.Succeeded)
        {
            rows = await Contracts.ListAsync(Id);
            await LoadSignaturesAsync();
            Notify.Success("Der Entwurf wurde erstellt. Ein früherer offener Entwurf ist ersetzt.");
        }
    }

    private void SelectSigned(Guid contractId)
    {
        signing = contractId;
        signedFile = null;
    }

    private async Task ConcludeAsync()
    {
        if (signing is not { } contractId || signedFile is null || signedFile.Length == 0)
        {
            errors = ["Bitte die Datei des unterschriebenen Vertrags auswählen."];
            return;
        }

        await using var content = signedFile.Open();
        var result = await Contracts.ConcludeAsync(contractId, signedData, signedFile.Name, content);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            signing = null;
            rows = await Contracts.ListAsync(Id);
            await LoadSignaturesAsync();
            Notify.Success("Der unterschriebene Vertrag wurde abgelegt.");
        }
    }

    private async Task WithdrawAsync(ContractRow row)
    {
        if (!await Confirm.AskAsync("Entwurf verwerfen", "Der Entwurf wird als verworfen markiert. Die PDF-Datei bleibt erhalten.", "Ja, verwerfen"))
        {
            return;
        }

        var result = await Contracts.WithdrawAsync(row.Id);
        errors = result.Succeeded ? null : result.Errors;
        rows = await Contracts.ListAsync(Id);
        await LoadSignaturesAsync();
        if (signing == row.Id)
        {
            signing = null;
        }
    }
}
