@using MudBlazor
@using Elocaro.Domain.Deposits
@inject IDeposits Deposits
@inject Notifier Notify
@inject Confirmations Confirm
@inject IDialogService Dialogs
@* Deposit account of a lease: agreed amount, payments, interest, refund and set-offs. *@
<section id="deposit">
    <h2>Kaution</h2>
    @if (view is null)
    {
        <p class="loading" role="status">Wird geladen …</p>
    }
    else
    {
        <ErrorList Errors="errors" />
        <dl class="details">
            <dt>Vereinbart</dt><dd>@(view.Account.Agreed is { } agreed ? Format.Money(agreed) : "keine Kaution vereinbart")@(view.Note is null ? "" : " · " + view.Note)</dd>
            <dt>Eingegangen</dt><dd>@Format.Money(view.Account.Received)@(view.Account.Outstanding > 0 ? $" (noch offen: {Format.Money(view.Account.Outstanding)})" : "")</dd>
            @if (view.Account.Interest > 0)
            {
                <dt>Zinsen</dt><dd>@Format.Money(view.Account.Interest)</dd>
            }
            @if (view.Account.Refunded > 0)
            {
                <dt>Zurückgezahlt</dt><dd>@Format.Money(view.Account.Refunded)</dd>
            }
            @if (view.Account.Deducted > 0)
            {
                <dt>Verrechnet</dt><dd>@Format.Money(view.Account.Deducted)</dd>
            }
            <dt>Bestand</dt><dd><strong id="deposit-balance">@Format.Money(view.Account.Balance)</strong></dd>
        </dl>
        <details class="explain">
            <summary>Rechtliche Hinweise zur Kaution</summary>
            <p class="small">
            Die Kaution darf höchstens drei Nettokaltmieten betragen und in drei Raten gezahlt werden (§ 551 BGB); Zinsen stehen dem Mieter zu und erhöhen die Kaution.
            @if (view.LeaseEnd is not null && view.Account.Balance > 0)
            {
                <text> Das Mietverhältnis endet am @Format.Date(view.LeaseEnd.Value): nach Prüfung offener Ansprüche zurückzahlen oder verrechnen.</text>
            }
        </p>
        </details>

        @if (view.Entries.Count == 0)
        {
            <EmptyState Compact="true" Text="Noch keine Buchungen." />
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr><th>Datum</th><th>Art</th><th>Hinweis</th><th class="number">Betrag</th><th><span class="visually-hidden">Aktion</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in view.Entries)
                        {
                            <tr>
                                <td>@Format.Date(row.Date)</td>
                                <td>@Labels.From(row.Kind)</td>
                                <td>@row.Note</td>
                                <td class="number">@(row.Kind is DepositEntryKind.Refund or DepositEntryKind.Deduction ? "−" : "")@Format.Money(row.Amount)</td>
                                <td>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => EditAsync(row)" aria-label="@($"{Labels.From(row.Kind)} vom {Format.Date(row.Date)} bearbeiten")">Bearbeiten</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => DeleteAsync(row)" aria-label="@($"{Labels.From(row.Kind)} vom {Format.Date(row.Date)} löschen")">Löschen</MudButton></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddAsync">Buchung hinzufügen</MudButton>
    }
</section>

@code {
    private DepositView? view;
    private IReadOnlyList<string>? errors;
    private DepositEntryInput input = new();

    [Parameter, EditorRequired]
    public Guid LeaseId { get; set; }

    protected override async Task OnInitializedAsync() => view = await Deposits.GetAsync(LeaseId);

    private async Task AddAsync()
    {
        input = new DepositEntryInput { Kind = input.Kind };
        RenderFragment fields = @<text>
            <AppSelect @bind-Value="input.Kind" Label="Art" Items="Enum.GetValues<DepositEntryKind>()" Text="@(v => Labels.From(v))" />
            <AppDateField @bind-Value="input.Date" Label="Datum" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="input.Amount" Label="Betrag" Suffix="€" Required="true" />
            <AppTextField @bind-Value="input.Note" Label="Hinweis" Hint="@(input.Kind == DepositEntryKind.Deduction ? "Wogegen wird verrechnet? (Pflicht)" : "z. B. „Rate 1“, „Sparbuch“")" />
        </text>;
        if (await Dialogs.ShowFormAsync("Kautionsbuchung hinzufügen", input, fields, () => Deposits.AddAsync(LeaseId, input), "Buchen"))
        {
            errors = null;
            Notify.Success("Die Kautionsbuchung wurde gespeichert.");
            view = await Deposits.GetAsync(LeaseId);
        }
    }

    private async Task EditAsync(DepositRow row)
    {
        var dialog = await Dialogs.ShowAsync<DepositEntryDialog>(
            "Kautionsbuchung bearbeiten",
            new DialogParameters { ["Row"] = row },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        if (!(await dialog.Result)!.Canceled)
        {
            view = await Deposits.GetAsync(LeaseId);
        }
    }

    private async Task DeleteAsync(DepositRow row)
    {
        if (!await Confirm.AskAsync("Buchung löschen", $"{Labels.From(row.Kind)} über {Format.Money(row.Amount)} vom {Format.Date(row.Date)} löschen?", "Ja, löschen"))
        {
            return;
        }

        var result = await Deposits.DeleteAsync(row.Id);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success("Die Buchung wurde gelöscht.");
            view = await Deposits.GetAsync(LeaseId);
        }
    }
}
