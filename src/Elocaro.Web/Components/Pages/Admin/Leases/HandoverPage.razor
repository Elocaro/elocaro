@page "/verwaltung/vertraege/{Id:guid}/uebergabe/{Kind}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using MudBlazor
@using Elocaro.Web.Documents
@inject IHandovers Handovers
@inject TemplatePreviews Previews
@inject IJSRuntime JS
@inject Notifier Notify
@inject IDialogService Dialogs
@inject Confirmations Confirm

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (!valid)
{
    <PageHeader Title="Protokoll nicht gefunden" Back="@($"/verwaltung/vertraege/{Id}")" BackText="Zum Vertrag" />
}
else if (view is null)
{
    <PageHeader Title="@($"Übergabeprotokoll {TypeName}")" Back="@($"/verwaltung/vertraege/{Id}")" BackText="Zum Vertrag" />
    <ErrorList Errors="errors" />
    <p>Es gibt noch kein Protokoll. Die Räume, Schlüsselarten und Zähler werden aus den Stammdaten vorbelegt@(Type == HandoverType.MoveOut ? "; beim Auszug dient das Einzugsprotokoll als Ausgangspunkt" : "").</p>
    <EditForm Model="this" OnSubmit="CreateAsync" novalidate>
        <div class="form-grid">
            <AppDateField @bind-Value="date" Label="Datum der Übergabe" Required="true" />
        </div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Protokoll anlegen</MudButton>
    </EditForm>
}
else
{
    <PageHeader Title="@($"Übergabeprotokoll {TypeName}")" Subtitle="@($"{view.RentalUnit} · {view.Tenants}")" Back="@($"/verwaltung/vertraege/{Id}")" BackText="Zum Vertrag" />
    <ErrorList Errors="errors" />

    @if (view.Status == HandoverStatus.Completed)
    {
        <Notice Level="NoticeLevel.Success">Unterschrieben am @Format.Timestamp(view.SignedAt) von @view.SignedByName. Das Protokoll ist bei den Dokumenten des Vertrags abgelegt und im Mieterportal sichtbar.</Notice>
        <Notice Level="NoticeLevel.Info" id="residence-confirmation-hint">
            Wohnungsgeberbestätigung nicht vergessen: Sie muss binnen zwei Wochen nach @(Type == HandoverType.MoveOut ? "dem Auszug" : "dem Einzug") ausgestellt werden (§ 19 BMG).
            Die Vorlage „Wohnungsgeberbestätigung @(Type == HandoverType.MoveOut ? "Auszug" : "Einzug")“ erzeugen Sie unter <a href="/verwaltung/dokumente/schreiben">Schreiben an Mieter</a>.
        </Notice>
        <div class="form-row">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/dateien/{view.DocumentFileId}")">Protokoll (PDF)</MudButton>
            <MudButton Variant="Variant.Outlined" Href="@($"/verwaltung/dokumente/{view.DocumentId}")">Zum Dokument</MudButton>
        </div>
    }

    @if (Type == HandoverType.MoveOut && view.Differences.Count > 0)
    {
        <section>
            <h2>Vergleich mit dem Einzug</h2>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Bereich</th><th>Feststellung</th><th>Einordnung</th></tr></thead>
                    <tbody>
                        @foreach (var difference in view.Differences)
                        {
                            <tr>
                                <td>@difference.Room</td>
                                <td>@difference.Text</td>
                                <td><StatusChip Level="@(difference.Kind == DifferenceKind.KnownDefect ? StatusLevel.Neutral : StatusLevel.Warning)">@DifferenceText(difference.Kind)</StatusChip></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="@dirty" />
    <EditForm EditContext="editContext" OnSubmit="SaveAsync" novalidate>
        <fieldset disabled="@(view.Status == HandoverStatus.Completed)">
            <MudTabs Elevation="0" Rounded="false" TabPanelsClass="mt-4" Class="detail-tabs" KeepPanelsAlive="true">
            <MudTabPanel Text="Zustand">
            <section>
                <h2>Übergabe</h2>
                <div class="form-grid">
                    <AppDateField @bind-Value="date" Label="Datum der Übergabe" Required="true" />
                </div>
            </section>

            <section>
                <h2>Räume und Zustand</h2>
                @foreach (var room in view.Content.Rooms)
                {
                    <details class="field">
                        <summary>@room.Name @RoomSummary(room)</summary>
                        @foreach (var item in room.Items)
                        {
                            <div class="handover-item">
                                <strong>@item.Component</strong>
                                <AppSelect T="ItemCondition" @bind-Value="item.Condition" Label="Zustand" Items="Enum.GetValues<ItemCondition>()" Text="@(v => ConditionText(v))" />
                                <AppTextField @bind-Value="item.Note" Label="Bemerkung" />
                            </div>
                        }
                    </details>
                }
            </section>

            <section>
                <h2>Mängel und Fotos</h2>
                @for (var i = 0; i < view.Content.Defects.Count; i++)
                {
                    var defect = view.Content.Defects[i];
                    <div class="field">
                        <div class="form-grid">
                            <AppSelect T="string" @bind-Value="defect.Room" Label="Raum" Items="RoomNames" EmptyText="allgemein" />
                            <AppTextField @bind-Value="defect.Description" Label="Mangel / Auffälligkeit" Lines="2" />
                        </div>
                        @if (defect.SourceId is not null) {<p class="small">Bereits beim Einzug festgehalten.</p>}
                        <div class="thumbnails">
                            @foreach (var photo in defect.PhotoFileIds)
                            {
                                <img src="/dateien/@photo" alt="Foto zum Mangel" />
                            }
                        </div>
                        <div class="form-row">
                            <AppFileUpload Text="Foto aufnehmen" Accept="image/*" Capture="environment" OnSelected="f => AddDefectPhotoAsync(defect, f)" />
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveDefect(defect)" aria-label="Mangel entfernen">Entfernen</MudButton>
                        </div>
                    </div>
                }

                <MudButton Variant="Variant.Outlined" OnClick="AddDefect">Mangel hinzufügen</MudButton>
            </section>
            </MudTabPanel>

            <MudTabPanel Text="Schlüssel und Zähler">
            <section>
                <h2>Schlüssel</h2>
                @if (view.Content.Keys.Count > 0)
                {
                    <MudTable T="HandoverKey" Items="view.Content.Keys" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Dense="true" id="handover-keys">
                        <HeaderContent>
                            <MudTh>Art</MudTh><MudTh Style="text-align:right">Anzahl</MudTh><MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate Context="key">
                            <MudTd DataLabel="Art">@key.Kind</MudTd>
                            <MudTd DataLabel="Anzahl" Style="text-align:right">@key.Count</MudTd>
                            <MudTd Style="text-align:right; white-space:nowrap">
                                <MudButton Variant="Variant.Text" OnClick="() => EditKeyAsync(key)" aria-label="@($"{key.Kind} bearbeiten")">Bearbeiten</MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => { view.Content.Keys.Remove(key); dirty = true; }" aria-label="@($"{key.Kind} entfernen")">Entfernen</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                <MudButton Variant="Variant.Outlined" OnClick="AddKeyAsync">Schlüsselart hinzufügen</MudButton>
            </section>

            @if (view.Content.Meters.Count > 0)
            {
                <section>
                    <h2>Zählerstände</h2>
                    <p class="small">Die Stände werden als Zwischenablesung zum Übergabetag erfasst und für die Nebenkostenabrechnung verwendet.</p>
                    @foreach (var meter in view.Content.Meters)
                    {
                        <div class="form-grid">
                            <AppNumberField T="decimal?" @bind-Value="meter.Value" Label="@($"{meter.Name} ({meter.Number})")" Suffix="@meter.Unit" />
                            <div>
                                <AppFileUpload Text="Foto des Zählers" Accept="image/*" Capture="environment" OnSelected="f => AddMeterPhotoAsync(meter, f)" />
                                @if (meter.PhotoFileId is { } photo) {<div class="thumbnails"><img src="/dateien/@photo" alt="Foto des Zählers" /></div>}
                            </div>
                        </div>
                    }
                </section>
            }

            @if (Type == HandoverType.MoveOut)
            {
                <section>
                    <h2>Neue Anschrift der Mieter</h2>
                    <p class="small">Für die Zustellung der Nebenkostenabrechnung und der Kautionsabrechnung. Sie wird beim Unterschreiben bei den Mietern hinterlegt.</p>
                    <div class="form-grid">
                        <AppTextField @bind-Value="view.Content.NewStreet" Label="Straße und Hausnummer" />
                        <AppTextField @bind-Value="view.Content.NewPostalCode" Label="PLZ" />
                        <AppTextField @bind-Value="view.Content.NewCity" Label="Ort" />
                    </div>
                    <Notice Level="NoticeLevel.Info">Die Nebenkostenabrechnung folgt nach Vorliegen der Gesamtabrechnung. Über die Kaution wird nach einer Prüffrist abgerechnet; ein Teil kann bis zur Nebenkostenabrechnung einbehalten werden. Beides steht auch im Protokoll.</Notice>
                </section>
            }

            </MudTabPanel>

            <MudTabPanel Text="Bemerkungen">
            <section>
                <h2>Bemerkungen</h2>
                <AppTextField @bind-Value="view.Content.Remarks" Label="Bemerkungen" Lines="3" />
            </section>
            </MudTabPanel>
            </MudTabs>
        </fieldset>

        @if (view.Status == HandoverStatus.Draft)
        {
            <div class="form-row">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Speichern</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="PreviewAsync">Vorschau (PDF)</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="DeleteAsync">Protokoll löschen</MudButton>
            </div>
            <p class="help">Nächster Schritt: Protokoll speichern, dann unten vom Mieter unterschreiben lassen oder einen unterschriebenen Ausdruck ablegen.</p>
        }
    </EditForm>

    @if (previewId is not null)
    {
        <iframe class="document-preview" src="/verwaltung/einstellungen/vorlagen/vorschau/@(previewId).pdf" title="Vorschau des Protokolls"></iframe>
    }

    @if (view.Status == HandoverStatus.Draft)
    {
        <section>
            <h2>Unterschreiben</h2>
            <AppTextField @bind-Value="signedBy" Label="Name der unterschreibenden Person (Mieter)" Required="true" />
            <p class="small">Unterschrift des Mieters (mit dem Finger oder Stift):</p>
            <canvas @ref="tenantCanvas" class="signature-field" aria-label="Unterschrift des Mieters"></canvas>
            <MudButton Variant="Variant.Text" OnClick="() => ClearAsync(tenantCanvas)" aria-label="Feld für die Mieter-Unterschrift leeren">Löschen</MudButton>
            <p class="small">Unterschrift des Vermieters (optional):</p>
            <canvas @ref="landlordCanvas" class="signature-field" aria-label="Unterschrift des Vermieters"></canvas>
            <MudButton Variant="Variant.Text" OnClick="() => ClearAsync(landlordCanvas)" aria-label="Feld für die Vermieter-Unterschrift leeren">Löschen</MudButton>

            @if (warnings.Count > 0)
            {
                <Notice Level="NoticeLevel.Warning">
                    <strong>Bitte prüfen:</strong>
                    <ul>@foreach (var warning in warnings) {<li>@warning</li>}</ul>
                    Die Zählerstände sind trotzdem richtig? Dann erneut unterschreiben und bestätigen.
                </Notice>
            }

            <div class="form-row">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SignAsync(warnings.Count > 0)">@(warnings.Count > 0 ? "Trotzdem unterschreiben und ablegen" : "Unterschreiben und ablegen")</MudButton>
            </div>
        </section>

        <section>
            <h2>Oder: unterschriebenen Ausdruck ablegen</h2>
            <p class="small">Protokoll als PDF ausdrucken, unterschreiben lassen und den Scan oder ein Foto hier hochladen. Der Name ist der des Unterzeichners.</p>
            <div class="form-grid">
                <AppFileUpload Text="Scan oder Foto wählen" Accept="application/pdf,image/*" OnSelected="f => scan = f" />
            </div>
            <MudButton Variant="Variant.Outlined" OnClick="() => SignScanAsync(warnings.Count > 0)">Scan ablegen</MudButton>
        </section>
    }
}
</InteractiveShell>

@code {
    private async Task AddKeyAsync()
    {
        var dialog = await Dialogs.ShowAsync<HandoverKeyDialog>("Schlüsselart", new DialogParameters(), ListDialogOptions);
        if (await dialog.Result is { Canceled: false, Data: HandoverKey added })
        {
            view!.Content.Keys.Add(added);
            dirty = true;
        }
    }

    private async Task EditKeyAsync(HandoverKey key)
    {
        var dialog = await Dialogs.ShowAsync<HandoverKeyDialog>("Schlüsselart bearbeiten", new DialogParameters { ["Existing"] = key }, ListDialogOptions);
        if (await dialog.Result is { Canceled: false, Data: HandoverKey changed })
        {
            view!.Content.Keys[view.Content.Keys.IndexOf(key)] = changed;
            dirty = true;
        }
    }

    private static readonly DialogOptions ListDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    private IJSObjectReference? module;
    private Task? moduleReady;
    private ElementReference tenantCanvas;
    private ElementReference landlordCanvas;
    private bool canvasReady;
    private HandoverView? view;
    private EditContext? editContext;
    private bool dirty;
    private IReadOnlyList<string>? errors;
    private List<string> warnings = [];
    private DateOnly? date;
    private string? signedBy;
    private FileSelection? scan;
    private Guid? previewId;
    private bool loaded;
    private bool valid = true;

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public string Kind { get; set; } = "";

    private HandoverType Type => Kind == "auszug" ? HandoverType.MoveOut : HandoverType.MoveIn;

    private string TypeName => Type == HandoverType.MoveOut ? "Auszug" : "Einzug";

    private IEnumerable<string> RoomNames => view?.Content.Rooms.Select(r => r.Name) ?? [];

    protected override async Task OnInitializedAsync()
    {
        valid = Kind is "einzug" or "auszug";
        if (valid)
        {
            await ReloadAsync();
            date ??= DateOnly.FromDateTime(DateTime.Today);
        }

        loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (view is { Status: HandoverStatus.Draft } && !canvasReady && tenantCanvas.Id is not null)
        {
            canvasReady = true;
            moduleReady = LoadSignatureAsync();
            await moduleReady;
        }
    }

    private async Task LoadSignatureAsync()
    {
        var loaded = await JS.InvokeAsync<IJSObjectReference>("import", "/js/signature.js");
        await loaded.InvokeVoidAsync("init", tenantCanvas);
        await loaded.InvokeVoidAsync("init", landlordCanvas);
        module = loaded;
    }

    private async Task ReloadAsync()
    {
        view = await Handovers.GetAsync(Id, Type);
        if (view is not null)
        {
            date = view.Date;
            signedBy ??= view.Tenants;
            editContext = new EditContext(view.Content);
            editContext.OnFieldChanged += (_, _) => dirty = true;
        }

        dirty = false;
    }

    /// <summary>Unsaved input is lost when the page is left: ask first (the browser asks itself for external navigation).</summary>
    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (dirty && !await Confirm.AskAsync("Ungespeicherte Änderungen", "Das Protokoll enthält Änderungen, die noch nicht gespeichert sind. Die Seite trotzdem verlassen?", "Ja, verlassen"))
        {
            context.PreventNavigation();
        }
    }

    private async Task CreateAsync()
    {
        var result = await Handovers.CreateAsync(Id, Type, date ?? DateOnly.FromDateTime(DateTime.Today));
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            await ReloadAsync();
        }
    }

    private async Task<bool> PersistAsync()
    {
        if (view is null || view.Status != HandoverStatus.Draft)
        {
            return true;
        }

        var result = await Handovers.SaveAsync(view.Id, date ?? view.Date, view.Content);
        errors = result.Succeeded ? null : result.Errors;
        return result.Succeeded;
    }

    private async Task SaveAsync()
    {
        if (await PersistAsync())
        {
            await ReloadAsync();
            Notify.Success("Das Protokoll wurde gespeichert.");
        }
    }

    private async Task PreviewAsync()
    {
        if (!await PersistAsync())
        {
            return;
        }

        var preview = await Handovers.PreviewAsync(view!.Id);
        errors = preview.Errors.Count > 0 ? preview.Errors : null;
        previewId = preview.Pdf is { } pdf ? Previews.Add(pdf) : null;
    }

    private void AddDefect()
    {
        view!.Content.Defects.Add(new HandoverDefect());
        dirty = true;
    }

    private void RemoveDefect(HandoverDefect defect)
    {
        view!.Content.Defects.Remove(defect);
        dirty = true;
    }

    private async Task AddDefectPhotoAsync(HandoverDefect defect, FileSelection file)
    {
        var id = await UploadAsync(file);
        if (id is not null)
        {
            defect.PhotoFileIds.Add(id.Value);
            await PersistAsync();
        }
    }

    private async Task AddMeterPhotoAsync(HandoverMeterReading meter, FileSelection file)
    {
        var id = await UploadAsync(file);
        if (id is not null)
        {
            meter.PhotoFileId = id;
            await PersistAsync();
        }
    }

    private async Task<Guid?> UploadAsync(FileSelection file)
    {
        await using var content = file.Open();
        var result = await Handovers.AddPhotoAsync(view!.Id, file.Name, content);
        errors = result.Succeeded ? null : result.Errors;
        return result.Succeeded ? result.Id : null;
    }

    private async Task ClearAsync(ElementReference canvas)
    {
        await WhenSignatureReadyAsync();
        if (module is not null)
        {
            await module.InvokeVoidAsync("clear", canvas);
        }
    }

    /// <summary>A quick click can arrive while the signature script is still loading: wait for it instead of ignoring the click.</summary>
    private async Task WhenSignatureReadyAsync()
    {
        if (moduleReady is not null)
        {
            await moduleReady;
        }
    }

    private async Task SignAsync(bool confirm)
    {
        await WhenSignatureReadyAsync();
        if (module is null || !await PersistAsync())
        {
            return;
        }

        if (await module.InvokeAsync<bool>("isEmpty", tenantCanvas))
        {
            errors = ["Bitte unterschreiben (Unterschrift des Mieters fehlt)."];
            return;
        }

        var signature = new HandoverSignature
        {
            SignedByName = signedBy ?? "",
            TenantSignature = Convert.FromBase64String(await module.InvokeAsync<string>("toPng", tenantCanvas)),
            LandlordSignature = await module.InvokeAsync<bool>("isEmpty", landlordCanvas) ? null : Convert.FromBase64String(await module.InvokeAsync<string>("toPng", landlordCanvas)),
        };
        await FinishAsync(await Handovers.SignAsync(view!.Id, signature, confirm));
    }

    private async Task SignScanAsync(bool confirm)
    {
        if (scan is null || scan.Length == 0)
        {
            errors = ["Bitte den Scan oder das Foto des unterschriebenen Protokolls auswählen."];
            return;
        }

        if (!await PersistAsync())
        {
            return;
        }

        await using var content = scan.Open();
        await FinishAsync(await Handovers.SignWithScanAsync(view!.Id, signedBy ?? "", scan.Name, content, confirm));
    }

    private async Task FinishAsync(HandoverSignResult result)
    {
        errors = result.Errors.Count > 0 ? result.Errors : null;
        warnings = [.. result.Warnings];
        if (result.Succeeded)
        {
            previewId = null;
            await ReloadAsync();
            Notify.Success("Das Protokoll ist unterschrieben und abgelegt, die Zählerstände sind erfasst.");
        }
    }

    private async Task DeleteAsync()
    {
        if (!await Confirm.AskAsync("Protokoll löschen", "Das Protokoll mit allen Eingaben wird gelöscht. Hochgeladene Fotos bleiben im Dateispeicher.", "Ja, löschen"))
        {
            return;
        }

        var result = await Handovers.DeleteAsync(view!.Id);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            view = null;
        }
    }

    private static string ConditionText(ItemCondition value) => value switch
    {
        ItemCondition.Wear => "Gebrauchsspuren",
        ItemCondition.Defect => "Mangel",
        _ => "in Ordnung",
    };

    private static string DifferenceText(DifferenceKind kind) => kind switch
    {
        DifferenceKind.Worse => "verschlechtert",
        DifferenceKind.NewDefect => "neu",
        DifferenceKind.KnownDefect => "schon beim Einzug",
        _ => "fehlt",
    };

    private static string RoomSummary(HandoverRoom room)
    {
        var defects = room.Items.Count(i => i.Condition == ItemCondition.Defect);
        var wear = room.Items.Count(i => i.Condition == ItemCondition.Wear);
        return defects > 0 ? $"· {defects} Mangel" : wear > 0 ? $"· {wear}× Gebrauchsspuren" : "";
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
