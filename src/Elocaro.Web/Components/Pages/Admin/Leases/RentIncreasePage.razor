@page "/verwaltung/vertraege/{Id:guid}/mieterhoehung"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Application.Documents
@using Elocaro.Domain.Documents
@using Elocaro.Web.Documents
@inject IRentIncreases Increases
@inject IDocumentTemplates Templates
@inject IDocumentReadiness Readiness
@inject TemplatePreviews Previews
@inject Notifier Notify
@inject IDialogService Dialogs
@inject Confirmations Confirm

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (overview is null)
{
    <PageHeader Title="Vertrag nicht gefunden" Back="/verwaltung/vertraege" BackText="Alle Verträge" />
}
else
{
    <PageHeader Title="@($"Mieterhöhung {overview.RentalUnit}")" Subtitle="@overview.Property" Back="@($"/verwaltung/vertraege/{Id}")" BackText="Zum Vertrag" />

    <ErrorList Errors="errors" />

    <dl class="details">
        <dt>Mietmodell</dt><dd>@Labels.From(overview.Model)</dd>
        <dt>Grundmiete heute</dt><dd>@Format.Money(overview.BaseRent)</dd>
        <dt>Letzte Erhöhung</dt><dd>@(overview.LastIncrease is { } last ? Format.Date(last) : "keine seit Mietbeginn")</dd>
        <dt>Kappungsgrenze</dt><dd>@overview.CapPercent % in drei Jahren (am Objekt einstellbar) · Miete vor drei Jahren @Format.Money(overview.RentThreeYearsAgo)</dd>
        <dt>Wohnfläche für den Mietspiegel</dt><dd>@(overview.LivingArea is { } area ? $"{area:N2} m²" : "nicht hinterlegt")</dd>
        <dt>Frühester Zugang eines Verlangens</dt><dd>@Format.Date(overview.EarliestDeclaration)</dd>
    </dl>

    <section>
        <h2>Neues Schreiben</h2>
        <EditForm Model="input" novalidate>
        <div class="form-grid">
            <AppSelect T="RentIncreaseKind" Value="input.Kind" ValueChanged="OnKindChanged" Label="Art" Items="Kinds" Text="@(v => Labels.From(v))" />
            <AppSelect T="Guid" Value="input.TemplateId ?? Guid.Empty" ValueChanged="v => input.TemplateId = v" Label="Vorlage" Items="KindTemplates.Select(t => t.Id)" Text="@(id => templates.FirstOrDefault(t => t.Id == id)?.Name ?? "")" />
            <AppDateField @bind-Value="input.PlannedDeclaration" Label="Voraussichtlicher Zugang beim Mieter" Hint="Danach richten sich die Termine im Schreiben; maßgeblich ist später der tatsächliche Zugang." />
        </div>
        <ReadinessNotice Issues="readiness" OnFixed="ReloadAsync" />

        @switch (input.Kind)
        {
            case RentIncreaseKind.Comparative:
                <p class="small">Zustimmungsverlangen nach § 558 BGB. Die Begründung (Mietspiegel, Vergleichswohnungen oder Gutachten) ist Pflicht.</p>
                <div class="form-grid">
                    <AppSelect T="ComparativeBasis" @bind-Value="input.Basis" Label="Begründung durch" Items="Enum.GetValues<ComparativeBasis>()" Text="@(v => Labels.From(v))" />
                    <AppNumberField T="decimal?" @bind-Value="input.NewAmount" Label="Neue Grundmiete" Suffix="€" Hint="Leer = die höchste zulässige Miete" />
                </div>
                @if (input.Basis == ComparativeBasis.RentIndex)
                {
                    <div class="form-grid">
                        <AppTextField @bind-Value="input.RentIndexName" Label="Mietspiegel" Required="true" Hint="Gemeinde und Jahr, z. B. „Köln 2025“" />
                        <AppNumberField T="decimal?" @bind-Value="input.PerSquareMetreFrom" Label="Spanne von" Suffix="€/m²" />
                        <AppNumberField T="decimal?" @bind-Value="input.PerSquareMetreTo" Label="Spanne bis" Suffix="€/m²" />
                        <AppNumberField T="decimal?" @bind-Value="input.PerSquareMetre" Label="Einordnung der Wohnung" Suffix="€/m²" Required="true" />
                    </div>
                    <AppTextField @bind-Value="input.FeatureText" Label="Begründung der Einordnung" Lines="3" Hint="Merkmale der Wohnung, z. B. Baujahr, Ausstattung, Lage (aus Objekt und Einheit)" />
                }
                else if (input.Basis == ComparativeBasis.Comparables)
                {
                    <p class="small">Mindestens drei vergleichbare Wohnungen. Maßgeblich für die zulässige Miete ist der niedrigste Preis je m².</p>
                    @if (input.Comparables.Count > 0)
                    {
                        <MudTable T="ComparableFlatInput" Items="input.Comparables" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Dense="true" id="comparables">
                            <HeaderContent>
                                <MudTh>Anschrift</MudTh><MudTh Style="text-align:right">Fläche</MudTh><MudTh Style="text-align:right">Nettokaltmiete</MudTh><MudTh Style="text-align:right">je m²</MudTh><MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate Context="flat">
                                <MudTd DataLabel="Anschrift">@flat.Address</MudTd>
                                <MudTd DataLabel="Fläche" Style="text-align:right">@Format.Area(flat.Area)</MudTd>
                                <MudTd DataLabel="Nettokaltmiete" Style="text-align:right">@Format.Money(flat.Rent)</MudTd>
                                <MudTd DataLabel="je m²" Style="text-align:right">@(flat is { Area: > 0, Rent: not null } ? Format.Money(flat.Rent / flat.Area) : "–")</MudTd>
                                <MudTd Style="text-align:right; white-space:nowrap">
                                    <MudButton Variant="Variant.Text" OnClick="() => EditComparableAsync(flat)" aria-label="@($"{flat.Address} bearbeiten")">Bearbeiten</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => input.Comparables.Remove(flat)" aria-label="@($"{flat.Address} entfernen")">Entfernen</MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }

                    <MudButton Variant="Variant.Outlined" OnClick="AddComparableAsync">Vergleichswohnung hinzufügen</MudButton>
                }
                else
                {
                    <div class="form-grid">
                        <AppTextField @bind-Value="input.AppraiserName" Label="Sachverständiger" Required="true" />
                        <AppDateField @bind-Value="input.AppraisalDate" Label="Datum des Gutachtens" />
                        <AppNumberField T="decimal?" @bind-Value="input.AppraisalRent" Label="Vergleichsmiete laut Gutachten" Suffix="€" Required="true" />
                    </div>
                    <p class="small">Das Gutachten ist dem Schreiben beizufügen.</p>
                }

                break;
            case RentIncreaseKind.Index:
                @if (overview.Index is { } index)
                {
                    <p>Neuester VPI: @Format.Month(index.CpiMonth) = @index.CpiValue.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("de-DE")) (@index.ChangePercent.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("de-DE")) % seit dem Ausgangsindex) → neue Grundmiete <strong>@Format.Money(index.NewBaseRent)</strong>. Frühestens wirksam ab @Format.Date(index.EarliestEffective).</p>
                }
                else
                {
                    <p class="small">Es gibt keinen VPI-Wert, der neuer ist als der Ausgangsindex, oder der Vertrag ist keine Indexmiete. Den Verbraucherpreisindex unter „Verbraucherpreisindex“ pflegen.</p>
                }

                <p class="small">Die Anpassung braucht keine Zustimmung. Mit dem erfassten Zugang wird die neue Miete im Vertrag eingetragen.</p>
                break;
            case RentIncreaseKind.Graduated:
                @if (overview.NextStep is { } step)
                {
                    <p>Nächste Staffel: ab @Format.Date(step.From) <strong>@Format.Money(step.BaseRent)</strong>. Die Staffel gilt ohne Erklärung; das Schreiben ist eine freiwillige Information.</p>
                }
                else
                {
                    <p class="small">Es gibt keine kommende Staffel.</p>
                }

                break;
            case RentIncreaseKind.Modernisation:
                <details class="explain">
                    <summary>Mieterhöhung nach Modernisierung</summary>
                    <p class="small">Mieterhöhung nach Modernisierung (§ 559 BGB): 8 % der umlagefähigen Kosten im Jahr, begrenzt auf 3 € je m² in sechs Jahren (2 € bei einer Miete unter 7 €/m²). Sie braucht keine Zustimmung; mit dem erfassten Zugang wird die neue Miete im Vertrag eingetragen.</p>
                </details>
                <AppTextField @bind-Value="input.ModernisationDescription" Label="Durchgeführte Maßnahme" Lines="4" Required="true" Hint="Art und Umfang der Maßnahme und ihr Nutzen, z. B. Energieeinsparung durch neue Fenster" />
                <div class="form-grid">
                    <AppNumberField T="decimal?" @bind-Value="input.ModernisationCosts" Label="Kosten für diese Wohnung" Suffix="€" Required="true" Hint="Anteil der Gesamtkosten, der auf die Wohnung entfällt" />
                    <AppNumberField T="decimal?" @bind-Value="input.MaintenanceShare" Label="Davon Instandhaltung" Suffix="€" Hint="Nicht umlagefähig; ohne Angabe 0 €. Im vereinfachten Verfahren pauschal 30 %." />
                </div>
                <AppCheckBox @bind-Value="input.Simplified" Label="Vereinfachtes Verfahren (§ 559c): Kosten bis 10.000 €, einmal in fünf Jahren, kein Härteeinwand" />
                <AppCheckBox @bind-Value="input.AnnouncedProperly" Label="Die Maßnahme wurde angekündigt (§ 555c) und die Kosten liegen höchstens 10 % über der Ankündigung" />
                break;
            default:
                <p class="small">Anpassung der Betriebskostenpauschale nach § 560 BGB. Bisherige Pauschale: @Format.Money(overview.FlatRate).</p>
                <div class="form-grid">
                    <AppNumberField T="decimal?" @bind-Value="input.NewAmount" Label="Neue Pauschale" Suffix="€" Required="true" />
                </div>
                <AppCheckBox @bind-Value="input.ReservationConfirmed" Label="Der Mietvertrag sieht die Erhöhung der Pauschale vor" />
                <AppTextField @bind-Value="input.CostReason" Label="Grund und Erläuterung" Lines="4" Required="true" Hint="Welche Kosten sind gestiegen, von wann auf wann? Ohne Erläuterung ist die Erklärung unwirksam." />
                break;
        }

        <div class="form-row">
            <MudButton Variant="Variant.Outlined" OnClick="CheckAsync">Prüfen</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="Blocked" OnClick="PreviewAsync">Vorschau</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Blocked" OnClick="CreateAsync">Schreiben erzeugen</MudButton>
        </div>
        <details class="explain">
            <summary>Prüfen, Vorschau und Schreiben</summary>
            <p class="help">„Prüfen“ nennt Fristen und Grenzen (z. B. Kappung), „Vorschau“ zeigt das Schreiben als PDF, ohne etwas zu speichern. Erst „Schreiben erzeugen“ legt es bei den Dokumenten des Vertrags ab.</p>
        </details>

        </EditForm>

        @if (check is not null)
        {
            @foreach (var error in check.Errors)
            {
                <Notice Level="NoticeLevel.Error">@error</Notice>
            }

            @foreach (var warning in check.Warnings)
            {
                <Notice Level="NoticeLevel.Warning">@warning</Notice>
            }

            @if (check.IsAllowed)
            {
                <Notice Level="NoticeLevel.Success">
                    Zulässig.
                    @if (check.NewAmount is { } amount) {<text> Neuer Betrag @Format.Money(amount).</text>}
                    @if (check.MaxRent is { } max) {<text> Höchstens zulässig: @Format.Money(max) (Kappungsgrenze @Format.Money(check.CapLimit)@(check.ComparativeRent is { } cr ? $", Vergleichsmiete {Format.Money(cr)}" : "")).</text>}
                    @if (check.EffectiveFrom is { } from) {<text> Wirksam ab @Format.Date(from).</text>}
                    @if (check.ConsentDeadline is { } deadline) {<text> Zustimmung bis @Format.Date(deadline).</text>}
                </Notice>
            }
            else if (check.EarliestDeclaration is { } earliest)
            {
                <p class="small">Frühester Zugang, mit dem alle Fristen eingehalten sind: @Format.Date(earliest).</p>
            }
        }

        @if (previewId is not null)
        {
            <iframe class="document-preview" src="/verwaltung/einstellungen/vorlagen/vorschau/@(previewId).pdf" title="Vorschau des Schreibens"></iframe>
        }
    </section>

    <section>
        <h2>Schreiben und Stand</h2>
        @if (overview.Increases.Count == 0)
        {
            <EmptyState Compact="true" Text="Noch keine Schreiben." />
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Art</th><th class="number">Bisher</th><th class="number">Neu</th><th>Termine</th><th>Stand</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var row in overview.Increases)
                        {
                            <tr>
                                <td>@Labels.From(row.Kind)<br><span class="small">@row.Summary</span></td>
                                <td class="number">@Format.Money(row.CurrentAmount)</td>
                                <td class="number">@Format.Money(row.NewAmount)</td>
                                <td>
                                    ab @Format.Date(row.EffectiveFrom)
                                    @if (row.DeclaredOn is { } declared) {<br><span class="small">zugegangen @Format.Date(declared)</span>}
                                    @if (row.ConsentDeadline is { } deadline) {<br><span class="small">Zustimmung bis @Format.Date(deadline)</span>}
                                    @if (row.ConsentOn is { } consent) {<br><span class="small">zugestimmt @Format.Date(consent)</span>}
                                </td>
                                <td><StatusChip Level="Labels.Level(row.Status)">@Labels.From(row.Status)</StatusChip></td>
                                <td>
                                    @if (row.DocumentId is not null) {<a href="/verwaltung/dokumente/@row.DocumentId">Schreiben</a>}
                                    @if (row.Status == RentIncreaseStatus.Draft) {<MudButton Variant="Variant.Text" OnClick="() => Act(row.Id, Step.Declare)">Zugang erfassen</MudButton>}
                                    @if (row.Status == RentIncreaseStatus.Declared && row.Kind == RentIncreaseKind.Comparative) {<MudButton Variant="Variant.Text" OnClick="() => Act(row.Id, Step.Agree)">Zustimmung erfassen</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RefuseAsync(row)">Abgelehnt / Frist abgelaufen</MudButton>}
                                    @if (row.Status == RentIncreaseStatus.Draft || (row.Status == RentIncreaseStatus.Declared && row.Kind == RentIncreaseKind.Comparative)) {<MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => WithdrawAsync(row)">Verwerfen</MudButton>}
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (acting is not null)
        {
            <EditForm Model="this" OnSubmit="ConfirmActAsync" novalidate>
                <div class="form-grid">
                    <AppDateField @bind-Value="actDate" Label="@(step == Step.Declare ? "Zugegangen am" : "Zugestimmt am")" Required="true"
                                  Hint="@(step == Step.Declare ? "Tag, an dem der Mieter das Schreiben erhalten hat. Die Termine werden daraus berechnet." : "Der Mieter muss innerhalb der Zustimmungsfrist zugestimmt haben.")" />
                </div>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">@(step == Step.Declare ? "Zugang übernehmen" : "Zustimmung übernehmen")</MudButton>
            </EditForm>
        }
    </section>
}
</InteractiveShell>

@code {
    private async Task AddComparableAsync()
    {
        var dialog = await Dialogs.ShowAsync<ComparableFlatDialog>("Vergleichswohnung", new DialogParameters(), ListDialogOptions);
        if (await dialog.Result is { Canceled: false, Data: ComparableFlatInput added })
        {
            input.Comparables.Add(added);
        }
    }

    private async Task EditComparableAsync(ComparableFlatInput flat)
    {
        var dialog = await Dialogs.ShowAsync<ComparableFlatDialog>("Vergleichswohnung bearbeiten", new DialogParameters { ["Existing"] = flat }, ListDialogOptions);
        if (await dialog.Result is { Canceled: false, Data: ComparableFlatInput changed })
        {
            input.Comparables[input.Comparables.IndexOf(flat)] = changed;
        }
    }

    private static readonly DialogOptions ListDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    private enum Step
    {
        Declare,
        Agree,
    }

    private static readonly RentIncreaseKind[] AllKinds = Enum.GetValues<RentIncreaseKind>();

    private RentIncreaseOverview? overview;
    private IReadOnlyList<TemplateRow> templates = [];
    private IReadOnlyList<string>? errors;
    private RentIncreaseInput input = new();
    private RentIncreaseCheck? check;
    private Guid? previewId;
    private Guid? acting;
    private Step step;
    private DateOnly? actDate;
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    private IEnumerable<RentIncreaseKind> Kinds => AllKinds;

    private IEnumerable<TemplateRow> KindTemplates => templates.Where(t => t.Name.Contains(Keyword(input.Kind), StringComparison.Ordinal) || !templates.Any(o => o.Name.Contains(Keyword(input.Kind), StringComparison.Ordinal)));

    private IReadOnlyList<ReadinessIssue> readiness = [];

    private bool Blocked => readiness.Any(i => i.Blocking);

    private async Task ReloadAsync()
    {
        templates = (await Templates.ListAsync()).Where(t => t.Kind == TemplateKind.RentIncrease).ToList();
        SelectTemplate();
        readiness = await Readiness.CheckAsync(TemplateKind.RentIncrease, Id);
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        overview = await Increases.OverviewAsync(Id);
        if (overview is not null)
        {
            readiness = await Readiness.CheckAsync(TemplateKind.RentIncrease, Id);
            templates = (await Templates.ListAsync()).Where(t => t.Kind == TemplateKind.RentIncrease).ToList();
            input.Kind = overview.Model switch
            {
                RentModel.Index => RentIncreaseKind.Index,
                RentModel.Graduated => RentIncreaseKind.Graduated,
                _ => overview.BillingType == BillingType.FlatRate ? RentIncreaseKind.FlatRate : RentIncreaseKind.Comparative,
            };
            input.Comparables = [new(), new(), new()];
            SelectTemplate();
        }

        loaded = true;
    }

    private static string Keyword(RentIncreaseKind kind) => kind switch
    {
        RentIncreaseKind.Index => "Indexmiete",
        RentIncreaseKind.Graduated => "Staffel",
        RentIncreaseKind.FlatRate => "Pauschale",
        RentIncreaseKind.Modernisation => "Modernisierung",
        _ => "Vergleichsmiete",
    };

    private void OnKindChanged(RentIncreaseKind kind)
    {
        input.Kind = kind;
        check = null;
        previewId = null;
        SelectTemplate();
    }

    private void SelectTemplate() => input.TemplateId = KindTemplates.FirstOrDefault()?.Id;

    private async Task CheckAsync()
    {
        errors = null;
        check = await Increases.CheckAsync(Id, input);
    }

    private async Task PreviewAsync()
    {
        var preview = await Increases.PreviewAsync(Id, input);
        errors = preview.Errors.Count > 0 ? preview.Errors : null;
        previewId = preview.Pdf is { } pdf ? Previews.Add(pdf) : null;
    }

    private async Task CreateAsync()
    {
        var result = await Increases.CreateDraftAsync(Id, input);
        errors = result.Succeeded ? null : result.Errors;
        previewId = null;
        if (result.Succeeded)
        {
            check = null;
            overview = await Increases.OverviewAsync(Id);
            Notify.Success("Das Schreiben wurde erzeugt und bei den Dokumenten abgelegt. Nach dem Versand den Zugang erfassen.");
        }
    }

    private void Act(Guid increaseId, Step what)
    {
        acting = increaseId;
        step = what;
        actDate = DateOnly.FromDateTime(DateTime.Today);
    }

    private async Task ConfirmActAsync()
    {
        if (acting is not { } increaseId || actDate is not { } date)
        {
            errors = ["Bitte das Datum angeben."];
            return;
        }

        var result = step == Step.Declare ? await Increases.DeclareAsync(increaseId, date) : await Increases.AgreeAsync(increaseId, date);
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            acting = null;
            overview = await Increases.OverviewAsync(Id);
            Notify.Success(step == Step.Declare ? "Der Zugang wurde erfasst, die Termine sind berechnet." : "Die Zustimmung wurde erfasst, die neue Miete steht im Vertrag.");
        }
    }

    private async Task RefuseAsync(RentIncreaseRow row)
    {
        if (!await Confirm.AskAsync("Verlangen abgelehnt", "Das Verlangen wird als abgelehnt oder nicht fristgerecht beantwortet markiert. Die Miete bleibt unverändert. Ein Zustimmungsverfahren (Klage innerhalb von drei Monaten) ist Sache des Vermieters.", "Ja, markieren"))
        {
            return;
        }

        await RunAsync(Increases.RefuseAsync(row.Id));
    }

    private async Task WithdrawAsync(RentIncreaseRow row)
    {
        if (!await Confirm.AskAsync("Schreiben verwerfen", "Das Schreiben wird als verworfen markiert. Das Dokument bleibt bei den Dokumenten erhalten.", "Ja, verwerfen"))
        {
            return;
        }

        await RunAsync(Increases.WithdrawAsync(row.Id));
    }

    private async Task RunAsync(Task<Result> command)
    {
        var result = await command;
        errors = result.Succeeded ? null : result.Errors;
        acting = null;
        overview = await Increases.OverviewAsync(Id);
    }
}
