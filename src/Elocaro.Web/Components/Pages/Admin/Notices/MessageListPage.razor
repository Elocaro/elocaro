@page "/verwaltung/nachrichten"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Application.Notices
@inject IMessages Messages

<InteractiveShell>
    <PageHeader Title="Nachrichten" Subtitle="Unterhaltungen mit den Mietern im Portal.">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/verwaltung/nachrichten/neu">Nachricht schreiben</MudButton>
        </Actions>
    </PageHeader>

    @if (rows is not null)
    {
        <ThreadTable Rows="rows" BasePath="/verwaltung/nachrichten" WithPeople="true" EmptyText="Noch keine Nachrichten." />
    }
</InteractiveShell>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> Authentication { get; set; } = default!;

    private IReadOnlyList<ThreadRow>? rows;

    protected override async Task OnInitializedAsync() => rows = await Messages.ListAsync((await Authentication).User);
}
