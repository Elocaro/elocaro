@page "/verwaltung/bank/umsaetze/{Id:guid}/zuordnen"
@rendermode InteractiveServer
@using MudBlazor
@inject IPaymentAssignment Assignment
@inject IBankService Bank
@inject Notifier Notify
@inject Confirmations Confirm
@inject IDialogService Dialogs

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (proposal is null)
{
    <PageHeader Title="Umsatz nicht gefunden" Back="/verwaltung/bank/zuordnung" BackText="Zuordnung" />
}
else
{
var u = proposal.Transaction;
var income = u.Amount > 0;

<PageHeader Title="@($"Umsatz {Format.Money(u.Amount)} vom {Format.Date(u.BookingDate)}")" Subtitle="@proposal.Account" Back="/verwaltung/bank/zuordnung" BackText="Zuordnung" />

<ErrorList Errors="errors" />

<section>
    <h2>Umsatz</h2>
    <dl class="details">
        <dt>Status</dt>
        <dd><StatusChip Level="Labels.Level(u.Status)">@Labels.From(u.Status)</StatusChip>@if (u.Note is not null) {<span class="small">&#32;Notiz: @u.Note</span>}</dd>
        <dt>Gegenseite</dt>
        <dd>@(u.CounterpartyName ?? "–")<span class="small">&#32;@u.CounterpartyIban</span></dd>
        <dt>Verwendungszweck</dt>
        <dd>@u.Purpose</dd>
        <dt>Betrag</dt>
        <dd>@Format.Money(u.Amount)</dd>
    </dl>
</section>

@if (u.Status == TransactionStatus.Assigned)
{
    <section>
        <h2>Zuordnung</h2>
        <div class="table-wrapper">
            <table class="data-table">
                <thead><tr><th>Art</th><th>Ziel</th><th>Details</th><th class="number">Betrag</th></tr></thead>
                <tbody>
                    @foreach (var a in assignments)
                    {
                        <tr>
                            <td>@a.Kind</td>
                            <td>@if (a.Link is not null) {<a href="@a.Link">@a.Target</a>} else {@a.Target}</td>
                            <td>@a.Detail @if (a.ReceiptWithoutFile) {<StatusChip Level="StatusLevel.Warning">Beleg ohne Datei</StatusChip>}</td>
                            <td class="number">@Format.Money(a.Amount)</td>
                        </tr>
                    }
                </tbody>
                <tfoot><tr><th colspan="3">Summe</th><th class="number">@Format.Money(assignments.Sum(a => a.Amount))</th></tr></tfoot>
            </table>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="UnassignAsync">Zuordnung rückgängig machen</MudButton>
    </section>
}
else if (u.Status == TransactionStatus.Ignored)
{
    <section>
        <h2>Ignoriert</h2>
        <MudButton Variant="Variant.Outlined" OnClick="ReopenAsync">Wieder öffnen</MudButton>
    </section>
}
else if (options is not null)
{
    <section>
        <h2>Vorschläge</h2>
        @if (proposal.Suggestions.Count == 0)
        {
            <p class="small">Kein Vorschlag. Bitte unten manuell zuordnen oder eine Regel anlegen.</p>
        }
        else
        {
            @for (var i = 0; i < proposal.Suggestions.Count; i++)
            {
                var rank = i;
                var s = proposal.Suggestions[i];
                <article class="suggestion">
                    <h3>@s.Target <StatusChip Level="@(s.Score >= 70 ? StatusLevel.Success : StatusLevel.Warning)">@(s.Score >= 90 ? "sehr sicher" : s.Score >= 70 ? "wahrscheinlich" : "unsicher, bitte prüfen")</StatusChip></h3>
                    <ul class="small">
                        @foreach (var reason in s.Reasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                    @if (s.Parts.Count > 1)
                    {
                        <p class="small">Aufgeteilt auf: @string.Join(", ", s.Parts.Select(p => $"{p.Text} {Format.Money(p.Amount)}"))</p>
                    }
                    <MudButton Variant="@(i == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="() => AcceptAsync(rank)" aria-label="@($"Vorschlag {i + 1} übernehmen: {s.Target}")">Übernehmen</MudButton>
                </article>
            }
        }
    </section>

    <section>
        <h2>Manuell zuordnen oder aufteilen</h2>
        @if (income)
        {
            <p class="small">Zur Anrechnung siehe <HelpTerm Term="Verrechnungsreihenfolge" />.</p>
        }
        <p class="small">
            @(income ? "Ein Umsatz kann auf mehrere Mietverhältnisse oder Forderungen verteilt werden (z. B. Sammelzahlung für mehrere Monate)." : "Ein Umsatz kann auf mehrere Kostenarten oder Objekte verteilt werden.")
            Die Teilbeträge müssen zusammen genau den Umsatz von @Format.Money(Math.Abs(u.Amount)) ergeben; ein leerer Betrag erhält den Rest.
            @(income ? "Ohne bestimmte Forderung werden Zahlungen in der festgelegten Reihenfolge angerechnet; Teilzahlungen bleiben offen, Überzahlungen werden Guthaben." : "Ohne vorhandenen Beleg wird ein neuer Beleg für den Umsatz angelegt; die Datei kann später ergänzt werden.")
        </p>
        @if (parts.Count == 0)
        {
            <p class="small">Noch kein Teil. „Teil hinzufügen“ legt fest, wohin der Umsatz oder ein Teil davon gehört; mit mehreren Teilen wird er aufgeteilt.</p>
        }
        else
        {
            <MudTable T="AssignmentPartForm" Items="parts" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Dense="true" id="assignment-parts">
                <HeaderContent>
                    <MudTh>Teil</MudTh><MudTh Style="text-align:right">Betrag</MudTh><MudTh>Zuordnung</MudTh><MudTh>Notiz</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="part">
                    <MudTd DataLabel="Teil">@(parts.IndexOf(part) + 1)</MudTd>
                    <MudTd DataLabel="Betrag" Style="text-align:right">@(part.Amount is { } amount ? Format.Money(amount) : "Rest")</MudTd>
                    <MudTd DataLabel="Zuordnung">@PartText(part)</MudTd>
                    <MudTd DataLabel="Notiz">@part.Note</MudTd>
                    <MudTd Style="text-align:right; white-space:nowrap">
                        <MudButton Variant="Variant.Text" OnClick="() => EditPartAsync(part)" aria-label="@($"Teil {parts.IndexOf(part) + 1} bearbeiten")">Bearbeiten</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => parts.Remove(part)" aria-label="@($"Teil {parts.IndexOf(part) + 1} entfernen")">Entfernen</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        @if (parts.Count > 0)
        {
            <p class="small" id="assignment-rest">
                Verteilt: @Format.Money(Assigned) von @Format.Money(Math.Abs(u.Amount)) ·
                @if (parts.Any(p => p.Amount is null))
                {
                    <strong>Der Rest von @Format.Money(Math.Abs(u.Amount) - Assigned) geht an den Teil ohne Betrag.</strong>
                }
                else
                {
                    <strong>Noch offen: @Format.Money(Math.Abs(u.Amount) - Assigned)</strong>
                }
            </p>
            <ProgressMeter Value="Assigned" Total="Math.Abs(u.Amount)" Text="@($"{Format.Money(Assigned)} von {Format.Money(Math.Abs(u.Amount))} verteilt")" />
        }
        <div class="form-row">
            <MudButton Variant="@(parts.Count == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="AddPartAsync">Teil hinzufügen</MudButton>
            @if (parts.Count > 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AssignAsync">Zuordnen</MudButton>
            }
        </div>
    </section>

    <section>
        <h2>Ignorieren</h2>
        <div class="form-row">
            <AppTextField @bind-Value="ignoreNote" Label="Notiz (optional)" Placeholder="z. B. privat, Umbuchung" />
            <MudButton Variant="Variant.Outlined" OnClick="IgnoreAsync">Als privat ignorieren</MudButton>
        </div>
        <p><a href="@RuleLink(u)">Regel aus diesem Umsatz anlegen</a></p>
    </section>
}

<ChangeHistory EntityType="Transaction" EntityId="Id" />
}
</InteractiveShell>

@code {
    private decimal Assigned => parts.Sum(p => Math.Abs(p.Amount ?? 0m));

    private static readonly IReadOnlyList<bool?> allocableChoices = [true, false];

    private AssignmentProposal? proposal;
    private AssignmentOptions? options;
    private IReadOnlyList<AssignmentView> assignments = [];
    private IReadOnlyList<string>? errors;
    private List<AssignmentPartForm> parts = [];
    private IReadOnlyList<string> targetKeys = [];
    private IReadOnlyList<Guid?> receiptIds = [];
    private string? ignoreNote;
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        proposal = await Assignment.ProposalAsync(Id);
        if (proposal is not null)
        {
            assignments = await Assignment.AssignmentsAsync(Id);
            if (proposal.Transaction.Status == TransactionStatus.Open)
            {
                options = await Assignment.OptionsAsync();
                var income = proposal.Transaction.Amount > 0;
                targetKeys = options.Leases.Select(l => $"L:{l.Id}").Concat(income ? options.Charges.Select(c => $"C:{c.Id}") : []).ToList();
                receiptIds = options.Receipts.Select(r => (Guid?)r.Id).ToList();
            }
        }

        loaded = true;
    }

    private string TargetText(string? key) =>
        key is null ? "" :
        key.StartsWith("L:", StringComparison.Ordinal) ? options!.Leases.FirstOrDefault(l => $"L:{l.Id}" == key)?.Text ?? "" :
        "Forderung: " + (options!.Charges.FirstOrDefault(c => $"C:{c.Id}" == key)?.Text ?? "");

    private string ReceiptText(Guid? id) => options?.Receipts.FirstOrDefault(r => r.Id == id)?.Text ?? "";

    private bool Income => proposal!.Transaction.Amount > 0;

    private static string CostTypeText(string? key) =>
        Elocaro.Domain.Receipts.CostTypes.All.FirstOrDefault(k => k.Key == key) is { } kind
            ? kind.Allocable ? $"{kind.BetrKvNumber}. {kind.Name}" : $"{kind.Name} (nicht umlagefähig)"
            : "";

    private string PartText(AssignmentPartForm part)
    {
        if (!string.IsNullOrEmpty(part.Target))
        {
            return TargetText(part.Target);
        }

        if (Income)
        {
            return "Nach Verrechnungsreihenfolge";
        }

        if (part.LoanId is { } loan)
        {
            return "Darlehensrate: " + (options!.Loans.FirstOrDefault(l => l.Id == loan)?.Text ?? "");
        }

        var property = options!.Properties.FirstOrDefault(o => o.Id == part.PropertyId)?.Name;
        return string.Join(" · ", new[] { CostTypeText(part.CostType), property }.Where(text => !string.IsNullOrEmpty(text)));
    }

    private async Task AddPartAsync()
    {
        var part = new AssignmentPartForm();
        if (await ShowPartAsync("Teil hinzufügen", part))
        {
            parts.Add(part);
        }
    }

    private async Task EditPartAsync(AssignmentPartForm part)
    {
        var copy = part.Copy();
        if (await ShowPartAsync("Teil bearbeiten", copy))
        {
            parts[parts.IndexOf(part)] = copy;
        }
    }

    private async Task<bool> ShowPartAsync(string title, AssignmentPartForm part)
    {
        RenderFragment fields = @<text>
            <AppNumberField T="decimal?" @bind-Value="part.Amount" Label="Betrag" Suffix="€" Hint="Leer = Rest" />
            <AppSelect T="string" @bind-Value="part.Target" Label="@(Income ? "Mietverhältnis oder Forderung" : "Auszahlung an Mieter (optional)")" Items="targetKeys" Text="TargetText" EmptyText="@(Income ? "– bitte wählen –" : "– keine, Kostenposition –")" />
            @if (!Income && options!.Loans.Count > 0)
            {
                <OptionSelect @bind-Value="part.LoanId" Label="Darlehensrate (statt Kostenposition)" Options="options.Loans.Select(o => (o.Id, o.Text)).ToList()" />
                @if (part.LoanId is not null)
                {
                    <AppNumberField T="decimal?" @bind-Value="part.LoanInterest" Label="Davon Zinsen" Suffix="€" Hint="Leer = laut Tilgungsplan" />
                }
            }

            @if (!Income && part.LoanId is null)
            {
                <CostTypeSelect @bind-Value="part.CostType" />
                <OptionSelect @bind-Value="part.PropertyId" Label="Objekt" Options="options!.Properties.Select(o => (o.Id, o.Name)).ToList()" />
                <OptionSelect @bind-Value="part.UnitId" Label="Nur Einheit" Options="options.Units.Select(o => (o.Id, o.Name)).ToList()" />
                <AppDateField @bind-Value="part.From" Label="Leistungszeitraum von" Hint="Leer = Kalenderjahr der Buchung" />
                <AppDateField @bind-Value="part.To" Label="bis" />
                <AppSelect T="bool?" @bind-Value="part.Allocable" Label="Umlagefähig" Items="allocableChoices" Text="@(v => v == true ? "ja" : "nein")" EmptyText="nach Kostenart" />
                <AppSelect T="Guid?" @bind-Value="part.ReceiptId" Label="Beleg" Items="receiptIds" Text="ReceiptText" EmptyText="Neuen Beleg anlegen" />
            }
            <AppTextField @bind-Value="part.Note" Label="Notiz" />
        </text>;
        return await Dialogs.ShowFormAsync(title, part, fields, () => Task.FromResult(new Result(true, [])), "Übernehmen");
    }

    private static string RuleLink(TransactionRow u)
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(u.CounterpartyIban))
        {
            query.Add("iban=" + Uri.EscapeDataString(u.CounterpartyIban));
        }

        if (!string.IsNullOrWhiteSpace(u.CounterpartyName))
        {
            query.Add("name=" + Uri.EscapeDataString(u.CounterpartyName));
        }

        query.Add("richtung=" + (u.Amount > 0 ? "Income" : "Expense"));
        return "/verwaltung/bank/regeln/neu?" + string.Join('&', query);
    }

    private Task AssignAsync() => ExecuteAsync(Assignment.AssignAsync(Id, parts.Select(p => p.ToInput()).ToList()), "Der Umsatz wurde zugeordnet.");

    private Task AcceptAsync(int rank) => ExecuteAsync(Assignment.AcceptAsync(Id, rank), "Der Vorschlag wurde übernommen.");

    private Task IgnoreAsync() => ExecuteAsync(Bank.IgnoreAsync(Id, ignoreNote), "Der Umsatz wird ignoriert.");

    private Task ReopenAsync() => ExecuteAsync(Bank.ReopenAsync(Id), "Der Umsatz ist wieder offen.");

    private async Task UnassignAsync()
    {
        if (await Confirm.AskAsync("Zuordnung rückgängig machen", "Zahlungen, Kostenpositionen und dafür angelegte Belege werden wieder entfernt; der Umsatz ist danach offen.", "Ja, rückgängig machen"))
        {
            await ExecuteAsync(Assignment.UnassignAsync(Id), "Die Zuordnung wurde rückgängig gemacht.");
        }
    }

    private async Task ExecuteAsync(Task<Result> command, string success)
    {
        var result = await command;
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success(success);
            parts = [];
            await LoadAsync();
        }
    }
}
