@page "/verwaltung/bank/zuordnung"
@rendermode InteractiveServer
@using MudBlazor
@inject IPaymentAssignment Assignment
@inject IBankService Bank
@inject IDialogService Dialogs
@inject Notifier Notify
@inject Confirmations Confirm

<InteractiveShell>
    <PageHeader Title="Umsätze zuordnen" Subtitle="Unzugeordnete Umsätze mit Vorschlag: bestätigen, ändern oder aufteilen, ignorieren.">
        <Actions>
            <MudButton Variant="Variant.Outlined" Href="@ImportLink">Kontoauszug importieren</MudButton>
            @if (Certain.Count > 1)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AcceptAllAsync">@Certain.Count sichere Vorschläge bestätigen</MudButton>
            }
        </Actions>
    </PageHeader>

    <ErrorList Errors="errors" />

    <div class="form-row search-bar" role="search">
        <AppSelect T="Guid?" Value="accountId" ValueChanged="OnAccountChanged" Label="Konto" Items="accountIds" Text="AccountText" EmptyText="Alle Konten" />
    </div>

    @if (rows is { Count: 0 })
    {
        <EmptyState Text="@(hasAny ? "Alle Umsätze sind zugeordnet." : "Noch keine Umsätze importiert.")">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@ImportLink">Kontoauszug importieren</MudButton>
        </EmptyState>
    }
    else if (rows is not null)
    {
        <p class="small">@rows.Count offene Umsätze · @rows.Count(r => r.Suggestion is not null) mit Vorschlag</p>
        <ul class="work-list">
            @foreach (var row in rows.Take(visible))
            {
                var u = row.Transaction;
                <li class="work-card">
                    <div class="work-card-transaction">
                        <span class="work-card-amount @(u.Amount < 0 ? "negative" : null)">@Format.Money(u.Amount)</span>
                        <div>
                            <strong>@u.CounterpartyName</strong><span class="small">&#32;@u.CounterpartyIban</span>
                            <div class="small">@Format.Date(u.BookingDate) · @u.Purpose</div>
                        </div>
                    </div>
                    <div class="work-card-suggestion">
                        @if (row.Suggestion is { } s)
                        {
                            <strong>@s.Target</strong>
                            <StatusChip Level="@(s.Score >= 70 ? StatusLevel.Success : StatusLevel.Warning)">@ScoreText(s.Score)</StatusChip>
                            <div class="small">@string.Join(" · ", s.Reasons)</div>
                            @if (s.Parts.Count > 1)
                            {
                                <div class="small">@s.Parts.Count Teilbeträge</div>
                            }
                            @if (row.Alternatives > 0)
                            {
                                <div class="small">+ @row.Alternatives weitere Vorschläge</div>
                            }
                        }
                        else
                        {
                            <span class="small">kein Vorschlag</span>
                        }
                    </div>
                    <div class="row-actions">
                        @if (row.Suggestion is not null)
                        {
                            <MudButton Variant="@(row.Suggestion.Score >= 70 ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="() => AcceptAsync(u)" aria-label="@($"Vorschlag für den Umsatz vom {Format.Date(u.BookingDate)} über {Format.Money(u.Amount)} bestätigen")">Bestätigen</MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Href="@($"/verwaltung/bank/umsaetze/{u.Id}/zuordnen")" aria-label="@($"Umsatz vom {Format.Date(u.BookingDate)} über {Format.Money(u.Amount)} ändern oder aufteilen")">Ändern / Aufteilen</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="() => IgnoreAsync(u)" aria-label="@($"Umsatz vom {Format.Date(u.BookingDate)} über {Format.Money(u.Amount)} ignorieren")">Ignorieren</MudButton>
                    </div>
                </li>
            }
        </ul>
        @if (rows.Count > visible)
        {
            <MudButton Variant="Variant.Outlined" OnClick="ShowMore">Weitere @Math.Min(PageSize, rows.Count - visible) von @(rows.Count - visible) anzeigen</MudButton>
        }
    }
</InteractiveShell>

@code {
    private const int PageSize = 50;

    private int visible = PageSize;

    private void ShowMore() => visible += PageSize;

    private IReadOnlyList<BankAccountRow> accounts = [];
    private IReadOnlyList<Guid?> accountIds = [];
    private IReadOnlyList<InboxRow>? rows;
    private IReadOnlyList<string>? errors;
    private Guid? accountId;

    // The query string only provides the start value (see ADR 0005).
    [SupplyParameterFromQuery(Name = "konto")]
    private Guid? InitialAccount { get; set; }

    protected override async Task OnInitializedAsync()
    {
        accounts = await Bank.AccountsAsync();
        accountIds = accounts.Select(a => (Guid?)a.Id).ToList();
        accountId = InitialAccount;
        await LoadAsync();
    }

    private string AccountText(Guid? id) => accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "";

    private async Task OnAccountChanged(Guid? value)
    {
        accountId = value;
        visible = PageSize;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        rows = await Assignment.InboxAsync(accountId);
        hasAny = rows.Count > 0 || (await Bank.TransactionsAsync(new TransactionQuery(accountId))).Count > 0;
    }

    private bool hasAny;

    private const int CertainFrom = 90;

    private List<InboxRow> Certain => [.. (rows ?? []).Where(r => r.Suggestion is { Score: >= CertainFrom })];

    /// <summary>Single account: straight to its upload; otherwise the list of accounts.</summary>
    private string ImportLink => accountId is { } id ? $"/verwaltung/bank/konten/{id}" : accounts.Count == 1 ? $"/verwaltung/bank/konten/{accounts[0].Id}" : "/verwaltung/bank/konten";

    private static string ScoreText(int score) => score >= CertainFrom ? "sehr sicher" : score >= 70 ? "wahrscheinlich" : "unsicher, bitte prüfen";

    private async Task AcceptAllAsync()
    {
        var certain = Certain;
        if (!await Confirm.AskAsync("Vorschläge bestätigen", $"{certain.Count} Umsätze über zusammen {Format.Money(certain.Sum(r => r.Transaction.Amount))} werden wie vorgeschlagen zugeordnet.", "Ja, alle bestätigen"))
        {
            return;
        }

        var failed = new List<string>();
        foreach (var row in certain)
        {
            failed.AddRange((await Assignment.AcceptAsync(row.Transaction.Id, 0)).Errors);
        }

        errors = failed.Count == 0 ? null : failed;
        if (failed.Count == 0)
        {
            Notify.Success($"{certain.Count} Vorschläge wurden übernommen.");
        }

        await LoadAsync();
    }

    private async Task AcceptAsync(TransactionRow transaction) => await ChangeAsync(await Assignment.AcceptAsync(transaction.Id, 0), "Der Vorschlag wurde übernommen.");

    private async Task IgnoreAsync(TransactionRow transaction)
    {
        var dialog = await Dialogs.ShowAsync<IgnoreDialog>("Umsatz ignorieren", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: string note })
        {
            await ChangeAsync(await Bank.IgnoreAsync(transaction.Id, note.Length == 0 ? null : note), "Der Umsatz wird ignoriert.");
        }
    }

    private async Task ChangeAsync(Result result, string success)
    {
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success(success);
            await LoadAsync();
        }
    }
}
