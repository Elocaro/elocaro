@using MudBlazor
@inject IPersonService Admin
@inject Notifier Notify
@inject TimeProvider Clock

@* Dialog "create person": stays on the list page, reports with a snackbar and returns the id of the new person. *@
<EditForm Model="data" OnValidSubmit="SaveAsync" novalidate class="dialog-form">
    <DataAnnotationsValidator />
    <MudDialog>
        <DialogContent>
            <ErrorList Errors="errors" />
            <PersonEditor Data="data" Address="address" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Abbrechen</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Person anlegen</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    private readonly PersonInput data = new();
    private readonly AddressInput address = new();
    private IReadOnlyList<string>? errors;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        var withAddress = !string.IsNullOrWhiteSpace(address.Street);
        if (withAddress && (string.IsNullOrWhiteSpace(address.PostalCode) || string.IsNullOrWhiteSpace(address.City)))
        {
            errors = ["Bitte zur Straße auch PLZ und Ort angeben."];
            return;
        }

        address.From ??= Elocaro.Domain.Common.GermanTime.Today(Clock.GetUtcNow());
        var result = await Admin.CreateAsync(data, withAddress ? address : null);
        if (result.Succeeded)
        {
            Notify.Success("Die Person wurde angelegt.");
            MudDialog.Close(DialogResult.Ok(result.Id));
        }
        else
        {
            errors = result.Errors;
        }
    }
}
