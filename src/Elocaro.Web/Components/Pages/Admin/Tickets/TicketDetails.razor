@page "/verwaltung/tickets/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Application.Documents
@using Elocaro.Application.Receipts
@using Elocaro.Application.Tickets
@using Elocaro.Domain.Tickets
@inject ITickets Tickets
@inject ITicketWork Work
@inject IContractorLinks ContractorLinks
@inject IReceiptService Receipts
@inject Notifier Notify

<InteractiveShell>
    <PageHeader Title="@(view?.Row.Title ?? "Ticket")" Subtitle="@(view is null ? null : string.Join(" · ", new[] { view.Row.Property, view.Row.Unit }.Where(x => !string.IsNullOrEmpty(x))))" Back="/verwaltung/tickets" BackText="Alle Tickets" />
    <StatusMessage />
    <ErrorList Errors="errors" />

    @* The thread loads through the same scoped DbContext, so it starts only after this page has finished loading. *@
    @if (loaded)
    {
        <TicketThread @key="version" Id="Id" Admin="true" OnChanged="LoadAsync" />
    }

    @if (view is not null)
    {
        <section>
            <h2>Zuständigkeit</h2>
            <div class="form-row">
                <AppSelect T="Guid?" @bind-Value="assigneeId" Label="Zuständig" EmptyText="Niemand" Items="assignees.Select(o => (Guid?)o.Id).ToList()" Text="@(id => assignees.FirstOrDefault(o => o.Id == id)?.Name ?? "")" />
                <AppDateField @bind-Value="appointment" Label="Termin" />
                <MudButton Variant="Variant.Outlined" OnClick="AssignAsync">Speichern</MudButton>
            </div>
            @if (assignees.Count == 0)
            {
                <p class="small">Zuweisen lassen sich Personen vom Typ Hausmeister oder Handwerker, die einen Zugang zum Servicebereich haben (Personenakte → Zugang einrichten).</p>
            }
        </section>

        <TicketWorkPanel @key="@("w" + version)" View="work" />

        <section>
            <h2>Link für Handwerker ohne Zugang</h2>
            <p class="small">Der Link zeigt nur dieses Ticket (ohne Kontaktdaten des Mieters), gilt befristet und endet mit dem Abschluss des Tickets.</p>
            @if (createdUrl is not null)
            {
                <Notice Level="NoticeLevel.Success">
                    <p>Link für <strong>@createdFor</strong> (gültig bis @Format.Timestamp(createdUntil!.Value)). Er wird nur jetzt angezeigt:</p>
                    <p><input class="link-field" readonly value="@createdUrl" onfocus="this.select()" aria-label="Link" /></p>
                </Notice>
            }
            <div class="form-row">
                <AppTextField @bind-Value="linkRecipient" Label="Für wen?" Hint="Firma oder Name" />
                <AppNumberField T="int" @bind-Value="linkDays" Label="Gültig (Tage)" Min="1" Max="60" />
                <MudButton Variant="Variant.Outlined" OnClick="CreateLinkAsync">Link erzeugen</MudButton>
            </div>
            @if (links.Count > 0)
            {
                <ul class="todos">
                    @foreach (var link in links)
                    {
                        <li class="todo">
                            @link.Recipient
                            <span class="small">@(link.RevokedAt is not null ? "widerrufen" : link.Active ? $"gültig bis {Format.Timestamp(link.ExpiresAt)}" : "abgelaufen")</span>
                            @if (link.Active)
                            {
                                <MudButton Variant="Variant.Text" OnClick="() => RevokeAsync(link.Id)">Widerrufen</MudButton>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <section>
            <h2>Rechnung</h2>
            <div class="form-row">
                <AppSelect T="Guid?" @bind-Value="receiptId" Label="Beleg zur Arbeit" EmptyText="Keiner" Items="receipts.Select(r => (Guid?)r.Id).ToList()" Text="@(id => receipts.FirstOrDefault(r => r.Id == id) is { } r ? $"{r.Supplier} · {Format.Date(r.InvoiceDate)} · {Format.Money(r.Gross)}" : "")" />
                <MudButton Variant="Variant.Outlined" OnClick="LinkAsync">Verknüpfen</MudButton>
                <MudButton Variant="Variant.Text" Href="@("/verwaltung/belege/neu")">Rechnung hochladen</MudButton>
            </div>
            <p class="small">Mit der Verknüpfung lassen sich die Kosten je Einheit auswerten.</p>
        </section>
    }
</InteractiveShell>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> Authentication { get; set; } = default!;

    private TicketView? view;
    private IReadOnlyList<Elocaro.Application.Documents.ReferenceOption> assignees = [];
    private IReadOnlyList<ReceiptRow> receipts = [];
    private IReadOnlyList<string>? errors;
    private Guid? assigneeId;
    private DateOnly? appointment;
    private Guid? receiptId;
    private int version;
    private bool loaded;
    private TicketWorkView work = new([], [], false);
    private IReadOnlyList<LinkRow> links = [];
    private string? linkRecipient;
    private int linkDays = TicketAccessLink.DefaultDays;
    private string? createdUrl;
    private string? createdFor;
    private DateTimeOffset? createdUntil;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        assignees = await Tickets.AssigneesAsync();
        receipts = await Receipts.SearchAsync(new ReceiptQuery());
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        view = await Tickets.GetAsync((await Authentication).User, Id);
        assigneeId = view?.AssigneeId;
        appointment = view?.Row.AppointmentOn;
        receiptId = view?.ReceiptId;
        var user = (await Authentication).User;
        work = await Work.GetAsync(user, Id) ?? work;
        links = await ContractorLinks.ListAsync(user, Id);
    }

    private async Task CreateLinkAsync()
    {
        var created = await ContractorLinks.CreateAsync((await Authentication).User, Id, linkRecipient ?? "", linkDays);
        errors = created.Result.Succeeded ? null : created.Result.Errors;
        if (created.Result.Succeeded)
        {
            createdUrl = created.Url;
            createdFor = linkRecipient;
            createdUntil = created.ExpiresAt;
            linkRecipient = null;
            await LoadAsync();
        }
    }

    private async Task RevokeAsync(Guid linkId)
    {
        var result = await ContractorLinks.RevokeAsync((await Authentication).User, linkId);
        await FinishAsync(result, "Der Link ist widerrufen.");
    }

    private async Task AssignAsync()
    {
        var result = await Tickets.AssignAsync((await Authentication).User, Id, assigneeId, appointment);
        await FinishAsync(result, "Die Zuständigkeit wurde gespeichert.");
    }

    private async Task LinkAsync()
    {
        var result = await Tickets.LinkReceiptAsync((await Authentication).User, Id, receiptId);
        await FinishAsync(result, "Der Beleg wurde verknüpft.");
    }

    private async Task FinishAsync(Elocaro.Application.Common.Result result, string success)
    {
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success(success);
            version++;
            await LoadAsync();
        }
    }
}
