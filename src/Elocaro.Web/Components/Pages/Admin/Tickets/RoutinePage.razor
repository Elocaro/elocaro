@page "/verwaltung/tickets/routinen"
@rendermode InteractiveServer
@using MudBlazor
@using Elocaro.Application.Documents
@using Elocaro.Application.Tickets
@using Elocaro.Domain.Tickets
@inject ICareRoutines Routines
@inject IDocumentLibrary Documents
@inject Notifier Notify
@inject IDialogService Dialogs

<InteractiveShell>
    <PageHeader Title="Hausmeister-Aufgaben" Subtitle="Regelmäßige Aufgaben je Objekt, vom Hausmeister im Service-Bereich abgehakt.">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync" Disabled="options is null">Aufgabe anlegen</MudButton>
            <MudMenu Label="Nachweis exportieren" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true">
                <MudMenuItem Href="@($"/verwaltung/tickets/routinen.pdf?jahr={DateTime.Today.Year}")">@DateTime.Today.Year als PDF</MudMenuItem>
                <MudMenuItem Href="@($"/verwaltung/tickets/routinen.csv?jahr={DateTime.Today.Year}")">@DateTime.Today.Year als CSV</MudMenuItem>
                <MudMenuItem Href="@($"/verwaltung/tickets/routinen.pdf?jahr={DateTime.Today.Year - 1}")">@(DateTime.Today.Year - 1) als PDF</MudMenuItem>
                <MudMenuItem Href="@($"/verwaltung/tickets/routinen.csv?jahr={DateTime.Today.Year - 1}")">@(DateTime.Today.Year - 1) als CSV</MudMenuItem>
            </MudMenu>
        </Actions>
    </PageHeader>
    <ErrorList Errors="errors" />

    @if (rows is not null)
    {
        @if (rows.Count == 0)
        {
            <EmptyState Text="Noch keine Aufgaben." />
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Aufgabe</th><th>Objekt</th><th>Rhythmus</th><th>Zuletzt</th><th>Erledigt @DateTime.Today.Year</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td><a href="/verwaltung/tickets/routinen/@row.Id">@row.Title</a>@(row.Due ? " (fällig)" : "")</td>
                                <td>@row.Property</td>
                                <td>@Labels.From(row.Interval)</td>
                                <td>@(row.LastDone is { } last ? $"{Format.Date(last)} · {row.LastDoneBy}" : "–")</td>
                                <td>@row.ChecksThisYear</td>
                                <td><MudButton Variant="Variant.Text" OnClick="() => DeactivateAsync(row.Id)">Beenden</MudButton></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</InteractiveShell>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> Authentication { get; set; } = default!;

    private ReferenceOptions? options;
    private IReadOnlyList<RoutineRow>? rows;
    private IReadOnlyList<string>? errors;

    protected override async Task OnInitializedAsync()
    {
        options = await Documents.ReferenceOptionsAsync();
        await LoadAsync();
    }

    private async Task<System.Security.Claims.ClaimsPrincipal> UserAsync() => (await Authentication).User;

    private async Task LoadAsync() => rows = await Routines.ListAsync(await UserAsync());

    private async Task CreateAsync()
    {
        var input = new RoutineInput();
        var user = await UserAsync();
        RenderFragment fields = @<text>
            <AppSelect T="Guid?" @bind-Value="input.PropertyId" Label="Objekt" Required="true" Items="options!.Properties.Select(o => (Guid?)o.Id).ToList()" Text="@(id => options.Properties.FirstOrDefault(o => o.Id == id)?.Name ?? "")" />
            <AppTextField @bind-Value="input.Title" Label="Aufgabe" Required="true" Hint="z. B. Treppenhaus reinigen" />
            <AppSelect T="CareInterval" @bind-Value="input.Interval" Label="Rhythmus" Items="Enum.GetValues<CareInterval>()" Text="@(v => Labels.From(v))" />
            <AppTextField @bind-Value="input.Description" Label="Beschreibung" />
        </text>;
        if (await Dialogs.ShowFormAsync("Aufgabe anlegen", input, fields, () => Routines.CreateAsync(user, input), "Aufgabe anlegen"))
        {
            errors = null;
            Notify.Success("Die Aufgabe ist angelegt.");
            await LoadAsync();
        }
    }

    private async Task DeactivateAsync(Guid id)
    {
        var result = await Routines.DeactivateAsync(await UserAsync(), id);
        errors = result.Succeeded ? null : result.Errors;
        await LoadAsync();
    }
}
