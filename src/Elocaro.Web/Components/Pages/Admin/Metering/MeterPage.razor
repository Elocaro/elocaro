@page "/verwaltung/zaehler/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor
@inject IMeterService Admin
@inject IPropertyService Properties
@inject NavigationManager Navigation
@inject Notifier Notify
@inject Confirmations Confirm
@inject IDialogService Dialogs

<InteractiveShell>
@if (!loaded)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (meter is null)
{
    <PageHeader Title="Zähler nicht gefunden" Back="/verwaltung/objekte" BackText="Alle Objekte" />
}
else
{

<PageHeader Title="@meter.Meter.Name" Subtitle="@($"{Labels.From(meter.Meter.Type)} · Nr. {meter.Meter.Number} · {meter.Meter.Assignment}")"
            Back="@($"/verwaltung/objekte/{meter.PropertyId}/zaehler")" BackText="@($"Zähler {meter.PropertyName}")">
    <Actions>
        @if (!meter.Meter.IsDerived && meter.Meter.RemovedOn is null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="RecordReadingAsync">Stand erfassen</MudButton>
        }
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Weitere Aktionen" Dense="true">
            <MudMenuItem OnClick="DeleteAsync">Zähler löschen</MudMenuItem>
        </MudMenu>
    </Actions>
</PageHeader>

<ErrorList Errors="errors" />

<div class="summary-card">
<dl class="details">
    <dt>Eingebaut</dt><dd>@Format.Date(meter.Meter.InstalledOn)@(meter.Meter.RemovedOn is { } removal ? $", ausgebaut am {Format.Date(removal)}" : "")</dd>
    @if (meter.Meter.CalibrationDueDate is { } deadline)
    {
        <dt>Eichfrist</dt><dd>@Format.Date(deadline)</dd>
    }
    <dt>Fernablesbar</dt><dd>@(meter.Meter.RemoteReadable ? "Ja" : "Nein")</dd>
    @if (meter.Meter.Location is not null)
    {
        <dt>Lage</dt><dd>@meter.Meter.Location</dd>
    }
    @if (meter.Terms is { Count: > 0 } terms)
    {
        <dt>Berechnet aus</dt>
        <dd>
            @foreach (var term in terms)
            {
                <span>@(term.Subtract ? "−" : "+") <a href="/verwaltung/zaehler/@term.MeterId">@term.Label</a></span>
                @if (term != terms[^1])
                {
                    <span> </span>
                }
            }
        </dd>
    }
    @if (meter.MeteringPoint.Count > 1)
    {
        <dt>Messstelle</dt>
        <dd>
            @foreach (var m in meter.MeteringPoint)
            {
                <a href="/verwaltung/zaehler/@m.Id">@m.Number</a>
                <span class="small">(@Format.Date(m.InstalledOn) – @(m.RemovedOn is null ? "heute" : Format.Date(m.RemovedOn)))</span>
                @if (m != meter.MeteringPoint[^1])
                {
                    <span> → </span>
                }
            }
        </dd>
    }
</dl>
</div>

<MudTabs Elevation="0" Rounded="false" TabPanelsClass="mt-4" Class="detail-tabs" KeepPanelsAlive="true">
    <MudTabPanel Text="Stände">
@if (meter.Meter.IsDerived)
{
    <Notice Level="NoticeLevel.Info">Rechenzähler: Er hat keine eigenen Stände. Der Verbrauch wird aus den Zählerständen der Zähler berechnet, aus denen er sich zusammensetzt (siehe oben).</Notice>
}

@if (!meter.Meter.IsDerived)
{
<section>
    <h2>Stände</h2>
        @{
            const int recent = 12;
        }
        <div class="table-wrapper">
            <table class="data-table grid-cards">
                <thead><tr><th>Datum</th><th class="number">Stand</th><th>Art</th><th>Erfasst von</th><th></th></tr></thead>
                <tbody>
                    @ReadingRows(meter.Readings.Take(recent))
                </tbody>
            </table>
        </div>
        @if (meter.Readings.Count > recent)
        {
            <details class="disclosure">
                <summary>Ältere Stände anzeigen (@(meter.Readings.Count - recent))</summary>
                <div class="table-wrapper">
                    <table class="data-table grid-cards">
                        <thead><tr><th>Datum</th><th class="number">Stand</th><th>Art</th><th>Erfasst von</th><th></th></tr></thead>
                        <tbody>
                            @ReadingRows(meter.Readings.Skip(recent))
                        </tbody>
                    </table>
                </div>
            </details>
        }
</section>
}

    </MudTabPanel>
    <MudTabPanel Text="Verbrauch">
<section>
    <h2>Verbrauch</h2>
    <LineChart id="meter-consumption" Caption="Verbrauch je Jahr" LabelHeading="Jahr" ValueHeading="Verbrauch"
               FormatValue="@(v => Format.Quantity(v, Labels.From(meter.Meter.MeasurementUnit)))"
               Points="@(meter.AnnualConsumptions.Where(y => y.Consumption.Quantity is not null).OrderBy(y => y.Year).Select(y => new ChartPoint(y.Year.ToString(System.Globalization.CultureInfo.InvariantCulture), y.Consumption.Quantity!.Value)).ToList())" />
    <div class="table-wrapper">
        <table class="data-table">
            <thead><tr><th>Jahr</th><th class="number">Verbrauch</th><th>Hinweis</th></tr></thead>
            <tbody>
                @foreach (var year in meter.AnnualConsumptions)
                {
                    <tr>
                        <td>@year.Year</td>
                        <td class="number">@Format.Quantity(year.Consumption.Quantity, Labels.From(meter.Meter.MeasurementUnit))</td>
                        <td class="small">@(year.Consumption.MissingReason ?? (year.Consumption.ContainsInterpolation ? "enthält interpolierte Stände" : ""))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (meter.SubMeters.Count > 0)
{
    <section>
        <h2>Unterzähler</h2>
        <ul>
            @foreach (var u in meter.SubMeters)
            {
                <li><a href="/verwaltung/zaehler/@u.Id">@u.Name</a> <span class="small">@u.Number · @u.Assignment</span></li>
            }
        </ul>
        @if (meter.Balance is { } balance)
        {
            <dl class="details">
                <dt>@balance.Year: Hauptzähler</dt><dd>@Format.Quantity(balance.MainMeter, Labels.From(meter.Meter.MeasurementUnit))</dd>
                <dt>Summe Unterzähler</dt><dd>@Format.Quantity(balance.SubMeterTotal, Labels.From(meter.Meter.MeasurementUnit))</dd>
                <dt>Differenz</dt><dd><strong>@Format.Quantity(balance.Difference, Labels.From(meter.Meter.MeasurementUnit))</strong> <span class="small">(Allgemeinverbrauch, Schwund, Messtoleranz)</span></dd>
            </dl>
            @foreach (var hint in balance.Hints)
            {
                <p class="small">@hint</p>
            }
        }
    </section>
}

    </MudTabPanel>
    <MudTabPanel Text="Austausch & Ausbau">
@if (meter.Meter.RemovedOn is null)
{
    <section>
        <p class="small">Beim Tausch wird der Verbrauch über alten und neuen Zähler durchgängig berechnet.</p>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ReplaceAsync">Zähler tauschen</MudButton>
    </section>

    <section>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveDataAsync">Angaben ändern</MudButton>
    </section>
}

    </MudTabPanel>
    <MudTabPanel Text="Verlauf">
<ChangeHistory EntityType="@nameof(Elocaro.Domain.Metering.Meter)" EntityId="Id" />
    </MudTabPanel>
</MudTabs>
}
</InteractiveShell>

@code {
    private RenderFragment ReadingRows(IEnumerable<ReadingView> entries) => __builder =>
    {
        <text>
                    @foreach (var entry in entries)
        {
            <tr>
                <td>@Format.Date(entry.Date)</td>
                <td class="number">@Format.Quantity(entry.Value)</td>
                <td>
                    @Labels.From(entry.Kind)
                    @if (entry.PhotoFileId is { } photo)
                    {
                        <a href="/dateien/@photo" target="_blank" rel="noopener">Foto</a>
                    }
                    @if (entry.Note is not null)
                    {
                        <span class="small">@entry.Note</span>
                    }
                </td>
                <td class="small">@entry.ReadBy</td>
                <td>
                    <MudButton Variant="Variant.Text" OnClick="() => EditReadingAsync(entry)" aria-label="@($"Stand vom {Format.Date(entry.Date)} bearbeiten")">Bearbeiten</MudButton>
                    @if (entry.Kind is not (ReadingType.Installation or ReadingType.Removal))
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveReadingAsync(entry)" aria-label="@($"Stand vom {Format.Date(entry.Date)} entfernen")">Entfernen</MudButton>
                    }
                </td>
            </tr>
        }
        </text>
    };

    private MeterDetails? meter;
    private IReadOnlyList<UnitRow> units = [];
    private IReadOnlyList<MeterRow> mainMeter = [];
    private IReadOnlyList<string>? errors;
    private ReplacementInput replacement = new();
    private MeterInput data = new();
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        meter = await Admin.GetAsync(Id);
        if (meter is not null)
        {
            data = meter.Data;
            units = (await Properties.GetAsync(meter.PropertyId))?.Units ?? [];
            mainMeter = (await Admin.ListAsync(meter.PropertyId)).Where(z => z.Id != Id).ToList();
        }

        loaded = true;
    }

    private async Task RecordReadingAsync()
    {
        var dialog = await Dialogs.ShowAsync<ReadingEntryDialog>(
            "Stand erfassen",
            new DialogParameters { ["MeterId"] = Id, ["UnitText"] = Labels.From(meter!.Meter.MeasurementUnit) },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await LoadAsync();
        }
    }
    private async Task EditReadingAsync(ReadingView reading)
    {
        var dialog = await Dialogs.ShowAsync<ReadingDialog>(
            "Stand bearbeiten",
            new DialogParameters { ["MeterId"] = Id, ["Reading"] = reading },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        if (!(await dialog.Result)!.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task RemoveReadingAsync(ReadingView reading)
    {
        if (await Confirm.AskAsync("Stand entfernen", $"Soll der Stand vom {Format.Date(reading.Date)} entfernt werden?", "Ja, entfernen"))
        {
            await ExecuteAsync(Admin.RemoveReadingAsync(Id, reading.Id), "Der Stand wurde entfernt.");
        }
    }

    private async Task ReplaceAsync()
    {
        replacement = new();
        RenderFragment fields = @<text>
            <AppDateField @bind-Value="replacement.Date" Label="Tauschdatum" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="replacement.FinalReading" Label="Endstand alter Zähler" Required="true" />
            <AppTextField @bind-Value="replacement.NewNumber" Label="Nummer neuer Zähler" Required="true" />
            <AppNumberField T="decimal?" @bind-Value="replacement.InitialReading" Label="Anfangsstand neuer Zähler" Required="true" />
            <AppDateField @bind-Value="replacement.CalibrationDueDate" Label="Eichfrist neuer Zähler" Hint="Leer = gesetzliche Frist" />
            <AppCheckBox @bind-Value="replacement.RemoteReadable" Label="Neuer Zähler ist fernablesbar" />
        </text>;
        Guid? replacementId = null;
        if (await Dialogs.ShowFormAsync("Zähler tauschen", replacement, fields, async () =>
            {
                var result = await Admin.ReplaceAsync(Id, replacement);
                replacementId = result.Id;
                return result;
            }, "Tausch erfassen"))
        {
            Navigation.NavigateTo($"/verwaltung/zaehler/{replacementId}?meldung=gespeichert");
        }
    }

    private async Task DeleteAsync()
    {
        if (!await Confirm.AskAsync("Zähler löschen", $"Soll der Zähler {meter!.Meter.Name} mit allen Zählerständen gelöscht werden? Das ist für doppelt angelegte Zähler gedacht; ein ausgebauter oder getauschter Zähler gehört stattdessen in die Historie (Tausch erfassen).", "Ja, löschen"))
        {
            return;
        }

        var result = await Admin.DeleteAsync(Id);
        if (result.Succeeded)
        {
            Notify.Success("Der Zähler wurde gelöscht.");
            Navigation.NavigateTo($"/verwaltung/objekte/{meter.PropertyId}/zaehler");
            return;
        }

        errors = result.Errors;
    }

    private async Task SaveDataAsync()
    {
        RenderFragment fields = @<MeterEditor Data="data" Units="units" MainMeter="mainMeter" TypeLocked="true" />;
        if (await Dialogs.ShowFormAsync("Angaben ändern", data, fields, () => Admin.UpdateAsync(Id, data)))
        {
            Notify.Success("Die Angaben wurden gespeichert.");
            await LoadAsync();
        }
    }

    private async Task ExecuteAsync(Task<Result> command, string success)
    {
        var result = await command;
        errors = result.Succeeded ? null : result.Errors;
        if (result.Succeeded)
        {
            Notify.Success(success);
        }

        await LoadAsync();
    }
}
