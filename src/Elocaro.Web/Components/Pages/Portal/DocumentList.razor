@page "/portal/dokumente"
@attribute [StreamRendering]
@using Elocaro.Application.Documents
@using Elocaro.Application.Portal
@inject ITenantPortal Portal
@inject IDocumentLibrary Documents

<PageHeader Title="Dokumente" Subtitle="Für Sie freigegebene Dokumente: Vertrag, Abrechnungen, Protokolle und Schreiben." />

@if (documents is null)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (documents.Count == 0)
{
    <EmptyState Text="Für Sie sind noch keine Dokumente freigegeben." />
}
else
{
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr><th>Dokument</th><th>Art</th><th>Datum</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var document in documents)
                {
                    <tr>
                        <td>@document.Title</td>
                        <td>@Labels.From(document.Category)</td>
                        <td>@Format.Date(document.Date)</td>
                        <td>
                            @if (read!.Contains(document.Id))
                            {
                                <StatusChip>gelesen</StatusChip>
                            }
                            else
                            {
                                <StatusChip Level="StatusLevel.Warning">neu</StatusChip>
                            }
                        </td>
                        <td>
                            <a href="/dateien/@document.FileId" target="_blank" rel="noopener">Öffnen</a>
                            · <a href="/dateien/@document.FileId?download=true">Herunterladen</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<DocumentRow>? documents;
    private IReadOnlySet<Guid>? read;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        read = await Portal.ReadDocumentsAsync(HttpContext.User);
        documents = await Documents.SharedAsync(HttpContext.User);
    }
}
