@page "/portal/konto"
@attribute [StreamRendering]
@using Elocaro.Application.Portal
@inject ITenantPortal Portal

<PageHeader Title="Konto" Subtitle="Ihre Mietforderungen und Zahlungen." />

@if (accounts is null)
{
    <p class="loading" role="status">Wird geladen …</p>
}
else if (accounts.Count == 0)
{
    <EmptyState Text="Für Sie gibt es noch kein Mietverhältnis." />
}
else
{
    @foreach (var account in accounts)
    {
        <section id="@($"account-{account.LeaseId}")">
            <h2>@account.RentalUnit<span class="small"> · @account.Property</span></h2>
            @if (account.AccountingStart is null)
            {
                <Notice Level="NoticeLevel.Info">Ihr Mieterkonto wird noch nicht geführt. Sobald Ihr Vermieter die Buchhaltung gestartet hat, sehen Sie hier Forderungen und Zahlungen.</Notice>
            }
            else
            {
                <dl class="details">
                    <dt>Stand</dt>
                    <dd class="account-state" data-state="@State(account.Balance)">@StateText(account.Balance)</dd>
                    @if (account.Balance > 0 && account.Due > 0)
                    {
                        <dt>Davon fällig</dt>
                        <dd>@Format.Money(account.Due)</dd>
                    }
                </dl>

                @if (account.Entries.Count == 0)
                {
                    <EmptyState Compact="true" Text="Noch keine Buchungen." />
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr><th>Datum</th><th>Buchung</th><th class="number">Forderung</th><th class="number">Zahlung</th><th class="number">Saldo</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in account.Entries)
                                {
                                    <tr>
                                        <td>@Format.Date(entry.Date)</td>
                                        <td>@entry.Text</td>
                                        <td class="number">@(entry.Debit > 0 ? Format.Money(entry.Debit) : "")</td>
                                        <td class="number">@(entry.Credit > 0 ? Format.Money(entry.Credit) : "")</td>
                                        <td class="number">@Format.Money(Math.Abs(entry.Balance))@(entry.Balance < 0 ? " Guthaben" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    }

    <p class="small">
        Zahlungen erscheinen, sobald Ihr Vermieter sie gebucht hat; das kann einige Tage dauern. Bei Fragen zu einer Buchung schreiben Sie ihm eine Nachricht.
    </p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> Authentication { get; set; } = default!;

    private IReadOnlyList<PortalAccount>? accounts;

    protected override async Task OnInitializedAsync() =>
        accounts = await Portal.AccountsAsync((await Authentication).User);

    private static string State(decimal balance) => balance > 0 ? "arrears" : balance < 0 ? "credit" : "settled";

    private static string StateText(decimal balance) => balance switch
    {
        > 0 => $"{Format.Money(balance)} offen",
        < 0 => $"{Format.Money(-balance)} Guthaben",
        _ => "ausgeglichen",
    };
}
