@using Elocaro.Application.Admin
@using Elocaro.Application.Portfolio
@inject NavigationManager Navigation

@* Trail above the tabs: area › list › names of the entities the page belongs to. Each step but the page's own is a link. *@
@if (Context is { Trail.Count: > 0 })
{
    <nav class="context-bar" aria-label="Brotkrumenpfad">
        <ol>
            <li class="context-area"><a href="@Area.Href">@Area.Label</a></li>
            @foreach (var step in Context.Trail)
            {
                var current = step.Href is not null && step == Context.Trail[^1] && Path.Equals(step.Href, StringComparison.OrdinalIgnoreCase);
                <li class="@(step == Context.Trail[^1] ? "context-last" : null)">
                    @if (step.Href is null || current)
                    {
                        <span aria-current="@(current ? "page" : null)">@step.Label</span>
                    }
                    else
                    {
                        <a href="@step.Href">@step.Label</a>
                    }
                </li>
            }
        </ol>
    </nav>
}

@code {
    [Parameter]
    public PageContext? Context { get; set; }

    private NavArea Area => AdminNavModel.AreaOf(Path) ?? AdminNavModel.AreaOf("/verwaltung/objekte")!;

    private string Path => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
}
