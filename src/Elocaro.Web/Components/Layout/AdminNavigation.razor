@using Elocaro.Application.Accounts
@using Elocaro.Application.Admin
@inject NavigationManager Navigation
@inject IModuleState Modules

@* Main navigation of the administration (sidebar and menu sheet on smartphones); entries only appear with the matching permission. *@
<ul class="navigation">
    @foreach (var group in AdminNavModel.VisibleAreas(Modules).GroupBy(a => a.Group))
    {
        var policies = group.Select(a => a.Policy).Distinct().ToList();
        var items = group.ToList();
        @if (group.Key is not null)
        {
            @if (policies.Count == 1)
            {
                <AuthorizeView Policy="@policies[0]"><li class="navigation-group">@group.Key</li></AuthorizeView>
            }
            else
            {
                <li class="navigation-divider" aria-hidden="true"></li>
            }
        }
        @foreach (var area in items)
        {
            <AuthorizeView Policy="@area.Policy">
                <li><a href="@area.Href" class="@(IsActive(area) ? "active" : null)" aria-current="@(IsActive(area) ? "page" : null)"><Icon Path="@area.Icon" /><span>@area.Label</span></a></li>
                @if (IsActive(area) && PagesOf(area) is { Length: > 1 } pages)
                {
                    @* Wide screens: the pages of the open area are listed right here (the tab bar of the area is hidden); smartphones keep the tab bar. *@
                    <li class="navigation-pages-item">
                        <ul class="navigation-pages" aria-label="@area.Label">
                            @for (var index = 0; index < pages.Length; index++)
                            {
                                var entry = pages[index];
                                @if (entry.IsGroup)
                                {
                                    <AuthorizeView Policy="@entry.Policy" Context="allowed">
                                        @if (entry.Label != entry.Children![0].Label)
                                        {
                                            @* A group whose name is not already its first page gets a heading; the others are only set apart by a line. *@
                                            <li class="navigation-pages-heading" role="presentation">@entry.Label</li>
                                        }
                                        else
                                        {
                                            <li class="navigation-pages-divider" aria-hidden="true"></li>
                                        }
                                        @foreach (var child in entry.Children!)
                                        {
                                            <AuthorizeView Policy="@child.Policy" Context="childAllowed">
                                                <li><a href="@child.Href" class="@(child.Matches(CurrentPath) ? "active" : null)" aria-current="@(child.Matches(CurrentPath) ? "page" : null)">@child.Label</a></li>
                                            </AuthorizeView>
                                        }
                                    </AuthorizeView>
                                }
                                else
                                {
                                    <AuthorizeView Policy="@entry.Policy" Context="allowed">
                                        @if (index > 0 && pages[index - 1].IsGroup)
                                        {
                                            <li class="navigation-pages-divider" aria-hidden="true"></li>
                                        }
                                        <li><a href="@entry.Href" class="@(entry.Matches(CurrentPath) ? "active" : null)" aria-current="@(entry.Matches(CurrentPath) ? "page" : null)">@entry.Label</a></li>
                                    </AuthorizeView>
                                }
                            }
                        </ul>
                    </li>
                }
            </AuthorizeView>
        }
    }
    <li class="navigation-divider" aria-hidden="true"></li>
    <li><a href="/verwaltung/hilfe" class="@(CurrentPath == "/verwaltung/hilfe" ? "active" : null)" aria-current="@(CurrentPath == "/verwaltung/hilfe" ? "page" : null)"><Icon Path="@AppIcons.Info" /><span>Hilfe</span></a></li>
</ul>

@code {
    private string Path => new Uri(Navigation.Uri).AbsolutePath;

    private string CurrentPath => Path.TrimEnd('/');

    private NavTab[] PagesOf(NavArea area) => AdminNavModel.Visible(area.Tabs, Modules);

    private bool IsActive(NavArea area) => AdminNavModel.AreaOf(Path)?.Label == area.Label;
}
