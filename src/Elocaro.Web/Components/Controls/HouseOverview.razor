@using Elocaro.Application.Portfolio
@using Elocaro.Application.Properties
@using Elocaro.Domain.Properties
@inherits DataComponent

@* The building as a plan: floors from the roof down, units side by side with a width that follows the living area. Rents and arrears only for users with finance rights. *@
@if (floors.Count > 0)
{
    <section id="house-overview" aria-label="Hausplan">
        <h2>Hausplan</h2>
        <div class="house">
            @foreach (var floor in floors)
            {
                <div class="house-floor @(floor.Rank == OutsideRank ? "is-outside" : null)">
                    <div class="house-floor-name">@floor.Name</div>
                    <div class="house-units">
                        @foreach (var unit in floor.Units)
                        {
                            <div class="house-unit" style="flex-grow:@Grow(unit)">
                                <a class="house-unit-name" href="/verwaltung/einheiten/@unit.Id">
                                    @unit.Name
                                    @if (unit.LivingArea is { } area)
                                    {
                                        <span class="small">@Format.Area(area)</span>
                                    }
                                </a>
                                @if (unit.IsSharedFlat)
                                {
                                    <span class="house-rooms">
                                        @foreach (var room in unit.RentalUnits)
                                        {
                                            <a class="house-room @Css(room)" href="/verwaltung/zimmer/@room.Id" title="@Title(room)">@room.Name: @(room.Occupancy?.Tenant ?? "leer")</a>
                                        }
                                    </span>
                                }
                                else if (unit.RentalUnits.FirstOrDefault() is { } rental)
                                {
                                    <span class="house-room @Css(rental)" title="@Title(rental)">@(rental.Occupancy?.Tenant ?? "leer")</span>
                                }
                                @foreach (var line in Facts(unit))
                                {
                                    <span class="small">@line</span>
                                }
                                @foreach (var vacant in unit.RentalUnits.Where(r => r.Occupancy is null))
                                {
                                    <a class="house-unit-action" href="/verwaltung/vertraege/neu?mietobjekt=@vacant.Id">@(vacant.IsRoom ? $"{vacant.Name}: Vertrag anlegen" : "Vertrag anlegen")</a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <p class="small house-legend"><span class="house-room state-rented">vermietet</span> <span class="house-room state-ending">Mietende absehbar</span> <span class="house-room state-arrears">Rückstand</span> <span class="house-room state-empty">leer</span></p>
        <p class="house-total" id="house-total">
            @if (figures is not null && !HideFigures)
            {
                <span>Monatsmieten <strong>@Format.Money(figures.MonthlyRent)</strong></span>
                <span>Rückstände <strong>@Format.Money(figures.Arrears)</strong></span>
            }
            <span>Leerstand <strong>@Format.Area(VacantArea)</strong></span>
        </p>
    </section>
}

@code {
    /// <summary>Hides rent and arrears when the page already shows them as tiles.</summary>
    [Parameter] public bool HideFigures { get; set; }

    private const int UnknownRank = -1000;
    private const int OutsideRank = -2000;

    private sealed record Floor(string Name, int Rank, List<UnitRow> Units);

    private List<Floor> floors = [];
    private PropertyFigures? figures;

    [Parameter, EditorRequired]
    public Guid PropertyId { get; set; }

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthenticationState { get; set; }

    private decimal VacantArea => floors.SelectMany(f => f.Units).SelectMany(u => u.RentalUnits).Where(r => r.Occupancy is null).Sum(r => r.Area ?? 0m);

    protected override async Task OnInitializedAsync()
    {
        var property = await GetAsync<IPropertyService, PropertyDetails?>(p => p.GetAsync(PropertyId));
        if (property is null)
        {
            return;
        }

        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;
            figures = await GetAsync<IPortfolioFigures, PropertyFigures?>(p => p.PropertyFiguresAsync(user, PropertyId));
        }

        floors = [.. property.Units
            .GroupBy(RankOf)
            .Select(g => new Floor(NameOf(g.Key), g.Key, [.. g.OrderBy(u => u.Name, StringComparer.CurrentCulture)]))
            .OrderByDescending(f => f.Rank)];
    }

    private static int RankOf(UnitRow unit) => unit.Type is UnitType.ParkingSpace or UnitType.Miscellaneous ? OutsideRank : unit.Floor ?? UnknownRank;

    private static string NameOf(int rank) => rank switch
    {
        OutsideRank => "Stellplätze und Sonstiges",
        UnknownRank => "Ohne Geschoss",
        _ => BuildingFloor.Label(rank),
    };

    /// <summary>Wider for larger flats, but no flat gets so narrow that its text no longer fits.</summary>
    private static string Grow(UnitRow unit) => ChartScale.Css(Math.Clamp(unit.LivingArea ?? 40m, 20m, 200m));

    private IEnumerable<string> Facts(UnitRow unit)
    {
        var rent = unit.RentalUnits.Select(r => r.Occupancy?.LeaseId).OfType<Guid>().Distinct().Sum(id => figures?.RentByLease.GetValueOrDefault(id) ?? 0m);
        if (rent > 0m)
        {
            yield return $"{Format.Money(rent)} im Monat";
        }

        var due = unit.RentalUnits.Select(r => r.Occupancy?.LeaseId).OfType<Guid>().Distinct().Sum(id => figures?.ArrearsByLease.GetValueOrDefault(id) ?? 0m);
        if (due > 0m)
        {
            yield return $"Rückstand {Format.Money(due)}";
        }

        foreach (var end in unit.RentalUnits.Where(r => r.Occupancy?.End is not null).Select(r => r.Occupancy!.End!.Value).Distinct())
        {
            yield return $"Mietende {Format.Date(end)}";
        }
    }

    private string Css(RentalUnitRow row) =>
        row.Occupancy is not { } occupancy ? "state-empty"
        : figures?.ArrearsByLease.ContainsKey(occupancy.LeaseId) == true ? "state-arrears"
        : occupancy.End is not null ? "state-ending"
        : "state-rented";

    private string Title(RentalUnitRow row) =>
        row.Occupancy is not { } occupancy ? $"{row.Name}: leer"
        : $"{row.Name}: {occupancy.Tenant}{(occupancy.End is { } end ? $", Mietende {Format.Date(end)}" : "")}{(figures?.ArrearsByLease.TryGetValue(occupancy.LeaseId, out var due) == true ? $", Rückstand {Format.Money(due)}" : "")}";
}
