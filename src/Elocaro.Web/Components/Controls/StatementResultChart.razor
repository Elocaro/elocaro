@* The result of a statement: the tenant's share against the prepayments on one scale, with the difference named in words. *@
@if (Visible)
{
    <figure class="cost-chart statement-chart" id="result-chart">
        <figcaption class="small">@Caption</figcaption>
        <div class="cost-chart-row" data-row="share">
            <span class="cost-chart-label">Ihr Anteil</span>
            <span class="cost-chart-track">
                @if (Share > 0m)
                {
                    <span class="cost-chart-bar tenant" style="width:@ChartScale.Css(Position(Share))%"></span>
                }
            </span>
            <span class="cost-chart-value">@Format.Money(Share)</span>
        </div>
        <div class="cost-chart-row" data-row="prepayments">
            <span class="cost-chart-label">Vorauszahlungen</span>
            <span class="cost-chart-track">
                @if (Prepayments > 0m)
                {
                    <span class="cost-chart-bar prepayment" style="width:@ChartScale.Css(Position(Prepayments))%"></span>
                }
            </span>
            <span class="cost-chart-value">@Format.Money(Prepayments)</span>
        </div>
        <div class="cost-chart-row" data-row="result">
            <span class="cost-chart-label"><strong>@ResultName</strong></span>
            <span class="cost-chart-track">
                @if (Balance != 0m)
                {
                    var from = Math.Min(Position(Share), Position(Prepayments));
                    <span class="cost-chart-gap" style="left:@ChartScale.Css(from)%;width:@ChartScale.Css(Math.Max(Position(Share), Position(Prepayments)) - from)%"></span>
                }
            </span>
            <span class="cost-chart-value"><strong>@Format.Money(Math.Abs(Balance))</strong></span>
        </div>
    </figure>
}

@code {
    /// <summary>Sum of the tenant's shares.</summary>
    [Parameter, EditorRequired]
    public decimal Share { get; set; }

    /// <summary>Sum of the prepayments paid.</summary>
    [Parameter, EditorRequired]
    public decimal Prepayments { get; set; }

    /// <summary>The result of the statement; positive = additional payment, negative = credit.</summary>
    [Parameter, EditorRequired]
    public decimal Balance { get; set; }

    private decimal Scale => ChartScale.Max([Share, Prepayments]);

    // A picture that contradicts the stated result would be worse than none, so bars and result have to add up.
    private bool Visible => Scale > 0m && Math.Round(Share - Prepayments, 2) == Math.Round(Balance, 2);

    private string ResultName => Balance switch
    {
        > 0m => "Nachzahlung",
        < 0m => "Guthaben",
        _ => "Ausgeglichen",
    };

    private string Caption => Balance switch
    {
        > 0m => "Ihr Anteil minus Ihre Vorauszahlungen ergibt die Nachzahlung.",
        < 0m => "Ihre Vorauszahlungen minus Ihr Anteil ergeben das Guthaben.",
        _ => "Ihr Anteil und Ihre Vorauszahlungen sind gleich hoch.",
    };

    private decimal Position(decimal amount) => ChartScale.Percent(amount, Scale);
}
