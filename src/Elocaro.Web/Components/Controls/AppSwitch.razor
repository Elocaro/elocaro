@using System.Linq.Expressions
@using MudBlazor
@* On/off setting with a short explanation below the title (a switch changes something at once or reveals more settings;
   use AppCheckBox for a yes/no answer inside a form). *@
<div class="switch-row @(Value ? "on" : null)">
    <MudSwitch T="bool" Value="Value" ValueChanged="ValueChanged" For="ValueExpression" Disabled="Disabled" Color="Color.Primary" Label="@Label" />
    @if (!string.IsNullOrEmpty(Hint))
    {
        <p class="switch-hint">@Hint</p>
    }
</div>

@code {
    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<bool>>? ValueExpression { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>Explanation below the title.</summary>
    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
