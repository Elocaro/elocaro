@using Elocaro.Application.Statements
@* The tenant's share per cost type, largest first. Several lines of one cost type (e.g. of a split period) count as one bar. A full track is the whole share. *@
@if (Scale > 0m)
{
    <figure class="cost-chart statement-chart" id="cost-type-chart">
        <figcaption class="small">Ihr Anteil je Kostenart, größter zuerst. Der volle Balken entspricht der Summe von @Format.Money(Scale).</figcaption>
        @foreach (var row in Rows)
        {
            <div class="cost-chart-row" data-cost-type="@row.CostType">
                <span class="cost-chart-label">
                    @($"{row.Name} ")
                    @if (row.Share >= 0m)
                    {
                        <span class="small cost-chart-share">@PercentText(row.Share)</span>
                    }
                </span>
                <span class="cost-chart-track">
                    @if (row.Share > 0m)
                    {
                        <span class="cost-chart-bar tenant" style="width:@ChartScale.Css(ChartScale.Percent(row.Share, Scale))%"></span>
                    }
                </span>
                <span class="cost-chart-value">@Format.Money(row.Share)</span>
            </div>
        }
    </figure>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<PortalStatementLine> Lines { get; set; } = [];

    private List<CostRow> Rows { get; set; } = [];

    private decimal Scale { get; set; }

    protected override void OnParametersSet()
    {
        Rows = [.. Lines
            .GroupBy(l => l.CostType)
            .Select(g => new CostRow(g.Key, g.First().Name, g.Sum(l => l.Share)))
            .OrderByDescending(r => r.Share)
            .ThenBy(r => r.Name, StringComparer.CurrentCulture)];
        Scale = ChartScale.Total(Rows.Select(r => r.Share));
    }

    private string PercentText(decimal share)
    {
        var percent = ChartScale.Percent(share, Scale);
        return percent is > 0m and < 1m ? "unter 1 %" : $"{Math.Round(percent, MidpointRounding.AwayFromZero):0} %";
    }

    private sealed record CostRow(string CostType, string Name, decimal Share);
}
