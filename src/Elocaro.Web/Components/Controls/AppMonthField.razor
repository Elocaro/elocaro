@using System.Linq.Expressions
@using MudBlazor
@* Month input (e.g. "Januar 2026") with a calendar. Value is text in the form "yyyy-MM" (empty = none), as the models use it. *@
<div class="app-field">
    <MudDatePicker @key="generation" Date="current" DateChanged="OnDateChanged" Label="@Label" HelperText="@Hint" Required="Required" Disabled="Disabled" Clearable="true" Editable="true"
                   OpenTo="OpenTo.Month" FixDay="1" Culture="German" Variant="Variant.Outlined" ShrinkLabel="true" Placeholder="MM.JJJJ" DateFormat="MM.yyyy" Converter="converter"
                   TextChanged="OnTextChanged" Error="errorText is not null" ErrorText="@errorText" />
    @if (ValueExpression is not null && EditContext is not null)
    {
        <ValidationMessage For="ValueExpression" />
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo German = System.Globalization.CultureInfo.GetCultureInfo("de-DE");
    private DateTime? current;
    private string? lastValue;

    // The picker keeps the text as typed; a new key makes it show the month in the normal format after each change.
    private int generation;
    private string? errorText;
    private readonly LenientDateConverter converter = new(monthOnly: true);

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Present inside an EditForm only; without it there is nothing to show messages from.</summary>
    [CascadingParameter]
    private Microsoft.AspNetCore.Components.Forms.EditContext? EditContext { get; set; }

    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    // Same pattern as AppDateField: keep the chosen value locally, take the parameter only when the parent changed it.
    protected override void OnParametersSet()
    {
        if (Value != lastValue)
        {
            lastValue = Value;
            current = DateTime.TryParseExact(Value + "-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed) ? parsed : null;
        }
    }

    // Typed text that cannot be read as a date is reported instead of silently dropped.
    private void OnTextChanged(string? typed) =>
        errorText = converter.LastReadFailed || (!string.IsNullOrWhiteSpace(typed) && LenientDateConverter.Read(typed, monthOnly: true) is null) ? "Bitte einen Monat wie 11.2026 eingeben." : null;

    private async Task OnDateChanged(DateTime? date)
    {
        current = date;
        errorText = null;
        generation++;
        await ValueChanged.InvokeAsync(date?.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture));
    }
}
