@typeparam T
@using System.Linq.Expressions
@using MudBlazor
@* Number input (int, decimal, double; also nullable) with German notation. Suffix: unit text such as "m²" or "€". *@
<MudNumericField T="T" Value="Value" ValueChanged="ValueChanged" For="ValueExpression" Label="@Label" HelperText="@Hint" Required="Required" Disabled="Disabled"
                 Culture="German" Converter="converter" HideSpinButtons="true" Adornment="@(Suffix is null ? Adornment.None : Adornment.End)" AdornmentText="@Suffix"
                 Variant="Variant.Outlined" ShrinkLabel="true" @attributes="limits" />

@code {
    private static readonly System.Globalization.CultureInfo German = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    [Parameter]
    public T? Value { get; set; }

    [Parameter]
    public EventCallback<T?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<T?>>? ValueExpression { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Suffix { get; set; }

    /// <summary>Lower limit; only applied when set (for non-nullable types an unset limit would otherwise be 0).</summary>
    [Parameter]
    public T? Min { get; set; }

    /// <summary>Upper limit; only applied when set.</summary>
    [Parameter]
    public T? Max { get; set; }

    private readonly LenientNumberConverter<T> converter = new();
    private Dictionary<string, object?> limits = [];
    private bool minGiven;
    private bool maxGiven;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        minGiven = parameters.TryGetValue<T?>(nameof(Min), out _);
        maxGiven = parameters.TryGetValue<T?>(nameof(Max), out _);
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        limits = [];
        if (minGiven)
        {
            limits["Min"] = Min;
        }

        if (maxGiven)
        {
            limits["Max"] = Max;
        }
    }
}
