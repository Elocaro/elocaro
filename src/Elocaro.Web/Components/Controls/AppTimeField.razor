@using System.Linq.Expressions
@using MudBlazor
@* Time of day (HH:mm, typed or picked on the clock face). Value is a TimeOnly?. *@
<div class="app-field">
    <MudTimePicker Time="current" TimeChanged="OnTimeChanged" Label="@Label" HelperText="@Hint" Required="Required" Disabled="Disabled" Editable="true" AmPm="false"
                   Variant="Variant.Outlined" ShrinkLabel="true" Placeholder="HH:mm" />
    @if (ValueExpression is not null && EditContext is not null)
    {
        <ValidationMessage For="ValueExpression" />
    }
</div>

@code {
    [Parameter]
    public TimeOnly? Value { get; set; }

    [Parameter]
    public EventCallback<TimeOnly?> ValueChanged { get; set; }

    /// <summary>Present inside an EditForm only; without it there is nothing to show messages from.</summary>
    [CascadingParameter]
    private Microsoft.AspNetCore.Components.Forms.EditContext? EditContext { get; set; }

    [Parameter]
    public Expression<Func<TimeOnly?>>? ValueExpression { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    // The component keeps the chosen time itself (see AppDateField): it re-renders when it raises ValueChanged, before the parent has
    // passed the new Value down.
    private TimeSpan? current;
    private TimeOnly? lastValue;

    protected override void OnParametersSet()
    {
        if (Value != lastValue)
        {
            lastValue = Value;
            current = Value?.ToTimeSpan();
        }
    }

    private async Task OnTimeChanged(TimeSpan? time)
    {
        current = time;
        await ValueChanged.InvokeAsync(time is null ? null : TimeOnly.FromTimeSpan(time.Value));
    }
}
