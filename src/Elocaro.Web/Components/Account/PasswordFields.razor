@* Input fields for a new password; must sit inside an EditForm with NewPasswordInput. *@
<div class="field">
    <label for="password">Neues Passwort (mindestens 12 Zeichen)</label>
    <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" />
    <ValidationMessage For="() => Input.Password" />
</div>
<div class="field">
    <label for="password2">Passwort wiederholen</label>
    <InputText id="password2" type="password" @bind-Value="Input.PasswordConfirmation" autocomplete="new-password" />
    <ValidationMessage For="() => Input.PasswordConfirmation" />
</div>

@code {
    [Parameter, EditorRequired]
    public NewPasswordInput Input { get; set; } = default!;
}
