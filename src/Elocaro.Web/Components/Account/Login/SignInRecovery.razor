@page "/konto/anmelden/wiederherstellungscode"
@inject SignInManager<ApplicationUser> Login
@inject Elocaro.Application.Audit.ISecurityAudit SecurityLog
@inject Redirector Redirector

<PageTitle>Wiederherstellungscode – Elocaro</PageTitle>

<h1>Wiederherstellungscode</h1>
<p>Geben Sie einen Ihrer Wiederherstellungscodes ein. Jeder Code funktioniert nur einmal.</p>

<StatusMessage Message="@errors" IsError="true" />

<EditForm Model="Input" FormName="recovery" OnValidSubmit="ValidateAsync">
    <DataAnnotationsValidator />
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    <div class="field">
        <label for="code">Wiederherstellungscode</label>
        <InputText id="code" @bind-Value="Input!.Code" autocomplete="off" />
        <ValidationMessage For="() => Input!.Code" />
    </div>
    <button type="submit" class="button button-primary">Anmelden</button>
</EditForm>

@code {
    private string? errors;

    [SupplyParameterFromForm(FormName = "recovery")]
    private CodeInput? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (await Login.GetTwoFactorAuthenticationUserAsync() is null)
        {
            Redirector.To("/konto/anmelden");
        }
    }

    private async Task ValidateAsync()
    {
        var pending = await Login.GetTwoFactorAuthenticationUserAsync();
        var result = await Login.TwoFactorRecoveryCodeSignInAsync(Input!.Code.Replace(" ", "", StringComparison.Ordinal));
        if (result.Succeeded)
        {
            await SecurityLog.LogAsync(Elocaro.Application.Audit.SecurityEvent.RecoveryCodeUsed, pending?.Email, pending?.Id);
            Redirector.To(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            await SecurityLog.LogAsync(Elocaro.Application.Audit.SecurityEvent.LockedOut, pending?.Email, pending?.Id);
            Redirector.To("/konto/gesperrt");
        }
        else
        {
            await SecurityLog.LogAsync(Elocaro.Application.Audit.SecurityEvent.RecoveryCodeFailed, pending?.Email, pending?.Id);
            errors = "Der Wiederherstellungscode ist ungültig.";
        }
    }

    private sealed class CodeInput
    {
        [Required(ErrorMessage = "Bitte einen Code eingeben.")]
        public string Code { get; set; } = "";
    }
}
