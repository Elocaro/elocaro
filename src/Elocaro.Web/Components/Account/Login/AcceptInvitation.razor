@page "/konto/einladung"
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> Login
@inject Redirector Redirector

<PageTitle>Einladung annehmen – Elocaro</PageTitle>

<h1>Willkommen bei Elocaro</h1>

@if (invalid)
{
    <Notice Level="NoticeLevel.Error">Diese Einladung ist ungültig oder abgelaufen. Bitte wenden Sie sich an den Vermieter.</Notice>
}
else
{
    <p>Bitte legen Sie Ihr Passwort fest.</p>
    <ErrorList Errors="errors" />
    <EditForm Model="Input" FormName="invitation" OnValidSubmit="AcceptAsync">
        <DataAnnotationsValidator />
        <input type="hidden" name="Benutzer" value="@UserId" />
        <input type="hidden" name="Code" value="@Code" />
        <PasswordFields Input="Input!" />
        <button type="submit" class="button button-primary">Passwort festlegen</button>
    </EditForm>
}

@code {
    private bool invalid;
    private IReadOnlyList<string>? errors;

    [SupplyParameterFromForm(FormName = "invitation")]
    private NewPasswordInput? Input { get; set; }

    [SupplyParameterFromQuery(Name = "benutzer")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        invalid = await ValidUserAsync() is null;
    }

    private async Task<ApplicationUser?> ValidUserAsync()
    {
        var user = UserId is null ? null : await UserManager.FindByIdAsync(UserId);
        if (user is null || string.IsNullOrEmpty(Code) || await UserManager.HasPasswordAsync(user))
        {
            return null;
        }

        return await UserManager.VerifyUserTokenAsync(user, TokenProviders.Invitation, TokenProviders.Invitation, Code)
            ? user
            : null;
    }

    private async Task AcceptAsync()
    {
        var user = await ValidUserAsync();
        if (user is null)
        {
            invalid = true;
            return;
        }

        var result = await UserManager.AddPasswordAsync(user, Input!.Password);
        if (!result.Succeeded)
        {
            errors = [.. result.Errors.Select(e => e.Description)];
            return;
        }

        user.EmailConfirmed = true;
        await UserManager.UpdateAsync(user);
        await Login.SignInAsync(user, isPersistent: false);

        var roles = await UserManager.GetRolesAsync(user);
        Redirector.To(roles.Any(Roles.RequiringTwoFactor.Contains) ? AccountExtensions.TwoFactorSetupPath : "/");
    }
}
