@page "/konto/link/{Token}"
@inject IAccountService Accounts
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> Login
@inject Redirector Redirector
@inject Elocaro.Application.Audit.ISecurityAudit SecurityLog

<PageTitle>Anmelden – Elocaro</PageTitle>

<h1>Anmelden</h1>

@if (invalid)
{
    <Notice Level="NoticeLevel.Error">Dieser Link ist ungültig, abgelaufen oder wurde bereits verwendet.</Notice>
    <div class="account-links"><a href="/konto/link">Neuen Anmeldelink anfordern</a></div>
}
else
{
    @* Only the click redeems the link: email scanners that open links in advance therefore do not consume it. *@
    <p>Klicken Sie auf „Anmelden“, um sich bei Elocaro anzumelden.</p>
    <form method="post" @formname="link-redeem" @onsubmit="RedeemAsync">
        <AntiforgeryToken />
        <button type="submit" class="button button-primary">Anmelden</button>
    </form>
}

@code {
    private bool invalid;

    [Parameter]
    public string Token { get; set; } = "";

    private async Task RedeemAsync()
    {
        var id = await Accounts.RedeemMagicLinkAsync(Token);
        var user = id is null ? null : await UserManager.FindByIdAsync(id.Value.ToString());
        if (user is null)
        {
            invalid = true;
            return;
        }

        await Login.SignInAsync(user, isPersistent: true);
        await SecurityLog.LogAsync(Elocaro.Application.Audit.SecurityEvent.MagicLinkSignedIn, user.Email, user.Id);
        Redirector.To("/");
    }
}
