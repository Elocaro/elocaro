@page "/konto/passwort-zuruecksetzen"
@inject UserManager<ApplicationUser> UserManager
@inject Redirector Redirector

<PageTitle>Neues Passwort – Elocaro</PageTitle>

<h1>Neues Passwort festlegen</h1>

<ErrorList Errors="errors" />

<EditForm Model="Input" FormName="password-reset" OnValidSubmit="SetAsync">
    <DataAnnotationsValidator />
    <input type="hidden" name="Benutzer" value="@UserId" />
    <input type="hidden" name="Code" value="@Code" />
    <PasswordFields Input="Input!" />
    <button type="submit" class="button button-primary">Passwort speichern</button>
</EditForm>

@code {
    private IReadOnlyList<string>? errors;

    [SupplyParameterFromForm(FormName = "password-reset")]
    private NewPasswordInput? Input { get; set; }

    [SupplyParameterFromQuery(Name = "benutzer")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task SetAsync()
    {
        var user = UserId is null ? null : await UserManager.FindByIdAsync(UserId);
        if (user is null || string.IsNullOrEmpty(Code))
        {
            errors = ["Der Link ist ungültig oder abgelaufen."];
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Code, Input!.Password);
        if (!result.Succeeded)
        {
            errors = [.. result.Errors.Select(e => e.Description)];
            return;
        }

        await UserManager.ResetAccessFailedCountAsync(user);
        Redirector.RedirectWithMessage("/konto/anmelden", "Ihr Passwort wurde geändert. Bitte melden Sie sich an.", HttpContext);
    }
}
