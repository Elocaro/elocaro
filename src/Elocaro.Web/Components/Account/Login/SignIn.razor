@page "/konto/anmelden"
@inject IAccountService Accounts
@inject SignInManager<ApplicationUser> Login
@inject Elocaro.Application.Audit.ISecurityAudit SecurityLog
@inject Redirector Redirector
@using Elocaro.Application.Admin
@using Microsoft.Extensions.Options
@inject IOptions<DemoOptions> Demo

<PageTitle>Anmelden – Elocaro</PageTitle>

<h1>Anmelden</h1>

@if (Demo.Value.Enabled)
{
    <Notice Level="NoticeLevel.Info">
        <strong>Demo:</strong> Die Beispieldaten sind erfunden und werden jede Nacht zurückgesetzt. Bitte keine echten Daten eingeben.
        Wählen Sie eine Rolle, die Anmeldung erfolgt automatisch.
    </Notice>
    <EditForm Model="DemoLogin" FormName="demo-login" OnValidSubmit="DemoSignInAsync" class="demo-roles">
        <button type="submit" name="DemoLogin.Email" value="@Demo.Value.AdminEmail" class="button button-outlined"><strong>Administrator</strong><span>alles, auch Einstellungen und Benutzer</span></button>
        @foreach (var user in DemoOptions.Users)
        {
            <button type="submit" name="DemoLogin.Email" value="@user.Email" class="button button-outlined"><strong>@user.Role</strong><span>@user.Description</span></button>
        }
    </EditForm>
    <p class="demo-hint">Oder manuell anmelden (Passwort für alle Konten: <code>@Demo.Value.AdminPassword</code>):</p>
}

<StatusMessage Message="@(SignedOut ? "Sie wurden abgemeldet." : null)" />
<StatusMessage Message="@errors" IsError="true" />

<EditForm Model="Input" FormName="login" OnValidSubmit="SignInAsync">
    <DataAnnotationsValidator />
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    <div class="field">
        <label for="email">E-Mail-Adresse</label>
        <InputText id="email" type="email" @bind-Value="Input!.Email" autocomplete="username" />
        <ValidationMessage For="() => Input!.Email" />
    </div>
    <div class="field">
        <label for="password">Passwort</label>
        <InputText id="password" type="password" @bind-Value="Input!.Password" autocomplete="current-password" />
        <ValidationMessage For="() => Input!.Password" />
    </div>
    <div class="field field-checkbox">
        <InputCheckbox id="keep" @bind-Value="Input!.RememberMe" />
        <label for="keep">Angemeldet bleiben</label>
    </div>
    <button type="submit" class="button button-primary">Anmelden</button>
</EditForm>

<div class="account-links">
    <a href="/konto/link">Ohne Passwort anmelden (Link per E-Mail)</a>
    <a href="/konto/passwort-vergessen">Passwort vergessen?</a>
</div>

@code {
    private string? errors;

    [SupplyParameterFromForm(FormName = "login")]
    private SignInInput? Input { get; set; }

    [SupplyParameterFromForm(FormName = "demo-login")]
    private DemoLoginInput? DemoLogin { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "abgemeldet")]
    private bool SignedOut { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        DemoLogin ??= new();
        if (HttpMethods.IsGet(HttpContext.Request.Method) && await Accounts.InitialSetupPossibleAsync())
        {
            Redirector.To("/konto/einrichtung");
        }
    }

    private Task SignInAsync() => SignInAsync(Input!.Email.Trim(), Input.Password, Input.RememberMe);

    /// <summary>Demo only: signs in as one of the demo accounts with the published password.</summary>
    private async Task DemoSignInAsync()
    {
        var email = DemoLogin!.Email;
        if (Demo.Value.Enabled && (email == Demo.Value.AdminEmail || DemoOptions.Users.Any(u => u.Email == email)))
        {
            await SignInAsync(email, Demo.Value.AdminPassword, rememberMe: false);
        }
    }

    private async Task SignInAsync(string email, string password, bool rememberMe)
    {
        var result = await Login.PasswordSignInAsync(email, password, rememberMe, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            await SecurityLog.LogAsync(Elocaro.Application.Audit.SecurityEvent.SignedIn, email, null);
            Redirector.To(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            Redirector.To("/konto/anmelden/zwei-faktor", new Dictionary<string, object?>
            {
                ["ReturnUrl"] = ReturnUrl,
                ["AngemeldetBleiben"] = rememberMe,
            });
        }
        else if (result.IsLockedOut)
        {
            await SecurityLog.LogAsync(Elocaro.Application.Audit.SecurityEvent.LockedOut, email, null);
            Redirector.To("/konto/gesperrt");
        }
        else
        {
            await SecurityLog.LogAsync(Elocaro.Application.Audit.SecurityEvent.SignInFailed, email, null);
            // Deliberately no distinction (unknown address, wrong password, locked account).
            errors = "E-Mail-Adresse oder Passwort ist falsch.";
        }
    }

    private sealed class DemoLoginInput
    {
        public string Email { get; set; } = "";
    }

    private sealed class SignInInput
    {
        [Required(ErrorMessage = "Bitte die E-Mail-Adresse angeben.")]
        [EmailAddress(ErrorMessage = "Bitte eine gültige E-Mail-Adresse angeben.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Bitte das Passwort angeben.")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
