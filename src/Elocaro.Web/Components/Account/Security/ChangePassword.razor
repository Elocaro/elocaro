@page "/konto/sicherheit/passwort"
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> Login
@inject Redirector Redirector
@using Elocaro.Application.Admin
@using Microsoft.Extensions.Options
@inject IOptions<DemoOptions> Demo

<PageTitle>Passwort ändern – Elocaro</PageTitle>

<h1>Passwort ändern</h1>

@if (Demo.Value.Enabled)
{
    <Notice Level="NoticeLevel.Info">In der Demo lassen sich Passwörter nicht ändern.</Notice>
}
else
{
<ErrorList Errors="errors" />

<EditForm Model="Input" FormName="password-change" OnValidSubmit="UpdateAsync">
    <DataAnnotationsValidator />
    <div class="field">
        <label for="current">Aktuelles Passwort</label>
        <InputText id="current" type="password" @bind-Value="Input!.CurrentPassword" autocomplete="current-password" />
        <ValidationMessage For="() => Input!.CurrentPassword" />
    </div>
    <PasswordFields Input="Input!" />
    <button type="submit" class="button button-primary">Passwort ändern</button>
</EditForm>
}

<div class="account-links"><a href="/konto/sicherheit">Zurück</a></div>

@code {
    private IReadOnlyList<string>? errors;

    [SupplyParameterFromForm(FormName = "password-change")]
    private ChangeInput? Input { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task UpdateAsync()
    {
        if (Demo.Value.Enabled)
        {
            return;
        }

        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Redirector.To("/konto/anmelden");
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input!.CurrentPassword, Input.Password);
        if (!result.Succeeded)
        {
            errors = [.. result.Errors.Select(e => e.Description)];
            return;
        }

        await Login.RefreshSignInAsync(user);
        Redirector.RedirectWithMessage("/konto/sicherheit", "Ihr Passwort wurde geändert.", HttpContext);
    }

    private sealed class ChangeInput : NewPasswordInput
    {
        [Required(ErrorMessage = "Bitte das aktuelle Passwort angeben.")]
        public string CurrentPassword { get; set; } = "";
    }
}
