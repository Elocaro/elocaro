@page "/konto/sicherheit"
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> Login
@inject Redirector Redirector
@using Elocaro.Application.Admin
@using Microsoft.Extensions.Options
@inject IOptions<DemoOptions> Demo
@inject IAccessTokens AccessTokens

<PageTitle>Konto &amp; Sicherheit – Elocaro</PageTitle>

<h1>Konto &amp; Sicherheit</h1>

<StatusMessage />
<ErrorList Errors="errors" />

@if (user is not null)
{
    <section class="account-profile" aria-label="Ihr Konto">
        <div class="account-avatar" aria-hidden="true">@Initials(user.DisplayName)</div>
        <div class="account-profile-text">
            <strong>@user.DisplayName</strong>
            <span>@user.Email</span>
            <span class="account-role">@string.Join(", ", roles.Select(Roles.DisplayName))</span>
        </div>
    </section>

    <h2 class="account-heading">Sicherheit</h2>
    <ul class="account-nav">
        @if (hasPassword)
        {
            <li><a href="/konto/sicherheit/passwort"><span class="account-nav-text"><strong>Passwort ändern</strong><span>Neues Passwort festlegen</span></span><Icon Path="@AppIcons.ChevronRight" /></a></li>
            <li><a href="/konto/sicherheit/zwei-faktor"><span class="account-nav-text"><strong>Zwei-Faktor-Anmeldung</strong><span>@(user.TwoFactorEnabled ? "Aktiv" : "Nicht eingerichtet, jetzt einrichten")</span></span><Icon Path="@AppIcons.ChevronRight" /></a></li>
            @if (user.TwoFactorEnabled)
            {
                <li><a href="/konto/sicherheit/wiederherstellungscodes"><span class="account-nav-text"><strong>Wiederherstellungscodes</strong><span>Neue Codes erzeugen, falls das Handy fehlt</span></span><Icon Path="@AppIcons.ChevronRight" /></a></li>
            }
        }
        else
        {
            <li class="account-nav-note">Sie melden sich per Anmeldelink an; ein Passwort ist nicht erforderlich.</li>
        }
    </ul>

    <h2 class="account-heading">Geräte und Integrationen</h2>
    <ul class="account-nav">
        <li><a href="/konto/benachrichtigungen"><span class="account-nav-text"><strong>Benachrichtigungen</strong><span>Auf diesem Gerät ein- oder ausschalten</span></span><Icon Path="@AppIcons.ChevronRight" /></a></li>
        @if (hasPassword && AccessTokens.IsAvailable && (roles.Contains(Roles.Admin) || roles.Contains(Roles.Manager)))
        {
            <li><a href="/konto/sicherheit/zugriffstoken"><span class="account-nav-text"><strong>Zugriffstoken</strong><span>Für KI-Assistenten und andere Integrationen</span></span><Icon Path="@AppIcons.ChevronRight" /></a></li>
        }
    </ul>
}

<div class="account-session">
    <form method="post" action="/konto/abmelden">
        <AntiforgeryToken />
        <button type="submit" class="button button-primary">Abmelden</button>
    </form>

@* The demo accounts are shared: one visitor would sign out all the others. *@
@if (user is not null && !Demo.Value.Enabled)
{
    <DangerAction Text="Auf allen Geräten abmelden"
                  Confirmation="Alle Anmeldungen dieses Kontos enden sofort, auch auf diesem Gerät. Gemerkte Geräte verlangen beim nächsten Mal wieder den Bestätigungscode."
                  ConfirmText="Ja, überall abmelden"
                  FormName="sign-out-everywhere"
                  Confirmed="SignOutEverywhereAsync" />
}
</div>

@code {
    private ApplicationUser? user;
    private IList<string> roles = [];
    private bool hasPassword;
    private IReadOnlyList<string>? errors;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is not null)
        {
            roles = await UserManager.GetRolesAsync(user);
            hasPassword = await UserManager.HasPasswordAsync(user);
        }
    }

    private static string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private async Task SignOutEverywhereAsync()
    {
        if (Demo.Value.Enabled || user is null)
        {
            return;
        }

        // The new stamp invalidates all sign-in cookies and the "remember this device" cookies.
        var result = await UserManager.UpdateSecurityStampAsync(user);
        if (!result.Succeeded)
        {
            errors = [.. result.Errors.Select(e => e.Description)];
            return;
        }

        await Login.SignOutAsync();
        Redirector.To("/konto/anmelden?abgemeldet=true");
    }
}
