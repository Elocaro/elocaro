<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Analyzer">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.322" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Persistenz">
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Infrastruktur">
    <PackageVersion Include="libfintx.FinTS" Version="1.4.0" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="MudBlazor" Version="9.12.0" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="4.7.2" />
    <PackageVersion Include="Quartz.Serialization.SystemTextJson" Version="4.7.2" />
    <PackageVersion Include="Scriban" Version="7.6.1" />
    <PackageVersion Include="SkiaSharp" Version="4.155.0" />
    <!-- Transitive via MimeKit; pinned because of GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.155.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="bunit" Version="2.14.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.Retry" Version="2.5.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
  </ItemGroup>
</Project>
